@inherits ThemeLayoutBase
@using global::App.Shared.RCL.Services
@using global::App.Shared.RCL.Themes
@inject IApiSession Session
@inject IAppUpdaterService UpdaterService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@PageTitles.Brand</PageTitle>

<MudThemeProvider @ref="MudThemeProviderRef" Theme="@HabitinatorMudTheme.Default" @bind-IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="true"/>
<MudSnackbarProvider/>
<TimeZoneInitializer />

<MudLayout Class="app-shell-layout">
    @if (Session.IsLoggedIn)
    {
        <MudAppBar Elevation="0" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar">
            <div class="app-top-bar__stack w-100">
                <div class="app-top-bar__row d-flex">
                    <div class="app-show-desktop-only align-center">
                        <NavMenu />
                    </div>
                </div>
                <NavMenu MobileTopBar="true" />
            </div>
        </MudAppBar>
    }
    <MudMainContent Class="app-shell-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pb-3 px-3 px-sm-4 board-main-container">
            @if (!_sessionInitialized)
            {
                <MudProgressLinear Indeterminate="true"/>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@if (Session.IsLoggedIn)
{
    <GlobalTimerFocusAlertHost/>
    <GlobalSyncAlertHost/>
}

@code {
    private static bool IsAuthPath(string path) =>
        path.Equals("/auth/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/auth/register", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/register", StringComparison.OrdinalIgnoreCase);

    private static bool IsHomePath(string path) => string.IsNullOrEmpty(path);

    private static bool IsPublicWhenLoggedOut(string path) => IsAuthPath(path) || IsHomePath(path);

    private bool _sessionInitialized;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Session.Changed += OnSessionChanged;
        IsDarkMode = GetSystemDarkMode();
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(OnSessionChangedAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (!Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }
        else
        {
            await LoadPreferencesAsync();
        }

        _sessionInitialized = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterFirstRenderAsync()
    {
        if (!Session.IsLoggedIn || !UpdaterService.IsSupported)
        {
            return;
        }

        _ = Task.Run(async () => await CheckForUpdatesOnStartupAsync());
    }

    private async Task OnSessionChangedAsync()
    {
        if (_sessionInitialized && !Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }

        if (Session.IsLoggedIn)
        {
            await LoadPreferencesAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task SyncNativeThemeAsync(bool isDarkMode)
    {
        // Keep the native status bar icon appearance in sync with the Blazor theme.
        // When following the system theme, let the OS decide.
        // otherwise, lock to the user's explicit choice.
        if (Microsoft.Maui.Controls.Application.Current is { } app)
        {
            if (Preferences?.Theme == AppTheme.System)
            {
                app.UserAppTheme = Microsoft.Maui.ApplicationModel.AppTheme.Unspecified;
            }
            else if (IsDarkMode)
            {
                app.UserAppTheme = Microsoft.Maui.ApplicationModel.AppTheme.Dark;
            }
            else
            {
                app.UserAppTheme = Microsoft.Maui.ApplicationModel.AppTheme.Light;
            }

            // Keep the safe area, behind the transparent status bar, in sync with the theme.
            if (app.Windows.FirstOrDefault()?.Page is { } page)
            {
                page.BackgroundColor = IsDarkMode
                    ? new Microsoft.Maui.Graphics.Color(3, 7, 18)
                    : new Microsoft.Maui.Graphics.Color(248, 250, 252);
            }
        }
    }

    private async Task CheckForUpdatesOnStartupAsync()
    {
        if (!UpdaterService.IsSupported) return;

        // Add a slight delay so it doesn't interfere with initial startup rendering
        await Task.Delay(3000);

        try
        {
            var result = await UpdaterService.CheckForUpdateAsync();
            if (result.UpdateAvailable)
            {
                await InvokeAsync(() =>
                {
                    Snackbar.Add(
                        $"A new version of Habitinator is available (v{result.LatestVersion}).",
                        Severity.Info,
                        config =>
                        {
                            config.Action = "View Update";
                            config.ActionColor = Color.Primary;
                            config.OnClick = async snackbar =>
                            {
                                await UpdateDialogHelper.ShowUpdateDialogAsync(
                                    DialogService,
                                    result.LatestVersion,
                                    result.ReleaseNotes,
                                    result.DownloadUrl);
                            };
                        });
                });
            }
        }
        catch
        {
            // Suppress background startup update failures to not interrupt user experience
        }
    }

    protected override bool GetSystemDarkMode()
    {
        try
        {
            var systemTheme = Microsoft.Maui.Controls.Application.Current?.RequestedTheme;
            return systemTheme == Microsoft.Maui.ApplicationModel.AppTheme.Dark;
        }
        catch
        {
            return true; // Default
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            Session.Changed -= OnSessionChanged;
        }

        base.Dispose(disposing);
    }
}
