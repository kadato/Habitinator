@inject IUserDateFormatService DateFormatService
@inject IBoardDataService BoardDataService
@inject IUserNotifier Notifier
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog Class="hab-modal-dialog"
           ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--daily" data-dialog-label="Yesterday's dailies">
            <div class="hab-modal__grabber" aria-hidden="true"></div>
            <div class="hab-modal__header" @ref="_headerRef">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="CloseAsync" />
                </div>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="letter-spacing:-0.02em;">Yesterday's dailies</MudText>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                    You did not finish these dailies on <strong class="daily-yesterday-date">@_dueOnFormatted</strong>. Check off each daily you completed that day.
                </MudText>
            </div>

            <div class="hab-modal__body">
                <div class="daily-yesterday-list">
                    @foreach (var item in _pending)
                    {
                        var isCompleted = _completedById.GetValueOrDefault(item.Id);
                        var rowClass = isCompleted ? "daily-yesterday-row--completed" : "";
                        var checkClass = isCompleted ? "daily-yesterday-check daily-yesterday-check--ok" : "daily-yesterday-check daily-yesterday-check--daily";
                        
                        <div class="daily-yesterday-row @rowClass" 
                             @key="item.Id"
                             @onclick="@(() => ToggleItem(item))"
                             @onkeydown="@(e => HandleKeyDown(e, item))"
                             role="checkbox"
                             tabindex="0"
                             aria-label="@item.Title"
                             @attributes="GetRowAria(isCompleted)"
                             aria-disabled="false">
                            <div class="daily-yesterday-row__check-col">
                                <div class="@checkClass"
                                     aria-hidden="true">
                                    @if (isCompleted)
                                    {
                                        <svg class="daily-yesterday-check-glyph"
                                             viewBox="0 0 24 24"
                                             width="12"
                                             height="12"
                                             fill="none"
                                             xmlns="http://www.w3.org/2000/svg"
                                             aria-hidden="true">
                                            <path d="M5 12l5 5L19 5"
                                                  stroke="currentColor"
                                                  stroke-width="3"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"/>
                                        </svg>
                                    }
                                </div>
                            </div>
                            <div class="daily-yesterday-row__title">
                                <span class="daily-yesterday-row__title-text">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="daily-yesterday-row__notes">@item.Notes</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="hab-modal__footer">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.Check"
                           Class="hab-primary-btn"
                           OnClick="CloseAsync">
                    Save
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] [EditorRequired] public DateOnly DueOn { get; set; }

    [Parameter] [EditorRequired] public IReadOnlyList<BoardItem> Items { get; set; } = [];

    private string _dueOnFormatted = string.Empty;
    private List<BoardItem> _pending = [];
    private readonly Dictionary<Guid, bool> _completedById = new();
    private readonly HashSet<Guid> _committedIds = [];
    private bool _isCommitting;
    private bool _sessionEnded;
    private ElementReference _headerRef;
    private DotNetObjectReference<DailyYesterdayRetroDialog>? _swipeRef;
    private bool _swipeStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_swipeStarted)
        {
            _swipeStarted = true;
            try
            {
                _swipeRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/modalSwipe.js");
                await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _headerRef, _swipeRef,
                    new { horizontal = false, dismissDown = true });
            }
            catch
            {
                // Swipe gestures are a touch enhancement. Save and close buttons always work.
            }
        }
    }

    /// <summary>Called from touch gestures. Swipe down on the header saves and closes.</summary>
    [JSInvokable]
    public Task OnModalSwipeDownAsync() => CloseAsync();

    protected override void OnParametersSet()
    {
        _ = InitializeDateFormatAsync();
        _pending = Items.ToList();
    }

    private async Task InitializeDateFormatAsync()
    {
        await DateFormatService.InitializeAsync();
        _dueOnFormatted = DateFormatService.Format(DueOn);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleItem(BoardItem item)
    {
        var nextVal = !_completedById.GetValueOrDefault(item.Id);
        _completedById[item.Id] = nextVal;
        StateHasChanged();
    }

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, BoardItem item)
    {
        if (e.Key is " " or "Enter")
        {
            ToggleItem(item);
        }
    }

    private async Task CommitCompletionsAsync()
    {
        if (_isCommitting)
        {
            return;
        }

        _isCommitting = true;
        try
        {
            var toComplete = _completedById
                .Where(kvp => kvp.Value && !_committedIds.Contains(kvp.Key))
                .Select(kvp => kvp.Key)
                .ToList();

            foreach (var id in toComplete)
            {
                try
                {
                    var updated = await BoardDataService.CompleteDailyForDateAsync(id, DueOn);
                    if (updated is not null)
                    {
                        _committedIds.Add(id);
                    }
                }
                catch (Exception)
                {
                    var item = _pending.FirstOrDefault(d => d.Id == id);
                    var title = item?.Title ?? "a daily";
                    await Notifier.NotifyAsync($"Failed to save retroactive completion for '{title}'.", Severity.Error);
                }
            }
        }
        finally
        {
            _isCommitting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_sessionEnded)
        {
            return;
        }

        _sessionEnded = true;
        await CommitCompletionsAsync();
        if (_committedIds.Count > 0)
        {
            MudDialog.Close(DialogResult.Ok(_committedIds.ToList()));
        }
        else
        {
            MudDialog.Close(DialogResult.Cancel());
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _headerRef);
        }
        catch
        {
            // Ignored during disposal.
        }

        _swipeRef?.Dispose();
        _swipeRef = null;

        if (_sessionEnded)
        {
            return;
        }

        _sessionEnded = true;
        await CommitCompletionsAsync();
    }

    private static Dictionary<string, object> GetRowAria(bool isCompleted) => new()
    {
        { "aria-checked", isCompleted ? "true" : "false" }
    };
}