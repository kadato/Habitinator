@using System.Security.Claims

<MudNavMenu Rounded="true" Margin="Margin.Dense" Class="pa-1 nav-menu-narrow" Dense="true">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard">Board</MudNavLink>
</MudNavMenu>

<MudDivider Class="my-2 mx-1" />

<AuthorizeView>
    <Authorized Context="auth">
        <MudText Typo="Typo.caption"
                 Color="Color.Secondary"
                 Class="px-2 mb-1 text-truncate"
                 title="@GetFullIdentity(auth)">
            @GetEmailLocalPart(auth)
        </MudText>
        <form method="post" action="/api/auth/cookie-logout" class="px-1">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Logout"
                       FullWidth="true"
                       Size="Size.Small"
                       Class="justify-start text-transform-none">
                Log out
            </MudButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <MudNavMenu Rounded="true" Margin="Margin.Dense" Dense="true" Class="px-1">
            <MudNavLink Href="auth/login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
            <MudNavLink Href="auth/register" Icon="@Icons.Material.Filled.PersonAdd">Register</MudNavLink>
        </MudNavMenu>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string GetFullIdentity(AuthenticationState auth) =>
        auth.User.FindFirst(ClaimTypes.Email)?.Value
        ?? auth.User.Identity?.Name
        ?? "User";

    /// <summary>Shows only the part before @ for emails; otherwise the full identity string.</summary>
    private static string GetEmailLocalPart(AuthenticationState auth)
    {
        string full = GetFullIdentity(auth);
        int at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }
}
