@inject IBoardSyncStatus BoardSync
@inject IUserNotifier UserNotifier
@inject INotificationSettingsService SettingsService
@implements IDisposable

@code {
    // Sync health lives in `SyncStatusIndicator`, a cloud icon plus text with `role=status`.
    // Toasts stay minimal: "You're offline" and "Couldn't sync". Merges resolve silently.
    private NotificationSettings? _settings;
    private bool _wasOffline;
    private string? _lastProblem;

    protected override async Task OnInitializedAsync()
    {
        BoardSync.Changed += OnBoardSyncChanged;
        SettingsService.Changed += OnSettingsChanged;
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = null;
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSettingsAsync();
            StateHasChanged();
        });
    }

    private void OnBoardSyncChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(HandleSyncStatusChangeAsync);
    }

    private async Task HandleSyncStatusChangeAsync()
    {
        if (_settings is null)
        {
            await LoadSettingsAsync();
        }

        var isOffline = BoardSync.IsOffline;
        var isPaused = BoardSync.IsPaused;
        var problem = BoardSync.SyncProblemMessage;
        var alertsEnabled = _settings is null || _settings.SyncFailureAlertsEnabled;

        try
        {
            if (alertsEnabled && isOffline && !_wasOffline && !isPaused)
            {
                await UserNotifier.NotifyAsync("You're offline", Severity.Warning);
            }
            else if (alertsEnabled && !isOffline && !isPaused && !string.IsNullOrEmpty(problem) && !string.Equals(problem, _lastProblem, StringComparison.Ordinal))
            {
                await UserNotifier.NotifyAsync("Couldn't sync", Severity.Error);
            }

            // Auto-resolved conflicts stay silent. Details live in the sync dialog.
        }
        catch
        {
            // Best-effort toast. The SyncStatusIndicator still shows the state.
        }
        finally
        {
            _wasOffline = isOffline;
            _lastProblem = problem;
        }
    }

    public void Dispose()
    {
        Dispose(disposing: true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!disposing)
        {
            return;
        }

        BoardSync.Changed -= OnBoardSyncChanged;
        SettingsService.Changed -= OnSettingsChanged;
    }
}
