@using System.Globalization
@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject IBoardDataService BoardData
@inject IUserNotifier Notifier

<MudDialog Class="daily-yesterday-dialog"
           ContentClass="pa-0"
           Style="width: min(28rem, calc(100vw - 2rem));">
    <DialogContent>
        <div class="pa-4">
            <MudText Typo="Typo.body2" Class="mb-2">
                <strong>@_dueOnFormatted</strong> (UTC) — dailies not done that day. Check off any you did.
            </MudText>
            <MudStack Spacing="1" Class="mt-2">
                @foreach (BoardItem item in _pending)
                {
                    <MudPaper Class="pa-2" Outlined="true" Elevation="0">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.body2" Class="flex-grow-1" Style="min-width: 0;">@item.Title</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => MarkForDueDateAsync(item))"
                                       Disabled="_busyById.GetValueOrDefault(item.Id)">
                                Mark done
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="CloseAsync" Disabled="AnyRowBusy">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public DateOnly DueOn { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<BoardItem> Items { get; set; } = [];

    private string _dueOnFormatted = string.Empty;
    private List<BoardItem> _pending = [];
    private readonly Dictionary<Guid, bool> _busyById = new();

    private bool AnyRowBusy => _busyById.Values.Any(v => v);

    protected override void OnParametersSet()
    {
        _dueOnFormatted = DueOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _pending = Items.ToList();
    }

    private async Task MarkForDueDateAsync(BoardItem item)
    {
        if (_busyById.GetValueOrDefault(item.Id))
        {
            return;
        }

        _busyById[item.Id] = true;
        try
        {
            BoardItem? updated = await BoardData.CompleteDailyForDateAsync(item.Id, DueOn);
            if (updated is null)
            {
                await Notifier.NotifyAsync("Could not update that daily.", Severity.Error);
                return;
            }

            int removed = _pending.RemoveAll(x => x.Id == item.Id);
            if (removed == 0)
            {
                return;
            }

            if (_pending.Count == 0)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Could not update that daily.", Severity.Error);
        }
        finally
        {
            _ = _busyById.Remove(item.Id);
        }
    }

    private void CloseAsync() => MudDialog.Close(DialogResult.Cancel());
}
