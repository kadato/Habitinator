<div class="hab-modal__footer">
    <button type="button" class="mud-button-root mud-button mud-button-text mud-button-text-warning mud-button-text-size-small" @onclick="OnArchive" style="text-transform:none; font-weight:650; border-radius:8px; padding:6px 10px; display:inline-flex; align-items:center; gap:6px; color:var(--mud-palette-text-secondary); border:1px solid transparent;">
        <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
        Archive
