@inject GlobalTimerService TimerService
@inject NavigationManager Navigation
@inject IBoardDataService BoardDataService
@inject ITimerSessionLogService TimerSessionLog
@inject IDialogService DialogService
@inject IDailyRetroPromptStore DailyRetroStore
@inject IRemoteBoardRefreshService RemoteBoardRefresh
@inject BoardRemoteNotifyBridge BoardNotifyBridge
@inject IBoardSyncStatus BoardSync
@inject IJSRuntime JS
@inject IUserTimeZoneService TimeZoneService
@inject IUserPreferencesService PreferencesService
@inject IUserDateFormatService DateFormatService
@inject IUndoService UndoService
@inject IInitialBoardLoadGate InitialBoardLoad
@inject ConflictResolutionService ConflictResolution
@inject IUserNotifier Notifier
@inject PersistentComponentState ApplicationState



<MudStack Class="board-shell w-100" Spacing="1">
    @if (_isLoading && _initialLoadComplete)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  ShowCloseIcon="false">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">@_loadError</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           OnClick="RetryLoadAsync">
                    Retry
                </MudButton>
            </MudStack>
        </MudAlert>
    }



    <GlobalTimerPanel OnLogSaved="HandleTimerLogSavedAsync"
                      Habits="Habits"
                      Dailies="Dailies"
                      Todos="Todos"/>

    @if (_initialLoadComplete && _loadError is null)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">

                <div class="board-stat-filters">
                    <div class="board-search-wrapper flex-grow-1" style="position: relative; display: flex; align-items: center;">
                        <MudTextField @bind-Value="_searchText"
                                      Placeholder="Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="board-search-field board-search-pill w-100"
                                      InputType="InputType.Text"
                                      Immediate="true"/>

                    </div>
                    <div class="board-tags-menu-activator">
                        <MudMenu AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 PopoverFixed="true"
                                 MaxHeight="500"
                                 RelativeWidth="DropdownWidth.Ignore"
                                 PopoverClass="board-tags-menu-popover">
                            <ActivatorContent Context="tagMenu">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Class="board-tags-trigger board-tags-trigger--strip"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Tune"
                                           EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                           OnClick="@(e => tagMenu.ToggleAsync(e))">
                                    @(SelectedFilterTagCount > 0 ? $"Tags ({SelectedFilterTagCount})" : "Tags")
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudPaper Class="board-tags-menu-panel pa-3" Elevation="0">
                                    <MudText Typo="Typo.subtitle1" Class="mb-1">Tags</MudText>
                                    @if (GetAllTagNamesForMenu().Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No tags on the board yet. Add tags in an item&rsquo;s details.</MudText>
                                    }
                                    else
                                    {
                                        <div class="board-tag-filter-grid board-tags-menu-body">
                                            @foreach (var tag in GetAllTagNamesForMenu())
                                            {
                                                <MudCheckBox Value="IsFilterTagSelected(tag)"
                                                             ValueChanged="@((bool b) => OnFilterTagChanged(tag, b))"
                                                             Label="@tag"
                                                             Color="Color.Primary"
                                                             Dense="true"
                                                             Class="ma-0"/>
                                            }
                                        </div>
                                    }
                                    <MudStack Row="true" Spacing="1" Justify="Justify.SpaceBetween" Class="mt-2 pt-2" Style="border-top: 1px solid var(--mud-palette-divider);">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="ClearBoardFilters"
                                                   Disabled="@(string.IsNullOrWhiteSpace(_searchText) && SelectedFilterTagCount == 0)">
                                            Clear all filters
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            </ChildContent>
                        </MudMenu>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Class="board-tags-trigger board-tags-trigger--strip"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Archive"
                               OnClick="OpenArchivedItemsDialogAsync">
                        Archive
                    </MudButton>
                    @if (_shortcutsEnabled)
                    {
                        <span class="board-shortcuts-hint mud-text-secondary">
                            Press <kbd style="background: var(--mud-palette-background-grey); color: var(--mud-palette-text-primary); border: 1px solid var(--mud-palette-divider); border-radius: 4px; padding: 1px 4px; font-family: monospace; font-size: 0.65rem; box-shadow: 0 1px 0 rgba(0,0,0,0.15); margin: 0 2px;">Shift</kbd> to toggle shortcuts
                        </span>
                    }
                </div>
            </div>
        </MudPaper>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">

                <div class="board-stat-filters d-flex gap-2">
                    <MudSkeleton Width="160px" Height="32px" Class="rounded-pill" />
                    <MudSkeleton Width="80px" Height="32px" Class="rounded-pill" />
                </div>
            </div>
        </MudPaper>
    }

    @if (_initialLoadComplete && _loadError is null)
    {
        <div class="board-columns-stage">
            <div class="board-columns-mobile">
                <MudTabs @bind-ActivePanelIndex="_mobileSectionIndex"
                         Class="board-section-tabs"
                         Centered="true"
                         ApplyEffectsToContainer="false"
                         Rounded="true"
                         Color="Color.Primary"
                         Elevation="0"
                         Outlined="false">
                    <MudTabPanel Text="@($"Habits ({FilteredHabits.Count})")">
                        <BoardColumn Section="BoardSection.Habit"
                                        Items="FilteredHabits"
                                        IsBoardFilterExcludingAll="Habits.Count > 0 && FilteredHabits.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Dailies ({DailiesDueOpenCount})")">
                        <BoardColumn Section="BoardSection.Daily"
                                        Items="FilteredDailies"
                                        IsBoardFilterExcludingAll="Dailies.Count > 0 && FilteredDailies.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                    <MudTabPanel Text="@($"To-dos ({OpenTodoCount})")">
                        <BoardColumn Section="BoardSection.Todo"
                                        Items="FilteredTodos"
                                        IsBoardFilterExcludingAll="Todos.Count > 0 && FilteredTodos.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                </MudTabs>
            </div>
            <div class="board-columns-desktop">
                <MudGrid Spacing="2" Class="board-columns-grid w-100">
                    <MudItem xs="12" md="4">
                        <BoardColumn Section="BoardSection.Habit"
                                        Items="FilteredHabits"
                                        IsBoardFilterExcludingAll="Habits.Count > 0 && FilteredHabits.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BoardColumn Section="BoardSection.Daily"
                                        Items="FilteredDailies"
                                        IsBoardFilterExcludingAll="Dailies.Count > 0 && FilteredDailies.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BoardColumn Section="BoardSection.Todo"
                                        Items="FilteredTodos"
                                        IsBoardFilterExcludingAll="Todos.Count > 0 && FilteredTodos.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                </MudGrid>
            </div>
        </div>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <div class="board-columns-stage">
            <div class="board-columns-mobile">
                <MudTabs Centered="true" Rounded="true" Color="Color.Primary" Elevation="0" Outlined="false">
                    <MudTabPanel Text="Habits">
                        <BoardColumnSkeleton Section="BoardSection.Habit" />
                    </MudTabPanel>
                    <MudTabPanel Text="Dailies">
                        <BoardColumnSkeleton Section="BoardSection.Daily" />
                    </MudTabPanel>
                    <MudTabPanel Text="To Do's">
                        <BoardColumnSkeleton Section="BoardSection.Todo" />
                    </MudTabPanel>
                </MudTabs>
            </div>
            <div class="board-columns-desktop">
                <MudGrid Spacing="2" Class="board-columns-grid w-100">
                    <MudItem xs="12" md="4">
                        <BoardColumnSkeleton Section="BoardSection.Habit" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BoardColumnSkeleton Section="BoardSection.Daily" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <BoardColumnSkeleton Section="BoardSection.Todo" />
                    </MudItem>
                </MudGrid>
            </div>
        </div>
    }
</MudStack>

@using App.Shared.RCL.Components.Dialogs
@using Microsoft.JSInterop
@implements IAsyncDisposable

@code {
    [Parameter] public string? SignedInEmail { get; set; }


    private List<BoardItem> Habits { get; set; } = [];
    private List<BoardItem> Dailies { get; set; } = [];
    private List<BoardItem> Todos { get; set; } = [];
    private bool _isLoading;
    private bool _initialLoadComplete;
    private string? _loadError;
    private string _searchText = string.Empty;
    private readonly HashSet<string> _selectedFilterTags = new(StringComparer.OrdinalIgnoreCase);
    private bool _dailyRetroSessionOffered;
    private bool _dailyRetroClientReady;
    private bool _boardClientScriptsStarted;
    private bool _shortcutsEnabled = true;
    private DotNetObjectReference<BoardRemoteNotifyBridge>? _visibilityRef;
    private DotNetObjectReference<MainBoard>? _selfRef;
    private DateTimeOffset _lastLocalMutationTime = DateTimeOffset.MinValue;
    private PersistingComponentStateSubscription _subscription;

    private IReadOnlyList<BoardItem> FilteredHabits => FilterItems(Habits);
    private IReadOnlyList<BoardItem> FilteredDailies => FilterItems(Dailies);

    private int DailiesDueOpenCount =>
        FilterItems(Dailies).Count(d => DailySchedule.IsDueOnDate(d, DailySchedule.LocalToday(TimeZoneService)));

    private IReadOnlyList<BoardItem> FilteredTodos => FilterItems(Todos);

    private int OpenTodoCount => FilteredTodos.Count(t => !t.IsCompleted);

    private int _mobileSectionIndex;

    private IReadOnlyList<string> GetAllTagNamesForMenu()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in Habits)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        foreach (var item in Dailies)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        foreach (var item in Todos)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        return set.OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private int SelectedFilterTagCount => _selectedFilterTags.Count;

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistBoardData);
        await DateFormatService.InitializeAsync();
        BoardSync.Changed += OnBoardSyncStatusChanged;
        RemoteBoardRefresh.RegisterForRemoteRefresh(HandleRemoteBoardRefreshedAsync);
        UndoService.OnStateChanged += HandleUndoStateChanged;
        UndoService.OnUndoPerformed += HandleUndoPerformed;
        ConflictResolution.ConflictDetected += HandleConflictDetected;
        PreferencesService.Changed += OnPreferencesChanged;
        await LoadShortcutsPreferenceAsync();
        await InitialLoadAsync();
    }

    private Task PersistBoardData()
    {
        var snapshot = new BoardSnapshot(
            Habits ?? new List<BoardItem>(),
            Dailies ?? new List<BoardItem>(),
            Todos ?? new List<BoardItem>()
        );
        ApplicationState.PersistAsJson("board_snapshot", snapshot);
        return Task.CompletedTask;
    }

    private void OnBoardSyncStatusChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnPreferencesChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadShortcutsPreferenceAsync();
            StateHasChanged();
        });
    }

    private async Task LoadShortcutsPreferenceAsync()
    {
        try
        {
            var prefs = await PreferencesService.GetAsync();
            _shortcutsEnabled = prefs.EnableKeyboardShortcuts;
        }
        catch
        {
            // Ignore if settings storage fails
        }
    }

    /// <summary>
    ///     Marshals server-pushed refreshes onto the Blazor dispatcher (SignalR/JS callbacks are not on the renderer sync
    ///     context).
    /// </summary>
    private Task HandleRemoteBoardRefreshedAsync()
    {
        return InvokeAsync(OnRemoteBoardRefreshedAsync);
    }

    private async Task OnRemoteBoardRefreshedAsync()
    {
        // Skip reloading from remote SignalR notifications if we recently performed a local mutation,
        // as the local action has already fetched the latest snapshot.
        if (DateTimeOffset.UtcNow - _lastLocalMutationTime < TimeSpan.FromSeconds(2.0))
        {
            return;
        }

        try
        {
            await LoadBoardAsync();
        }
        catch
        {
            // keep existing UI; user can use Retry
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        BoardSync.Changed -= OnBoardSyncStatusChanged;
        RemoteBoardRefresh.UnregisterForRemoteRefresh(HandleRemoteBoardRefreshedAsync);
        UndoService.OnStateChanged -= HandleUndoStateChanged;
        UndoService.OnUndoPerformed -= HandleUndoPerformed;
        ConflictResolution.ConflictDetected -= HandleConflictDetected;
        PreferencesService.Changed -= OnPreferencesChanged;
        if (_boardClientScriptsStarted)
        {
            await SafeInvokeVoidAsync("HabitinatorBoardVisibility.stop");
            await SafeInvokeVoidAsync("HabitinatorKeyboardShortcuts.stop");
        }

        _visibilityRef?.Dispose();
        _visibilityRef = null;
        _selfRef?.Dispose();
        _selfRef = null;
        _subscription.Dispose();
    }

    private async ValueTask SafeInvokeVoidAsync(string identifier, params object?[]? args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or InvalidOperationException)
        {
            // Ignored during page navigation/disposal
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Eagerly preload SortableJS and board reordering scripts during initial data load
            _ = PreloadSortableScriptsAsync();
        }

        if (_initialLoadComplete && _loadError is null && !_boardClientScriptsStarted)
        {
            await StartBoardClientScriptsAsync();
        }
    }

    private async Task PreloadSortableScriptsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/sortable.min.js");
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardSortable.js");
        }
        catch (Exception)
        {
            // Ignored during background preload
        }
    }

    private async Task StartBoardClientScriptsAsync()
    {
        _boardClientScriptsStarted = true;
        try
        {
            await JS.InvokeVoidAsync(
                "habitinatorLoadScript",
                "_content/App.Shared.RCL/js/boardVisibility.js");
            await JS.InvokeVoidAsync(
                "habitinatorLoadScript",
                "_content/App.Shared.RCL/js/dailyRetroSession.js");

            _visibilityRef = DotNetObjectReference.Create(BoardNotifyBridge);
            await JS.InvokeVoidAsync("HabitinatorBoardVisibility.start", _visibilityRef);

            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.start", _selfRef);

            _dailyRetroClientReady = true;
            _ = RefreshStreaksAsync();
            await TryOpenDailyYesterdayRetroIfNeededAsync();
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation
        }
        catch (InvalidOperationException)
        {
            // Ignored during page navigation
        }
        catch (JSException)
        {
            _boardClientScriptsStarted = false;
        }
    }

    private async Task OnBoardChanged()
    {
        _lastLocalMutationTime = DateTimeOffset.UtcNow;
        await LoadBoardAsync();
    }

    private async Task InitialLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
            _initialLoadComplete = true;
            InitialBoardLoad.MarkComplete();
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }

        if (_loadError is null && _dailyRetroClientReady)
        {
            await TryOpenDailyYesterdayRetroIfNeededAsync();
        }
    }

    private async Task LoadBoardAsync()
    {
        if (ApplicationState.TryTakeFromJson<BoardSnapshot>("board_snapshot", out var restored) && restored is not null)
        {
            Habits = restored.Habits.ToList();
            Dailies = restored.Dailies.ToList();
            Todos = restored.Todos.ToList();
        }
        else
        {
            var snapshot = await BoardDataService.GetSnapshotAsync();
            Habits = snapshot.Habits.ToList();
            Dailies = snapshot.Dailies.ToList();
            Todos = snapshot.Todos.ToList();
        }
        PruneStaleFilterTags();
    }

    private IReadOnlyList<BoardItem> FilterItems(IReadOnlyList<BoardItem> source)
    {
        return source.Where(MatchesGlobalFilters).ToList();
    }

    private bool MatchesGlobalFilters(BoardItem item)
    {
        return MatchesTagFilter(item) && MatchesSearchQuery(item);
    }

    private bool MatchesTagFilter(BoardItem item)
    {
        if (_selectedFilterTags.Count == 0)
        {
            return true;
        }

        var onItem = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var t in BoardTagUtil.ParseTags(item.Tags))
        {
            onItem.Add(t);
        }

        return _selectedFilterTags.Any(f => onItem.Contains(f));
    }

    private bool MatchesSearchQuery(BoardItem item)
    {
        var q = _searchText.Trim();
        if (q.Length == 0)
        {
            return true;
        }

        if (item.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (item.Notes is not null && item.Notes.Contains(q, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (DailyChecklistJson.Parse(item.ChecklistJson).Any(line => line.Text.Contains(q, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        return false;
    }

    private bool IsFilterTagSelected(string tag)
    {
        return _selectedFilterTags.Contains(tag);
    }

    private void OnFilterTagChanged(string tag, bool isChecked)
    {
        if (isChecked)
        {
            _selectedFilterTags.Add(tag);
        }
        else
        {
            _ = _selectedFilterTags.Remove(tag);
        }
    }

    private void PruneStaleFilterTags()
    {
        if (_selectedFilterTags.Count == 0)
        {
            return;
        }

        var available = new HashSet<string>(GetAllTagNamesForMenu(), StringComparer.OrdinalIgnoreCase);
        _selectedFilterTags.RemoveWhere(f => !available.Contains(f));
    }

    private void ClearBoardFilters()
    {
        _searchText = string.Empty;
        _selectedFilterTags.Clear();
    }

    private async Task HandleTimerLogSavedAsync(TimeSpan duration)
    {
        _lastLocalMutationTime = DateTimeOffset.UtcNow;
        var result = await TimerSessionLog.LogStoppedSessionAsync(duration);
        await Notifier.NotifyAsync(result.UserMessage, result.BoardUpdateFailed ? Severity.Error : Severity.Success);
        await LoadBoardAsync();
    }

    private async Task TryOpenDailyYesterdayRetroIfNeededAsync()
    {
        if (_dailyRetroSessionOffered)
        {
            return;
        }

        _dailyRetroSessionOffered = true;
        try
        {
            var prefs = await PreferencesService.GetAsync();
            var today = DailySchedule.LocalToday(TimeZoneService, prefs.DayStartLocalTime);
            DateOnly? lastResolved = await DailyRetroStore.GetLastPromptResolvedLocalDateAsync();

            if (lastResolved == today)
            {
                return;
            }

            var missed = DailySchedule.GetYesterdayUncompletedDailies(Dailies, today);
            if (missed.Count == 0)
            {
                return;
            }

            var yesterdayDate = today.AddDays(-1);
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = false,
                CloseButton = false,
                CloseOnEscapeKey = true,
                NoHeader = true
            };
            var parameters = new DialogParameters<DailyYesterdayRetroDialog>
            {
                { x => x.DueOn, yesterdayDate },
                { x => x.Items, missed }
            };

            var dialog = await DialogService.ShowAsync<DailyYesterdayRetroDialog>(
                string.Empty, parameters, options);
            var result = await dialog.Result;

            try
            {
                await DailyRetroStore.SetPromptResolvedForTodayAsync();
            }
            catch (Exception)
            {
                // Ignore error when saving daily retro status as it's non-critical local UI state
            }

            if (result is { Canceled: false, Data: List<Guid> ids } && ids.Count > 0)
            {
                _ = CompleteDailiesInBackgroundAsync(ids, yesterdayDate);
            }
        }
        catch (Exception)
        {
            _dailyRetroSessionOffered = false;
        }
    }

    private async Task CompleteDailiesInBackgroundAsync(List<Guid> completedIds, DateOnly dueOn)
    {
        try
        {
            var tasks = completedIds.Select(async id =>
            {
                try
                {
                    await BoardDataService.CompleteDailyForDateAsync(id, dueOn);
                }
                catch (Exception)
                {
                    var item = Dailies.FirstOrDefault(d => d.Id == id);
                    var title = item?.Title ?? "a daily";
                    await Notifier.NotifyAsync($"Failed to save retroactive completion for '{title}'.", Severity.Error);
                }
            }).ToList();

            await Task.WhenAll(tasks);
        }
        catch (Exception)
        {
            // Handled individually inside Tasks
        }
        finally
        {
            try
            {
                await RefreshStreaksAsync();
            }
            catch (Exception)
            {
                // Ignore load errors in background cleanup
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshStreaksAsync()
    {
        try
        {
            var streaks = await BoardDataService.GetStreakMapAsync();
            for (var i = 0; i < Dailies.Count; i++)
            {
                var daily = Dailies[i];
                if (streaks.TryGetValue(daily.Id, out var s) && s != daily.Counter)
                {
                    Dailies[i] = daily with { Counter = s };
                }
            }
        }
        catch (Exception)
        {
            // Silently ignore; board will reflect updated streaks on next full load
        }
    }

    private void HandleUndoStateChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleUndoPerformed(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            _lastLocalMutationTime = DateTimeOffset.UtcNow;
            await LoadBoardAsync();
            StateHasChanged();
        });
    }

    private async Task HandleUndoAsync()
    {
        await UndoService.UndoAsync();
    }

    [JSInvokable]
    public async Task OnCtrlZPressed()
    {
        if (UndoService.CanUndo)
        {
            await HandleUndoAsync();
        }
    }

    [JSInvokable]
    public void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    public async Task OpenEditHabitPublicAsync(BoardItem item)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = false,
            CloseButton = false,
            CloseOnEscapeKey = true,
            NoHeader = true
        };
        var parameters = new DialogParameters<EditHabitDialog> { { x => x.Item, item } };
        var dialog = await DialogService.ShowAsync<EditHabitDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await OnBoardChanged();
        }
    }

