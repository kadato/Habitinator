@page "/"
@inject IApiSession Session
@inject ApiAuthService Auth
@inject NavigationManager Nav
@implements IDisposable

@if (Session.IsLoggedIn)
{
    <PageTitle>@PageTitles.Page("Board")</PageTitle>
}
else
{
    <PageTitle>@PageTitles.Landing</PageTitle>
}

@if (Session.IsLoggedIn)
{
    <MainBoard/>
}
else
{
    <HomeLanding UseCookieGuestLogin="false" OnContinueAsDemoGuest="ContinueAsDemoGuestAsync"/>
}

@code {

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ContinueAsDemoGuestAsync()
    {
        var r = await Auth.GuestJwtLoginAsync();
        if (r is null)
        {
            Nav.NavigateTo("/auth/login?guest=missing", replace: true);
            return;
        }

        await Session.SetSessionAsync(r);
        // SetSessionAsync fires Session.Changed → OnSessionChanged → StateHasChanged,
        // which re-renders this component and switches from HomeLanding to MainBoard.
        // No NavigateTo("/") needed - we are already on "/" and the router would not
        // re-create the page component anyway, leaving the board invisible.
    }
}
