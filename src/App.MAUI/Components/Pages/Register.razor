@page "/auth/register"
@page "/register"
@using global::App.Shared.RCL.Models
@inject ApiAuthService Auth
@inject IApiSession Session
@inject NavigationManager Nav

@* 
  Fields are inlined (not RegisterFormFields) so WebView does not drop updates across child 
  [Parameter] binding. value + oninput updates fields on this page only. 
*@

<PageTitle>@PageTitles.Page("Create account")</PageTitle>

<AuthPageShell Title="Create account"
               Subtitle="Pick an email and a password with at least 8 characters."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-warning" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="reg-email">Email</label>
            <input class="form-control" id="reg-email" type="email" autocomplete="email"
                   value="@_email" @oninput="OnEmailInput" @attributes="FormControlAttrs"/>
        </div>
        <div class="mb-3">
            <label for="reg-password">Password</label>
            <input class="form-control" id="reg-password" type="password" minlength="8" autocomplete="new-password"
                   title="At least 8 characters."
                   value="@_password" @oninput="OnPasswordInput" @attributes="FormControlAttrs"/>
        </div>
        <p class="auth-form-hint">Use at least 8 characters. Avoid obvious passwords for your own account security.</p>
        <div class="auth-form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       OnClick="RegisterAsync">
                Create account
            </MudButton>
        </div>
    </ChildContent>
    <Footer>
        <span>Already have an account?</span>
        <a href="/auth/login">Sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _message;
    private bool _busy;

    private Dictionary<string, object> FormControlAttrs => _busy
        ? new Dictionary<string, object> { ["disabled"] = true }
        : [];

    private void OnEmailInput(ChangeEventArgs e) => _email = e.Value?.ToString() ?? string.Empty;

    private void OnPasswordInput(ChangeEventArgs e) => _password = e.Value?.ToString() ?? string.Empty;

    protected override void OnInitialized()
    {
        var query = AuthQueryMessages.ResolveRegister(Nav);
        _email = query.Email ?? string.Empty;
        _message = query.Message;
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (Session.IsLoggedIn)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task RegisterAsync()
    {
        _busy = true;
        try
        {
            if (!RegistrationEmailValidation.IsValid(_email))
            {
                _message = "Enter a valid email address.";
                return;
            }

            var result = await Auth.RegisterAsync(new RegisterRequest(_email, _password));
            if (!result.Succeeded)
            {
                _message = result.Message;
                return;
            }

            _message = null;
            Nav.NavigateTo("/auth/login?registered=1");
        }
        finally
        {
            _busy = false;
        }
    }

}
