@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject IBoardDataService BoardData
@inject IUserNotifier Notifier

<MudDialog Class="archived-dialog" Style="width: min(34rem, calc(100vw - 2rem)); margin-top: 10vh;">
    <TitleContent>
        <div class="archived-title">
            <span>Archive</span>
            @if (!_loading && TotalCount > 0)
            {
                <span class="archived-title-count">@TotalCount</span>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <div class="dialog-body">
                @if (TotalCount > 0)
                {
                    <div class="search-container">
                        <MudTextField @bind-Value="_searchQuery"
                                      Placeholder="Search archived items..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Clearable="true"
                                      Immediate="true" />
                    </div>

                    <div class="filter-tabs" role="tablist" aria-label="Filter archived items">
                        <button type="button" role="tab" aria-selected="@(_selectedSection == null ? "true" : "false")" class="@FilterTabClass(null)" @onclick="() => SetFilter(null)">
                            All <span class="filter-tab-count">@TotalCount</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_selectedSection == BoardSection.Habit ? "true" : "false")" class="@FilterTabClass(BoardSection.Habit)" @onclick="() => SetFilter(BoardSection.Habit)">
                            Habits <span class="filter-tab-count">@HabitsCount</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_selectedSection == BoardSection.Daily ? "true" : "false")" class="@FilterTabClass(BoardSection.Daily)" @onclick="() => SetFilter(BoardSection.Daily)">
                            Dailies <span class="filter-tab-count">@DailiesCount</span>
                        </button>
                        <button type="button" role="tab" aria-selected="@(_selectedSection == BoardSection.Todo ? "true" : "false")" class="@FilterTabClass(BoardSection.Todo)" @onclick="() => SetFilter(BoardSection.Todo)">
                            To-dos <span class="filter-tab-count">@TodosCount</span>
                        </button>
                    </div>
                }

                <div class="archived-list">
                    @if (GetFilteredItems().Count == 0)
                    {
                        <div class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="empty-icon" />
                            <div class="empty-text">No archived items</div>
                            <div class="empty-subtext">@(string.IsNullOrWhiteSpace(_searchQuery) ? "Nothing archived in this section." : "Try a different search.")</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var entry in GetFilteredItems())
                        {
                            var item = entry.Item;
                            var section = entry.Section;
                            var iconClass = section switch
                            {
                                BoardSection.Habit => "archive-row-icon--habit",
                                BoardSection.Daily => "archive-row-icon--daily",
                                BoardSection.Todo => "archive-row-icon--todo",
                                _ => ""
                            };
                            var itemIcon = section switch
                            {
                                BoardSection.Habit => Icons.Material.Filled.Autorenew,
                                BoardSection.Daily => Icons.Material.Filled.CalendarToday,
                                BoardSection.Todo => Icons.Material.Filled.FormatListBulleted,
                                _ => Icons.Material.Filled.Help
                            };
                            var metaText = section switch
                            {
                                BoardSection.Habit => $"Resets {item.ResetPeriod} · {item.Counter} logged · -{item.NegativeCounter} missed",
                                BoardSection.Daily => $"Streak {item.Counter} days",
                                _ => item.TodoDueDate is { } due ? $"Due {due:yyyy-MM-dd}" : "No due date"
                            };

                            <div class="archive-row" @key="item.Id">
                                <MudIcon Icon="@itemIcon" Class="@($"archive-row-icon {iconClass}")" />
                                <div class="archive-row-info">
                                    <span class="archive-row-title" title="@item.Title">@item.Title</span>
                                    <span class="archive-row-meta">@metaText</span>
                                </div>
                                <div class="archive-row-actions">
                                    <MudButton StartIcon="@Icons.Material.Filled.Unarchive"
                                               Color="Color.Primary"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@(() => UnarchiveAsync(section, item))"
                                               Disabled="_isClosing">
                                        Restore
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.DeleteForever"
                                               Color="Color.Error"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="@(() => DeletePermanentlyAsync(section, item))"
                                               Disabled="_isClosing">
                                        Delete
                                    </MudButton>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Close" Class="px-6 py-2" Disabled="_isClosing">
            @if (_isClosing && _inFlightTasks.Count > 0)
            {
                <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                <span>Closing...</span>
            }
            else
            {
                <span>Close</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    private BoardSnapshot _snapshot = new([], [], []);
    private bool _loading = true;
    private string _searchQuery = "";
    private BoardSection? _selectedSection = null;

    private int TotalCount => _allEntries.Count;
    private int HabitsCount => _allEntries.Count(x => x.Section == BoardSection.Habit);
    private int DailiesCount => _allEntries.Count(x => x.Section == BoardSection.Daily);
    private int TodosCount => _allEntries.Count(x => x.Section == BoardSection.Todo);

    private struct ArchivedItemEntry
    {
        public BoardSection Section { get; set; }
        public BoardItem Item { get; set; }
        public DateTimeOffset Date { get; set; }
    }

    private List<ArchivedItemEntry> _allEntries = new();
    private readonly Dictionary<Guid, Task> _inFlightTasks = new();
    private bool _isClosing;

    private List<ArchivedItemEntry> GetFilteredItems()
    {
        var query = _searchQuery?.Trim() ?? "";
        return _allEntries
            .Where(x => _selectedSection == null || x.Section == _selectedSection)
            .Where(x => string.IsNullOrEmpty(query) || x.Item.Title.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadArchivedItemsAsync();
    }

    private async Task LoadArchivedItemsAsync()
    {
        _loading = true;
        try
        {
            _snapshot = await BoardData.GetArchivedSnapshotAsync();
            BuildEntriesList();
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Could not load archived items.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildEntriesList()
    {
        _allEntries.Clear();
        
        foreach (var item in _snapshot.Habits)
        {
            _allEntries.Add(new ArchivedItemEntry 
            { 
                Section = BoardSection.Habit, 
                Item = item,
                Date = item.ServerUpdatedAtUtc ?? item.CreatedAtUtc ?? DateTimeOffset.MinValue
            });
        }
        
        foreach (var item in _snapshot.Dailies)
        {
            _allEntries.Add(new ArchivedItemEntry 
            { 
                Section = BoardSection.Daily, 
                Item = item,
                Date = item.ServerUpdatedAtUtc ?? item.CreatedAtUtc ?? DateTimeOffset.MinValue
            });
        }
        
        foreach (var item in _snapshot.Todos)
        {
            _allEntries.Add(new ArchivedItemEntry 
            { 
                Section = BoardSection.Todo, 
                Item = item,
                Date = item.ServerUpdatedAtUtc ?? item.CreatedAtUtc ?? DateTimeOffset.MinValue
            });
        }

        SortEntries();
    }

    private void SortEntries()
    {
        _allEntries = _allEntries
            .OrderByDescending(x => x.Date)
            .ThenBy(x => x.Item.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void SetFilter(BoardSection? section)
    {
        _selectedSection = section;
    }

    private string FilterTabClass(BoardSection? section) =>
        _selectedSection == section ? "filter-tab active" : "filter-tab";

    private async Task UnarchiveAsync(BoardSection section, BoardItem item)
    {
        var index = _allEntries.FindIndex(x => x.Item.Id == item.Id);
        ArchivedItemEntry? entry = null;
        if (index >= 0)
        {
            entry = _allEntries[index];
            _allEntries.RemoveAt(index);
            StateHasChanged();
        }

        var task = DoUnarchiveAsync(section, item, entry);
        _inFlightTasks[item.Id] = task;
    }

    private async Task DoUnarchiveAsync(BoardSection section, BoardItem item, ArchivedItemEntry? entry)
    {
        try
        {
            var res = await BoardData.UnarchiveItemAsync(section, item.Id);
            if (res is not null)
            {
                await Notifier.NotifyAsync($"Restored \"{item.Title}\" back to the board.", Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync($"Failed to restore \"{item.Title}\".", Severity.Error);
                if (entry is not null)
                {
                    _allEntries.Add(entry.Value);
                    SortEntries();
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Could not complete request. Check connection and try again.", Severity.Error);
            if (entry is not null)
            {
                _allEntries.Add(entry.Value);
                SortEntries();
                StateHasChanged();
            }
        }
        finally
        {
            _inFlightTasks.Remove(item.Id);
        }
    }

    private async Task DeletePermanentlyAsync(BoardSection section, BoardItem item)
    {
        var index = _allEntries.FindIndex(x => x.Item.Id == item.Id);
        ArchivedItemEntry? entry = null;
        if (index >= 0)
        {
            entry = _allEntries[index];
            _allEntries.RemoveAt(index);
            StateHasChanged();
        }

        var task = DoDeleteAsync(section, item, entry);
        _inFlightTasks[item.Id] = task;
    }

    private async Task DoDeleteAsync(BoardSection section, BoardItem item, ArchivedItemEntry? entry)
    {
        try
        {
            var success = await BoardData.DeleteItemAsync(section, item.Id);
            if (success)
            {
                await Notifier.NotifyAsync($"Permanently deleted \"{item.Title}\".", Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync($"Failed to delete \"{item.Title}\".", Severity.Error);
                if (entry is not null)
                {
                    _allEntries.Add(entry.Value);
                    SortEntries();
                    StateHasChanged();
                }
            }
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Could not complete request. Check connection and try again.", Severity.Error);
            if (entry is not null)
            {
                _allEntries.Add(entry.Value);
                SortEntries();
                StateHasChanged();
            }
        }
        finally
        {
            _inFlightTasks.Remove(item.Id);
        }
    }

    private async Task Close()
    {
        if (_isClosing) return;
        _isClosing = true;
        StateHasChanged();

        try
        {
            if (_inFlightTasks.Count > 0)
            {
                var tasks = _inFlightTasks.Values.ToList();
                await Task.WhenAll(tasks);
            }
        }
        catch
        {
            // Handled individually
        }

        MudDialog.Close();
    }
}
