    private async Task UpdateMentionsAsync()
    {
        _mentionItems.Clear();
        var atIndex = _inputText.LastIndexOf('@');
        if (atIndex < 0)
        {
            return;
        }
        var query = _inputText[(atIndex + 1)..].Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;
        if (query.Length < 1 && !_inputText.EndsWith('@') && string.IsNullOrEmpty(query))
        {
            return;
        }
        try
        {
            _boardSnapshot ??= await BoardData.GetSnapshotAsync();
            var q = query.Trim();
            var matches = _boardSnapshot.Habits.Select(h => new MentionItem(h.Title, "Habit"))
                .Concat(_boardSnapshot.Dailies.Select(d => new MentionItem(d.Title, "Daily")))
                .Concat(_boardSnapshot.Todos.Select(t => new MentionItem(t.Title, "Todo")))
                .Where(m => string.IsNullOrEmpty(q) || m.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
                .Take(6)
                .ToList();
            _mentionItems.AddRange(matches);
        }
        catch
        {
            // Ignore load failures. Chat stays usable without local history.
        }
    }

    private Task PickMentionAsync(string title)
    {
        var atIndex = _inputText.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var after = _inputText[(atIndex + 1)..];
            var spaceIndex = after.IndexOf(' ');
            var tail = spaceIndex >= 0 ? after[spaceIndex..] : string.Empty;
            _inputText = string.Concat(_inputText.AsSpan(0, atIndex).ToString(), "@", title, tail, spaceIndex < 0 ? " " : string.Empty);
        }
        _mentionItems.Clear();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private static string ExpandSlashCommand(string text) => text.TrimStart() switch
    {
        "/plan" or "/plan " or _ when text.StartsWith("/plan ", StringComparison.OrdinalIgnoreCase) =>
            "Plan my day based on today dailies and active todos. " + text.Replace("/plan", string.Empty, StringComparison.OrdinalIgnoreCase).Trim(),
        _ when text.StartsWith("/review", StringComparison.OrdinalIgnoreCase) =>
            "Review what dailies and todos are left for today, including overdue. " + text.Replace("/review", string.Empty, StringComparison.OrdinalIgnoreCase).Trim(),
        _ when text.StartsWith("/suggest", StringComparison.OrdinalIgnoreCase) =>
            "Suggest 3 positive daily habits for better focus and health. " + text.Replace("/suggest", string.Empty, StringComparison.OrdinalIgnoreCase).Trim(),
        _ when text.StartsWith("/retro", StringComparison.OrdinalIgnoreCase) =>
            "Review yesterday's dailies and help me backdate what I completed. " + text.Replace("/retro", string.Empty, StringComparison.OrdinalIgnoreCase).Trim(),
        _ when text.StartsWith("/timer", StringComparison.OrdinalIgnoreCase) =>
            "Show my timer summary and focus minutes. " + text.Replace("/timer", string.Empty, StringComparison.OrdinalIgnoreCase).Trim(),
        _ => text
    };

