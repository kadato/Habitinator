%% Authentication Architecture
%% Dual authentication strategy: Cookie for Web, JWT for MAUI

flowchart LR
    subgraph Client["Client Request"]
        direction TB
        WebReq["Web Browser Request<br/>/api/board/habits"]
        MauiReq["MAUI App Request<br/>/api/board/habits"]
    end

    subgraph AuthLayer["Authentication Layer"]
        direction TB
        Policy["Authorization Policy:<br/>BoardOrJwt"]
        
        subgraph CookieAuth["Cookie Authentication Scheme"]
            CookieCheck["Check .AspNetCore.Cookies"]
            CookieValid["Validate Session"]
        end
        
        subgraph JWTAuth["JWT Bearer Scheme"]
            JWTCheck["Check Authorization Header<br/>Bearer {token}"]
            JWTValid["Validate JWT<br/>Signature, Expiry, Issuer"]
        end
    end

    subgraph Resources["Protected Resources"]
        direction TB
        BoardAPI["Board API<br/>BoardController"]
        ActivityAPI["Activity API<br/>ActivityController"]
        SignalR["SignalR Hub<br/>/hubs/board"]
    end

    subgraph Identity["ASP.NET Core Identity"]
        UserStore["User Store<br/>PostgreSQL"]
        RoleStore["Role Store<br/>PostgreSQL"]
    end

    %% Web Flow
    WebReq -->|"Cookie Header"| Policy
    Policy --> CookieCheck
    CookieCheck --> CookieValid
    CookieValid -->|"✓ Authenticated"| BoardAPI
    
    %% MAUI Flow
    MauiReq -->|"Authorization: Bearer JWT"| Policy
    Policy --> JWTCheck
    JWTCheck --> JWTValid
    JWTValid -->|"✓ Authenticated"| BoardAPI
    
    %% Resource access
    BoardAPI --> UserStore
    ActivityAPI --> UserStore
    SignalR --> JWTCheck
    
    %% Styling
    classDef webClass fill:#e3f2fd
    classDef mauiClass fill:#e8f5e9
    classDef authClass fill:#fff3e0
    classDef resourceClass fill:#f3e5f5
    classDef identityClass fill:#fce4ec
    
    class WebReq webClass
    class MauiReq mauiClass
    class Policy,CookieCheck,CookieValid,JWTCheck,JWTValid authClass
    class BoardAPI,ActivityAPI,SignalR resourceClass
    class UserStore,RoleStore identityClass
