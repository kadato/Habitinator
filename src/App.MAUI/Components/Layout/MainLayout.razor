@inherits LayoutComponentBase
@using global::App.Shared.RCL.Themes
@using global::App.Shared.RCL.Models
@using global::App.Shared.RCL.Services
@implements IDisposable
@inject IApiSession Session
@inject IUserPreferencesService PreferencesService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@PageTitles.Brand</PageTitle>

<MudThemeProvider @ref="_mudThemeProvider" Theme="@HabitinatorMudTheme.Default" @bind-IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="false"/>
<MudSnackbarProvider/>
<TimeZoneInitializer />

<MudLayout Class="app-shell-layout">
    @if (Session.IsLoggedIn)
    {
        <MudAppBar Elevation="0" Dense="true" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar">
            <div class="app-top-bar__stack w-100">
                <div class="app-top-bar__row d-flex">
                    <div class="app-top-bar__left d-flex align-center">
                        <div class="app-branding d-flex flex-column justify-center">
                            <MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText>
                        </div>
                        <div class="app-show-desktop-only align-center">
                            <NavMenu/>
                        </div>
                    </div>
                    <div class="app-top-bar__flex-spacer" aria-hidden="true"></div>
                    <div class="app-top-bar__right d-flex align-center">
                        <div class="app-header-user-rail d-flex align-center">
                            <MudMenu AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Dense="true"
                                     PopoverFixed="true"
                                     PopoverClass="app-profile-menu-popover">
                                <ActivatorContent Context="profileMenu">
                                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                                   Color="Color.Primary"
                                                   Size="Size.Medium"
                                                   Class="app-header-profile-btn app-show-mobile-only"
                                                   aria-label="Account menu"
                                                   OnClick="@(e => profileMenu.ToggleAsync(e))" />
                                    <MudButton StartIcon="@Icons.Material.Filled.AccountCircle"
                                               Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Size="Size.Medium"
                                               Class="app-header-username-btn text-transform-none app-show-desktop-only"
                                               OnClick="@(e => profileMenu.ToggleAsync(e))">
                                        @GetDisplayName()
                                    </MudButton>
                                </ActivatorContent>
                                <ChildContent>
                                    <div class="px-4 py-3 border-bottom d-flex flex-column dropdown-header" style="min-width: 220px;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold dropdown-name">@GetDisplayName()</MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary text-truncate dropdown-email">@Session.Email</MudText>
                                    </div>
                                    <MudDivider Class="my-1"/>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="LogoutAsync" Class="app-dropdown-logout-btn text-danger">
                                        <MudText Color="Color.Error" Class="font-weight-semibold">Log out</MudText>
                                    </MudMenuItem>
                                </ChildContent>
                            </MudMenu>
                        </div>
                    </div>
                </div>
                <NavMenu MobileTopBar="true" />
            </div>
        </MudAppBar>
    }
    <MudMainContent Class="app-shell-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-3 px-4 px-sm-5 board-main-container">
            @if (!_sessionInitialized)
            {
                <MudProgressLinear Indeterminate="true"/>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@if (Session.IsLoggedIn)
{
    <GlobalTimerFocusAlertHost/>
    <GlobalSyncAlertHost/>
}

@code {
    private static bool IsAuthPath(string path) =>
        path.Equals("/auth/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/auth/register", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/register", StringComparison.OrdinalIgnoreCase);

    private static bool IsHomePath(string path) => string.IsNullOrEmpty(path);

    private static bool IsPublicWhenLoggedOut(string path) => IsAuthPath(path) || IsHomePath(path);

    private bool _sessionInitialized;
    private UserPreferences? _preferences;
    private bool _isDarkMode = true;
    private MudThemeProvider? _mudThemeProvider;
    private DotNetObjectReference<MainLayout>? _layoutSelfRef;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        PreferencesService.Changed += OnPreferencesChanged;
        Nav.LocationChanged += OnLocationChanged;

        _isDarkMode = GetSystemDarkMode();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider != null)
        {
            await ResolveThemeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
        }

        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardVisibility.js");
                _layoutSelfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.startGlobal", _layoutSelfRef);
                await SyncKeyboardShortcutsEnabledAsync();
            }
            catch
            {
                // Ignore JS errors on prerendering or test hosts
            }
        }
    }

    [JSInvokable]
    public void NavigateTo(string path)
    {
        Nav.NavigateTo(path);
    }

    [JSInvokable]
    public Task OnCtrlZPressed()
    {
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        PreferencesService.Changed -= OnPreferencesChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _layoutSelfRef?.Dispose();
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(OnSessionChangedAsync);
    }

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadPreferencesAsync();
        });
    }

    private async Task OnSessionChangedAsync()
    {
        if (_sessionInitialized && !Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }

        if (Session.IsLoggedIn)
        {
            await LoadPreferencesAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPreferencesAsync()
    {
        _preferences = await PreferencesService.GetAsync();
        await ResolveThemeAsync();
        await SyncKeyboardShortcutsEnabledAsync();
    }

    private async Task SyncKeyboardShortcutsEnabledAsync()
    {
        if (_preferences is null) return;
        try
        {
            await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.setEnabled", _preferences.EnableKeyboardShortcuts);
        }
        catch
        {
            // Ignore if JS is not available
        }
    }

    private async Task SyncHtmlThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("habitinatorSetTheme", _isDarkMode ? "dark" : "light");
        }
        catch
        {
            // Ignore if JS is not available
        }
    }

    private async Task ResolveThemeAsync()
    {
        if (_preferences is null) return;

        if (_preferences.Theme == AppTheme.Light)
        {
            _isDarkMode = false;
        }
        else if (_preferences.Theme == AppTheme.Dark)
        {
            _isDarkMode = true;
        }
        else // System
        {
            if (_mudThemeProvider != null)
            {
                _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            }
            else
            {
                _isDarkMode = GetSystemDarkMode();
            }
        }
        await SyncHtmlThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSystemPreferenceChanged(bool isDarkMode)
    {
        if (_preferences?.Theme == AppTheme.System)
        {
            _isDarkMode = isDarkMode;
            await SyncHtmlThemeAsync();
            StateHasChanged();
        }
    }

    private string GetFullIdentity()
    {
        var email = Session.Email ?? "User";
        var displayName = _preferences?.DisplayName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return email;
        }

        return $"{displayName} ({email})";
    }

    private string GetDisplayName()
    {
        var displayName = _preferences?.DisplayName;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        var full = GetFullIdentity();
        var at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }

    private async Task LogoutAsync()
    {
        await Session.ClearSessionAsync();
        Nav.NavigateTo("/", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (!Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }
        else
        {
            await LoadPreferencesAsync();
        }

        _sessionInitialized = true;
        await InvokeAsync(StateHasChanged);
    }

    private static bool GetSystemDarkMode()
    {
        try
        {
            var systemTheme = Microsoft.Maui.Controls.Application.Current?.RequestedTheme;
            return systemTheme == Microsoft.Maui.ApplicationModel.AppTheme.Dark;
        }
        catch
        {
            return true; // Default
        }
    }

}