@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject IBoardDataService BoardData
@inject IUserTimeZoneService TimeZoneService
@inject IUserDateFormatService DateFormatService
@inject IUserNotifier Notifier
@inject IUpcomingViewStateStore ViewState

<div class="cal upcoming-panel">
    @if (_error is not null)
    {
        <div class="cal-fallback">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Class="cal-fallback__icon" aria-hidden="true" />
            <MudText Typo="Typo.subtitle2" Class="cal-fallback__title">Upcoming unavailable</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">We couldn't load your upcoming schedule. Try again in a moment.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ReloadAsync">Retry</MudButton>
        </div>
    }
    else if (_loading)
    {
        <div class="cal-top" aria-hidden="true">
            <MudSkeleton Width="220px" Height="28px" Class="mb-2" />
            <MudSkeleton Width="60%" Height="18px" />
        </div>
        <div class="cal-skel-grid" aria-hidden="true">
            @for (var i = 0; i < 14; i++)
            {
                <MudSkeleton Height="72px" Class="cal-skel-cell" />
            }
        </div>
    }
    else
    {
        <section class="cal-top" aria-label="Upcoming calendar summary">
            <div class="cal-top__row">
                <div class="cal-nav" role="group" aria-label="Move in calendar">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Medium" Class="cal-navbtn" aria-label="@PrevLabel" OnClick="Prev" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="cal-todaybtn" OnClick="GoToday">Today</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" Class="cal-navbtn" aria-label="@NextLabel" OnClick="Next" />
                </div>
                <div class="cal-titles" aria-live="polite" aria-atomic="true">
                    <div class="cal-month">@HeaderTitle</div>
                    <div class="cal-sub">@HeadlineText</div>
                </div>
                <div class="cal-stats" role="list">
                    <div class="cal-stat @(OverdueCount > 0 ? "cal-stat--alert" : "")" role="listitem">
                        <span class="cal-stat__num">@OverdueCount</span>
                        <span class="cal-stat__label">overdue</span>
                    </div>
                    <div class="cal-stat cal-stat--today" role="listitem">
                        <span class="cal-stat__num">@TodayRemaining</span>
                        <span class="cal-stat__label">due today</span>
                    </div>
                    <div class="cal-stat" role="listitem">
                        <span class="cal-stat__num">@MonthTotal</span>
                        <span class="cal-stat__label">in @MonthShort</span>
                    </div>
                </div>
            </div>
            @if (_todayScheduled > 0)
            {
                <div class="cal-progress" aria-label="@($"{_todayDone} of {_todayScheduled} dailies done today")">
                    <div class="cal-progress__top">
                        <span>Today: @_todayDone of @_todayScheduled dailies done</span>
                        <span class="cal-progress__pct">@TodayPct%</span>
                    </div>
                    <div class="cal-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@TodayPct">
                        <div class="cal-progress__fill" style="width: @(TodayPct)%"></div>
                    </div>
                </div>
            }
            <div class="cal-controls">
                <div class="cal-seg" role="group" aria-label="Calendar view">
                    <button type="button" class="@ViewBtnClass(CalView.Day)" aria-pressed="@(_view == CalView.Day)" @onclick="() => SetView(CalView.Day)">Day</button>
                    <button type="button" class="@ViewBtnClass(CalView.Week)" aria-pressed="@(_view == CalView.Week)" @onclick="() => SetView(CalView.Week)">Week</button>
                    <button type="button" class="@ViewBtnClass(CalView.Next7)" aria-pressed="@(_view == CalView.Next7)" @onclick="() => SetView(CalView.Next7)">7 days</button>
                    <button type="button" class="@ViewBtnClass(CalView.Month)" aria-pressed="@(_view == CalView.Month)" @onclick="() => SetView(CalView.Month)">Month</button>
                </div>
                <div class="cal-seg" role="group" aria-label="Show items">
                    <button type="button" class="@FilterBtnClass(UpcomingFilter.All)" aria-pressed="@(_filter == UpcomingFilter.All)" @onclick="() => SetFilter(UpcomingFilter.All)">All</button>
                    <button type="button" class="@FilterBtnClass(UpcomingFilter.Dailies)" aria-pressed="@(_filter == UpcomingFilter.Dailies)" @onclick="() => SetFilter(UpcomingFilter.Dailies)">Dailies</button>
                    <button type="button" class="@FilterBtnClass(UpcomingFilter.Todos)" aria-pressed="@(_filter == UpcomingFilter.Todos)" @onclick="() => SetFilter(UpcomingFilter.Todos)">To-dos</button>
                </div>
            </div>
        </section>

        <div class="cal-body">
            <div class="cal-side">
                @if (ShowTodos && _overdue.Count > 0)
                {
                    <MudPaper Class="cal-card cal-card--overdue" Elevation="0" Outlined="true" id="upcoming-overdue">
                        <div class="cal-card__head">
                            <span class="cal-card__icon cal-card__icon--overdue" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
                            </span>
                            <div class="cal-card__titles">
                                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="cal-card__title">Overdue</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@_overdue.Count overdue to-do(s)</MudText>
                            </div>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="text-transform-none" OnClick="MoveOverdueToTodayAsync" Disabled="_bulkMoving">Move all to today</MudButton>
                        </div>
                        <ul class="cal-list">
                            @foreach (var todo in _overdue)
                            {
                                <li class="cal-row" @key="todo.Id">
                                    <span class="cal-row__icon cal-row__icon--todo" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" /></span>
                                    <div class="cal-row__text">
                                        <div class="cal-row__title">@todo.Title</div>
                                        <div class="cal-row__meta">@TodoDueRelativeText.Format(todo.TodoDueDate!.Value, _today)</div>
                                    </div>
                                    <div class="cal-row__actions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="cal-iconbtn" aria-label="@TodoCompleteLabel(todo)" OnClick="@(() => ToggleTodoAsync(todo))" Disabled="@IsBusy(todo.Id)" />
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="text-transform-none cal-pushbtn" OnClick="@(() => MoveTodoToTodayAsync(todo))" Disabled="@IsBusy(todo.Id)">Today</MudButton>
                                    </div>
                                </li>
                            }
                        </ul>
                    </MudPaper>
                }

                <MudPaper Class="cal-card cal-card--agenda" Elevation="0" Outlined="true" id="@SelectedAnchorId" aria-live="polite" aria-atomic="false">
                    <div class="cal-card__head">
                        <span class="cal-card__icon cal-card__icon--agenda" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                        </span>
                        <div class="cal-card__titles">
                            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="cal-card__title">@SelectedLabel</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@FormatDate(_selected)</MudText>
                        </div>
                        <div class="cal-agenda__side">
                            @if (SelectedVisibleCount > 0)
                            {
                                <span class="cal-pill" aria-label="@SelectedVisibleCount items">@SelectedVisibleCount</span>
                            }
                            <div class="cal-agenda__nav" role="group" aria-label="Move selected day">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Class="cal-daystep" aria-label="Previous day" OnClick="PrevDay" />
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="cal-daystep" aria-label="Next day" OnClick="NextDay" />
                            </div>
                        </div>
                    </div>
                    @if (SelectedVisibleCount == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Nothing scheduled.</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="cal-hint">A clear day. Use the board to add a daily or to-do.</MudText>
                    }
                    else
                    {
                        <div class="cal-agenda-cols">
                        @if (ShowDailies && SelectedDailies.Count > 0)
                        {
                            <div class="cal-agenda-col">
                            <div class="cal-group">Dailies</div>
                            <ul class="cal-list">
                                @foreach (var daily in SelectedDailies)
                                {
                                    @if (_selected == _today)
                                    {
                                        <li class="cal-row" @key="daily.Id">
                                            <MudCheckBox T="bool"
                                                         Value="@IsCheckedToday(daily)"
                                                         ValueChanged="@(v => ToggleTodayAsync(daily))"
                                                         Label="@daily.Title"
                                                         Class="ma-0 upcoming-check"
                                                         Color="Color.Primary"
                                                         Dense="true" />
                                            @if (daily.Counter > 0)
                                            {
                                                <span class="cal-streak" title="Daily streak: @daily.Counter days">
                                                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" aria-hidden="true" />
                                                    @daily.Counter
                                                </span>
                                            }
                                        </li>
                                        <li class="cal-row__sub" @key="@($"sub-{daily.Id}")">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@UpcomingSchedule.DescribeDaily(daily)</MudText>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="cal-row" @key="daily.Id">
                                            <span class="cal-row__icon cal-row__icon--daily" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" /></span>
                                            <div class="cal-row__text">
                                                <div class="cal-row__title">@daily.Title</div>
                                                <div class="cal-row__meta">@UpcomingSchedule.DescribeDaily(daily)</div>
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>
                            </div>
                        }
                        @if (ShowTodos && SelectedTodos.Count > 0)
                        {
                            <div class="cal-agenda-col">
                            <div class="cal-group">To-dos</div>
                            <ul class="cal-list">
                                @foreach (var todo in SelectedTodos)
                                {
                                    <li class="cal-row" @key="todo.Id">
                                        <span class="cal-row__icon cal-row__icon--todo" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" /></span>
                                        <div class="cal-row__text">
                                            <div class="cal-row__title">@todo.Title</div>
                                            <div class="cal-row__meta">@TodoDueRelativeText.Format(todo.TodoDueDate!.Value, _today)</div>
                                        </div>
                                        <div class="cal-row__actions">
                                            <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="cal-iconbtn" aria-label="@TodoCompleteLabel(todo)" OnClick="@(() => ToggleTodoAsync(todo))" Disabled="@IsBusy(todo.Id)" />
                                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="text-transform-none cal-pushbtn" OnClick="@(() => ShiftTodoAsync(todo, 1))" Disabled="@IsBusy(todo.Id)">+1 day</MudButton>
                                            @if (todo.TodoDueDate != _today)
                                            {
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="text-transform-none cal-pushbtn" OnClick="@(() => MoveTodoToDateAsync(todo, _today))" Disabled="@IsBusy(todo.Id)">Today</MudButton>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            </div>
                        }
                        </div>
                    }
                </MudPaper>
            </div>

            @if (_view == CalView.Month)
            {
                <section class="cal-grid-card cal-grid-card--month" aria-label="@($"{MonthTitle} calendar")">
                    <div class="cal-week" aria-hidden="true">
                        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                    </div>
                    <div class="cal-grid">
                        @foreach (var date in GridCells())
                        {
                            var dailies = CellDailies(date);
                            var todos = CellTodos(date);
                            var total = dailies.Count + todos.Count;
                            var chips = MonthChips(dailies, todos);
                            var shown = chips.Take(3).ToList();
                            var extra = chips.Count - shown.Count;
                            <button type="button"
                                    class="@CellClass(date)"
                                    aria-label="@CellAria(date, total)"
                                    aria-current="@(date == _selected ? "date" : null)"
                                    @onclick="() => SelectDay(date)"
                                    @key="date">
                                <span class="cal-cell__top">
                                    <span class="cal-cell__num">@date.Day</span>
                                    @if (date == _today)
                                    {
                                        <span class="cal-cell__todaydot" aria-hidden="true"></span>
                                    }
                                </span>
                                <span class="cal-cell__chips">
                                    @foreach (var chip in shown)
                                    {
                                        <span class="cal-chip @ChipClass(chip)" title="@chip.Hint">@ChipLabel(chip)</span>
                                    }
                                    @if (extra > 0)
                                    {
                                        <span class="cal-more">+@extra more</span>
                                    }
                                </span>
                                <span class="cal-cell__dots" aria-hidden="true">
                                    @if (ShowDailies && dailies.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--daily">@dailies.Count</span>
                                    }
                                    @if (ShowTodos && todos.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--todo">@todos.Count</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </section>
            }
            else if (_view == CalView.Week || _view == CalView.Next7)
            {
                <section class="cal-grid-card cal-grid-card--week" aria-label="@GridAriaLabel">
                    <div class="cal-grid cal-week-grid">
                        @foreach (var date in RangeCells())
                        {
                            var dailies = CellDailies(date);
                            var todos = CellTodos(date);
                            var total = dailies.Count + todos.Count;
                            var chips = CellChips(dailies, todos);
                            var shown = chips.Take(5).ToList();
                            var extra = chips.Count - shown.Count;
                            <button type="button"
                                    class="@(CellClass(date) + " cal-cell--week")"
                                    aria-label="@CellAria(date, total)"
                                    aria-current="@(date == _selected ? "date" : null)"
                                    @onclick="() => SelectDay(date)"
                                    @key="date">
                                <span class="cal-cell__top">
                                    <span class="cal-cell__dow">@date.ToString("ddd")</span>
                                    <span class="cal-cell__num">@date.Day</span>
                                </span>
                                <span class="cal-cell__chips">
                                    @foreach (var chip in shown)
                                    {
                                        <span class="cal-chip @ChipClass(chip)" title="@chip.Hint">@ChipLabel(chip)</span>
                                    }
                                    @if (extra > 0)
                                    {
                                        <span class="cal-more">+@extra more</span>
                                    }
                                </span>
                                <span class="cal-cell__dots" aria-hidden="true">
                                    @if (ShowDailies && dailies.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--daily">@dailies.Count</span>
                                    }
                                    @if (ShowTodos && todos.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--todo">@todos.Count</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </section>
            }
            else if (_view == CalView.Day)
            {
                <section class="cal-grid-card cal-grid-card--strip" aria-label="@($"Days around {FormatDate(_selected)}")">
                    <div class="cal-strip" role="listbox" aria-label="Choose a day">
                        @foreach (var date in DayStripCells())
                        {
                            var dailies = CellDailies(date);
                            var todos = CellTodos(date);
                            var total = dailies.Count + todos.Count;
                            <button type="button"
                                    role="option"
                                    aria-selected="@(date == _selected)"
                                    class="@(CellClass(date) + " cal-cell--strip")"
                                    aria-label="@CellAria(date, total)"
                                    @onclick="() => SelectDay(date)"
                                    @key="date">
                                <span class="cal-cell__dow">@date.ToString("ddd")</span>
                                <span class="cal-cell__num">@date.Day</span>
                                <span class="cal-cell__dots" aria-hidden="true">
                                    @if (ShowDailies && dailies.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--daily">@dailies.Count</span>
                                    }
                                    @if (ShowTodos && todos.Count > 0)
                                    {
                                        <span class="cal-dot cal-dot--todo">@todos.Count</span>
                                    }
                                    @if (total == 0)
                                    {
                                        <span class="cal-dot cal-dot--empty" aria-hidden="true"></span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>
