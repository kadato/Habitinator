@inject IBoardSyncStatus BoardSync
@inject IUserDateFormatService DateFormatService
@implements IDisposable

@{
    var hasState = BoardSync.LastSyncedUtc is not null || BoardSync.IsOffline || BoardSync.IsSyncing || !string.IsNullOrEmpty(BoardSync.SyncProblemMessage);
    var state = GetState();
    var dotClass = GetDotClass(state);
    var label = GetSyncStatusText();
    var tooltip = GetSyncStatusTooltip();
}

@if (hasState)
{
    @if (IconOnly)
    {
        <span class="sync-dot-wrap me-2" title="@tooltip" aria-label="@label" role="status">
            <span class="sync-dot @dotClass" aria-hidden="true"></span>
        </span>
    }
    else
    {
        <div class="sync-row">
            <span class="sync-dot @dotClass" aria-hidden="true"></span>
            <span class="sync-row__label">@label</span>
            @if (BoardSync.LastSyncedUtc is { } syncedAt && state == SyncState.Synced)
            {
                <span class="sync-row__meta">@DateFormatService.Format(syncedAt.LocalDateTime)</span>
            }
        </div>
        <MudDivider Class="my-1"/>
    }
}

@code {
    [Parameter] public bool IconOnly { get; set; }

    private enum SyncState { Offline, Error, Syncing, Synced, Idle }

    protected override void OnInitialized()
    {
        BoardSync.Changed += OnBoardSyncChanged;
    }

    private void OnBoardSyncChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        BoardSync.Changed -= OnBoardSyncChanged;
    }

    private SyncState GetState()
    {
        if (BoardSync.IsOffline) return SyncState.Offline;
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage)) return SyncState.Error;
        if (BoardSync.IsSyncing) return SyncState.Syncing;
        if (BoardSync.LastSyncedUtc is not null) return SyncState.Synced;
        return SyncState.Idle;
    }

    private static string GetDotClass(SyncState state) => state switch
    {
        SyncState.Offline => "sync-dot--offline",
        SyncState.Error => "sync-dot--error",
        SyncState.Syncing => "sync-dot--syncing",
        SyncState.Synced => "sync-dot--ok",
        _ => "sync-dot--idle"
    };

    private string GetSyncStatusTooltip()
    {
        if (BoardSync.IsOffline)
            return "Working offline. Changes will sync when you reconnect.";
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
            return $"Sync issue: {BoardSync.SyncProblemMessage}";
        if (BoardSync.IsSyncing)
            return "Syncing with server...";
        if (BoardSync.LastSyncedUtc is { } syncedAt)
            return $"Synced. Last sync: {DateFormatService.Format(syncedAt.LocalDateTime)}";
        return "Not synced yet";
    }

    private string GetSyncStatusText()
    {
        if (BoardSync.IsOffline)
            return "Offline";
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
            return "Sync issue";
        if (BoardSync.IsSyncing)
            return "Syncing";
        if (BoardSync.LastSyncedUtc is not null)
            return "Synced";
        return "Not synced";
    }
}
