@inherits AutosaveEditDialogBase<EditDailyDialogResult>
@inject IUserDateFormatService DateFormatService
@inject IDialogService DialogService

<MudDialog Class="edit-daily-dialog hab-modal-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(26rem, calc(100vw - 1rem));">
<DialogContent>
    <div class="hab-modal hab-modal--daily edit-daily-shell edit-daily-shell--daily" @onclick="OnShellClick">
        <EditDialogHeader TitleText="Edit daily"
                          TitlePlaceholder="Daily title"
                          @bind-Title="_title"
                          @bind-Title:after="OnTitleEdited"
                          @bind-Notes="_notes"
                          @bind-Notes:after="OnNotesEdited"
                          OnClose="CloseAsync"
                          SaveStatus="SaveStatus"
                          Section="BoardSection.Daily"/>

        <div class="hab-modal__body edit-daily-body">
            <button type="button" class="edit-daily-heatmap-btn" @onclick="OpenHeatmapDialogAsync">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="edit-daily-heatmap-btn__icon" />
                <span>View Heatmap</span>
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.2" fill="none" style="margin-left:auto; opacity:0.55;"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>

            <div class="hab-checklist">
                <div class="hab-checklist__head">
                    <span class="hab-checklist__head-title">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                        Checklist
                    </span>
                    @if (_checklistRows.Count > 0)
                    {
                        <span class="hab-checklist__count">@_checklistRows.Count(x => x.IsDone) / @_checklistRows.Count</span>
                    }
                </div>
                <div class="hab-checklist__list">
                    <ChecklistEditor @bind-Value="_checklistRows" @bind-Value:after="OnChecklistEdited"/>
                </div>
            </div>

            <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                <span class="hab-modal__section-label">
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Start date
                </span>
                <MudDatePicker @bind-Date="_startDate" @bind-Date:after="OnDiscreteEdited" Variant="Variant.Outlined" Editable="true" Class="hab-modal__field" DateFormat="@DateFormatService.DateFormat" Margin="Margin.Dense"/>
            </div>

            <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                <span class="hab-modal__section-label">Repeats</span>
                <MudSelect T="DailyRepeatType" @bind-Value="_repeat" @bind-Value:after="OnDiscreteEdited" Variant="Variant.Outlined" Class="hab-modal__field" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Daily">Daily</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Weekly">Weekly</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Monthly">Monthly</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Yearly">Yearly</MudSelectItem>
                </MudSelect>
            </div>

            <div class="hab-modal__section">
                <span class="hab-modal__section-label">Repeat every</span>
                <div class="edit-daily-repeat-every">
                    <MudNumericField @bind-Value="_repeatInterval" @bind-Value:after="OnIntervalEdited" Variant="Variant.Outlined" Class="edit-daily-repeat-every__n" Min="1" Max="999" HideSpinButtons="true" Margin="Margin.Dense"/>
                    <span class="edit-daily-repeat-every__unit">@RepeatUnitLabel()</span>
                </div>
            </div>

            <div class="hab-modal__section">
                <span class="hab-modal__section-label">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>
                    Tags
                </span>
                <TagPicker @bind-Tags="_tags" @bind-Tags:after="OnTagsEdited" TriggerId="edit-daily-tags-trigger" @ref="_tagPicker"/>
            </div>

            <div class="hab-advanced @(_advancedOpen ? "hab-advanced--open" : string.Empty)">
                <button type="button" class="hab-advanced__trigger" @onclick="() => _advancedOpen = !_advancedOpen">
                    <span>Scheduled streak tuning</span>
                    <svg class="hab-advanced__chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
                @if (_advancedOpen)
                {
                    <div class="hab-advanced__body">
                        <span style="font-size:0.78rem; color:var(--mud-palette-text-secondary);">Backfill past days to match this streak. Today is left unchanged.</span>
                        <div class="edit-daily-streak-input">
                            <span class="edit-daily-streak-input__icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" Style="color:var(--hab-accent-streak)"/>
                            </span>
                            <MudNumericField @bind-Value="_counter" @bind-Value:after="OnCounterEdited" Variant="Variant.Outlined" Class="edit-daily-streak-input__field" Min="0" Max="9999" HideSpinButtons="true" Margin="Margin.Dense"/>
                        </div>
                    </div>
                }
            </div>

            <EditDialogFooterActions OnArchive="ArchiveAsync" OnDelete="DeleteAsync"/>
        </div>
    </div>
</DialogContent>
</MudDialog>

@code {
    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private DateTime? _startDate;
    private DailyRepeatType _repeat = DailyRepeatType.Daily;
    private int _repeatInterval = 1;
    private List<ChecklistRow> _checklistRows = [];
    private int _counter;
    private bool _advancedOpen;

    protected override string BatchDescription => $"Edit \"{Item.Title}\"";

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _counter = Item.Counter;
        _startDate = Item.DailyStartDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
        _repeat = Item.DailyRepeat;
        _repeatInterval = Item.DailyRepeatInterval < 1 ? 1 : Item.DailyRepeatInterval;
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
    }

    private void OnShellClick() => _tagPicker?.Dismiss();
    private string RepeatUnitLabel() => _repeat switch
    {
        DailyRepeatType.Daily => _repeatInterval == 1 ? "day" : "days",
        DailyRepeatType.Weekly => _repeatInterval == 1 ? "week" : "weeks",
        DailyRepeatType.Monthly => _repeatInterval == 1 ? "month" : "months",
        DailyRepeatType.Yearly => _repeatInterval == 1 ? "year" : "years",
        _ => "days"
    };
    private void OnTitleEdited() => ScheduleSave();
    private void OnNotesEdited() => ScheduleSave();
    private Task OnTagsEdited() => SaveNowAsync();
    private void OnChecklistEdited() => ScheduleSave(300);
    private void OnDiscreteEdited() => _ = SaveNowAsync();
    private void OnIntervalEdited() => ScheduleSave(400);
    private void OnCounterEdited() => ScheduleSave(400);

    protected override async Task SaveValuesAsync(CancellationToken cancellationToken = default)
    {
        var title = string.IsNullOrWhiteSpace(_title) ? Item.Title : _title.Trim();
        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        var start = _startDate is { } d ? DateOnly.FromDateTime(d.Date) : Item.DailyStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var interval = _repeatInterval < 1 ? 1 : _repeatInterval;
        await BoardData.UpdateDailyAsync(Item.Id, new UpdateDailyArgs(title, EditDialogHelpers.CleanStringPayload(_notes), tagsPayload, start, _repeat, interval, checklistPayload, _counter), cancellationToken);
    }

    protected override EditDailyDialogResult BuildResult(EditDialogAction action)
    {
        var start = _startDate is { } d ? DateOnly.FromDateTime(d.Date) : Item.DailyStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        return new EditDailyDialogResult(action, _title.Trim(), EditDialogHelpers.CleanStringPayload(_notes), EditDialogHelpers.CleanStringPayload(_tags), start, _repeat, _repeatInterval < 1 ? 1 : _repeatInterval, EditDialogHelpers.SerializeChecklistRows(_checklistRows), _counter);
    }

    private void ArchiveAsync() => CloseWithAction(EditDialogAction.Archive);
    private void DeleteAsync() => CloseWithAction(EditDialogAction.Delete);
    private async Task OpenHeatmapDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = false, NoHeader = true };
        var parameters = new DialogParameters<DailyHeatmapDialog> { { x => x.BoardItemId, Item.Id }, { x => x.Title, string.IsNullOrWhiteSpace(_title) ? Item.Title : _title } };
        await DialogService.ShowAsync<DailyHeatmapDialog>(string.Empty, parameters, options);
    }
}
