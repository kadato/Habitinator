%% Streak Calculation Algorithm
%% Walks backward from today to count consecutive completed days

flowchart TD
    Start([Input: startDate, repeatType, interval, today, events]) --> Init
    
    Init[Initialize:<br/>n = 0 (streak count)<br/>d = today (current date)<br/>maxSteps = 20,000 (safety guard)]
    Init --> TodayCheck
    
    TodayCheck{Is today completed?} -->|Yes| SetToday
    TodayCheck -->|No| AdjustStart
    
    SetToday[d = today]<br/>SetToday --> WalkLoop
    
    AdjustStart[d = today - 1 day<br/>end = d]<br/>AdjustStart --> WalkLoop
    
    WalkLoop{{while maxSteps > 0}} --> CheckBounds
    
    CheckBounds{d < historyStart?} -->|Yes| ReturnResult
    CheckBounds -->|No| CheckScheduled
    
    CheckScheduled{IsScheduledOn(d)?} -->|No| SkipDay
    CheckScheduled -->|Yes| CheckCompleted
    
    SkipDay[d = d - 1 day<br/>maxSteps--] --> WalkLoop
    
    CheckCompleted{IsCalendarDayNetCompleted(d)?} -->|Yes| Increment
    CheckCompleted -->|No| BreakChain
    
    Increment[n++<br/>d = d - 1 day<br/>maxSteps--] --> WalkLoop
    
    BreakChain[Break loop<br/>Chain broken] --> ReturnResult
    
    ReturnResult[Return: min(n, MaxStreak)] --> End([End])
    
    %% Event sourcing detail
    subgraph EventSourcing["📋 Event Sourcing Detail"]
        direction TB
        
        Events["Events for day D:<br/>[Complete 09:00]<br/>[Uncomplete 10:00]<br/>[Complete 14:00]"] --> NetCalc
        
        NetCalc["Net Calculation:<br/>Last event wins<br/>Day is COMPLETED"]
        
        Synthetic["Synthetic Events:<br/>Timestamp = 12:00 UTC<br/>Marker for backfilled streaks"]
    end
    
    %% Styling
    classDef startEnd fill:#e3f2fd,stroke:#1565c0
    classDef process fill:#e8f5e9,stroke:#2e7d32
    classDef decision fill:#fff3e0,stroke:#ef6c00
    classDef result fill:#f3e5f5,stroke:#7b1fa2
    classDef detail fill:#fce4ec,stroke:#c2185b
    
    class Start,End startEnd
    class Init,SetToday,AdjustStart,SkipDay,Increment,ReturnResult process
    class TodayCheck,CheckBounds,CheckScheduled,CheckCompleted,WalkLoop decision
    class BreakChain result
    class EventSourcing,Events,NetCalc,Synthetic detail
