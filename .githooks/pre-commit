#!/bin/sh

# Get list of staged C# files
files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$')

if [ -z "$files" ]; then
    exit 0
fi

echo ""
echo "=================================================="
echo "Checking if backend and shared projects compile..."
echo "=================================================="
echo ""

dotnet build src/App.Web/App.Web.csproj --configuration Release -p:TreatWarningsAsErrors=true
build_exit_code=$?

if [ $build_exit_code -ne 0 ]; then
    echo ""
    echo "=================================================="
    echo "ERROR: dotnet build failed with exit code $build_exit_code."
    echo "Please resolve the compilation errors before committing."
    echo "=================================================="
    echo ""
    exit $build_exit_code
fi

echo ""
echo "=================================================="
echo "Automatically formatting staged C# files..."
echo "=================================================="
echo ""

# Run dotnet format style and whitespace on staged C# files
dotnet format Habitinator.slnx --include $files
format_exit_code=$?

if [ $format_exit_code -ne 0 ]; then
    echo ""
    echo "=================================================="
    echo "ERROR: dotnet format failed with exit code $format_exit_code."
    echo "Please verify you have the required workloads installed"
    echo "(run 'dotnet workload restore') and that there are no build errors."
    echo "=================================================="
    echo ""
    exit $format_exit_code
fi

# Re-add modified C# files to the commit
echo "$files" | while read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo ""
echo "=================================================="
echo "Formatting completed successfully."
echo "=================================================="
echo ""
