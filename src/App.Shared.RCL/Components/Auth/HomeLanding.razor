@inject NavigationManager Nav

<AuthPageShell Title="Welcome to Habitinator"
               Subtitle="Habits, dailies, and to-dos in one place."
               Class="auth-landing">
    <ChildContent>
        @if (_showDeletedMessage)
        {
            <div class="alert alert-info" role="alert">Your account has been deleted. Thanks for using Habitinator.</div>
        }
        <h2 class="auth-card__section-title">Get started</h2>
        <div class="auth-landing__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/auth/login"
                       Target="_self"
                       data-enhance-nav="false">
                Sign in
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/auth/register"
                       Target="_self"
                       data-enhance-nav="false">
                Register
            </MudButton>
        </div>

        <div class="auth-landing__guest-block">
            <div class="auth-form-divider" role="separator" aria-orientation="horizontal">or</div>
            <div class="auth-landing__guest-paper guest-login-paper">
                @if (UseCookieGuestLogin)
                {
                    <form method="post" action="/api/auth/guest-login" class="d-flex flex-column guest-login-form" onsubmit="return habitinatorGuestSubmit(this)">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   Size="Size.Large">
                            <span class="guest-login-label">Continue as demo guest</span>
                        </MudButton>
                        <p class="guest-login-status" role="status" hidden>Loading demo…</p>
                    </form>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="@_guestBusy"
                               OnClick="ContinueAsGuestAsync">
                        @(_guestBusy ? "Loading demo board…" : "Continue as demo guest")
                    </MudButton>
                }
            </div>
        </div>
    </ChildContent>
</AuthPageShell>

@code {
    /// <summary>When true, posts to the web cookie guest-login endpoint. When false, uses <see cref="OnContinueAsDemoGuest"/> for the MAUI / JWT flow.</summary>
    [Parameter] public bool UseCookieGuestLogin { get; set; } = true;

    [Parameter] public EventCallback OnContinueAsDemoGuest { get; set; }

    private bool _guestBusy;
    private bool _showDeletedMessage;

    protected override void OnInitialized()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        _showDeletedMessage = query
            .TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("accountDeleted=1", StringComparer.Ordinal);
    }

    private async Task ContinueAsGuestAsync()
    {
        if (!OnContinueAsDemoGuest.HasDelegate) return;
        _guestBusy = true;
        try
        {
            await OnContinueAsDemoGuest.InvokeAsync();
        }
        finally
        {
            _guestBusy = false;
        }
    }
}
