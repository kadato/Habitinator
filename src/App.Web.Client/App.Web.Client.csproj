<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <HybridGlobalization>true</HybridGlobalization>
    <!-- AOT: compile C# to native WebAssembly for roughly 10-20x faster runtime execution. Release only. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- Webcil: repackage DLLs as .wasm for better CDN and proxy compatibility -->
    <WasmEnableWebcil>true</WasmEnableWebcil>

    <!-- Size optimizations, all safe -->
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!-- AOT build optimizations. Release only, no effect in Debug. -->
    <WasmNativeStrip Condition="'$(Configuration)' == 'Release'">true</WasmNativeStrip>
    <WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">true</WasmStripILAfterAOT>

    <!-- Runtime performance -->
    <BlazorWebAssemblyJiterpreter>true</BlazorWebAssemblyJiterpreter>

    <!-- Trim safety -->
    <!-- JsonSerializerIsReflectionEnabledByDefault is NOT set here because
         the Blazor WASM runtime itself uses reflection-based JSON internally
         for component parameter marshaling and state persistence. Keeping it
         enabled allows the framework to work while our app code still benefits
         from the TrimmerRootDescriptor for MudBlazor reflection safety. -->
    <!-- Suppress known-safe framework trim warnings, for JS interop and the Blazor router -->
    <NoWarn>$(NoWarn);IL2026;IL2111;IL2110</NoWarn>
  </PropertyGroup>

  <!-- Trim-root descriptor for reflection-dependent libraries -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Shared.RCL\App.Shared.RCL.csproj" />
  </ItemGroup>

</Project>
