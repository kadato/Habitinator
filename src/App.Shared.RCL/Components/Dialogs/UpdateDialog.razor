@using App.Shared.RCL.Services
@inject IAppUpdaterService UpdaterService

<MudDialog Class="update-dialog">
    <TitleContent>
        <div class="update-title">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdate" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.h6">Update Available</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">A new version of Habitinator is ready to install.</MudText>
            </div>

            <div class="d-flex align-center justify-space-between py-2 px-3 border rounded-lg">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Current Version</MudText>
                    <MudText Typo="Typo.body2" Class="font-weight-bold">v@_currentVersion</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Secondary" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">New Version</MudText>
                    <span class="update-version-badge">v@LatestVersion</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ReleaseNotes))
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1 font-weight-semibold">What's New:</MudText>
                    <div class="release-notes-box">@ReleaseNotes</div>
                </div>
            }

            @if (_isDownloading)
            {
                <MudStack Spacing="2">
                    <div class="d-flex align-center justify-space-between">
                        <MudText Typo="Typo.body2" Class="font-weight-semibold">@_statusText</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="font-weight-bold">@_progressPercent%</MudText>
                    </div>
                    <MudProgressLinear Color="Color.Primary" Value="@_progressPercent" Class="my-2" Size="Size.Medium" Rounded="true" />
                </MudStack>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-2">
                    @_errorMessage
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (!_isDownloading)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartUpdate" StartIcon="@Icons.Material.Filled.Download">
                Update Now
            </MudButton>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartUpdate" StartIcon="@Icons.Material.Filled.Refresh">
                Retry
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string LatestVersion { get; set; } = string.Empty;

    [Parameter]
    public string ReleaseNotes { get; set; } = string.Empty;

    [Parameter]
    public string DownloadUrl { get; set; } = string.Empty;

    private string _currentVersion = "1.0.0";
    private bool _isDownloading;
    private int _progressPercent;
    private string _statusText = "Downloading update...";
    private string _errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        _currentVersion = UpdaterService.CurrentVersion;
    }

    private async Task StartUpdate()
    {
        _isDownloading = true;
        _progressPercent = 0;
        _errorMessage = string.Empty;
        _statusText = "Downloading update...";
        StateHasChanged();

        try
        {
            await UpdaterService.DownloadAndInstallUpdateAsync(DownloadUrl, progress =>
            {
                _progressPercent = (int)(progress * 100);
                if (_progressPercent >= 100)
                {
                    _statusText = "Launching installer...";
                }
                InvokeAsync(StateHasChanged);
            });

            // If we successfully launched the installer, or redirected to settings for permissions, close the dialog
            MudDialog.Close();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to install update: {ex.Message}";
            _statusText = "Update failed.";
            StateHasChanged();
        }
    }
}
