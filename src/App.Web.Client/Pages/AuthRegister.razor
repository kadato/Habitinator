@page "/auth/register"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Create account")"
          Description="Create a Habitinator account to sync habits, dailies, and to-dos across web and mobile."
          CanonicalPath="/auth/register"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Create account"
               Subtitle="Choose an email and a password. The password needs at least 8 characters."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-danger" role="alert" id="auth-error">@_message</div>
        }

        <form method="post" action="/api/auth/register-form">
            <RegisterFormFields FormEmail="@_email" HasError="@_hasError" ErrorId="auth-error"/>
            <div class="auth-form-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large">
                    Create account
                </MudButton>
            </div>
        </form>
    </ChildContent>
    <Footer>
        <span>Already have an account?</span>
        <a href="/auth/login" data-enhance-nav="false">Sign in</a>
        <span> · </span>
        <a href="/privacy" data-enhance-nav="false">Privacy</a>
    </Footer>
</AuthPageShell>

@code {
    private string? _message;
    private string _email = string.Empty;
    private bool _hasError;

    protected override void OnInitialized()
    {
        var query = AuthQueryMessages.ResolveRegister(Navigation);
        _email = query.Email ?? string.Empty;
        _message = query.Message;
        _hasError = _message is not null;
    }

}
