@using System.Security.Claims
@using global::App.Shared.RCL
@using global::App.Shared.RCL.Models
@using global::App.Shared.RCL.Services
@using global::App.Shared.RCL.Themes
@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inherits LayoutComponentBase
@rendermode @(new InteractiveWebAssemblyRenderMode(true))
@inject IUserPreferencesService PreferencesService
@inject IUserDateFormatService DateFormatService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@SeoDefaults.DefaultTitle</PageTitle>

<MudThemeProvider @ref="_mudThemeProvider" Theme="@HabitinatorMudTheme.Default" @bind-IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="false"/>
<MudSnackbarProvider/>
<TimeZoneInitializer />

<form id="globalLogoutForm" method="post" action="/api/auth/cookie-logout" style="display: none;"></form>

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudLayout Class="app-shell-layout">
    <AuthorizeView>
        <Authorized Context="auth">
            <MudAppBar Elevation="0" Dense="true" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar" role="banner">
                <div class="app-top-bar__stack w-100">
                    <div class="app-top-bar__row d-flex">
                        <div class="app-top-bar__left d-flex align-center">
                            <div class="app-branding d-flex flex-column justify-center">
                                <MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText>
                            </div>
                            <div class="app-show-desktop-only align-center">
                                <NavMenu Mode="AppNavMode.Full"/>
                            </div>
                        </div>
                        <div class="app-top-bar__flex-spacer" aria-hidden="true"></div>
                        <div class="app-top-bar__right d-flex align-center">
                            <div class="app-header-user-rail d-flex align-center">
                                <MudMenu AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Dense="true"
                                         PopoverFixed="true"
                                         PopoverClass="app-profile-menu-popover">
                                    <ActivatorContent Context="profileMenu">
                                        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                                       Color="Color.Primary"
                                                       Size="Size.Medium"
                                                       Class="app-header-profile-btn app-show-mobile-only"
                                                       aria-label="Account menu"
                                                       OnClick="@(e => profileMenu.ToggleAsync(e))" />
                                        <MudButton StartIcon="@Icons.Material.Filled.AccountCircle"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Filled"
                                                   Size="Size.Medium"
                                                   Class="app-header-username-btn text-transform-none app-show-desktop-only"
                                                   OnClick="@(e => profileMenu.ToggleAsync(e))">
                                            @GetDisplayName(auth)
                                        </MudButton>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <div class="px-4 py-3 border-bottom d-flex flex-column dropdown-header" style="min-width: 220px;">
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold dropdown-name">@GetDisplayName(auth)</MudText>
                                            <MudText Typo="Typo.caption" Class="text-secondary text-truncate dropdown-email">@auth.User.FindFirst(ClaimTypes.Email)?.Value</MudText>
                                        </div>
                                        <MudDivider Class="my-1"/>
                                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" Class="text-danger" OnClick="TriggerLogout">
                                            <MudText Color="Color.Error" Class="font-weight-semibold">Log out</MudText>
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        </div>
                    </div>
                    <NavMenu Mode="AppNavMode.Full" MobileTopBar="true" />
                </div>
            </MudAppBar>
        </Authorized>
        <NotAuthorized>
            <MudAppBar Elevation="0" Dense="true" Class="app-top-bar app-top-bar--guest" ToolBarClass="app-top-bar-toolbar" role="banner">
                <MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText>
                <MudSpacer />
                <MudButton Href="/auth/login" Variant="Variant.Text" Color="Color.Inherit" Class="text-transform-none app-show-mobile-only">Sign in</MudButton>
                <MudButton Href="/auth/register" Variant="Variant.Filled" Color="Color.Primary" Class="text-transform-none ms-1">Register</MudButton>
            </MudAppBar>
        </NotAuthorized>
    </AuthorizeView>
    <MudMainContent Class="app-shell-main">
        <main id="main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-3 px-4 px-sm-5 board-main-container">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <GlobalTimerFocusAlertHost/>
        <GlobalSyncAlertHost/>
        <WebBoardHubConnector/>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task TriggerLogout()
    {
        await JS.InvokeVoidAsync("eval", "document.getElementById('globalLogoutForm').submit()");
    }

    private UserPreferences? _preferences;
    private bool _isDarkMode = true;
    private MudThemeProvider? _mudThemeProvider;
    private DotNetObjectReference<MainLayout>? _layoutSelfRef;

    protected override async Task OnInitializedAsync()
    {
        PreferencesService.Changed += OnPreferencesChanged;
        Nav.LocationChanged += OnLocationChanged;

        _isDarkMode = GetSystemDarkMode();

        // Parse query parameter to avoid flash of wrong theme during loading
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("theme", out var themeValues))
        {
            var theme = themeValues.ToString();
            if (string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase))
            {
                _isDarkMode = false;
            }
            else if (string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase))
            {
                _isDarkMode = true;
            }
        }

        await LoadPreferencesAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Immediately remove the splash screen so the user is never stuck
            try
            {
                await JS.InvokeVoidAsync("habitinatorRemoveSplash");
            }
            catch
            {
                // Ignore early JS interop failures
            }

            // 2. Initialize board visibility script and keyboard shortcuts
            try
            {
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardVisibility.js");
                _layoutSelfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.startGlobal", _layoutSelfRef);
            }
            catch
            {
                // Ignore JS/shortcut initialization errors
            }

            // 3. Resolve theme and setup dark mode preference watcher
            try
            {
                if (_mudThemeProvider != null)
                {
                    await ResolveThemeAsync();
                    await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
                }
            }
            catch
            {
                // Ignore theme watcher failures
            }
        }
    }

    [JSInvokable]
    public void NavigateTo(string path)
    {
        Nav.NavigateTo(path);
    }

    [JSInvokable]
    public Task OnCtrlZPressed()
    {
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        PreferencesService.Changed -= OnPreferencesChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _layoutSelfRef?.Dispose();
    }

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadPreferencesAsync();
        });
    }

    private async Task LoadPreferencesAsync()
    {
        _preferences = await PreferencesService.GetAsync();
        DateFormatService.ApplyFromPreferences(_preferences);
        await ResolveThemeAsync();
    }

    private async Task SyncHtmlThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("habitinatorSetTheme", _isDarkMode ? "dark" : "light");
        }
        catch
        {
            // Ignore if JS is not available (e.g. prerendering)
        }
    }

    private async Task ResolveThemeAsync()
    {
        if (_preferences is null) return;

        if (_preferences.Theme == AppTheme.Light)
        {
            _isDarkMode = false;
        }
        else if (_preferences.Theme == AppTheme.Dark)
        {
            _isDarkMode = true;
        }
        else // System
        {
            if (_mudThemeProvider != null)
            {
                _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            }
            else
            {
                _isDarkMode = GetSystemDarkMode();
            }
        }
        await SyncHtmlThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSystemPreferenceChanged(bool isDarkMode)
    {
        if (_preferences?.Theme == AppTheme.System)
        {
            _isDarkMode = isDarkMode;
            await SyncHtmlThemeAsync();
            StateHasChanged();
        }
    }


    private string GetFullIdentity(AuthenticationState auth)
    {
        var email = auth.User.FindFirst(ClaimTypes.Email)?.Value
                    ?? auth.User.Identity?.Name
                    ?? "User";
        var displayName = _preferences?.DisplayName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return email;
        }

        return $"{displayName} ({email})";
    }

    private string GetDisplayName(AuthenticationState auth)
    {
        var displayName = _preferences?.DisplayName;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        var full = GetFullIdentity(auth);
        var at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }

    private bool GetSystemDarkMode()
    {
        if (JS is Microsoft.JSInterop.IJSInProcessRuntime jsInProcess)
        {
            try
            {
                return jsInProcess.Invoke<bool>("eval", "window.matchMedia('(prefers-color-scheme: dark)').matches");
            }
            catch
            {
                // Ignore and fall back
            }
        }
        return true; // Default
    }

}
