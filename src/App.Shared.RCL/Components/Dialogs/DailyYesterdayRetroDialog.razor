@inject IUserDateFormatService DateFormatService

<MudDialog Class="daily-yesterday-dialog"
           ContentClass="daily-yesterday-dialog__content"
           Style="width: min(28rem, calc(100vw - 2rem));">
    <DialogContent>
        <div class="daily-yesterday-shell">
            <div class="daily-yesterday-header">
                <div class="daily-yesterday-header__toolbar">
                    <div class="daily-yesterday-header__title-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.History" Class="daily-yesterday-header__icon me-2" Color="Color.Primary" Size="Size.Medium" />
                        <MudText Typo="Typo.subtitle1" Class="daily-yesterday-header__title">Yesterday's Dailies</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                   Class="daily-yesterday-header__close-btn" 
                                   OnClick="CloseAsync" 
                                   Size="Size.Small"
                                   title="Close" />
                </div>
                <div class="daily-yesterday-header__subtitle-wrap mt-1">
                    <MudText Typo="Typo.body2" Class="daily-yesterday-header__subtitle">
                        Dailies not done on <strong class="daily-yesterday-date">@_dueOnFormatted</strong>. Check off any you completed that day.
                    </MudText>
                </div>
            </div>

            <div class="daily-yesterday-body">
                <div class="daily-yesterday-list">
                    @foreach (var item in _pending)
                    {
                        var isCompleted = _completedById.GetValueOrDefault(item.Id);
                        var rowClass = isCompleted ? "daily-yesterday-row--completed" : "";
                        var checkClass = isCompleted ? "daily-yesterday-check daily-yesterday-check--ok" : "daily-yesterday-check daily-yesterday-check--daily";
                        
                        <div class="daily-yesterday-row @rowClass" 
                             @key="item.Id"
                             @onclick="@(() => ToggleItem(item))"
                             @onkeydown="@(e => HandleKeyDown(e, item))"
                             role="checkbox"
                             tabindex="0"
                             aria-label="@item.Title"
                             @attributes="GetRowAria(isCompleted)"
                             aria-disabled="false">
                            <div class="daily-yesterday-row__check-col">
                                <div class="@checkClass"
                                     aria-hidden="true">
                                    @if (isCompleted)
                                    {
                                        <svg class="daily-yesterday-check-glyph"
                                             viewBox="0 0 24 24"
                                             width="12"
                                             height="12"
                                             fill="none"
                                             xmlns="http://www.w3.org/2000/svg"
                                             aria-hidden="true">
                                            <path d="M5 12l5 5L19 5"
                                                  stroke="currentColor"
                                                  stroke-width="3"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"/>
                                        </svg>
                                    }
                                </div>
                            </div>
                            <div class="daily-yesterday-row__title">
                                <span class="daily-yesterday-row__title-text">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <span class="daily-yesterday-row__notes">@item.Notes</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] [EditorRequired] public DateOnly DueOn { get; set; }

    [Parameter] [EditorRequired] public IReadOnlyList<BoardItem> Items { get; set; } = [];

    private string _dueOnFormatted = string.Empty;
    private List<BoardItem> _pending = [];
    private readonly Dictionary<Guid, bool> _completedById = new();
    private bool _anyChanged;

    protected override void OnParametersSet()
    {
        _ = InitializeDateFormatAsync();
        _pending = Items.ToList();
    }

    private async Task InitializeDateFormatAsync()
    {
        await DateFormatService.InitializeAsync();
        _dueOnFormatted = DateFormatService.Format(DueOn);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleItem(BoardItem item)
    {
        var nextVal = !_completedById.GetValueOrDefault(item.Id);
        _completedById[item.Id] = nextVal;
        _anyChanged = true;
        StateHasChanged();
    }

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, BoardItem item)
    {
        if (e.Key is " " or "Enter")
        {
            ToggleItem(item);
        }
    }

    private void CloseAsync()
    {
        if (_anyChanged)
        {
            var completedIds = _completedById.Where(kvp => kvp.Value).Select(kvp => kvp.Key).ToList();
            MudDialog.Close(DialogResult.Ok(completedIds));
        }
        else
        {
            MudDialog.Close(DialogResult.Cancel());
        }
    }

    private static Dictionary<string, object> GetRowAria(bool isCompleted) => new()
    {
        { "aria-checked", isCompleted ? "true" : "false" }
    };
}