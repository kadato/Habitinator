@using App.Shared.RCL.Services.Board.Local
@using App.Shared.RCL.Components.Dialogs
@inject IBoardSyncStatus BoardSync
@inject IBoardSyncRequestor SyncRequestor
@inject IUserNotifier Notifier
@inject IDialogService DialogService
@inject IServiceProvider Services
@implements IDisposable

@{
    var state = GetState();
    var stateClass = GetStateClass(state);
    var flushClass = Flush ? "sync-row--flush" : string.Empty;
    var icon = GetStateIcon(state);
    var label = GetSyncStatusText();
    var tooltip = GetSyncStatusTooltip();
}

@if (IconOnly)
{
    <button type="button" class="sync-icon-btn @stateClass" title="@tooltip" aria-label="@($"{label}. Show sync details.")" @onclick="ShowDetailsAsync">
        <MudIcon Icon="@icon" Class="sync-icon" aria-hidden="true" />
    </button>
}
else
{
    <div class="sync-row @flushClass @stateClass" role="status">
        <MudIcon Icon="@icon" Class="sync-row__icon" aria-hidden="true" />
        <span class="sync-row__label">@label</span>
        @if (CanRetry(state))
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="sync-row__retry" OnClick="RetryNow">@GetRetryLabel(state)</MudButton>
        }
    </div>
    <MudDivider Class="my-1"/>
}

@code {
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>Drops horizontal padding so the row lines up with the host card text. Keep off inside the profile menu.</summary>
    [Parameter] public bool Flush { get; set; }

    private enum SyncState { Offline, Paused, Error, Syncing, Synced, Idle }

    protected override void OnInitialized()
    {
        BoardSync.Changed += OnBoardSyncChanged;
    }

    private void OnBoardSyncChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Dispose(disposing: true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!disposing)
        {
            return;
        }

        BoardSync.Changed -= OnBoardSyncChanged;
    }

    private async Task ShowDetailsAsync()
    {
        try
        {
            if (Services.GetService(typeof(LocalFirstBoardDataService)) is LocalFirstBoardDataService board)
            {
                var pending = await board.GetPendingOutboxAsync();
                if (pending.Count > 0)
                {
                    DialogParameters<PendingOutboxDialog> parameters = new()
                    {
                        { x => x.Pending, pending },
                        { x => x.Conflicts, BoardSync.RecentConflicts }
                    };
                    await DialogService.ShowAsync<PendingOutboxDialog>(string.Empty, parameters, DialogDefaults.Wide);
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(ex.Message);
        }

        if (BoardSync.RecentConflicts.Count > 0)
        {
            try
            {
                DialogParameters<SyncConflictsDialog> parameters = new() { { x => x.Conflicts, BoardSync.RecentConflicts } };
                await DialogService.ShowAsync<SyncConflictsDialog>(string.Empty, parameters, DialogDefaults.Wide);
                return;
            }
            catch
            {
                // Fall through to the toast. The indicator still shows the state.
            }
        }

        var severity = GetState() switch
        {
            SyncState.Error => MudBlazor.Severity.Error,
            SyncState.Offline => MudBlazor.Severity.Warning,
            SyncState.Paused => MudBlazor.Severity.Warning,
            SyncState.Syncing => MudBlazor.Severity.Info,
            _ => MudBlazor.Severity.Normal
        };
        try
        {
            await Notifier.NotifyAsync(GetSyncStatusTooltip(), severity);
        }
        catch
        {
            // Shows a best-effort toast. The indicator still shows the state.
        }
    }

    private SyncState GetState()
    {
        if (BoardSync.IsPaused) return SyncState.Paused;
        if (BoardSync.IsOffline) return SyncState.Offline;
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage)) return SyncState.Error;
        if (BoardSync.IsSyncing) return SyncState.Syncing;
        if (BoardSync.LastSyncedUtc is not null) return SyncState.Synced;
        return SyncState.Idle;
    }

    private static string GetStateClass(SyncState state) => state switch
    {
        SyncState.Paused => "sync-state--paused",
        SyncState.Offline => "sync-state--offline",
        SyncState.Error => "sync-state--error",
        SyncState.Syncing => "sync-state--syncing",
        SyncState.Synced => "sync-state--ok",
        _ => "sync-state--idle"
    };

    private static string GetStateIcon(SyncState state) => state switch
    {
        SyncState.Paused => Icons.Material.Filled.PauseCircle,
        SyncState.Offline => Icons.Material.Filled.CloudOff,
        SyncState.Error => Icons.Material.Filled.SyncProblem,
        SyncState.Syncing => Icons.Material.Filled.CloudSync,
        SyncState.Synced => Icons.Material.Filled.CloudDone,
        _ => Icons.Material.Filled.CloudQueue
    };

    private string GetSyncStatusTooltip()
    {
        if (BoardSync.IsPaused)
            return "Automatic sync is off. Changes stay on this device until you choose Sync now.";
        if (BoardSync.IsOffline)
            return "Working offline. The app saves changes on this device and syncs when you reconnect.";
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
            return $"Sync issue: {BoardSync.SyncProblemMessage}.";
        if (BoardSync.IsSyncing)
            return "Syncing...";
        return "Up to date.";
    }

    private string GetSyncStatusText()
    {
        if (BoardSync.IsPaused)
            return "Paused";
        if (BoardSync.IsOffline)
            return "Offline";
        if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
            return "Sync issue";
        if (BoardSync.IsSyncing)
            return "Syncing";
        return "Up to date";
    }

    private bool CanRetry(SyncState state) =>
        !BoardSync.IsSyncing && state is SyncState.Offline or SyncState.Paused or SyncState.Error;

    private static string GetRetryLabel(SyncState state) =>
        state is SyncState.Paused ? "Sync now" : "Retry now";

    private async Task RetryNow()
    {
        try
        {
            if (BoardSync.IsPaused)
            {
                // Paused mode ignores RequestSync. SyncNow runs once while paused.
                await SyncRequestor.SyncNowAsync();
                return;
            }

            SyncRequestor.RequestSync();
        }
        catch
        {
            // Keep best effort. The indicator still shows the state.
        }
    }
}
