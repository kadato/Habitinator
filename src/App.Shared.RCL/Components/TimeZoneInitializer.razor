@implements IAsyncDisposable
@inject IUserDayService UserDay
@inject IUserTimeZoneService TimeZoneService
@inject IUserPreferencesService PreferencesService

@code {
    private readonly CancellationTokenSource _watchCts = new();
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
        {
            return;
        }

        _initialized = true;
        await UserDay.InitializeAsync();
        await SyncTimeZoneToPreferencesAsync();
        _ = WatchDayChangesAsync(_watchCts.Token);
    }

    /// <summary>
    ///     Persists the detected timezone so the server can compute streaks, retro checks, and
    ///     statistics in the user's local days instead of UTC.
    /// </summary>
    private async Task SyncTimeZoneToPreferencesAsync()
    {
        try
        {
            var detected = TimeZoneService.TimeZoneId;
            if (string.IsNullOrWhiteSpace(detected))
            {
                return;
            }

            var prefs = await PreferencesService.GetAsync();
            if (string.Equals(prefs.TimeZoneOverrideId, detected, StringComparison.Ordinal))
            {
                return;
            }

            prefs.TimeZoneOverrideId = detected;
            await PreferencesService.SaveAsync(prefs);
        }
        catch (Exception)
        {
            // Best-effort sync. The server falls back to UTC until the timezone is known.
        }
    }

    /// <summary>
    ///     Browsers throttle timers in hidden tabs, so this check runs on a timer instead of
    ///     at the exact rollover. Any component that reads <see cref="IUserDayService.Today" />
    ///     between ticks still sees the correct day.
    /// </summary>
    private async Task WatchDayChangesAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                UserDay.CheckForDayChange();
            }
        }
        catch (OperationCanceledException)
        {
            // Shutdown is expected.
        }
    }

    public ValueTask DisposeAsync()
    {
        _watchCts.Cancel();
        _watchCts.Dispose();
        return ValueTask.CompletedTask;
    }
}
