@inject GlobalTimerService TimerService
@inject IBoardDataService BoardDataService
@inject ITimerSessionLogService TimerSessionLog
@inject IDialogService DialogService
@inject IDailyRetroPromptStore DailyRetroStore
@inject IRemoteBoardRefreshService RemoteBoardRefresh
@inject BoardRemoteNotifyBridge BoardNotifyBridge
@inject IBoardSyncStatus BoardSync
@inject IJSRuntime JS
@inject IUserTimeZoneService TimeZoneService
@inject IUserPreferencesService PreferencesService
@inject IUserDateFormatService DateFormatService
@inject IUndoService UndoService

<MudStack Class="board-shell w-100" Spacing="2">
    @if (_isLoading && _initialLoadComplete)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  ShowCloseIcon="false">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">@_loadError</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           OnClick="RetryLoadAsync">
                    Retry
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (BoardSync.IsOffline || BoardSync.IsSyncing || !string.IsNullOrEmpty(BoardSync.SyncProblemMessage) ||
         BoardSync.LastSyncedUtc is not null)
    {
        <MudStack Spacing="1">
            @if (BoardSync.IsOffline)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="ma-0">
                    You appear to be offline. Changes stay on this device and sync when you reconnect.
                </MudAlert>
            }
            @if (BoardSync.IsSyncing && !BoardSync.IsOffline)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="ma-0"
                          Icon="@Icons.Material.Filled.CloudSync">
                    Syncing with the server…
                </MudAlert>
            }
            @if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="ma-0">
                    @BoardSync.SyncProblemMessage
                </MudAlert>
            }
            @if (BoardSync.LastSyncedUtc is { } syncedAt && !BoardSync.IsOffline && !_isLoading)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Last synced @DateFormatService.Format(syncedAt.LocalDateTime)
                </MudText>
            }
        </MudStack>
    }

    <GlobalTimerPanel OnLogSaved="HandleTimerLogSavedAsync"
                      Habits="Habits"
                      Dailies="Dailies"
                      Todos="Todos"/>

    @if (_initialLoadComplete && _loadError is null)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="board-stat-chips flex-wrap">
                    <MudChip T="string"
                             Icon="@BoardSectionVisuals.GetMudIcon(BoardSection.Habit)"
                             Text="@($"{FilteredHabits.Count} habits")"
                             Size="Size.Small"
                             Variant="Variant.Text"
                             Color="Color.Success"/>
                    <MudChip T="string"
                             Icon="@BoardSectionVisuals.GetMudIcon(BoardSection.Daily)"
                             Text="@($"{DailiesDueOpenCount} dailies left")"
                             Size="Size.Small"
                             Variant="Variant.Text"
                             Color="Color.Primary"/>
                    <MudChip T="string"
                             Icon="@BoardSectionVisuals.GetMudIcon(BoardSection.Todo)"
                             Text="@($"{FilteredTodos.Count(t => !t.IsCompleted)} to-dos open")"
                             Size="Size.Small"
                             Variant="Variant.Text"
                             Color="Color.Warning"/>

                </MudStack>
                <div class="board-stat-filters">
                    <MudTextField @bind-Value="_searchText"
                                  Placeholder="Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="board-search-field board-search-pill"
                                  InputType="InputType.Text"
                                  Immediate="true"/>
                    <div class="board-tags-menu-activator">
                        <MudMenu AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"
                                 PopoverFixed="true"
                                 MaxHeight="500"
                                 RelativeWidth="DropdownWidth.Ignore"
                                 PopoverClass="board-tags-menu-popover">
                            <ActivatorContent Context="tagMenu">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Class="board-tags-trigger board-tags-trigger--strip"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Tune"
                                           EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                           OnClick="@(e => tagMenu.ToggleAsync(e))">
                                    @(SelectedFilterTagCount > 0 ? $"Tags ({SelectedFilterTagCount})" : "Tags")
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudPaper Class="board-tags-menu-panel pa-3" Elevation="0">
                                    <MudText Typo="Typo.subtitle1" Class="mb-1">Tags</MudText>
                                    @if (AllTagNamesForMenu.Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No tags on the board yet. Add tags in an item&rsquo;s details.</MudText>
                                    }
                                    else
                                    {
                                        <div class="board-tag-filter-grid board-tags-menu-body">
                                            @foreach (var tag in AllTagNamesForMenu)
                                            {
                                                <MudCheckBox Value="IsFilterTagSelected(tag)"
                                                             ValueChanged="@((bool b) => OnFilterTagChanged(tag, b))"
                                                             Label="@tag"
                                                             Color="Color.Primary"
                                                             Dense="true"
                                                             Class="ma-0"/>
                                            }
                                        </div>
                                    }
                                    <MudStack Row="true" Spacing="1" Justify="Justify.SpaceBetween" Class="mt-2 pt-2" Style="border-top: 1px solid var(--mud-palette-divider);">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="ClearBoardFilters"
                                                   Disabled="@(string.IsNullOrWhiteSpace(_searchText) && SelectedFilterTagCount == 0)">
                                            Clear all filters
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            </ChildContent>
                        </MudMenu>
                    </div>
                </div>
            </div>
        </MudPaper>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="board-stat-chips flex-wrap">
                    <MudSkeleton Width="80px" Height="28px" Class="rounded-pill" />
                    <MudSkeleton Width="100px" Height="28px" Class="rounded-pill" />
                    <MudSkeleton Width="90px" Height="28px" Class="rounded-pill" />
                </MudStack>
                <div class="board-stat-filters d-flex gap-2">
                    <MudSkeleton Width="160px" Height="32px" Class="rounded-pill" />
                    <MudSkeleton Width="80px" Height="32px" Class="rounded-pill" />
                </div>
            </div>
        </MudPaper>
    }

    @if (_initialLoadComplete && _loadError is null)
    {
        <div class="board-columns-stage">
            <div class="board-columns-mobile">
                <MudTabs @bind-ActivePanelIndex="_mobileSectionIndex"
                         Class="board-section-tabs"
                         Centered="true"
                         ApplyEffectsToContainer="true"
                         Rounded="true"
                         Color="Color.Primary"
                         Elevation="0"
                         Outlined="false">
                    <MudTabPanel Text="@($"Habits ({FilteredHabits.Count})")">
                        <HabiticaColumn Section="BoardSection.Habit"
                                        Items="FilteredHabits"
                                        IsBoardFilterExcludingAll="Habits.Count > 0 && FilteredHabits.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Dailies ({DailiesDueOpenCount})")">
                        <HabiticaColumn Section="BoardSection.Daily"
                                        Items="FilteredDailies"
                                        IsBoardFilterExcludingAll="Dailies.Count > 0 && FilteredDailies.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                    <MudTabPanel Text="@($"To-dos ({OpenTodoCount})")">
                        <HabiticaColumn Section="BoardSection.Todo"
                                        Items="FilteredTodos"
                                        IsBoardFilterExcludingAll="Todos.Count > 0 && FilteredTodos.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudTabPanel>
                </MudTabs>
            </div>
            <div class="board-columns-desktop">
                <MudGrid Spacing="4" Class="board-columns-grid mt-0 w-100">
                    <MudItem xs="12" md="4">
                        <HabiticaColumn Section="BoardSection.Habit"
                                        Items="FilteredHabits"
                                        IsBoardFilterExcludingAll="Habits.Count > 0 && FilteredHabits.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <HabiticaColumn Section="BoardSection.Daily"
                                        Items="FilteredDailies"
                                        IsBoardFilterExcludingAll="Dailies.Count > 0 && FilteredDailies.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <HabiticaColumn Section="BoardSection.Todo"
                                        Items="FilteredTodos"
                                        IsBoardFilterExcludingAll="Todos.Count > 0 && FilteredTodos.Count == 0"
                                        OnChanged="OnBoardChanged"/>
                    </MudItem>
                </MudGrid>
            </div>
        </div>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <div class="board-columns-stage">
            <div class="board-columns-mobile">
                <MudTabs Centered="true" Rounded="true" Color="Color.Primary" Elevation="0" Outlined="false">
                    <MudTabPanel Text="Habits">
                        @RenderColumnSkeleton(BoardSection.Habit)
                    </MudTabPanel>
                    <MudTabPanel Text="Dailies">
                        @RenderColumnSkeleton(BoardSection.Daily)
                    </MudTabPanel>
                    <MudTabPanel Text="To Do's">
                        @RenderColumnSkeleton(BoardSection.Todo)
                    </MudTabPanel>
                </MudTabs>
            </div>
            <div class="board-columns-desktop">
                <MudGrid Spacing="4" Class="board-columns-grid mt-0 w-100">
                    <MudItem xs="12" md="4">
                        @RenderColumnSkeleton(BoardSection.Habit)
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @RenderColumnSkeleton(BoardSection.Daily)
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @RenderColumnSkeleton(BoardSection.Todo)
                    </MudItem>
                </MudGrid>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(LastEvent))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@LastEvent</MudAlert>
    }
</MudStack>

@using App.Shared.RCL.Components.Dialogs
@using Microsoft.JSInterop
@implements IAsyncDisposable

@code {
    private RenderFragment<BoardSection> RenderColumnSkeleton => section => __builder =>
    {
        var accentClass = section switch
        {
            BoardSection.Habit => "habitica-column--habit",
            BoardSection.Daily => "habitica-column--daily",
            BoardSection.Todo => "habitica-column--todo",
            _ => string.Empty
        };
        var title = section switch
        {
            BoardSection.Habit => "Habits",
            BoardSection.Daily => "Dailies",
            BoardSection.Todo => "To Do's",
            _ => "Board"
        };
        var isHabit = section == BoardSection.Habit;

        <MudCard Class="@($"habitica-column {accentClass}")" Elevation="0" Outlined="false">
            <MudCardHeader Class="pb-2">
                <CardHeaderContent>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@BoardSectionVisuals.GetMudIcon(section)"
                                         Class="habitica-col-type-icon"
                                         Size="Size.Small"
                                         Color="Color.Primary"/>
                                <MudText Typo="Typo.subtitle1" Class="habitica-title">@title</MudText>
                            </MudStack>
                            <MudSkeleton Width="28px" Height="20px" Class="rounded-pill" />
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Class="flex-wrap habitica-filter-toolbar">
                            @if (section == BoardSection.Habit)
                            {
                                <MudSkeleton Width="40px" Height="26px" />
                                <MudSkeleton Width="45px" Height="26px" />
                                <MudSkeleton Width="50px" Height="26px" />
                            }
                            else if (section == BoardSection.Daily)
                            {
                                <MudSkeleton Width="40px" Height="26px" />
                                <MudSkeleton Width="40px" Height="26px" />
                                <MudSkeleton Width="60px" Height="26px" />
                            }
                            else
                            {
                                <MudSkeleton Width="50px" Height="26px" />
                                <MudSkeleton Width="65px" Height="26px" />
                            }
                        </MudStack>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent Class="pt-0">
                <div class="habitica-add-wrap mb-3">
                    <MudSkeleton Width="100%" Height="40px" />
                </div>

                <div class="habitica-list">
                    @for (int cardIdx = 0; cardIdx < 3; cardIdx++)
                    {
                        var rowClass = section switch
                        {
                            BoardSection.Habit => "habitica-row--habit",
                            BoardSection.Daily => "habitica-row--daily-open",
                            BoardSection.Todo => "habitica-row--todo-open",
                            _ => string.Empty
                        };
                        <div class="@($"habitica-card {rowClass} pa-3 mb-2 d-flex align-center gap-3")" style="min-height: 64px;">
                            <div class="habitica-card__left d-flex gap-1 align-center">
                                <MudSkeleton Width="28px" Height="28px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />
                                @if (isHabit)
                                {
                                    <MudSkeleton Width="28px" Height="28px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />
                                }
                            </div>
                            <div class="flex-grow-1">
                                <MudSkeleton Width="60%" Height="18px" Class="mb-1" />
                                <MudSkeleton Width="40%" Height="12px" />
                            </div>
                        </div>
                    }
                </div>
            </MudCardContent>

            <MudCardActions Class="habitica-col-foot px-4 pb-3 pt-0">
                <MudSkeleton Width="100%" Height="16px" />
            </MudCardActions>
        </MudCard>
    };

    [Parameter] public string? SignedInEmail { get; set; }

    private List<BoardItem> Habits { get; set; } = [];
    private List<BoardItem> Dailies { get; set; } = [];
    private List<BoardItem> Todos { get; set; } = [];
    private string? LastEvent { get; set; }
    private bool _isLoading;
    private bool _initialLoadComplete;
    private string? _loadError;
    private string _searchText = string.Empty;
    private readonly HashSet<string> _selectedFilterTags = new(StringComparer.OrdinalIgnoreCase);
    private bool _dailyRetroSessionOffered;
    private bool _dailyRetroClientReady;
    private DotNetObjectReference<BoardRemoteNotifyBridge>? _visibilityRef;
    private DotNetObjectReference<MainBoard>? _selfRef;

    private IReadOnlyList<BoardItem> FilteredHabits => FilterItems(Habits);
    private IReadOnlyList<BoardItem> FilteredDailies => FilterItems(Dailies);

    private int DailiesDueOpenCount =>
        FilterItems(Dailies).Count(d => DailySchedule.IsDueOnDate(d, DailySchedule.LocalToday(TimeZoneService)));

    private IReadOnlyList<BoardItem> FilteredTodos => FilterItems(Todos);

    private int OpenTodoCount => FilteredTodos.Count(t => !t.IsCompleted);

    private int _mobileSectionIndex;

    private IReadOnlyList<string> AllTagNamesForMenu
    {
        get
        {
            var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var item in Habits)
            {
                foreach (var t in BoardTagUtil.ParseTags(item.Tags))
                {
                    set.Add(t);
                }
            }

            foreach (var item in Dailies)
            {
                foreach (var t in BoardTagUtil.ParseTags(item.Tags))
                {
                    set.Add(t);
                }
            }

            foreach (var item in Todos)
            {
                foreach (var t in BoardTagUtil.ParseTags(item.Tags))
                {
                    set.Add(t);
                }
            }

            return set.OrderBy(t => t, StringComparer.OrdinalIgnoreCase).ToList();
        }
    }

    private int SelectedFilterTagCount => _selectedFilterTags.Count;

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        BoardSync.Changed += OnBoardSyncStatusChanged;
        RemoteBoardRefresh.RegisterForRemoteRefresh(HandleRemoteBoardRefreshedAsync);
        UndoService.OnStateChanged += HandleUndoStateChanged;
        UndoService.OnUndoPerformed += HandleUndoPerformed;
        await InitialLoadAsync();
    }

    private void OnBoardSyncStatusChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    ///     Marshals server-pushed refreshes onto the Blazor dispatcher (SignalR/JS callbacks are not on the renderer sync
    ///     context).
    /// </summary>
    private Task HandleRemoteBoardRefreshedAsync()
    {
        return InvokeAsync(OnRemoteBoardRefreshedAsync);
    }

    private async Task OnRemoteBoardRefreshedAsync()
    {
        try
        {
            await LoadBoardAsync();
        }
        catch
        {
            // keep existing UI; user can use Retry
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        BoardSync.Changed -= OnBoardSyncStatusChanged;
        RemoteBoardRefresh.UnregisterForRemoteRefresh(HandleRemoteBoardRefreshedAsync);
        UndoService.OnStateChanged -= HandleUndoStateChanged;
        UndoService.OnUndoPerformed -= HandleUndoPerformed;
        try
        {
            await JS.InvokeVoidAsync("HabitinatorBoardVisibility.stop");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }

        try
        {
            await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.stop");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }

        _visibilityRef?.Dispose();
        _visibilityRef = null;
        _selfRef?.Dispose();
        _selfRef = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dailyRetroClientReady = true;
            try
            {
                _visibilityRef = DotNetObjectReference.Create(BoardNotifyBridge);
                await JS.InvokeVoidAsync("HabitinatorBoardVisibility.start", _visibilityRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            try
            {
                _selfRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("HabitinatorKeyboardShortcuts.start", _selfRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        if (_initialLoadComplete && _loadError is null)
        {
            await TryOpenDailyYesterdayRetroIfNeededAsync();
        }
    }

    private async Task OnBoardChanged()
    {
        await LoadBoardAsync();
    }

    private async Task InitialLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
            _initialLoadComplete = true;
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }

        if (_loadError is null)
        {
            if (_dailyRetroClientReady)
            {
                await TryOpenDailyYesterdayRetroIfNeededAsync();
            }
        }
    }

    private async Task LoadBoardAsync()
    {
        var snapshot = await BoardDataService.GetSnapshotAsync();
        Habits = snapshot.Habits.ToList();
        Dailies = snapshot.Dailies.ToList();
        Todos = snapshot.Todos.ToList();
        PruneStaleFilterTags();
    }

    private IReadOnlyList<BoardItem> FilterItems(IReadOnlyList<BoardItem> source)
    {
        return source.Where(MatchesGlobalFilters).ToList();
    }

    private bool MatchesGlobalFilters(BoardItem item)
    {
        return MatchesTagFilter(item) && MatchesSearchQuery(item);
    }

    private bool MatchesTagFilter(BoardItem item)
    {
        if (_selectedFilterTags.Count == 0)
        {
            return true;
        }

        var onItem = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var t in BoardTagUtil.ParseTags(item.Tags))
        {
            onItem.Add(t);
        }

        return _selectedFilterTags.Any(f => onItem.Contains(f));
    }

    private bool MatchesSearchQuery(BoardItem item)
    {
        var q = _searchText.Trim();
        if (q.Length == 0)
        {
            return true;
        }

        if (item.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (item.Notes is not null && item.Notes.Contains(q, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        foreach (var line in DailyChecklistJson.Parse(item.ChecklistJson))
        {
            if (line.Text.Contains(q, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private bool IsFilterTagSelected(string tag)
    {
        return _selectedFilterTags.Contains(tag);
    }

    private void OnFilterTagChanged(string tag, bool isChecked)
    {
        if (isChecked)
        {
            _selectedFilterTags.Add(tag);
        }
        else
        {
            _ = _selectedFilterTags.Remove(tag);
        }
    }

    private void PruneStaleFilterTags()
    {
        if (_selectedFilterTags.Count == 0)
        {
            return;
        }

        var available = new HashSet<string>(AllTagNamesForMenu, StringComparer.OrdinalIgnoreCase);
        _selectedFilterTags.RemoveWhere(f => !available.Contains(f));
    }

    private void ClearBoardFilters()
    {
        _searchText = string.Empty;
        _selectedFilterTags.Clear();
    }

    private async Task HandleTimerLogSavedAsync(TimeSpan duration)
    {
        var result = await TimerSessionLog.LogStoppedSessionAsync(duration);
        LastEvent = result.UserMessage;
        await LoadBoardAsync();
    }

    private static string EmailLocalPart(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return string.Empty;
        }

        var at = email.IndexOf('@');
        return at > 0 ? email[..at] : email;
    }

    private async Task TryOpenDailyYesterdayRetroIfNeededAsync()
    {
        if (_dailyRetroSessionOffered)
        {
            return;
        }

        _dailyRetroSessionOffered = true;
        try
        {
            var prefs = await PreferencesService.GetAsync();
            var today = DailySchedule.LocalToday(TimeZoneService, prefs.DayStartLocalTime);
            DateOnly? lastResolved = await DailyRetroStore.GetLastPromptResolvedLocalDateAsync();

            if (lastResolved == today)
            {
                return;
            }

            var missed = DailySchedule.GetYesterdayUncompletedDailies(Dailies, today);
            if (missed.Count == 0)
            {
                return;
            }

            var y = today.AddDays(-1);
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = false,
                CloseButton = false,
                CloseOnEscapeKey = true,
                NoHeader = true
            };
            var parameters = new DialogParameters<DailyYesterdayRetroDialog>
            {
                { x => x.DueOn, y },
                { x => x.Items, missed }
            };

            var dialog = await DialogService.ShowAsync<DailyYesterdayRetroDialog>(
                string.Empty, parameters, options);
            _ = await dialog.Result;
        }
        catch (Exception)
        {
            _dailyRetroSessionOffered = false;
            return;
        }

        try
        {
            await DailyRetroStore.SetPromptResolvedForTodayAsync();
        }
        catch (Exception)
        {
        }

        try
        {
            await LoadBoardAsync();
        }
        catch (Exception)
        {
        }
    }

    private void HandleUndoStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleUndoPerformed()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadBoardAsync();
            StateHasChanged();
        });
    }

    private async Task HandleUndoAsync()
    {
        await UndoService.UndoAsync();
    }

    [JSInvokable]
    public async Task OnCtrlZPressed()
    {
        if (UndoService.CanUndo)
        {
            await HandleUndoAsync();
        }
    }
}