@inherits LayoutComponentBase
@using global::App.Shared.RCL.Themes
@using global::App.Shared.RCL.Models
@using global::App.Shared.RCL.Services
@implements IDisposable
@inject IApiSession Session
@inject IUserPreferencesService PreferencesService
@inject NavigationManager Nav

<MudThemeProvider @ref="_mudThemeProvider" Theme="@HabitinatorMudTheme.Default" @bind-IsDarkMode="@_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="false"/>
<MudSnackbarProvider/>
<TimeZoneInitializer />

<MudLayout>
    @if (Session.IsLoggedIn)
    {
        <MudAppBar Elevation="0" Dense="true" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar">
            <div class="app-top-bar__row d-flex">
                <div class="app-top-bar__left d-flex flex-wrap align-center">
                    <MudText Typo="Typo.h6" Class="app-top-bar__title">Habitinator</MudText>
                    <NavMenu/>
                </div>
                <div class="app-top-bar__flex-spacer" aria-hidden="true"></div>
                <div class="app-top-bar__right d-flex flex-wrap align-center">
                    <div class="app-header-user-rail d-flex flex-wrap align-center">
                        <MudChip T="string"
                                 Icon="@Icons.Material.Filled.AccountCircle"
                                 Color="Color.Primary"
                                 Variant="Variant.Filled"
                                 Size="Size.Small"
                                 Class="app-header-username-chip text-truncate"
                                 title="@GetFullIdentity()">
                            @GetDisplayName()
                        </MudChip>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Logout"
                                   Class="app-header-logout-btn"
                                   OnClick="LogoutAsync">
                            Log out
                        </MudButton>
                    </div>
                </div>
            </div>
        </MudAppBar>
    }
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-3 px-4 px-sm-5 board-main-container">
            @if (!_sessionInitialized)
            {
                <MudProgressLinear Indeterminate="true"/>
            }
            else
            {
                @Body
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

@if (Session.IsLoggedIn)
{
    <GlobalTimerFocusAlertHost/>
}

@code {
    private static bool IsAuthPath(string path) =>
        path.Equals("/auth/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/auth/register", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
        path.Equals("/register", StringComparison.OrdinalIgnoreCase);

    private static bool IsHomePath(string path) => string.IsNullOrEmpty(path);

    private static bool IsPublicWhenLoggedOut(string path) => IsAuthPath(path) || IsHomePath(path);

    private bool _sessionInitialized;
    private UserPreferences? _preferences;
    private bool _isDarkMode = true;
    private MudThemeProvider? _mudThemeProvider;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        PreferencesService.Changed += OnPreferencesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider != null)
        {
            await ResolveThemeAsync();
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);
        }
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        PreferencesService.Changed -= OnPreferencesChanged;
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(OnSessionChangedAsync);
    }

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadPreferencesAsync();
        });
    }

    private async Task OnSessionChangedAsync()
    {
        if (_sessionInitialized && !Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }

        if (Session.IsLoggedIn)
        {
            await LoadPreferencesAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadPreferencesAsync()
    {
        _preferences = await PreferencesService.GetAsync();
        await ResolveThemeAsync();
    }

    private async Task ResolveThemeAsync()
    {
        if (_preferences is null) return;

        if (_preferences.Theme == AppTheme.Light)
        {
            _isDarkMode = false;
        }
        else if (_preferences.Theme == AppTheme.Dark)
        {
            _isDarkMode = true;
        }
        else // System
        {
            if (_mudThemeProvider != null)
            {
                _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSystemPreferenceChanged(bool isDarkMode)
    {
        if (_preferences?.Theme == AppTheme.System)
        {
            _isDarkMode = isDarkMode;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private string GetFullIdentity()
    {
        var email = Session.Email ?? "User";
        var displayName = _preferences?.DisplayName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return email;
        }

        return $"{displayName} ({email})";
    }

    private string GetDisplayName()
    {
        var displayName = _preferences?.DisplayName;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        var full = GetFullIdentity();
        var at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }

    private async Task LogoutAsync()
    {
        await Session.ClearSessionAsync();
        Nav.NavigateTo("/", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (!Session.IsLoggedIn)
        {
            var path = new Uri(Nav.Uri).LocalPath.TrimEnd('/');
            if (!IsPublicWhenLoggedOut(path))
            {
                Nav.NavigateTo("/auth/login", replace: true);
            }
        }
        else
        {
            await LoadPreferencesAsync();
        }

        _sessionInitialized = true;
        await InvokeAsync(StateHasChanged);
    }

}