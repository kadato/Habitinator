@page "/auth/login"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Sign in")"
          Description="Sign in to your Habitinator account or continue as demo guest."
          CanonicalPath="/auth/login"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Sign in"
               Subtitle="Use your email and password, or try the demo guest."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-info" role="alert">@_message</div>
        }

        <form method="post" action="/api/auth/cookie-login">
            <LoginFormFields/>
            <div class="auth-form-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large">
                    Sign in
                </MudButton>
            </div>
        </form>

        <div class="auth-form-divider" role="presentation">or</div>

        <form method="post" action="/api/auth/guest-login">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       FullWidth="true"
                       Size="Size.Large">
                Continue as demo guest
            </MudButton>
        </form>
    </ChildContent>
    <Footer>
        <span>New here?</span>
        <a href="/auth/register" data-enhance-nav="false">Create account</a>
    </Footer>
</AuthPageShell>

@code {
    private string? _message;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Invalid email or password.";
        }
        else if (q.ContainsKey("guest") && q["guest"] == "missing")
        {
            _message = "Demo guest user is not available.";
        }
        else if (q.ContainsKey("registered") && q["registered"] == "1")
        {
            _message = "Registration complete. You can sign in now.";
        }
    }

}
