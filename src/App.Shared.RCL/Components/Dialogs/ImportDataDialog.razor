@inject IUserDataImportService Import
@inject IUserNotifier Notifier
@inject IDialogService DialogService
@inject IBoardSyncStatus BoardSync

<MudDialog Class="hab-modal-dialog"
           ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--neutral" data-dialog-label="Import data" aria-label="Import data" role="group">
            @if (BoardSync.IsOffline)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mx-3 mt-2" role="status">Offline. Restores on reconnect.</MudAlert>
            }
            <div class="hab-modal__header">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="() => MudDialog.Close()" />
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Import data</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Paste a backup. Restore replaces everything.
                </MudText>
            </div>
            <div class="hab-modal__body">
            <MudTextField T="string"
                          @bind-Value="_json"
                          @bind-Value:after="ClearPreview"
                          Variant="Variant.Outlined"
                          Lines="12"
                          Placeholder="Paste backup JSON here"
                          aria-label="Backup JSON to import"
                          Class="export-textarea mb-3"/>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            else if (_preview is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@_preview</MudText>
            }
            </div>
            <div class="hab-modal__footer">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       Size="Size.Medium"
                       OnClick="() => MudDialog.Cancel()">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Size="Size.Medium"
                       Disabled="_validating || string.IsNullOrWhiteSpace(_json)"
                       OnClick="ValidateAsync">
                Validate
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       Class="hab-primary-btn"
                       Disabled="_importing || _parsed is null"
                       OnClick="RestoreAsync">
                Restore
            </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    private string _json = string.Empty;
    private string? _error;
    private string? _preview;
    private UserDataExportDto? _parsed;
    private bool _validating;
    private bool _importing;

    private void ClearPreview()
    {
        _parsed = null;
        _preview = null;
        _error = null;
    }

    private async Task ValidateAsync()
    {
        if (_validating) return;
        var json = _json;
        if (string.IsNullOrEmpty(json) || json.Length > 5_000_000)
        {
            _error = json is { Length: > 5_000_000 } ? "Too large to preview." : "Paste a backup.";
            _parsed = null;
            _preview = null;
            return;
        }
        _validating = true;
        try
        {
            UserDataExportDto? data;
            try
            {
                data = await Task.Run(() => System.Text.Json.JsonSerializer.Deserialize<UserDataExportDto>(json, JsonDefaults.Api));
            }
            catch (System.Text.Json.JsonException)
            {
                _error = "Not valid JSON.";
                _parsed = null;
                _preview = null;
                return;
            }

            if (UserDataImportValidator.Validate(data) is { } problem)
            {
                _error = problem;
                _parsed = null;
                _preview = null;
                return;
            }

            _parsed = data;
            _error = null;
            _preview = Summary(data!);
            return;
        }
        finally
        {
            _validating = false;
        }
    }

    private static string Summary(UserDataExportDto data)
    {
        var prefs = data.Preferences is null ? "no preferences" : "preferences";
        var notif = data.NotificationSettings is null ? "no notification settings" : "notification settings";
        return $"{data.Items.Count} items, {data.Events.Count} activity events, {prefs}, {notif}.";
    }

    private async Task RestoreAsync()
    {
        if (_importing || _parsed is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Restore backup?",
            "Replaces everything. Cannot be undone.",
            "Restore backup",
            null,
            "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _importing = true;
        try
        {
            var result = await Import.ImportAsync(_json);
            await Notifier.NotifyAsync(
                $"Restored {result.Items} items and {result.Events} activity events.",
                Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            await Notifier.NotifyAsync(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }
}
