@implements IDisposable
@inject NavigationManager Nav
@inject IClientSessionProvider Session
@using Microsoft.AspNetCore.Components.Routing

@inject IActivityStatisticsReader StatsReader
@inject IBoardDataService BoardData

@{
    var navClass = MobileTopBar ? "app-mobile-nav" : "app-header-nav d-flex flex-wrap align-center";
}

@if (MobileTopBar)
{
    <nav class="@navClass" role="navigation" aria-label="Main navigation">
        @MobileNavItem("/", "", NavLinkMatch.All, Icons.Material.Filled.SpaceDashboard, "Board")
        @if (Session.IsLoggedIn)
        {
            @MobileNavItem("/stats", "stats", NavLinkMatch.Prefix, Icons.Material.Filled.BarChart, "Stats")
            @MobileNavItem("/settings", "settings", NavLinkMatch.Prefix, Icons.Material.Filled.Settings, "Settings")
        }
    </nav>
}
else
{
    <div class="@navClass">
        @HeaderNavItem("/", "", NavLinkMatch.All, Icons.Material.Filled.SpaceDashboard, "Board")
        @if (Session.IsLoggedIn)
        {
            @HeaderNavItem("/stats", "stats", NavLinkMatch.Prefix, Icons.Material.Filled.BarChart, "Statistics")
            @HeaderNavItem("/settings", "settings", NavLinkMatch.Prefix, Icons.Material.Filled.Settings, "Settings")
        }
    </div>
}

@code {
    [Parameter] public bool MobileTopBar { get; set; }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Session.Changed += OnSessionChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnSessionChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Session.Changed -= OnSessionChanged;
    }

    private bool IsActivePath(string path, NavLinkMatch match)
    {
        return NavMenuPaths.IsActivePath(Nav.ToBaseRelativePath(Nav.Uri), path, match);
    }

    private void Prefetch(string path)
    {
        if (path == "stats")
        {
            _ = StatsReader.GetOverviewAsync(null, null);
        }
        else if (string.IsNullOrEmpty(path))
        {
            _ = BoardData.GetSnapshotAsync();
        }
    }

    private RenderFragment MobileNavItem(string href, string path, NavLinkMatch match, string icon, string label) => __builder =>
    {
        var active = IsActivePath(path, match);
        var itemClass = active ? "app-mobile-nav__item app-mobile-nav__item--active" : "app-mobile-nav__item";
        <a href="@href"
           class="@itemClass"
           aria-current="@(active ? "page" : null)"
           @onpointerenter="() => Prefetch(path)"
           @ontouchstart="() => Prefetch(path)">
            <MudIcon Icon="@icon" Class="app-mobile-nav__icon" />
            <span class="app-mobile-nav__label">@label</span>
        </a>
    };

    private RenderFragment HeaderNavItem(string href, string path, NavLinkMatch match, string icon, string label) => __builder =>
    {
        var active = IsActivePath(path, match);
        var slotClass = active ? "app-header-nav-slot app-header-nav-slot--active" : "app-header-nav-slot";
        <span class="@slotClass"
              @onpointerenter="() => Prefetch(path)"
              @ontouchstart="() => Prefetch(path)">
            <MudButton Href="@href"
                       Variant="@(active ? Variant.Filled : Variant.Text)"
                       Color="@(active ? Color.Primary : Color.Default)"
                       Size="Size.Medium"
                       StartIcon="@icon"
                       Class="app-header-nav-btn text-transform-none"
                       aria-current="@(active ? "page" : null)">
                @label
            </MudButton>
        </span>
    };
}
