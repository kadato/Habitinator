@page "/"

<AuthorizeView>
    <Authorized>
        <PageMeta Title="@PageTitles.Page("Board")"
                  Description="Your habits, dailies, and to-dos board. Sign-in required."
                  CanonicalPath="/"
                  Robots="@SeoDefaults.NoIndexRobots"/>
        <MainBoard/>
    </Authorized>
    <NotAuthorized>
        <PageMeta Title="@SeoDefaults.DefaultTitle"
                  Description="@SeoDefaults.DefaultDescription"
                  CanonicalPath="/"
                  OgImagePath="/og-image.png"
                  Robots="@SeoDefaults.IndexRobots"/>
        <HomeLanding/>
    </NotAuthorized>
</AuthorizeView>
