@page "/auth/register"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Create account")"
          Description="Create a Habitinator account to sync habits, dailies, and to-dos across web and mobile."
          CanonicalPath="/auth/register"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Create account"
               Subtitle="Pick an email and a password with at least 8 characters."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-warning" role="alert">@_message</div>
        }

        <form method="post" action="/api/auth/register-form">
            <RegisterFormFields FormEmail="@_email"/>
            <div class="auth-form-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large">
                    Create account
                </MudButton>
            </div>
        </form>
    </ChildContent>
    <Footer>
        <span>Already have an account?</span>
        <a href="/auth/login" data-enhance-nav="false">Sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string? _message;
    private string _email = string.Empty;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (q.TryGetValue("email", out var email) && !string.IsNullOrWhiteSpace(email))
        {
            _email = email.ToString();
        }

        if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Registration could not be completed. Check the password length, or try another email if this one is already registered.";
        }
    }

}
