@inject IActivityStatisticsReader Stats
@inject IUserTimeZoneService TimeZoneService

<MudDialog Class="activity-day-detail-dialog"
           ContentClass="activity-day-detail-dialog__content">
    <DialogContent>
        @if (_loading)
        {
            <div class="activity-day-detail-summary mb-3">
                <MudSkeleton Width="120px" Height="20px" />
            </div>
            <MudTable Items="new byte[4]"
                      Dense="true"
                      Hover="false"
                      Bordered="false"
                      Striped="true"
                      Elevation="0"
                      Class="activity-day-detail-table">
                <RowTemplate>
                    <MudTd Class="activity-time-cell">
                        <span class="activity-time-text"><MudSkeleton Width="35px" Height="14px" /></span>
                    </MudTd>
                    <MudTd Class="activity-desc-cell">
                        <div class="activity-desc-wrap">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="20px" Height="20px" />
                            <MudSkeleton Width="160px" Height="16px" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else if (_detail is { Events.Count: 0 })
        {
            @if (!string.IsNullOrWhiteSpace(TagFilter))
            {
                <div class="d-flex align-center gap-1 flex-wrap mb-2">
                    @foreach (var t in TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0">@t</MudChip>
                    }
                </div>
            }
            <MudText Color="Color.Secondary">No activity counted for this day.</MudText>
        }
        else if (_detail is not null)
        {
            <div class="activity-day-detail-summary mb-3">
                <MudText Typo="Typo.body2">
                    @FormatActivitySummary(_detail)
                </MudText>
                @if (!string.IsNullOrWhiteSpace(TagFilter))
                {
                    <div class="d-flex align-center gap-1 flex-wrap mt-1">
                        @foreach (var t in TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0">@t</MudChip>
                        }
                    </div>
                }
            </div>
            <MudTable Items="_detail.Events"
                      Dense="true"
                      Hover="false"
                      Bordered="false"
                      Striped="true"
                      Elevation="0"
                      Class="activity-day-detail-table">
                <RowTemplate>
                    <MudTd Class="activity-time-cell">
                        <span class="activity-time-text">@FormatLocalTime(context.OccurredAtUtc)</span>
                    </MudTd>
                    <MudTd Class="activity-desc-cell">
                        <div class="activity-desc-wrap">
                            <MudIcon Icon="@GetEventIcon(context.EventType)"
                                     Color="@GetEventColor(context.EventType)"
                                     Size="Size.Medium"
                                     Class="activity-detail-icon" />
                            <span class="activity-text">
                                @GetEventTitle(context)@FormatTimerSuffix(context)
                            </span>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] [EditorRequired] public DateOnly Date { get; set; }

    [Parameter] public string? TagFilter { get; set; }

    private ActivityDayDetailDto? _detail;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var tag = string.IsNullOrWhiteSpace(TagFilter) ? null : TagFilter;
            _detail = await Stats.GetActivityDayDetailAsync(Date, tag);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close()
    {
        MudDialog?.Cancel();
    }

    private static string FormatActivitySummary(ActivityDayDetailDto detail)
    {
        var count = detail.Events.Count;
        var label = count == 1 ? "activity" : "activities";
        var summary = $"{count} {label}";
        if (detail.FocusMinutesTotal > 0)
            summary += $" · {detail.FocusMinutesTotal} min focus";
        return summary;
    }

    private string FormatLocalTime(DateTimeOffset utcTime)
    {
        var localTime = TimeZoneService.ConvertToLocal(utcTime);
        return localTime.ToString("HH:mm");
    }

    private static string FormatTimerSuffix(ActivityDayEventDto e)
    {
        if (e.EventType != ActivityEventType.TimerSession || e.DurationSeconds is not int s || s <= 0)
        {
            return string.Empty;
        }

        var m = (s + 30) / 60;
        return m < 1 ? " (< 1 min)" : $" ({m} min)";
    }

    private static string GetEventIcon(ActivityEventType eventType) =>
        eventType switch
        {
            ActivityEventType.DailyComplete => Icons.Material.Filled.CheckCircle,
            ActivityEventType.TodoComplete => Icons.Material.Filled.CheckBox,
            ActivityEventType.HabitPlus => Icons.Material.Filled.AddCircle,
            ActivityEventType.HabitMinus => Icons.Material.Filled.RemoveCircle,
            ActivityEventType.TimerSession => Icons.Material.Filled.Timer,
            _ => Icons.Material.Filled.Label
        };

    private static Color GetEventColor(ActivityEventType eventType) =>
        eventType switch
        {
            ActivityEventType.DailyComplete => Color.Success,
            ActivityEventType.TodoComplete => Color.Success,
            ActivityEventType.HabitPlus => Color.Primary,
            ActivityEventType.HabitMinus => Color.Warning,
            ActivityEventType.TimerSession => Color.Info,
            _ => Color.Default
        };

    private static string GetEventTitle(ActivityDayEventDto e)
    {
        var name = e.BoardItemTitle ?? e.CustomLabel;
        if (!string.IsNullOrWhiteSpace(name))
        {
            return name;
        }

        return e.EventType switch
        {
            ActivityEventType.DailyComplete => "Daily task completed",
            ActivityEventType.TodoComplete => "To-do completed",
            ActivityEventType.HabitPlus => "Habit incremented (+)",
            ActivityEventType.HabitMinus => "Habit decremented (−)",
            ActivityEventType.TimerSession => "Focus session completed",
            _ => e.EventType.ToString()
        };
    }

}
