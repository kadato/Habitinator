@using System.Globalization
@using App.Shared.RCL
@inject IUserPreferencesService PreferencesService
@inject IUserNotifier Notifier
@inject IUserTimeZoneService TimeZoneService

<MudStack Spacing="3">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5">Profile and preferences</MudText>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
    }
    else if (_loading)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="120px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="250px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="150px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="160px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="350px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="180px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="80px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="280px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Account</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    How your name and dates are shown across the app.
                </MudText>
                <MudTextField T="string" Label="Display name"
                              Variant="Variant.Outlined"
                              dense="true"
                              MaxLength="40"
                              Immediate="true"
                              Error="@(_displayNameError is not null)"
                              ErrorText="@_displayNameError"
                              Value="_displayName"
                              ValueChanged="OnDisplayNameChanged"
                              OnBlur="AutoSaveAsync"/>
                <MudTextField T="string"
                              Label="Date format"
                              Variant="Variant.Outlined"
                              dense="true"
                              Value="_model.DateFormat"
                              ValueChanged="OnDateFormatChanged"
                              Immediate="true"
                              Error="@(_dateFormatError is not null)"
                              ErrorText="@_dateFormatError"
                              OnBlur="AutoSaveAsync"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Preview: @_datePreview
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Pomodoro Timer</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Customize focus and break durations for the Pomodoro timer.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Work duration (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="180"
                                         Value="_model.PomodoroWorkDurationMinutes"
                                         ValueChanged="OnWorkDurationChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Short break (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="60"
                                         Value="_model.PomodoroShortBreakMinutes"
                                         ValueChanged="OnShortBreakChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Long break (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="120"
                                         Value="_model.PomodoroLongBreakMinutes"
                                         ValueChanged="OnLongBreakChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Sessions before long break"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="12"
                                         Value="_model.PomodoroCyclesBeforeLongBreak"
                                         ValueChanged="OnCyclesChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Day start and timezone</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Set when your day starts and override the detected timezone if you travel or prefer a fixed zone.
                </MudText>
                <MudTimePicker Label="Day starts at"
                               Time="_dayStart"
                               TimeChanged="OnDayStartChanged"
                               TimeEditMode="TimeEditMode.Normal"/>
                @if (_dayStartError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_dayStartError</MudText>
                }
                <MudSelect T="string" Label="Timezone" Variant="Variant.Outlined" dense="true"
                           Value="_timeZoneSelection" ValueChanged="OnTimeZoneChanged">
                    <MudSelectItem Value="@AutoTimeZoneValue">Auto (@_detectedTimeZoneLabel)</MudSelectItem>
                    @foreach (var tz in _timeZones)
                    {
                        <MudSelectItem Value="@tz.Id">@tz.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Current: @_resolvedTimeZoneLabel
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Theme</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Sync with your system theme or pin a specific mode.
                </MudText>
                <div class="d-flex flex-row align-center flex-wrap gap-2">
                    <MudSwitch T="bool"
                               Value="_useSystemTheme"
                               ValueChanged="OnUseSystemThemeChanged"
                               Color="Color.Primary"
                               Label="Sync with system" />
                    <MudButton Variant="@(_pinnedThemeBtnVariant)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="text-transform-none"
                               Disabled="@_useSystemTheme"
                               OnClick="TogglePinnedTheme">
                        @_pinnedThemeBtnLabel
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_themeStatusText
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Keyboard Shortcuts</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Enable keyboard shortcuts to move through and control the app quickly.
                </MudText>
                <MudSwitch T="bool" Label="Enable keyboard shortcuts" Color="Color.Primary"
                           Value="_model.EnableKeyboardShortcuts" ValueChanged="OnEnableKeyboardShortcutsChanged" />
            </MudStack>
        </MudPaper>

        @* Settings are saved automatically on change or blur *@
    }
</MudStack>
