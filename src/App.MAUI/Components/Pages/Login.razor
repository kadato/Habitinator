@page "/auth/login"
@page "/login"
@using global::App.Shared.RCL.Models
@using Microsoft.AspNetCore.WebUtilities
@inject ApiAuthService Auth
@inject IApiSession Session
@inject NavigationManager Nav

@* Inlined like Register — WebView + child components can break password/email binding. *@

<PageTitle>Login</PageTitle>

<AuthPageShell Title="Sign in"
               Subtitle="Use your email and password, or try the demo guest."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-info" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" type="email" autocomplete="email"
                   value="@_email" @oninput="OnEmailInput" disabled="@_busy"/>
        </div>
        <div class="mb-3">
            <label for="password">Password</label>
            <input class="form-control" id="password" type="password" autocomplete="current-password"
                   value="@_password" @oninput="OnPasswordInput" disabled="@_busy"/>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" id="remember" type="checkbox" @bind="_rememberMe" disabled="@_busy"/>
            <label class="form-check-label" for="remember">Remember me</label>
        </div>
        <div class="auth-form-actions">
            <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="LoginAsync">Sign in</button>
        </div>

        <div class="auth-form-divider" role="presentation">or</div>

        <button class="btn btn-outline-secondary" type="button" disabled="@_busy" @onclick="GuestAsync">
            Continue as demo guest
        </button>
    </ChildContent>
    <Footer>
        <span>New here?</span>
        <a href="/auth/register">Create account</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _message;
    private bool _busy;
    private bool _rememberMe;

    private void OnEmailInput(ChangeEventArgs e) => _email = e.Value?.ToString() ?? string.Empty;

    private void OnPasswordInput(ChangeEventArgs e) => _password = e.Value?.ToString() ?? string.Empty;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (q.ContainsKey("registered") && q["registered"] == "1")
        {
            _message = "Registration complete. You can sign in now.";
        }
        else if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Invalid email or password.";
        }
        else if (q.ContainsKey("guest") && q["guest"] == "missing")
        {
            _message = "Demo guest user is not available.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (Session.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        try
        {
            var r = await Auth.LoginAsync(new LoginRequest(_email, _password, _rememberMe));
            if (r is null)
            {
                _message = "Invalid email or password.";
                return;
            }

            _message = null;
            await Session.SetSessionAsync(r);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GuestAsync()
    {
        _busy = true;
        try
        {
            var r = await Auth.GuestJwtLoginAsync();
            if (r is null)
            {
                _message = "Demo guest is not available. Is the server running?";
                return;
            }

            _message = null;
            await Session.SetSessionAsync(r);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }

}
