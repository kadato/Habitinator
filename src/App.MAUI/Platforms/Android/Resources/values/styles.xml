<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Custom theme extending MAUI's splash theme.
        Makes the status bar transparent so the app background shows through
        on devices with punch-hole cameras. The window background colour
        (#0b0f19) fills the area behind the transparent status bar during
        startup and theme transitions.
    -->
    <style name="Maui.MainTheme" parent="Maui.SplashTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#0b0f19</item>
    </style>
</resources>
