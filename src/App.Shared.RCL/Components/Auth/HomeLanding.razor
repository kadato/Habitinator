<AuthPageShell Title="Welcome to Habitinator"
               Subtitle="Track habits, dailies, and todos on one board."
               Class="auth-landing">
    <ChildContent>
        <p class="auth-card__section-title">Get started</p>
        <div class="auth-landing__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/auth/login"
                       Target="_self"
                       data-enhance-nav="false">
                Sign in
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/auth/register"
                       Target="_self"
                       data-enhance-nav="false">
                Register
            </MudButton>
        </div>

        <div class="auth-landing__guest-block">
            <div class="auth-form-divider" role="presentation">or</div>
            <p class="auth-landing__guest-hint">
                Prefer to look around first? The demo guest account loads sample board data.
            </p>
            <div class="auth-landing__guest-paper guest-login-paper">
                @if (UseCookieGuestLogin)
                {
                    <form method="post" action="/api/auth/guest-login" class="d-flex flex-column">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   Size="Size.Large">
                            Continue as demo guest
                        </MudButton>
                    </form>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="@_guestBusy"
                               OnClick="ContinueAsGuestAsync">
                        Continue as demo guest
                    </MudButton>
                }
            </div>
        </div>
    </ChildContent>
</AuthPageShell>

@code {
    /// <summary>When true, posts to the web cookie guest-login endpoint. When false, uses <see cref="OnContinueAsDemoGuest"/> for the MAUI / JWT flow.</summary>
    [Parameter] public bool UseCookieGuestLogin { get; set; } = true;

    [Parameter] public EventCallback OnContinueAsDemoGuest { get; set; }

    private bool _guestBusy;

    private async Task ContinueAsGuestAsync()
    {
        if (!OnContinueAsDemoGuest.HasDelegate) return;
        _guestBusy = true;
        try
        {
            await OnContinueAsDemoGuest.InvokeAsync();
        }
        finally
        {
            _guestBusy = false;
        }
    }
}
