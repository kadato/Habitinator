@inject IOnboardingStore OnboardingStore

<MudDialog Class="hab-modal-dialog" ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--neutral" data-dialog-label="Welcome to Habitinator">
            <div class="hab-modal__header">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="DismissAsync" />
                </div>
                <div class="onboarding-header-text">
                <div class="onboarding-logo" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Medium"/>
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Welcome to Habitinator</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Track habits, dailies and to-dos on one board, and stay focused with the timer.
                </MudText>
                </div>
            </div>

            <div class="hab-modal__body">

            <div class="onboarding-steps">
                <div class="onboarding-step">
                    <div class="onboarding-step__icon onboarding-step__icon--board" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small"/>
                    </div>
                    <div class="onboarding-step__body">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Build your board</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Habits count reps, dailies run on schedules with streaks, to-dos carry due dates and checklists.
                        </MudText>
                    </div>
                </div>
                <div class="onboarding-step">
                    <div class="onboarding-step__icon onboarding-step__icon--timer" aria-hidden="true">
                        <PomodoroIcon Size="Size.Small" Plain="true" />
                    </div>
                    <div class="onboarding-step__body">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Focus with the timer</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Run a stopwatch or a full pomodoro cycle on any board item and log the session.
                        </MudText>
                    </div>
                </div>
                <div class="onboarding-step">
                    <div class="onboarding-step__icon onboarding-step__icon--stats" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Size="Size.Small"/>
                    </div>
                    <div class="onboarding-step__body">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Watch your consistency</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Heatmaps, streaks and focus-time graphs show how your routines are building.
                        </MudText>
                    </div>
                </div>
            </div>
            </div>

            <div class="hab-modal__footer">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Medium"
                           Class="hab-primary-btn"
                           OnClick="DismissAsync">
                    Get started
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    private async Task DismissAsync()
    {
        try
        {
            await OnboardingStore.MarkCompletedAsync();
        }
        catch (Exception)
        {
            // Ignored. Onboarding may show again on the next visit
        }

        MudDialog.Close(DialogResult.Ok(false));
    }
}
