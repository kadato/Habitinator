        _isCommandPaletteOpen = true;

        try
        {
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = true,
                NoHeader = true,
                Position = DialogPosition.TopCenter
            };
            var parameters = new DialogParameters<CommandPaletteDialog>
            {
                { x => x.Habits, Habits },
                { x => x.Dailies, Dailies },
                { x => x.Todos, Todos },
                { x => x.BoardDataService, BoardDataService },
                { x => x.ParentBoard, this }
            };
            var dialog = await DialogService.ShowAsync<CommandPaletteDialog>(string.Empty, parameters, options);
            await dialog.Result;
        }
        finally
        {
            _isCommandPaletteOpen = false;
        }
    }

    private void HandleConflictDetected(ConflictInfo conflict)
    {
        _ = InvokeAsync(async () =>
        {
            var options = new DialogOptions
            {
                CloseButton = false,
                CloseOnEscapeKey = false,
                NoHeader = true
            };
            
            var parameters = new DialogParameters<ConflictResolutionDialog>
            {
                { x => x.Conflict, conflict }
            };

            var dialog = await DialogService.ShowAsync<ConflictResolutionDialog>(
                string.Empty, parameters, options);
            
            var result = await dialog.Result;
            if (result is not null && !result.Canceled && result.Data is ConflictResolutionChoice choice)
            {
                ConflictResolution.Resolve(conflict.OperationId, choice);
            }
            else
            {
                ConflictResolution.Resolve(conflict.OperationId, ConflictResolutionChoice.Cancel);
            }
            
            await LoadBoardAsync();
        });
    }

