@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@using App.Shared.RCL.Services.Board.Local
@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    private IBoardLocalStore? _store;
    private DotNetObjectReference<BoardPersistOnHide>? _selfRef;
    private bool _hooked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hooked)
        {
            return;
        }

        // The server renders without a local store. It writes straight to the
        // database, so there is nothing to flush.
        _store = Services.GetService<IBoardLocalStore>();
        if (_store is null)
        {
            return;
        }

        _hooked = true;
        try
        {
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardLocalStore.js");
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("habBoardStore.onHidden", _selfRef);
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation or hot reload.
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation or hot reload.
        }
    }

    /// <summary>Flushes the debounced in-memory mirror when the tab hides.</summary>
    [JSInvokable]
    public Task OnHidden()
    {
        if (_store is null)
        {
            return Task.CompletedTask;
        }

        return _store.FlushAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("habBoardStore.clearHidden");
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation or hot reload.
        }
        catch (JSException)
        {
            // Ignored during page navigation or hot reload.
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation or hot reload.
        }
        catch (InvalidOperationException)
        {
            // Ignored during page navigation or hot reload.
        }
        finally
        {
            _selfRef?.Dispose();
        }

        GC.SuppressFinalize(this);
    }
}
