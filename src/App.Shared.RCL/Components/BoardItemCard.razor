<div class="@CardClass">
    @if (Section == BoardSection.Habit)
    {
        <div class="board-card__habit-btns board-card__left">
            @if (Item.TrackPlus)
            {
                <button type="button" class="@($"board-sq board-sq--good{(IsBusy ? " board-sq--pending" : string.Empty)}")" aria-label="@($"Log positive for {Item.Title}{(IsBusy ? ", saving" : string.Empty)}")" aria-busy="@(IsBusy ? "true" : "false")" disabled="@IsBusy" draggable="false" @onclick="OnHabitUp" @onclick:stopPropagation="true">
                    <svg aria-hidden="true" class="board-habit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span class="hab-visually-hidden">Log positive</span>
                </button>
            }
            @if (Item.TrackMinus)
            {
                <button type="button" class="@($"board-sq board-sq--bad{(IsBusy ? " board-sq--pending" : string.Empty)}")" aria-label="@($"Log negative for {Item.Title}{(IsBusy ? ", saving" : string.Empty)}")" aria-busy="@(IsBusy ? "true" : "false")" disabled="@IsBusy" draggable="false" @onclick="OnHabitDown" @onclick:stopPropagation="true">
                    <svg aria-hidden="true" class="board-habit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span class="hab-visually-hidden">Log negative</span>
                </button>
            }
        </div>
    }
    else
    {
        <div class="board-card__check-col board-card__left">
            <button type="button"
                    class="board-check @CheckClass"
                    aria-label="@($"Toggle complete for {Item.Title}")"
                    draggable="false"
                    @onclick="OnToggle"
                    @onclick:stopPropagation="true"
                    aria-pressed="@AriaBool(Item.IsCompleted)">
                @if (Item.IsCompleted)
                {
                    <svg class="board-check-glyph"
                         viewBox="0 0 24 24"
                         width="14"
                         height="14"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">
                        <path d="M5 12l5 5L19 5"
                              stroke="currentColor"
                              stroke-width="2.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"/>
                    </svg>
                }
            </button>
        </div>
    }
    <div class="board-card__head">
        <button type="button" class="board-card__title" @onclick="OnOpenEditor" @onkeydown="OnTitleKeyDown" aria-label="@GetTitleAriaLabel()" aria-keyshortcuts="@GetTitleKeyShortcuts()">
            <span class="board-card__title-text">@Item.Title</span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="board-card__title-chevron" aria-hidden="true" />
        </button>
        <div class="board-card__head-actions">
            @if (Section == BoardSection.Daily && Item.Counter > 0)
            {
                <div class="board-streak board-streak--active">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" Class="streak-flame-icon" aria-hidden="true" />
                    <span class="hab-visually-hidden">Daily streak @Item.Counter days: </span><span class="board-streak__text" aria-hidden="true">@Item.Counter</span>
                </div>
            }
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Dense="true"
                     aria-label="@($"Options for {Item.Title}")">
                <ActivatorContent Context="itemMenu">
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                                       Size="Size.Small"
                                       Class="ma-0 board-card__delete"
                                       title="@($"Options for {Item.Title}")"
                                       aria-label="@($"Options for {Item.Title}")"
                                       OnClick="@(e => itemMenu.ToggleAsync(e))"/>
                    </span>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem OnClick="OnOpenEditor">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-hidden="true" />
                            <MudText Typo="Typo.body2">Edit</MudText>
                        </div>
                    </MudMenuItem>
                    @if (CanReorder)
                    {
                        <MudMenuItem OnClick="OnMoveUp">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-hidden="true" />
                                <MudText Typo="Typo.body2">Move up</MudText>
                            </div>
                        </MudMenuItem>
                        <MudMenuItem OnClick="OnMoveDown">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-hidden="true" />
                                <MudText Typo="Typo.body2">Move down</MudText>
                            </div>
                        </MudMenuItem>
                        <MudMenuItem OnClick="OnMoveToTop">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" aria-hidden="true" />
                                <MudText Typo="Typo.body2">Move to top</MudText>
                            </div>
                        </MudMenuItem>
                        <MudMenuItem OnClick="OnMoveToBottom">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.VerticalAlignBottom" Size="Size.Small" aria-hidden="true" />
                                <MudText Typo="Typo.body2">Move to bottom</MudText>
                            </div>
                        </MudMenuItem>
                    }
                    <MudMenuItem OnClick="OnDelete">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error" aria-hidden="true" />
                            <MudText Typo="Typo.body2" Color="Color.Error">Delete</MudText>
                        </div>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </div>
    </div>
    @if (HasBodyExtra)
    {
        <div class="board-card__extra">
            @if (TagsList.Count > 0)
            {
                <div class="board-card__tags">
                    @if (_tagsExpanded || TagsList.Count <= 3)
                    {
                        @foreach (var tag in TagsList)
                        {
                            <span @key="tag" class="board-card__tag-badge" style="@TagBadgeStyle(tag)">
                                <span class="board-card__tag-badge__text">@tag</span>
                            </span>
                        }
                        @if (_tagsExpanded && TagsList.Count > 3)
                        {
                            <button type="button"
                                    class="board-card__tag-badge board-card__tag-badge--more"
                                    aria-expanded="true"
                                    aria-label="@($"Show less, {TagsList.Count} tags")"
                                    @onclick="ToggleTagsExpand"
                                    @onclick:stopPropagation="true">Show less</button>
                        }
                    }
                    else
                    {
                        @foreach (var tag in TagsList.Take(2))
                        {
                            <span @key="tag" class="board-card__tag-badge" style="@TagBadgeStyle(tag)">
                                <span class="board-card__tag-badge__text">@tag</span>
                            </span>
                        }
                        <button type="button"
                                class="board-card__tag-badge board-card__tag-badge--more"
                                aria-expanded="false"
                                aria-label="@($"Show all {TagsList.Count} tags, +{TagsList.Count - 2} more: {string.Join(", ", TagsList)}")"
                                @onclick="ToggleTagsExpand"
                                @onclick:stopPropagation="true">+@(TagsList.Count - 2)</button>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Notes))
            {
                <MudText Typo="Typo.caption" Class="board-card__notes" Color="Color.Secondary">@Item.Notes</MudText>
            }
            @if (SubTotal > 0)
            {
                <button type="button"
                        class="board-subtask-pill"
                        @onclick="ToggleSubtasksExpand"
                        @onclick:stopPropagation="true"
                        aria-expanded="@AriaBool(_subtasksExpanded)"
                        aria-label="@($"Subtasks: {SubDone} completed out of {SubTotal}")">
                    <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" aria-hidden="true"/>
                    <span class="board-subtask-pill__count">@SubDone / @SubTotal</span>
                    <MudIcon Icon="@(_subtasksExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" aria-hidden="true"/>
                </button>
            }
            @if (SubTotal > 0 && _subtasksExpanded)
            {
                <ul class="board-subtask-list">
                    @foreach (var line in Checklist)
                    {
                        <li class="board-subtask-list__row" @key="line.Id">
                            <MudCheckBox T="bool"
                                         Value="line.IsDone"
                                         ValueChanged="@(v => OnSetChecklistItemDone.InvokeAsync((line.Id, v)))"
                                         Label="@line.Text"
                                         Class="ma-0 board-subtask-cb"
                                         Color="Color.Secondary"
                                         Dense="true"/>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    @if (ShouldShowItemFooter(Section, Item))
    {
        <div class="board-card__foot">
            <div class="board-card__foot-left">
                @if (Section == BoardSection.Todo && Item.TodoDueDate is { } due)
                {
                    <a href="@($"/upcoming?date={due:yyyy-MM-dd}")" class="@TodoDueCssClass(due)" title="Open this date in Upcoming. The Back button returns here." aria-label="@($"Open {DateFormatService.Format(due)}, {TodoDueRelativeLabel(due)}, in Upcoming. The Back button returns here.")">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" aria-hidden="true" />
                        <span class="board-todo-due__date">@DateFormatService.Format(due)</span>
                        <span class="board-todo-due__relative">@TodoDueRelativeLabel(due)</span>
                    </a>
                }
                @if (Section == BoardSection.Daily && OverdueSince is { } overdueSince)
                {
                    <div class="board-daily-overdue">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" aria-hidden="true" />
                        <span>Overdue since @DateFormatService.Format(overdueSince)</span>
                    </div>
                }
                @if (Section == BoardSection.Habit)
                {
                    <div class="board-habit-counters">
                        <span class="hab-visually-hidden">@HabitCounterTitle()</span>
                        @if (Item.TrackPlus)
                        {
                            <span class="board-habit-badge board-habit-badge--plus">
                                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                @Item.Counter
                            </span>
                        }
                        @if (Item.TrackMinus)
                        {
                            <span class="board-habit-badge board-habit-badge--minus">
                                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                @Item.NegativeCounter
                            </span>
                        }
                        @if (Item.ResetPeriod != HabitResetPeriod.Daily)
                        {
                            <span class="board-habit-badge board-habit-badge--period">@ResetPeriodLabel</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
