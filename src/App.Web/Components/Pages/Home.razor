@page "/"
@rendermode InteractiveServer
@using System.Security.Claims

<PageTitle>Habitinator</PageTitle>

<AuthorizeView>
    <Authorized>
        <MainBoard SignedInEmail="@GetEmail(context.User)" />
    </Authorized>
    <NotAuthorized>
        <HomeLanding />
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string? GetEmail(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Email)?.Value
        ?? user.Identity?.Name;
}
