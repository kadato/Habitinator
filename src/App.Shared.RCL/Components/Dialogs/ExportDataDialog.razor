@using Microsoft.JSInterop
@inject IUserNotifier Notifier
@inject IJSRuntime JS

<MudDialog Class="hab-modal-dialog"
           ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--neutral" data-dialog-label="Export data">
            <div class="hab-modal__header">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="() => MudDialog.Close()" />
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">Export data</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Copy the JSON below to save it, or use a desktop browser for file downloads.
                </MudText>
            </div>
            <div class="hab-modal__body">
            <MudTextField T="string"
                          @bind-Value="JsonText"
                          Variant="Variant.Outlined"
                          Lines="16"
                          ReadOnly="true"
                          aria-label="Exported data as JSON"
                          Class="export-textarea mb-3"/>
            </div>
            <div class="hab-modal__footer">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       Class="hab-primary-btn"
                       Disabled="_copying"
                       OnClick="CopyAsync">
                Copy to clipboard
            </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] [EditorRequired] public required string JsonText { get; set; }

    private bool _copying;

    private async Task CopyAsync()
    {
        if (_copying) return;
        _copying = true;
        try
        {
            try
            {
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardUiState.js");
            }
            catch (Exception)
            {
                // Ignored. The copy call below will fail and be caught too
            }

            var copied = await JS.InvokeAsync<bool>("habitinatorCopyText", JsonText);
            await Notifier.NotifyAsync(
                copied ? "Copied to clipboard." : "Copying failed. Select the text manually.",
                copied ? Severity.Success : Severity.Warning);
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Copying failed. Select the text manually.", Severity.Warning);
        }
        finally
        {
            _copying = false;
        }
    }
}
