@page "/privacy"
@layout MainLayout

<PageTitle>Privacy — Habitinator</PageTitle>
<SeoHead Title="Privacy — Habitinator"
         Description="How Habitinator collects, uses, and protects your personal data on web and mobile."
         CanonicalPath="/privacy"
         Robots="@SeoDefaults.IndexRobots"/>
<HeadContent>
    <script type="application/ld+json">
        @((MarkupString)BreadcrumbJsonLd)
    </script>
</HeadContent>

<article class="privacy-page">
    <h1>Privacy policy</h1>
    <p class="text-secondary">Last updated: June 2026</p>

    <h2>Overview</h2>
    <p>
        Habitinator is a productivity application for habits, scheduled dailies, and to-dos.
        This policy describes what we collect when you use the web app at habitinator.app and related services,
        and how we use it.
    </p>

    <h2>Data we collect</h2>
    <ul>
        <li><strong>Account information</strong> — email address and password hash when you register.</li>
        <li><strong>Board data</strong> — habits, dailies, to-dos, tags, focus timer sessions, and activity history you create in the app.</li>
        <li><strong>Preferences</strong> — display name, theme, time zone, date format, and notification settings you choose.</li>
        <li><strong>Technical data</strong> — standard server logs (IP address, user agent, request timestamps) for security and reliability.</li>
    </ul>

    <h2>How we use data</h2>
    <p>
        We use your data to authenticate you, sync your board across devices, show statistics,
        send optional notifications you configure, and operate and secure the service.
        We do not sell your personal data or use third-party advertising trackers on the web app.
    </p>

    <h2>Cookies and storage</h2>
    <p>
        The web app uses essential session cookies for sign-in and security (including antiforgery protection).
        Native clients may use a JWT instead of cookies. We do not use non-essential analytics or advertising cookies.
    </p>

    <h2>Retention and deletion</h2>
    <p>
        We retain your account and board data while your account is active.
        You can delete your account from Settings when signed in; this removes associated board data subject to backup retention limits.
    </p>

    <h2>Your rights</h2>
    <p>
        Depending on where you live, you may have rights to access, correct, export, or delete your personal data.
        Contact us using the details below to exercise those rights.
    </p>

    <h2>Security</h2>
    <p>
        We use HTTPS, access controls, and industry-standard practices to protect your data.
        Report security issues via our <a href="/.well-known/security.txt">security.txt</a> contact.
    </p>

    <h2>Contact</h2>
    <p>
        Questions about this policy: <a href="mailto:security@habitinator.app">security@habitinator.app</a>
        (or open an issue on our <a href="https://github.com/tothKarolyDavid/Habitinator">GitHub repository</a>).
    </p>

    <p class="privacy-page__back">
        <a href="/">Back to home</a>
    </p>
</article>

@code {
    private const string BreadcrumbJsonLd = """
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://habitinator.app/" },
            { "@type": "ListItem", "position": 2, "name": "Privacy", "item": "https://habitinator.app/privacy" }
          ]
        }
        """;
}
