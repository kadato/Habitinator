@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@inject IUserPreferencesService PreferencesService
@inject IAiAssistantService AiService
@inject IAccountActionsService AccountActions
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudStack Spacing="3">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5" Class="font-weight-bold">AI assistant and provider settings</MudText>
    }

    @if (_loading)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="160px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="350px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <div class="d-flex align-center justify-space-between">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Enable AI assistant</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                            Activate the in-app AI assistant drawer, habit coaching, and board tools. Board content you discuss is sent to your configured provider.
                        </MudText>
                    </div>
                    <MudSwitch T="bool"
                               Value="_model.Ai.Enabled"
                               ValueChanged="OnEnabledChanged"
                               Color="Color.Primary" />
                </div>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">LLM provider configuration</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                        Connect OpenCode API, OpenRouter, OpenAI, Groq, or local Ollama. Any OpenAI-compatible endpoint works.
                    </MudText>
                </div>

                <MudSelect T="string"
                           Label="Provider preset"
                           Variant="Variant.Outlined"
                           dense="true"
                           Value="_model.Ai.Provider"
                           ValueChanged="OnPresetChanged">
                    <MudSelectItem Value="@("OpenCode Go")">OpenCode Go (subscription, recommended)</MudSelectItem>
                    <MudSelectItem Value="@("OpenCode")">OpenCode Console (pay-per-token)</MudSelectItem>
                    <MudSelectItem Value="@("OpenRouter")">OpenRouter</MudSelectItem>
                    <MudSelectItem Value="@("OpenAI")">OpenAI</MudSelectItem>
                    <MudSelectItem Value="@("Groq")">Groq</MudSelectItem>
                    <MudSelectItem Value="@("Ollama")">Ollama (local)</MudSelectItem>
                    <MudSelectItem Value="@("Custom")">Custom (OpenAI compatible)</MudSelectItem>
                </MudSelect>

                <MudTextField T="string"
                              Label="API Endpoint URL"
                              Variant="Variant.Outlined"
                              dense="true"
                              Placeholder="https://api.opencode.ai/v1"
                              Value="_model.Ai.Endpoint"
                              ValueChanged="v => { _model.Ai.Endpoint = v; _testResult = null; }"
                              OnBlur="SavePreferencesAsync"
                              HelperText="Supports the OpenAI chat completions protocol and responses protocol." />

                <MudTextField T="string"
                              Label="API Key"
                              Variant="Variant.Outlined"
                              dense="true"
                              InputType="@(_showKey ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showKey = !_showKey"
                              Placeholder="sk-..."
                              Value="_model.Ai.ApiKey"
                              ValueChanged="v => { _model.Ai.ApiKey = v; _testResult = null; }"
                              OnBlur="SavePreferencesAsync"
                              HelperText="Stored in your account preferences. Habitinator never shares your API key." />

                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1 font-weight-bold">
                        Model selection (@_model.Ai.Provider)
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                        Choose a model from the dropdown or select a quick pill below.
                    </MudText>

                    <MudSelect T="string"
                               Label="AI model"
                               Variant="Variant.Outlined"
                               dense="true"
                               Value="@GetSelectedDropdownValue()"
                               ValueChanged="OnModelDropdownChanged"
                               PopoverClass="ai-settings-model-popover"
                               HelperText="Select an OpenCode or provider model from the list.">
                        @foreach (var opt in AiModelCatalog.GetModelsForProvider(_model.Ai.Provider))
                        {
                            <MudSelectItem Value="@opt.Id">
                                <div class="d-flex align-center justify-space-between w-100 gap-2 min-w-0"
                                     title="@AiModelCatalog.GetModelTooltip(opt.DisplayName, opt.Description)">
                                    <span class="font-weight-medium text-truncate min-w-0">@opt.DisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(opt.Badge))
                                    {
                                        <span class="ai-dropdown-badge flex-shrink-0">@opt.Badge</span>
                                    }
                                </div>
                            </MudSelectItem>
                        }
                        <MudSelectItem Value="@("custom_model_choice")">Custom model ID</MudSelectItem>
                    </MudSelect>

                    @if (_isCustomModel || !AiModelCatalog.GetModelsForProvider(_model.Ai.Provider).Any(m => string.Equals(m.Id, _model.Ai.Model, StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="mt-2">
                            <MudTextField T="string"
                                          Label="Custom model identifier"
                                          Variant="Variant.Outlined"
                                          dense="true"
                                          Placeholder="For example: muse-spark-1.3-contributor"
                                          Value="_model.Ai.Model"
                                          ValueChanged="OnCustomModelInputChanged"
                                          OnBlur="SavePreferencesAsync"
                                          HelperText="Enter the exact model identifier required by your provider." />
                        </div>
                    }
                </div>

                <MudTextField T="string"
                              Label="Custom instructions (optional)"
                              Variant="Variant.Outlined"
                              dense="true"
                              Lines="3"
                              Placeholder="For example: Keep responses short and actionable. Finish overdue todos first."
                              Value="_model.Ai.CustomInstructions"
                              ValueChanged="v => _model.Ai.CustomInstructions = v"
                              OnBlur="SavePreferencesAsync" />

                <div class="d-flex align-center gap-2 mt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="_testing"
                               StartIcon="@(_testing ? null : Icons.Material.Filled.Bolt)"
                               OnClick="TestConnectionAsync">
                        @if (_testing)
                        {
                            <span class="ai-spinner mr-2" aria-hidden="true"></span>
                            <span>Testing connection...</span>
                        }
                        else
                        {
                            <span>Test connection</span>
                        }
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               Disabled="_saving"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SavePreferencesAsync">
                        Save
                    </MudButton>
                </div>

                @if (_testResult is not null)
                {
                    <MudAlert Severity="@(_testResult.Success ? Severity.Success : Severity.Error)"
                              Variant="Variant.Outlined"
                              Dense="true"
                              Class="mt-2">
                        @_testResult.Message
                    </MudAlert>
                }
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1 font-weight-bold">Available board tools</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    The assistant uses these tools on your Habitinator board:
                </MudText>

                <div class="ai-tool-pills-list d-flex flex-wrap gap-2">
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" Color="Color.Primary" />
                        <code class="ai-tool-cap-pill__code">get_board_summary</code>
                        <span class="ai-tool-cap-pill__desc">Today overview</span>
                    </span>
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary" />
                        <code class="ai-tool-cap-pill__code">get_snapshot</code>
                        <span class="ai-tool-cap-pill__desc">Inspect items</span>
                    </span>
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.AddCircle" Size="Size.Small" Color="Color.Success" />
                        <code class="ai-tool-cap-pill__code">create_item</code>
                        <span class="ai-tool-cap-pill__desc">Habit, Daily, Todo</span>
                    </span>
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Info" />
                        <code class="ai-tool-cap-pill__code">toggle_item</code>
                        <span class="ai-tool-cap-pill__desc">Mark done or undone</span>
                    </span>
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.PlusOne" Size="Size.Small" Color="Color.Secondary" />
                        <code class="ai-tool-cap-pill__code">habit_plus, habit_minus</code>
                        <span class="ai-tool-cap-pill__desc">Streaks</span>
                    </span>
                    <span class="ai-tool-cap-pill">
                        <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Color="Color.Warning" />
                        <code class="ai-tool-cap-pill__code">get_timer_summary</code>
                        <span class="ai-tool-cap-pill__desc">Focus timer</span>
                    </span>
                </div>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                    <div>
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">External AI access (MCP)</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                            Give an external AI client its own token to manage your board. Label the token, pick an expiry, generate it, then copy your client's config below.
                        </MudText>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 align-end">
                    <MudTextField T="string"
                                  Label="Token label"
                                  Variant="Variant.Outlined"
                                  dense="true"
                                  Placeholder="For example: laptop-claude"
                                  Value="_mcpLabel"
                                  ValueChanged="v => _mcpLabel = v"
                                  Class="flex-grow-1" />
                    <MudSelect T="string"
                               Label="Scope"
                               Variant="Variant.Outlined"
                               dense="true"
                               Value="_mcpScope"
                               ValueChanged="v => _mcpScope = v">
                        <MudSelectItem Value="@McpTokenScopes.Full">Full access</MudSelectItem>
                        <MudSelectItem Value="@McpTokenScopes.TrackingOnly">Tracking only</MudSelectItem>
                        <MudSelectItem Value="@McpTokenScopes.ReadOnly">Read only</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int"
                               Label="Expiry"
                               Variant="Variant.Outlined"
                               dense="true"
                               Value="_mcpDays"
                               ValueChanged="v => _mcpDays = v">
                        <MudSelectItem Value="7">7 days</MudSelectItem>
                        <MudSelectItem Value="30">30 days</MudSelectItem>
                        <MudSelectItem Value="90">90 days</MudSelectItem>
                        <MudSelectItem Value="180">180 days</MudSelectItem>
                        <MudSelectItem Value="365">365 days</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               Style="align-self: stretch;"
                               Class="flex-shrink-0"
                               Disabled="_generatingMcpToken"
                               StartIcon="@(_generatingMcpToken ? null : Icons.Material.Filled.Key)"
                               OnClick="GenerateMcpTokenAsync">
                        @if (_generatingMcpToken)
                        {
                            <span class="ai-spinner mr-2" aria-hidden="true"></span>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <span>Generate MCP token</span>
                        }
                    </MudButton>
                </div>

                @if (_mcpTokenResponse is not null)
                {
                    <div class="mcp-token-panel pa-3 rounded-lg border d-flex flex-column gap-2 mt-2">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                            <MudText Typo="Typo.caption" Class="font-weight-bold">
                                Token valid until @_mcpTokenResponse.ExpiresAtUtc.ToString("u") (@_mcpTokenResponse.Days days)
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Disabled="_testingMcp"
                                       StartIcon="@Icons.Material.Filled.Bolt"
                                       OnClick="TestMcpConnectionAsync">
                                @(_testingMcp ? "Testing..." : "Test connection")
                            </MudButton>
                        </div>
                        @if (_mcpTestResult is not null)
                        {
                            <MudAlert Severity="@_mcpTestSeverity"
                                      Variant="Variant.Outlined"
                                      Dense="true">
                                @_mcpTestResult
                            </MudAlert>
                        }
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Endpoint URL:</MudText>
                            <div class="d-flex align-center gap-1">
                                <code class="d-block pa-1 rounded text-truncate font-monospace flex-grow-1 mcp-token-panel__code">@_mcpTokenResponse.Endpoint</code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Size="Size.Small"
                                               aria-label="Copy MCP endpoint"
                                               OnClick='() => CopyTextAsync(_mcpTokenResponse.Endpoint, "Endpoint URL copied.")' />
                            </div>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Bearer Token:</MudText>
                            <div class="d-flex align-center gap-1">
                                <code class="d-block pa-1 rounded text-truncate font-monospace flex-grow-1 mcp-token-panel__code">@_mcpTokenResponse.Token</code>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Size="Size.Small"
                                               aria-label="Copy MCP token"
                                               OnClick='() => CopyTextAsync(_mcpTokenResponse.Token, "Bearer token copied.")' />
                            </div>
                        </div>
                    </div>
                }

                @if (_mcpExpiringSoon is not null)
                {
                    <MudAlert Severity="Severity.Warning"
                              Variant="Variant.Outlined"
                              Dense="true">
                        Token '@_mcpExpiringSoon.Value.Label' expires @_mcpExpiringSoon.Value.ExpiryText. Generate a replacement before it lapses.
                    </MudAlert>
                }

                <div class="mcp-token-panel pa-3 rounded-lg border d-flex flex-column gap-2 mt-2">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <MudText Typo="Typo.caption" Class="font-weight-bold">
                            Issued tokens (@_mcpActiveCount active)
                        </MudText>
                        @if (_mcpTokens.Any(t => t.RevokedAtUtc is null))
                        {
                            @if (_confirmRevokeAll)
                            {
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="_revokingAll"
                                               OnClick="RevokeAllMcpTokensAsync">
                                        @(_revokingAll ? "Revoking..." : "Confirm revoke all")
                                    </MudButton>
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               OnClick="() => _confirmRevokeAll = false">
                                        Cancel
                                    </MudButton>
                                </MudStack>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="() => _confirmRevokeAll = true">
                                    Revoke all
                                </MudButton>
                            }
                        }
                    </div>
                    @if (_loadingMcpTokens)
                    {
                        <MudSkeleton Width="100%" Height="24px" />
                    }
                    else if (_mcpTokens.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">No tokens yet. Generate one above.</MudText>
                    }
                    else
                    {
                        @foreach (var token in _mcpTokens)
                        {
                            <div class="d-flex align-center justify-space-between gap-2">
                                <div class="min-w-0">
                                    <div class="d-flex align-center gap-1">
                                        <MudText Typo="Typo.caption" Class="font-weight-bold text-truncate">@token.Label</MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetMcpScopeColor(token.Scope)">@McpTokenScopes.DisplayName(token.Scope)</MudChip>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @McpTokenStatusText(token)
                                    </MudText>
                                </div>
                                @if (token.RevokedAtUtc is null)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                   Size="Size.Small"
                                                   aria-label="@($"Revoke token {token.Label}")"
                                                   Disabled="_revokingId == token.Id"
                                                   OnClick="() => RevokeMcpTokenAsync(token.Id)" />
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Revoked</MudChip>
                                }
                            </div>
                        }
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Revoking takes effect immediately. The client keeps failing until you replace its token.
                    </MudText>
                </div>

                <MudTabs Elevation="0" Rounded="true" Outlined="true" Class="mt-1">
                    <MudTabPanel Text="OAuth (Zero key)" Icon="@Icons.Material.Filled.AutoAwesome">
                        <div class="pa-2">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                <strong>Zero manual keys:</strong> Habitinator supports RFC 9728 &amp; RFC 8414 OAuth 2.1. Configure your client with the server URL; when the client connects, it opens your browser to approve access. No API key copying required.
                            </MudAlert>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                <strong>Option A: Claude Desktop, Cursor, or VS Code:</strong>
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpClaudeOAuthSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpClaudeOAuthSnippet(), "OAuth configuration copied.")'>Copy Zero-Key Config</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                <strong>Option B: OpenCode (with native OAuth discovery):</strong>
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpOpenCodeOAuthSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpOpenCodeOAuthSnippet(), "OpenCode OAuth config copied.")'>Copy OpenCode Config</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                <strong>Option C: Claude Code CLI:</strong>
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpClaudeCodeCliOAuth()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpClaudeCodeCliOAuth(), "Claude Code CLI command copied.")'>Copy Claude Code CLI</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                <strong>Option D: OpenCode CLI:</strong>
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpOpenCodeCliOAuth()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpOpenCodeCliOAuth(), "OpenCode CLI command copied.")'>Copy OpenCode CLI</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Claude">
                        <div class="pa-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                Paste into Claude Desktop config, then restart Claude.
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpClaudeSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpClaudeSnippet(), "Claude configuration copied.")'>Copy Desktop config</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                Or add to Claude Code CLI:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpClaudeCodeCli()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpClaudeCodeCli(), "Claude Code command copied.")'>Copy CLI command</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                                Desktop config locations: macOS at <code>~/Library/Application Support/Claude/claude_desktop_config.json</code>, Windows at <code>%APPDATA%\Claude\claude_desktop_config.json</code>, Linux at <code>~/.config/Claude/claude_desktop_config.json</code>.
                            </MudText>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="OpenCode">
                        <div class="pa-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                <strong>Step 1:</strong> Export your token as an environment variable so secrets stay out of git commits:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpExportEnv()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpExportEnv(), "Export command copied.")'>Copy export command</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                <strong>Step 2:</strong> Add to OpenCode with the CLI:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpOpenCodeCli()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpOpenCodeCli(), "OpenCode command copied.")'>Copy CLI command</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                Or paste into <code>opencode.jsonc</code> directly:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpOpenCodeSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpOpenCodeSnippet(), "OpenCode configuration copied.")'>Copy config</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Hermes">
                        <div class="pa-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                <strong>Step 1:</strong> Export your token as an environment variable, or add it to your Hermes <code>.env</code> file:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpExportEnv()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpExportEnv(), "Export command copied.")'>Copy export command</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                <strong>Step 2:</strong> Append Habitinator to <code>~/.hermes/config.yaml</code> with one terminal command:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpHermesAppend()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpHermesAppend(), "Hermes append command copied.")'>Copy append command</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                Or paste this block under <code>mcp_servers</code> in <code>config.yaml</code>:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpHermesSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpHermesSnippet(), "Hermes configuration copied.")'>Copy Hermes config</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Cursor or VS Code">
                        <div class="pa-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">Paste into <code>.vscode/mcp.json</code> or Cursor MCP settings.</MudText>
                            <pre class="mcp-snippet-pre">@GetMcpClaudeSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpClaudeSnippet(), "Cursor/VS Code configuration copied.")'>Copy config</MudButton>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Terminal or curl">
                        <div class="pa-2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                Quick one-line health check returning the tool count with <code>jq</code>:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpHealthCheckCurl()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpHealthCheckCurl(), "Health check command copied.")'>Copy health check</MudButton>

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-3 mb-1 d-block">
                                Full curl request for tools/list:
                            </MudText>
                            <pre class="mcp-snippet-pre">@GetMcpCurlSnippet()</pre>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick='() => CopyTextAsync(GetMcpCurlSnippet(), "curl command copied.")'>Copy curl</MudButton>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <div class="d-flex align-center gap-2 mb-1">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">What you can ask your AI</MudText>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    Ready prompt recipes for your in-app assistant or external agents like OpenCode, Hermes, and Claude:
                </MudText>

                <div class="d-flex flex-column gap-2">
                    @foreach (var recipe in _promptRecipes)
                    {
                        <div class="pa-3 rounded border prompt-recipe-card d-flex align-center justify-space-between gap-3">
                            <div class="min-w-0">
                                <div class="d-flex align-center gap-2 mb-1">
                                    <MudIcon Icon="@recipe.Icon" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@recipe.Title</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="font-italic">
                                    "@recipe.Prompt"
                                </MudText>
                            </div>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Class="flex-shrink-0"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick='() => CopyTextAsync(recipe.Prompt, "Prompt copied to clipboard.")'>
                                Copy prompt
                            </MudButton>
                        </div>
                    }
                </div>
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    [Parameter] public bool ShowTitle { get; set; } = true;

    private UserPreferences? _model;
    private bool _loading = true;
    private bool _saving;
    private bool _testing;
    private bool _generatingMcpToken;
    private bool _showKey;
    private AiTestConnectionResponse? _testResult;
    private CreateMcpTokenResponse? _mcpTokenResponse;
    private bool _isCustomModel;
    private string _mcpLabel = "AI Settings";
    private string _mcpScope = McpTokenScopes.Full;
    private int _mcpDays = 90;
    private bool _testingMcp;
    private string? _mcpTestResult;
    private Severity _mcpTestSeverity = Severity.Info;
    private IReadOnlyList<McpTokenInfo> _mcpTokens = [];
    private bool _loadingMcpTokens = true;
    private Guid? _revokingId;
    private bool _confirmRevokeAll;
    private bool _revokingAll;

    private int _mcpActiveCount => _mcpTokens.Count(t => t.RevokedAtUtc is null && t.ExpiresAtUtc > DateTime.UtcNow);

    private (string Label, string ExpiryText)? _mcpExpiringSoon
    {
        get
        {
            var soon = _mcpTokens
                .Where(t => t.RevokedAtUtc is null && t.ExpiresAtUtc > DateTime.UtcNow)
                .OrderBy(t => t.ExpiresAtUtc)
                .FirstOrDefault(t => (t.ExpiresAtUtc - DateTime.UtcNow).TotalDays <= 14);
            return soon is null ? null : (soon.Label, McpExpiryText(soon.ExpiresAtUtc));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await PreferencesService.GetAsync();
            _model.Ai ??= new AiPreferences();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load preferences: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }

        await LoadMcpTokensAsync();
    }

    private static string McpExpiryText(DateTime expiresAtUtc)
    {
        var days = (int)Math.Ceiling((expiresAtUtc - DateTime.UtcNow).TotalDays);
        if (days <= 0)
        {
            return "today";
        }

        return days == 1 ? "tomorrow" : $"in {days} days";
    }

    private static string McpTokenStatusText(McpTokenInfo token)
    {
        if (token.RevokedAtUtc is not null)
        {
            return $"Revoked {token.RevokedAtUtc.Value:yyyy-MM-dd}.";
        }

        if (token.ExpiresAtUtc <= DateTime.UtcNow)
        {
            return $"Expired {token.ExpiresAtUtc:yyyy-MM-dd}.";
        }

        var expires = $"Expires {token.ExpiresAtUtc:yyyy-MM-dd} ({McpExpiryText(token.ExpiresAtUtc)}).";
        if (token.LastUsedAtUtc is { } lastUsed)
        {
            return $"{expires} Last active {FormatTimeAgo(lastUsed)}.";
        }

        return $"{expires} Never used.";
    }

    private static string FormatTimeAgo(DateTime utcTime)
    {
        var span = DateTime.UtcNow - utcTime;
        if (span.TotalMinutes < 1)
        {
            return "just now";
        }

        if (span.TotalHours < 1)
        {
            return $"{(int)span.TotalMinutes}m ago";
        }

        if (span.TotalDays < 1)
        {
            return $"{(int)span.TotalHours}h ago";
        }

        return $"{(int)span.TotalDays}d ago";
    }

    private static Color GetMcpScopeColor(string? scope) => McpTokenScopes.Normalize(scope) switch
    {
        McpTokenScopes.ReadOnly => Color.Info,
        McpTokenScopes.TrackingOnly => Color.Warning,
        _ => Color.Primary,
    };

    private async Task LoadMcpTokensAsync()
    {
        _loadingMcpTokens = true;
        try
        {
            _mcpTokens = await AccountActions.ListMcpTokensAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load MCP tokens: {ex.Message}", Severity.Warning);
            _mcpTokens = [];
        }
        finally
        {
            _loadingMcpTokens = false;
            StateHasChanged();
        }
    }

    private async Task RevokeMcpTokenAsync(Guid id)
    {
        _revokingId = id;
        try
        {
            await AccountActions.RevokeMcpTokenAsync(id);
            Snackbar.Add("Token revoked.", Severity.Success, o => o.VisibleStateDuration = 1200);
            await LoadMcpTokensAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to revoke token: {ex.Message}", Severity.Error);
        }
        finally
        {
            _revokingId = null;
            StateHasChanged();
        }
    }

    private async Task RevokeAllMcpTokensAsync()
    {
        _revokingAll = true;
        try
        {
            await AccountActions.RevokeAllMcpTokensAsync();
            Snackbar.Add("All tokens revoked.", Severity.Success);
            _confirmRevokeAll = false;
            await LoadMcpTokensAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to revoke tokens: {ex.Message}", Severity.Error);
        }
        finally
        {
            _revokingAll = false;
            StateHasChanged();
        }
    }

    private string GetSelectedDropdownValue()
    {
        if (_isCustomModel)
        {
            return "custom_model_choice";
        }

        if (_model is null || string.IsNullOrWhiteSpace(_model.Ai.Model))
        {
            return string.Empty;
        }

        var inCatalog = AiModelCatalog.GetModelsForProvider(_model.Ai.Provider)
            .Any(m => string.Equals(m.Id, _model.Ai.Model, StringComparison.OrdinalIgnoreCase));

        return inCatalog ? _model.Ai.Model : "custom_model_choice";
    }

    private async Task OnModelDropdownChanged(string modelId)
    {
        if (_model is null)
        {
            return;
        }

        if (modelId == "custom_model_choice")
        {
            _isCustomModel = true;
            return;
        }

        _isCustomModel = false;
        _model.Ai.Model = modelId;
        _testResult = null;
        await SavePreferencesAsync();
        StateHasChanged();
    }

    private void OnCustomModelInputChanged(string value)
    {
        if (_model is null)
        {
            return;
        }

        _model.Ai.Model = value;
        _testResult = null;
    }

    private async Task OnEnabledChanged(bool value)
    {
        if (_model is null)
        {
            return;
        }

        _model.Ai.Enabled = value;
        await SavePreferencesAsync();
    }

    private async Task OnPresetChanged(string provider)
    {
        if (_model is null)
        {
            return;
        }

        _model.Ai.Provider = provider;
        _testResult = null;
        _isCustomModel = false;

        var defaultEndpoint = GetDefaultEndpoint(provider);
        if (!string.IsNullOrWhiteSpace(defaultEndpoint))
        {
            _model.Ai.Endpoint = defaultEndpoint;
        }

        var defaultModel = GetDefaultModel(provider);
        if (!string.IsNullOrWhiteSpace(defaultModel))
        {
            _model.Ai.Model = defaultModel;
        }

        await SavePreferencesAsync();
        StateHasChanged();
    }

    private static string GetDefaultEndpoint(string provider) => provider switch
    {
        "OpenCode Go" => AiPreferences.DefaultOpenCodeGoEndpoint,
        "OpenCode" => AiPreferences.DefaultOpenCodeConsoleEndpoint,
        "OpenRouter" => AiPreferences.DefaultOpenRouterEndpoint,
        "OpenAI" => AiPreferences.DefaultOpenAiEndpoint,
        "Groq" => AiPreferences.DefaultGroqEndpoint,
        "Ollama" => AiPreferences.DefaultOllamaEndpoint,
        _ => string.Empty
    };

    private static string GetDefaultModel(string provider) => provider switch
    {
        "OpenCode Go" => "muse-spark-1.3-contributor",
        "OpenCode" => "muse-spark-1.3-contributor",
        "OpenRouter" => "anthropic/claude-3.7-sonnet",
        "OpenAI" => "gpt-4o",
        "Groq" => "llama-3.3-70b-versatile",
        "Ollama" => "llama3.2",
        _ => "muse-spark-1.3-contributor"
    };

    private async Task SavePreferencesAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        try
        {
            await PreferencesService.SaveAsync(_model);
            Snackbar.Add("AI preferences saved.", Severity.Success, o => o.VisibleStateDuration = 1500);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save preferences: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_model is null)
        {
            return;
        }

        _testing = true;
        _testResult = null;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var req = new AiTestConnectionRequest
            {
                Endpoint = _model.Ai.Endpoint,
                ApiKey = _model.Ai.ApiKey,
                Model = _model.Ai.Model
            };

            var res = await AiService.TestConnectionAsync(req);
            _testResult = res;

            if (res.Success)
            {
                Snackbar.Add("Connection test succeeded.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Connection test failed: {res.Message}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _testResult = new AiTestConnectionResponse
            {
                Success = false,
                Message = $"Request exception: {ex.Message}"
            };
            Snackbar.Add(_testResult.Message, Severity.Error);
        }
        finally
        {
            _testing = false;
            StateHasChanged();
        }
    }

    private async Task GenerateMcpTokenAsync()
    {
        _generatingMcpToken = true;
        _mcpTestResult = null;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var label = string.IsNullOrWhiteSpace(_mcpLabel) ? "AI Settings" : _mcpLabel.Trim();
            var days = Math.Clamp(_mcpDays, 1, 365);
            _mcpTokenResponse = await AccountActions.CreateMcpTokenAsync(new CreateMcpTokenRequest(days, label, _mcpScope));
            Snackbar.Add("Generated MCP token.", Severity.Success);
            await LoadMcpTokensAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate MCP token: {ex.Message}", Severity.Error);
        }
        finally
        {
            _generatingMcpToken = false;
            StateHasChanged();
        }
    }

    private string GetMcpClaudeOAuthSnippet() =>
        McpClientConfigSnippets.ClaudeOAuth(_mcpTokenResponse?.Endpoint);

    private string GetMcpClaudeCodeCliOAuth() =>
        McpClientConfigSnippets.ClaudeCodeCliOAuth(_mcpTokenResponse?.Endpoint);

    private string GetMcpOpenCodeOAuthSnippet() =>
        McpClientConfigSnippets.OpenCodeOAuth(_mcpTokenResponse?.Endpoint);

    private string GetMcpOpenCodeCliOAuth() =>
        McpClientConfigSnippets.OpenCodeCliOAuth(_mcpTokenResponse?.Endpoint);

    private string GetMcpExportEnv() =>
        McpClientConfigSnippets.ExportEnv(_mcpTokenResponse?.Token);

    private string GetMcpClaudeSnippet() =>
        McpClientConfigSnippets.Claude(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token);

    private string GetMcpClaudeCodeCli() =>
        McpClientConfigSnippets.ClaudeCodeCli(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token);

    private string GetMcpOpenCodeSnippet() =>
        McpClientConfigSnippets.OpenCode(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token, useEnvVar: true);

    private string GetMcpOpenCodeCli() =>
        McpClientConfigSnippets.OpenCodeCli(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token, useEnvVar: true);

    private string GetMcpHermesSnippet() =>
        McpClientConfigSnippets.Hermes(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token, useEnvVar: true);

    private string GetMcpHermesAppend() =>
        McpClientConfigSnippets.HermesAppend(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token, useEnvVar: true);

    private string GetMcpCurlSnippet() =>
        McpClientConfigSnippets.Curl(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token);

    private string GetMcpHealthCheckCurl() =>
        McpClientConfigSnippets.HealthCheckCurl(_mcpTokenResponse?.Endpoint, _mcpTokenResponse?.Token);

    private sealed record PromptRecipe(string Title, string Prompt, string Icon);

    private static readonly IReadOnlyList<PromptRecipe> _promptRecipes =
    [
        new(
            "Morning kickoff and planning",
            "Review my Habitinator board for today. What dailies and overdue todos should I prioritize this morning?",
