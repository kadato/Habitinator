        "get_timer_summary" => "Checked focus timer",
        _ => toolName
    };

    private static string GetToolIcon(string toolName) => toolName switch
    {
        "create_item" => Icons.Material.Filled.AddCircle,
        "toggle_item" => Icons.Material.Filled.CheckCircle,
        "habit_plus" => Icons.Material.Filled.Add,
        "habit_minus" => Icons.Material.Filled.Remove,
        "rename_item" => Icons.Material.Filled.Edit,
        "set_due_date" => Icons.Material.Filled.Event,
        "archive_item" => Icons.Material.Filled.Archive,
        "get_board_summary" => Icons.Material.Filled.Assessment,
        "get_snapshot" => Icons.Material.Filled.Visibility,
        "get_timer_summary" => Icons.Material.Filled.Timer,
        _ => Icons.Material.Filled.Build
    };

    private async Task ClearChat()
    {
        var thread = _threads.FirstOrDefault(t => t.Id == _activeThreadId);
        if (thread is not null)
        {
            thread.Entries.Clear();
            thread.Entries.Add(new ChatEntry { Message = AiChatMessage.Assistant("Chat history cleared. How can I help you today?", _activeModel) });
            thread.UpdatedAt = DateTime.UtcNow;
            await PersistThreadsAsync();
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    private void NavigateToSettings()
    {
        UiSessionState.SetAiDrawer(false);
        UiSessionState.SettingsSectionIndex = 3;
        Nav.NavigateTo("/settings");
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!disposing)
        {
            return;
        }

        UiSessionState.OnAiDrawerChanged -= HandleDrawerChanged;
        _streamCts?.Cancel();
        _streamCts?.Dispose();
        try
        {
            _ = JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _sheetHeaderRef);
        }
        catch
        {
            // Ignored during disposal.
        }
        try
        {
            _ = JS.InvokeVoidAsync("HabitinatorBoardViewport.unwatchPhoneSheet");
        }
        catch
        {
            // Ignored during disposal.
        }
        _sheetRef?.Dispose();
        _sheetRef = null;
    }
}
