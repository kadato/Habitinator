@inherits LayoutComponentBase
@using global::App.Shared.RCL.Themes
@using System.Security.Claims

<MudThemeProvider Theme="@HabitinatorMudTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar">
        <div class="app-top-bar__row d-flex">
            <div class="app-top-bar__left d-flex flex-wrap align-center">
                <MudText Typo="Typo.h6" Class="app-top-bar__title">Habitinator</MudText>
                <NavMenu Mode="AppNavMode.Full" />
            </div>
            <div class="app-top-bar__right d-flex flex-wrap align-center">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="app-header-user-rail d-flex flex-wrap align-center">
                            <MudChip T="string"
                                     Icon="@Icons.Material.Filled.AccountCircle"
                                     Color="Color.Primary"
                                     Variant="Variant.Filled"
                                     Size="Size.Medium"
                                     Class="app-header-username-chip text-truncate"
                                     title="@GetFullIdentity(auth)">
                                @GetEmailLocalPart(auth)
                            </MudChip>
                            <form method="post" action="/api/auth/cookie-logout" class="d-inline m-0 app-header-logout-form">
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.Logout"
                                           Class="app-header-logout-btn text-transform-none">
                                    Log out
                                </MudButton>
                            </form>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <WebBoardHubConnector />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static string GetFullIdentity(AuthenticationState auth) =>
        auth.User.FindFirst(ClaimTypes.Email)?.Value
        ?? auth.User.Identity?.Name
        ?? "User";

    private static string GetEmailLocalPart(AuthenticationState auth)
    {
        string full = GetFullIdentity(auth);
        int at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }
}
