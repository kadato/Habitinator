@using Microsoft.Extensions.Options
@inject IOptions<SitePublicOptions> SiteOptions

<PageTitle>@EffectiveTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@EffectiveDescription"/>
    <meta name="robots" content="@Robots"/>
    <link rel="canonical" href="@CanonicalUrl"/>

    <meta property="og:site_name" content="@SeoDefaults.SiteName"/>
    <meta property="og:title" content="@EffectiveTitle"/>
    <meta property="og:description" content="@EffectiveDescription"/>
    <meta property="og:url" content="@CanonicalUrl"/>
    <meta property="og:type" content="website"/>
    <meta property="og:image" content="@OgImageUrl"/>

    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content="@EffectiveTitle"/>
    <meta name="twitter:description" content="@EffectiveDescription"/>
    <meta name="twitter:image" content="@OgImageUrl"/>

    @ChildContent
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Robots { get; set; } = SeoDefaults.NoIndexRobots;

    [Parameter]
    public string CanonicalPath { get; set; } = "/";

    [Parameter]
    public string OgImagePath { get; set; } = "/og-image.png";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private SitePublicOptions Site => SiteOptions.Value;

    private string EffectiveTitle => Title.Trim();

    private string EffectiveDescription => string.IsNullOrWhiteSpace(Description)
        ? SeoDefaults.DefaultDescription
        : Description.Trim();

    private string CanonicalUrl =>
        new Uri(Site.PublicBaseUri, SeoDefaults.CanonicalPathFor(CanonicalPath)).ToString();

    private string OgImageUrl => new Uri(Site.PublicBaseUri, OgImagePath.TrimStart('/')).ToString();
}
