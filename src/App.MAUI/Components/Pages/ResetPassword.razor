@page "/auth/reset-password"
@using global::App.Shared.RCL.Models
@using Microsoft.AspNetCore.WebUtilities
@inject ApiAuthService Auth
@inject NavigationManager Nav

<PageTitle>@PageTitles.Page("Reset password")</PageTitle>

<AuthPageShell Title="Reset password"
               Subtitle="Enter the email from your reset link. Choose a new password."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" type="email" autocomplete="email"
                   value="@_email" @oninput="OnEmailInput" disabled="@_busy" />
        </div>
        <div class="mb-3">
            <label for="password">New password</label>
            <input class="form-control" id="password" type="password" autocomplete="new-password"
                   value="@_password" @oninput="OnPasswordInput" disabled="@_busy" />
            <div class="auth-form-hint">At least 8 characters.</div>
        </div>
        <div class="auth-form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       OnClick="SubmitAsync">
                Reset password
            </MudButton>
        </div>
    </ChildContent>
    <Footer>
        <a href="/auth/login">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string _token = string.Empty;
    private string _password = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _busy;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("email", out var email))
        {
            _email = email.ToString();
        }

        if (query.TryGetValue("token", out var token))
        {
            _token = token.ToString();
        }
    }

    private void OnEmailInput(ChangeEventArgs e) => _email = e.Value?.ToString() ?? string.Empty;

    private void OnPasswordInput(ChangeEventArgs e) => _password = e.Value?.ToString() ?? string.Empty;

    private async Task SubmitAsync()
    {
        if (_password.Length < 8)
        {
            _message = "Password needs at least 8 characters.";
            _hasError = true;
            return;
        }

        _busy = true;
        try
        {
            var ok = await Auth.ResetPasswordAsync(_email, _token, _password);
            if (ok)
            {
                Nav.NavigateTo("/auth/login?reset=1");
                return;
            }

            _message = "Invalid reset link. Request a new one.";
            _hasError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
