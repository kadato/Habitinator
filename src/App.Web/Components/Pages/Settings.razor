@page "/settings"

<PageTitle>Settings — Habitinator</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <MudText Typo="Typo.h4">Settings</MudText>
        <MudText Class="mb-2">Sign in to manage notification preferences.</MudText>
        <MudButton Href="auth/login" Variant="Variant.Filled" Color="Color.Primary">Log in</MudButton>
    </NotAuthorized>
    <Authorized>
        <MudText Typo="Typo.h4" Class="mb-2">Settings</MudText>
        <NotificationSettingsSection />
    </Authorized>
</AuthorizeView>
