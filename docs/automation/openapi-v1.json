  "components": {
    "schemas": {
      "AppTheme": {
        "type": "integer"
      },
      "BoardSection": {
        "type": "integer"
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "DailyCompleteForDateRequest": {
        "required": [
          "completedOn"
        ],
        "type": "object",
        "properties": {
          "completedOn": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "DailyRepeatType": {
        "type": "integer"
      },
      "DailyUpdateRequest": {
        "required": [
          "title",
          "notes",
          "tags",
          "startDate",
          "repeat",
          "repeatInterval",
          "checklistJson"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": [
              "null",
              "string"
            ]
          },
          "startDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "repeat": {
            "$ref": "#/components/schemas/DailyRepeatType"
          },
          "repeatInterval": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "checklistJson": {
            "type": [
              "null",
              "string"
            ]
          },
          "streak": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 0
          },
          "sortOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "HabitResetPeriod": {
        "type": "integer"
      },
      "HabitUpdateRequest": {
        "required": [
          "title",
          "notes",
          "tags",
          "trackPlus",
          "trackMinus",
          "resetPeriod",
          "counter",
          "negativeCounter"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": [
              "null",
              "string"
            ]
          },
          "trackPlus": {
            "type": "boolean"
          },
          "trackMinus": {
            "type": "boolean"
          },
          "resetPeriod": {
            "$ref": "#/components/schemas/HabitResetPeriod"
          },
          "counter": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "negativeCounter": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "checklistJson": {
            "type": [
              "null",
              "string"
            ]
          },
          "sortOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ItemTitleRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "itemId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "NotificationSettings": {
        "type": "object",
        "properties": {
          "inAppMessagesEnabled": {
            "type": "boolean"
          },
          "showSuccessToasts": {
            "type": "boolean"
          },
          "showWarningToasts": {
            "type": "boolean"
          },
          "showErrorToasts": {
            "type": "boolean"
          },
          "toastDuration": {
            "$ref": "#/components/schemas/NotificationToastDuration"
          },
          "dailyReminderEnabled": {
            "type": "boolean"
          },
          "dailyReminderTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "focusTimerAlertsEnabled": {
            "type": "boolean"
          },
          "syncFailureAlertsEnabled": {
            "type": "boolean"
          },
          "soundEnabledForDeviceNotifications": {
            "type": "boolean"
          },
          "quietHoursEnabled": {
            "type": "boolean"
          },
          "quietHoursStartUtc": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "quietHoursEndUtc": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "NotificationToastDuration": {
        "type": "integer"
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "TodoUpdateRequest": {
        "required": [
          "title",
          "notes",
          "tags",
          "checklistJson",
          "dueDate"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": [
              "null",
              "string"
            ]
          },
          "checklistJson": {
            "type": [
              "null",
              "string"
            ]
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "sortOrder": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "UserPreferences": {
        "type": "object",
        "properties": {
          "dateFormat": {
            "type": "string"
          },
          "dayStartLocalTime": {
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": "string"
          },
          "timeZoneOverrideId": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "theme": {
            "$ref": "#/components/schemas/AppTheme"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "App.Web"
    }
  ]
}