@inherits AutosaveEditDialogBase<EditDailyDialogResult>
@inject IUserDateFormatService DateFormatService
@inject IDialogService DialogService
@inject IActivityStatisticsReader StatsReader

<MudDialog Class="edit-daily-dialog hab-modal-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(26rem, calc(100vw - 1rem));">
<DialogContent>
    <div class="hab-modal hab-modal--daily edit-daily-shell edit-daily-shell--daily" data-dialog-label="Edit daily" @onclick="OnShellClick">
        <EditDialogHeader TitleText="Edit daily"
                          TitlePlaceholder="Daily title"
                          @bind-Title="_title"
                          @bind-Title:after="OnTitleEdited"
                          OnClose="CloseAsync"
                          SaveStatus="SaveStatus"
                          Section="BoardSection.Daily"/>

        <div class="hab-modal__body edit-daily-body">
            <EditDialogNotes @bind-Notes="_notes"
                             @bind-Notes:after="OnNotesEdited"/>

            <div class="hab-checklist">
                <div class="hab-checklist__head">
                    <span class="hab-checklist__head-title">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                        Checklist
                    </span>
                    @if (_checklistRows.Count > 0)
                    {
                        <span class="hab-checklist__count">@_checklistRows.Count(x => x.IsDone) / @_checklistRows.Count</span>
                    }
                </div>
                <div class="hab-checklist__list">
                    <ChecklistEditor @bind-Value="_checklistRows" @bind-Value:after="OnChecklistEdited"/>
                </div>
            </div>

            <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                <span class="hab-modal__section-label">
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    Start date
                </span>
                <MudDatePicker @bind-Date="_startDate" @bind-Date:after="OnDiscreteEdited" Variant="Variant.Outlined" Editable="true" Class="hab-modal__field" DateFormat="@DateFormatService.DateFormat" Margin="Margin.Dense" aria-label="Start date"/>
            </div>

            <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                <span class="hab-modal__section-label">Repeats</span>
                <MudSelect T="DailyRepeatType" @bind-Value="_repeat" @bind-Value:after="OnDiscreteEdited" Variant="Variant.Outlined" Class="hab-modal__field" Margin="Margin.Dense" Dense="true" aria-label="Repeats" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Daily">Daily</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Weekly">Weekly</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Monthly">Monthly</MudSelectItem>
                    <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Yearly">Yearly</MudSelectItem>
                </MudSelect>
            </div>

            <div class="hab-modal__section">
                <span class="hab-modal__section-label">Repeat every</span>
                <div class="edit-daily-repeat-every">
                    <MudNumericField @bind-Value="_repeatInterval" @bind-Value:after="OnIntervalEdited" Variant="Variant.Outlined" Class="edit-daily-repeat-every__n" Min="1" Max="999" HideSpinButtons="true" Margin="Margin.Dense" aria-label="Repeat every"/>
                    <span class="edit-daily-repeat-every__unit">@RepeatUnitLabel()</span>
                </div>
            </div>

            @if (_repeat == DailyRepeatType.Weekly)
            {
                <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                    <span class="hab-modal__section-label" id="edit-daily-weekdays-label">Weekdays</span>
                    <div class="edit-daily-weekdays" role="group" aria-labelledby="edit-daily-weekdays-label">
                        @foreach (var day in WeekdayOrder)
                        {
                            var selected = DailyWeekdays.Has(_weekdays, day);
                            <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                       Color="@(selected ? Color.Primary : Color.Default)"
                                       Size="Size.Small"
                                       Class="edit-daily-weekdays__chip"
                                       aria-pressed="@(selected ? "true" : "false")"
                                       aria-label="@day.ToString()"
                                       OnClick="@(() => ToggleWeekday(day))">@WeekdayShort(day)</MudButton>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                        @WeekdayHint()
                    </MudText>
                </div>
            }

            <div class="hab-modal__section">
                <span class="hab-modal__section-label">
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>
                    Tags
                </span>
                <TagPicker @bind-Tags="_tags" @bind-Tags:after="OnTagsEdited" TriggerId="edit-daily-tags-trigger" @ref="_tagPicker"/>
            </div>

            <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                <span class="hab-modal__section-label">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" Style="color:var(--hab-accent-streak); margin-right: 4px;" aria-hidden="true" />
                    Streaks
                </span>
                <div class="edit-daily-streak-stats" aria-live="polite" title="@StreakTooltip">
                    @if (_streaksLoading)
                    {
                        <MudSkeleton Width="100%" Height="44px" SkeletonType="SkeletonType.Rectangle" />
                    }
                    else if (_streaksAvailable)
                    {
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">@_currentStreak</span>
                            <span class="edit-daily-streak-stat__label">Current</span>
                        </div>
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">@_previousStreak</span>
                            <span class="edit-daily-streak-stat__label">Previous</span>
                        </div>
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">@_longestStreak</span>
                            <span class="edit-daily-streak-stat__label">Longest</span>
                        </div>
                    }
                    else
                    {
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">@_counter</span>
                            <span class="edit-daily-streak-stat__label">Current</span>
                        </div>
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">-</span>
                            <span class="edit-daily-streak-stat__label">Previous</span>
                        </div>
                        <div class="edit-daily-streak-stat">
                            <span class="edit-daily-streak-stat__value">-</span>
                            <span class="edit-daily-streak-stat__label">Longest</span>
                        </div>
                    }
                </div>
                <span class="hab-modal__section-label" style="margin-top:0.6rem;">Adjust the streak</span>
                <div class="edit-daily-streak-input">
                    <MudNumericField @bind-Value="_counter" @bind-Value:after="OnCounterEdited" Variant="Variant.Outlined" Class="edit-daily-streak-input__field" Min="0" Max="9999" HideSpinButtons="true" Margin="Margin.Dense" aria-label="Adjust the streak"/>
                </div>
                <button type="button" class="edit-daily-heatmap-btn" style="margin-top:0.6rem;" @onclick="OpenHeatmapDialogAsync">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="edit-daily-heatmap-btn__icon" aria-hidden="true" />
                    <span>View heatmap</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.2" fill="none" style="margin-left:auto; opacity:0.55;"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </div>

            <EditDialogFooterActions OnArchive="ArchiveAsync" OnDelete="DeleteAsync"/>
        </div>
    </div>
</DialogContent>
</MudDialog>

@code {
    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private DateTime? _startDate;
    private DailyRepeatType _repeat = DailyRepeatType.Daily;
    private int _repeatInterval = 1;
    private int _weekdays;
    private List<ChecklistRow> _checklistRows = [];
    private int _counter;
    private int _currentStreak;
    private int _previousStreak;
    private int _longestStreak;
    private bool _streaksLoading = true;
    private bool _streaksAvailable;

    private static readonly DayOfWeek[] WeekdayOrder =
    [
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday,
        DayOfWeek.Sunday,
    ];

    private static string WeekdayShort(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Mon",
        DayOfWeek.Tuesday => "Tue",
        DayOfWeek.Wednesday => "Wed",
        DayOfWeek.Thursday => "Thu",
        DayOfWeek.Friday => "Fri",
        DayOfWeek.Saturday => "Sat",
        DayOfWeek.Sunday => "Sun",
        _ => day.ToString(),
    };

    protected override string BatchDescription => $"Edit \"{Item.Title}\"";

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _counter = Item.Counter;
        _currentStreak = Item.Counter;
        _startDate = Item.DailyStartDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
        _repeat = Item.DailyRepeat;
        _repeatInterval = Item.DailyRepeatInterval < 1 ? 1 : Item.DailyRepeatInterval;
        _weekdays = DailyWeekdays.Normalize(Item.DailyWeekdays);
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
        await LoadStreaksAsync();
    }

    private string StreakTooltip =>
        $"Current streak: {_currentStreak} days. Previous streak: {_previousStreak} days. Longest streak: {_longestStreak} days.";

    private async Task LoadStreaksAsync()
    {
        _streaksLoading = true;
        try
        {
            var view = await StatsReader.GetDailyContributionsAsync(DailyGraphPeriods.Rolling370Days);
            var graph = view.Graphs.FirstOrDefault(g => g.BoardItemId == Item.Id);
            if (graph is not null)
            {
                _currentStreak = graph.CurrentStreak;
                _previousStreak = graph.PreviousStreak;
                _longestStreak = Math.Max(graph.LongestStreak, graph.CurrentStreak);
                _streaksAvailable = true;
            }
            else
            {
                _currentStreak = Item.Counter;
                _streaksAvailable = false;
            }
        }
        catch
        {
            _currentStreak = Item.Counter;
            _streaksAvailable = false;
        }
        finally
        {
            _streaksLoading = false;
        }
    }

    private void OnShellClick() => _tagPicker?.Dismiss();
    private string RepeatUnitLabel() => _repeat switch
    {
        DailyRepeatType.Daily => _repeatInterval == 1 ? "day" : "days",
        DailyRepeatType.Weekly => _repeatInterval == 1 ? "week" : "weeks",
        DailyRepeatType.Monthly => _repeatInterval == 1 ? "month" : "months",
        DailyRepeatType.Yearly => _repeatInterval == 1 ? "year" : "years",
        _ => "days"
    };

    private string WeekdayHint()
    {
        if (_weekdays == 0)
        {
            return "No days selected repeats on the start date's weekday.";
        }

        if (_repeatInterval == 1)
        {
            return "Due on the selected days every week.";
        }

        return $"Due on the selected days every {_repeatInterval} weeks.";
    }
    private void OnTitleEdited() => ScheduleSave();
    private void OnNotesEdited() => ScheduleSave();
    private Task OnTagsEdited() => SaveNowAsync();
    private void OnChecklistEdited() => ScheduleSave(300);
    private void OnDiscreteEdited() => _ = SaveNowAsync();
    private void OnIntervalEdited() => ScheduleSave(400);
    private void OnCounterEdited() => ScheduleSave(400);

    private Task ToggleWeekday(DayOfWeek day)
    {
        _weekdays ^= 1 << (int)day;
        _weekdays = DailyWeekdays.Normalize(_weekdays);
        return SaveNowAsync();
    }

    protected override async Task SaveValuesAsync(CancellationToken cancellationToken = default)
    {
        var title = string.IsNullOrWhiteSpace(_title) ? Item.Title : _title.Trim();
        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        var start = _startDate is { } d ? DateOnly.FromDateTime(d.Date) : Item.DailyStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var interval = _repeatInterval < 1 ? 1 : Math.Min(999, _repeatInterval);
        var weekdays = _repeat == DailyRepeatType.Weekly ? DailyWeekdays.Normalize(_weekdays) : DailyWeekdays.None;
        await BoardData.UpdateDailyAsync(Item.Id, new UpdateDailyArgs(title, EditDialogHelpers.CleanStringPayload(_notes), tagsPayload, start, _repeat, interval, checklistPayload, _counter, null, null, weekdays), cancellationToken);
    }

    protected override EditDailyDialogResult BuildResult(EditDialogAction action)
    {
        var start = _startDate is { } d ? DateOnly.FromDateTime(d.Date) : Item.DailyStartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var interval = _repeatInterval < 1 ? 1 : Math.Min(999, _repeatInterval);
        var weekdays = _repeat == DailyRepeatType.Weekly ? DailyWeekdays.Normalize(_weekdays) : DailyWeekdays.None;
        return new EditDailyDialogResult(action, _title.Trim(), EditDialogHelpers.CleanStringPayload(_notes), EditDialogHelpers.CleanStringPayload(_tags), start, _repeat, interval, EditDialogHelpers.SerializeChecklistRows(_checklistRows), _counter, weekdays);
    }

    private void ArchiveAsync() => CloseWithAction(EditDialogAction.Archive);
    private void DeleteAsync() => CloseWithAction(EditDialogAction.Delete);
    private async Task OpenHeatmapDialogAsync()
    {
        var parameters = new DialogParameters<DailyHeatmapDialog> { { x => x.BoardItemId, Item.Id }, { x => x.Title, string.IsNullOrWhiteSpace(_title) ? Item.Title : _title } };
        await DialogService.ShowAsync<DailyHeatmapDialog>(string.Empty, parameters, DialogDefaults.Wide);
    }
}
