@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject GlobalTimerService TimerService
@inject IBoardDataService BoardDataService

<MudStack Class="board-shell" Spacing="2">
    <MudStack Spacing="0">
        @if (!string.IsNullOrWhiteSpace(SignedInEmail))
        {
        }
        <MudText Typo="Typo.h4">Habitinator</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Habits, dailies, and to-dos — one global timer for focus time.</MudText>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  ShowCloseIcon="false">
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">@_loadError</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@_isLoading"
                           OnClick="RetryLoadAsync">
                    Retry
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (_initialLoadComplete && _loadError is null)
    {
        <MudPaper Class="px-3 py-2" Outlined="true" Elevation="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudChip T="string"
                         Icon="@Icons.Material.Filled.FitnessCenter"
                         Text="@($"{Habits.Count} habits")"
                         Size="Size.Small"
                         Variant="Variant.Text"
                         Color="Color.Success" />
                <MudChip T="string"
                         Icon="@Icons.Material.Filled.Today"
                         Text="@($"{Dailies.Count(d => !d.IsCompleted)} dailies left")"
                         Size="Size.Small"
                         Variant="Variant.Text"
                         Color="Color.Primary" />
                <MudChip T="string"
                         Icon="@Icons.Material.Filled.Checklist"
                         Text="@($"{Todos.Count(t => !t.IsCompleted)} to-dos open")"
                         Size="Size.Small"
                         Variant="Variant.Text"
                         Color="Color.Warning" />
            </MudStack>
        </MudPaper>
    }

    <GlobalTimerPanel OnLogSaved="HandleTimerLogSaved" />

    @if (_loadError is null)
    {
        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" md="4">
                <HabiticaColumn Section="BoardSection.Habit" Items="Habits" OnChanged="OnBoardChanged" />
            </MudItem>
            <MudItem xs="12" md="4">
                <HabiticaColumn Section="BoardSection.Daily" Items="Dailies" OnChanged="OnBoardChanged" />
            </MudItem>
            <MudItem xs="12" md="4">
                <HabiticaColumn Section="BoardSection.Todo" Items="Todos" OnChanged="OnBoardChanged" />
            </MudItem>
        </MudGrid>
    }

    @if (!string.IsNullOrWhiteSpace(LastEvent))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@LastEvent</MudAlert>
    }
</MudStack>

@code {
    [Parameter]
    public string? SignedInEmail { get; set; }

    private List<BoardItem> Habits { get; set; } = [];
    private List<BoardItem> Dailies { get; set; } = [];
    private List<BoardItem> Todos { get; set; } = [];
    private string? LastEvent { get; set; }
    private bool _isLoading;
    private bool _initialLoadComplete;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await InitialLoadAsync();
    }

    private async Task OnBoardChanged()
    {
        await LoadBoardAsync();
    }

    private async Task InitialLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
            _initialLoadComplete = true;
        }
    }

    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        try
        {
            await LoadBoardAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex is InvalidOperationException
                ? ex.Message
                : "Could not load your board. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBoardAsync()
    {
        BoardSnapshot snapshot = await BoardDataService.GetSnapshotAsync();
        Habits = snapshot.Habits.ToList();
        Dailies = snapshot.Dailies.ToList();
        Todos = snapshot.Todos.ToList();
    }

    private void HandleTimerLogSaved(TimeSpan duration)
    {
        LastEvent = $"Timer log saved for {TimerService.TargetType ?? "Unassigned"} '{TimerService.TargetId ?? "-"}' with duration {duration:hh\\:mm\\:ss}.";
    }

    private static string EmailLocalPart(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return string.Empty;
        }

        int at = email.IndexOf('@');
        return at > 0 ? email[..at] : email;
    }

}
