@page "/auth/login"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<h1>Login</h1>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-info" role="alert">@_message</div>
}

<div class="d-flex flex-wrap gap-2 align-items-end">
    <form method="post" class="flex-grow-1" style="min-width: 240px;" action="/api/auth/cookie-login">
        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" name="Email" type="email" required autocomplete="username" value="" />
        </div>
        <div class="mb-3">
            <label for="password">Password</label>
            <input class="form-control" id="password" name="Password" type="password" required autocomplete="current-password" value="" />
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" id="remember" name="RememberMe" type="checkbox" value="true" />
            <label class="form-check-label" for="remember">Remember me</label>
        </div>
        <button class="btn btn-primary" type="submit">Login</button>
    </form>

    <form method="post" action="/api/auth/guest-login">
        <button class="btn btn-outline-secondary" type="submit">Use demo guest</button>
    </form>
</div>

@code {
    private string? _message;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Invalid login attempt.";
        }
        else if (q.ContainsKey("guest") && q["guest"] == "missing")
        {
            _message = "Demo guest user is not available.";
        }
        else if (q.ContainsKey("registered") && q["registered"] == "1")
        {
            _message = "Registration complete. You can sign in now.";
        }
    }
}
