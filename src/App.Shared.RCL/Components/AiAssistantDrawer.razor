    private async Task SendMessageAsync()
    {
        var raw = _inputText?.Trim();
        if (string.IsNullOrWhiteSpace(raw) || _isSending)
        {
            return;
        }

        if (raw.Equals("/help", StringComparison.OrdinalIgnoreCase))
        {
            _inputText = string.Empty;
            ActiveEntries.Add(new ChatEntry { Message = AiChatMessage.User(raw) });
            ActiveEntries.Add(new ChatEntry { Message = AiChatMessage.Assistant("Try /plan, /review, /suggest, /retro, or /timer. Use @@ to mention a board item by title.", _activeModel) });
            await PersistThreadsAsync();
            StateHasChanged();
            await ScrollToBottomAsync();
            return;
        }

        var text = ExpandSlashCommand(raw);
        _inputText = string.Empty;
        _mentionItems.Clear();
        var thread = _threads.FirstOrDefault(t => t.Id == _activeThreadId);
        if (thread is null)
        {
            EnsureThread();
            thread = _threads.First(t => t.Id == _activeThreadId);
        }
        thread.Entries.Add(new ChatEntry { Message = AiChatMessage.User(text) });
        thread.Title = text.Length <= 32 ? text : string.Concat(text.AsSpan(0, 31).ToString(), "…");
        thread.UpdatedAt = DateTime.UtcNow;
        var assistantEntry = new ChatEntry { Message = AiChatMessage.Assistant(string.Empty, _activeModel) };
        thread.Entries.Add(assistantEntry);
        _isSending = true;
        _isStreaming = true;
        StateHasChanged();

        await ScrollToBottomAsync();
        await PersistThreadsAsync();

        if (_streamCts is not null)
        {
            await _streamCts.CancelAsync();
            _streamCts.Dispose();
        }
        _streamCts = new CancellationTokenSource();
        var requestToken = _streamCts.Token;

        try
        {
            var request = new AiChatRequest
            {
                Messages = PruneContextMessages(thread.Entries.Take(thread.Entries.Count - 1).ToList()),
                ModelOverride = _activeModel,
                ClientTimeZoneId = TimeZoneInfo.Local.Id
            };

            var refreshedBoard = false;
            await foreach (var evt in AiService.StreamChatAsync(request, requestToken))
            {
                if (evt.Type == "tool_end" && evt.ToolExecution is not null)
                {
                    assistantEntry.Tools.Add(evt.ToolExecution);
                    if (!refreshedBoard)
                    {
                        refreshedBoard = true;
                        _ = RemoteRefresh.NotifyFromRemoteAsync(requestToken);
                    }
                    StateHasChanged();
                }
                else if (evt.Type == "delta" && !string.IsNullOrEmpty(evt.Text))
                {
                    assistantEntry.Message.Content = (assistantEntry.Message.Content ?? string.Empty) + evt.Text;
                    StateHasChanged();
                    await ScrollToBottomIfNearAsync();
                }
                else if (evt.Type == "done")
                {
                    if (!string.IsNullOrWhiteSpace(evt.Model))
                    {
                        assistantEntry.Message.Model = evt.Model;
                    }
                }
                else if (evt.Type == "error")
                {
                    var errorMsg = evt.Error ?? "Failed to receive response from AI provider.";
                    assistantEntry.Message.Content = $"⚠️ {errorMsg}";
                    Snackbar.Add(errorMsg, Severity.Error);
                }
            }

            if (refreshedBoard)
            {
                try
                {
                    await RemoteRefresh.NotifyFromRemoteAsync(requestToken);
                }
                catch
                {
                    // Best effort: board refresh must not fail the chat response.
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (string.IsNullOrWhiteSpace(assistantEntry.Message.Content))
            {
                assistantEntry.Message.Content = "Stopped. The board was not changed.";
            }
        }
        catch (Exception ex)
        {
            assistantEntry.Message.Content = $"⚠️ Request failed: {ex.Message}";
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSending = false;
            _isStreaming = false;
            thread.UpdatedAt = DateTime.UtcNow;
            StateHasChanged();
            await PersistThreadsAsync();
            await ScrollToBottomIfNearAsync();
        }
    }

    private static List<AiChatMessage> PruneContextMessages(List<ChatEntry> entries)
    {
        var recent = entries.TakeLast(14).ToList();
        var pruned = new List<AiChatMessage>();

        for (var i = 0; i < recent.Count; i++)
        {
            var msg = recent[i].Message;
            if (i < recent.Count - 4 && msg.Role == "assistant" && msg.ToolCalls is { Count: > 0 })
            {
                pruned.Add(new AiChatMessage
                {
                    Role = msg.Role,
                    Content = !string.IsNullOrWhiteSpace(msg.Content) ? msg.Content : "Executed board tools.",
                    Model = msg.Model
                });
            }
            else
            {
                pruned.Add(msg);
            }
        }

        return pruned;
    }

    private sealed record SuggestedActionItem(BoardSection Section, string Title);

    private static List<SuggestedActionItem> ExtractSuggestions(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return [];
        }

        var results = new List<SuggestedActionItem>();
        var lines = content.Split('\n');
        foreach (var line in lines)
        {
            var trimmed = line.Trim().TrimStart('-', '*', '•', '1', '2', '3', '4', '5', '.', ' ');
            BoardSection? sec = null;
            string? title = null;

            if (trimmed.StartsWith("[Habit]", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("Habit:", StringComparison.OrdinalIgnoreCase))
            {
                sec = BoardSection.Habit;
                title = trimmed[(trimmed.IndexOfAny([']', ':']) + 1)..].Trim();
            }
            else if (trimmed.StartsWith("[Daily]", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("Daily:", StringComparison.OrdinalIgnoreCase))
            {
                sec = BoardSection.Daily;
                title = trimmed[(trimmed.IndexOfAny([']', ':']) + 1)..].Trim();
            }
            else if (trimmed.StartsWith("[Todo]", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("Todo:", StringComparison.OrdinalIgnoreCase) || trimmed.StartsWith("To-do:", StringComparison.OrdinalIgnoreCase))
            {
                sec = BoardSection.Todo;
                title = trimmed[(trimmed.IndexOfAny([']', ':']) + 1)..].Trim();
            }

            if (sec.HasValue && !string.IsNullOrWhiteSpace(title) && title.Length < 60)
            {
                title = title.Trim('*', '"', '\'');
                if (!results.Any(r => r.Title.Equals(title, StringComparison.OrdinalIgnoreCase)))
                {
                    results.Add(new SuggestedActionItem(sec.Value, title));
                }
            }

            if (results.Count >= 4)
            {
                break;
            }
        }

        return results;
    }

