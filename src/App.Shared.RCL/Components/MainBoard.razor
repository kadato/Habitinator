    public async Task CreateItemPublicAsync(BoardSection section)
    {
        var defaultTitle = section switch
        {
            BoardSection.Habit => "New Habit",
            BoardSection.Daily => "New Daily",
            BoardSection.Todo => "New To Do",
            _ => "New Item"
        };
        try
        {
            var item = await BoardDataService.CreateItemAsync(section, defaultTitle);
            if (item is not null)
            {
                await OnBoardChanged();
                if (section == BoardSection.Habit) await OpenEditHabitPublicAsync(item);
                else if (section == BoardSection.Daily) await OpenEditDailyPublicAsync(item);
                else if (section == BoardSection.Todo) await OpenEditTodoPublicAsync(item);
            }
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Could not create item.", Severity.Error);
        }
    }



    private void HandleConflictDetected(object? sender, ConflictInfoEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            var options = new DialogOptions
            {
                CloseButton = false,
                CloseOnEscapeKey = false,
                NoHeader = true
            };
            
            var parameters = new DialogParameters<ConflictResolutionDialog>
            {
                { x => x.Conflict, e.Conflict }
            };

            var dialog = await DialogService.ShowAsync<ConflictResolutionDialog>(
                string.Empty, parameters, options);
            
            var result = await dialog.Result;
            if (result is not null && !result.Canceled && result.Data is ConflictResolutionChoice choice)
            {
                ConflictResolution.Resolve(e.Conflict.OperationId, choice);
            }
            else
            {
                ConflictResolution.Resolve(e.Conflict.OperationId, ConflictResolutionChoice.Cancel);
            }
            
            _lastLocalMutationTime = DateTimeOffset.UtcNow;
            await LoadBoardAsync();
        });
    }

