@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Hosting
@using global::App.Web.Client
@inject IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en" class="@GetInitialThemeClass()" data-user-email="@GetUserEmail()" data-server-theme="@GetServerTheme()" data-lighthouse="@(IsLighthouseRequest() ? "true" : "false")">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader />
    @if (HttpContext?.User?.Identity?.IsAuthenticated != true)
    {
        <!-- Prefetch WASM framework resources in the background for faster post-login startup -->
        <WasmPrefetchLinks />
    }
    <SiteHead/>
    <script>
        (function () {
            // Prevent link clicks from updating the URL without navigating before WebAssembly is loaded
            window.addEventListener('click', function(e) {
                if (window.habitinatorWasmLoaded) {
                    return;
                }
                let anchor = e.target.closest('a');
                if (!anchor) {
                    return;
                }
                if (anchor.hasAttribute('download') || anchor.target) {
                    return;
                }
                let href = anchor.getAttribute('href');
                if (!href || href.startsWith('#') || href.startsWith('javascript:')) {
                    return;
                }
                let url;
                try {
                    url = new URL(anchor.href, window.location.href);
                } catch (err) {
                    return;
                }
                if (url.origin !== window.location.origin) {
                    return;
                }
                console.log("Habitinator: Intercepted click on link before WASM loaded. Forcing full reload:", anchor.href);
                e.stopPropagation();
                e.preventDefault();
                window.location.href = anchor.href;
            }, true);

            try {
                const isLighthouse = document.documentElement.getAttribute('data-lighthouse') === 'true';
                const email = document.documentElement.getAttribute('data-user-email') || '';
                let isDark = false;
                let hasTheme = false;

                if (isLighthouse) {
                    isDark = true;
                    hasTheme = true;
                } else if (email) {
                    // Authenticated user: try local storage preference first
                    const key = 'user_preferences_v1_' + email;
                    let stored = localStorage.getItem(key) || localStorage.getItem('user_preferences_v1');
                    if (stored) {
                        const prefs = JSON.parse(stored);
                        if (prefs && typeof prefs.theme === 'number') {
                            if (prefs.theme === 2) {
                                isDark = true;
                                hasTheme = true;
                            } else if (prefs.theme === 1) {
                                isDark = false;
                                hasTheme = true;
                            } else if (prefs.theme === 0) {
                                isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                                hasTheme = true;
                            }
                        }
                    }

                    // Fallback to cookie if no local storage preference exists
                    if (!hasTheme) {
                        const cookies = document.cookie.split('; ');
                        const themeCookie = cookies.find(row => row.startsWith('habitinator_theme='));
                        if (themeCookie) {
                            const themeVal = themeCookie.split('=')[1];
                            isDark = (themeVal === 'dark');
                            hasTheme = true;
                        }
                    }
                }

                // If anonymous, or no preference found for authenticated user, always use system theme
                if (!hasTheme) {
                    isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                }

                const root = document.documentElement;
                if (isDark) {
                    root.classList.add('dark-theme');
                    root.classList.remove('light-theme');
                    root.style.colorScheme = 'dark';
                } else {
                    root.classList.add('light-theme');
                    root.classList.remove('dark-theme');
                    root.style.colorScheme = 'light';
                }

                // Sync the cookie so the server knows it on next loads
                const newTheme = isDark ? "dark" : "light";
                document.cookie = "habitinator_theme=" + newTheme + "; path=/; max-age=31536000; SameSite=Lax";

                // Check for mismatch between client-resolved theme and server-rendered theme.
                // If mismatch occurs, reload once so the server renders the correct theme.
                const serverTheme = document.documentElement.getAttribute('data-server-theme') || 'dark';
                if (serverTheme !== newTheme && navigator.cookieEnabled && !isLighthouse) {
                    try {
                        const redirectKey = 'habitinator_theme_redirect_' + newTheme;
                        if (!sessionStorage.getItem(redirectKey)) {
                            sessionStorage.setItem(redirectKey, '1');
                            window.location.reload();
                        }
                    } catch (e) {
                        // ignore sessionStorage security restrictions
                    }
                } else if (serverTheme === newTheme) {
                    try {
                        sessionStorage.removeItem('habitinator_theme_redirect_light');
                        sessionStorage.removeItem('habitinator_theme_redirect_dark');
                        sessionStorage.removeItem('habitinator_theme_redirected');
                    } catch (e) {
                        // ignore sessionStorage security restrictions
                    }
                }
            } catch (e) {
                console.error(e);
            }
        })();
    </script>
    <link rel="preload" href="@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Regular.woff2"]" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Medium.woff2"]" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Bold.woff2"]" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_framework/blazor.web.js"]" as="script" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_content/MudBlazor/MudBlazor.min.js"]" as="script" crossorigin="anonymous"/>

    <script>
        window.habitinatorAssets = {
            "lib/microsoft-signalr/signalr.min.js": "@Assets["lib/microsoft-signalr/signalr.min.js"]",
            "js/boardHub.js": "@Assets["js/boardHub.js"]",
            "_content/App.Shared.RCL/js/sortable.min.js": "@Assets["_content/App.Shared.RCL/js/sortable.min.js"]",
            "_content/App.Shared.RCL/js/boardSortable.js": "@Assets["_content/App.Shared.RCL/js/boardSortable.js"]",
            "_content/App.Shared.RCL/js/boardVisibility.js": "@Assets["_content/App.Shared.RCL/js/boardVisibility.js"]",
            "_content/App.Shared.RCL/js/dailyRetroSession.js": "@Assets["_content/App.Shared.RCL/js/dailyRetroSession.js"]",
            "_content/App.Shared.RCL/js/statisticsScrolling.js": "@Assets["_content/App.Shared.RCL/js/statisticsScrolling.js"]",
            "_content/App.Shared.RCL/js/focusTimerAlert.js": "@Assets["_content/App.Shared.RCL/js/focusTimerAlert.js"]",
            "_content/App.Shared.RCL/js/userTimezone.js": "@Assets["_content/App.Shared.RCL/js/userTimezone.js"]"
        };
    </script>

    <style>
        :root {
            --hab-bg-light: #f8fafc;
            --hab-bg-dark: #0b0f19;
        }
        html, body {
            background-color: var(--hab-bg-light);
        }
        html.dark-theme, html.dark-theme body {
            background-color: var(--hab-bg-dark);
        }
        @@media (prefers-color-scheme: dark) {
            html:not(.light-theme), html:not(.light-theme) body {
                background-color: var(--hab-bg-dark);
            }
        }

        /* Top Loading Bar */
        #habitinator-loading-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 50%, #3b82f6 100%);
            background-size: 200% 100%;
            opacity: 0;
            animation: habLoading 1.5s infinite linear, habFadeIn 0.3s forwards;
            animation-delay: 0s, 0.8s;
            z-index: 20000;
            transition: opacity 0.25s ease, visibility 0.25s ease;
        }
        @@keyframes habLoading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        @@keyframes habFadeIn {
            to { opacity: 1; }
        }
    </style>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]"/>
    <link rel="stylesheet" href="@Assets["_content/App.Shared.RCL/css/typography.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["_content/App.Shared.RCL/css/auth-pages.css"]"/>
    <link rel="stylesheet" href="@Assets["App.Web.styles.css"]" media="print" onload="this.media='all'"/>
    <noscript><link rel="stylesheet" href="@Assets["App.Web.styles.css"]"/></noscript>
    <style>
        @@font-face {
            font-family: "Plus Jakarta Sans";
            font-style: normal;
            font-weight: 400;
            font-display: swap;
            src: url("@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Regular.woff2"]") format("woff2");
        }

        @@font-face {
            font-family: "Plus Jakarta Sans";
            font-style: normal;
            font-weight: 500;
            font-display: swap;
            src: url("@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Medium.woff2"]") format("woff2");
        }

        @@font-face {
            font-family: "Plus Jakarta Sans";
            font-style: normal;
            font-weight: 700;
            font-display: swap;
            src: url("@Assets["_content/App.Shared.RCL/fonts/PlusJakartaSans-Bold.woff2"]") format("woff2");
        }
    </style>
    <ImportMap/>
    <link rel="icon" href="/favicon.ico" sizes="any"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    @* Fallback until the interactive circuit updates head; must match Routes render mode. *@
    <title>@SeoDefaults.DefaultTitle</title>
    <HeadOutlet @rendermode="GetRoutesRenderMode()"/>
</head>

<body>

<CascadingValue Value="@IsDarkTheme()" Name="IsDarkMode">
    <CascadingAuthenticationState>
        <Routes @rendermode="GetRoutesRenderMode()"/>
    </CascadingAuthenticationState>
</CascadingValue>
<ReconnectModal/>
<script src="@Assets["_content/App.Shared.RCL/js/scriptLoader.js"]" defer></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]" defer crossorigin="anonymous"></script>
<script src="@Assets["_framework/blazor.web.js"]" defer crossorigin="anonymous"></script>
<script>
    window.habitinatorSetWasmLoaded = function () {
        window.habitinatorWasmLoaded = true;
    };
    window.habitinatorRemoveLoadingBar = function () {
        window.habitinatorWasmLoaded = true;
        const el = document.getElementById('habitinator-loading-bar');
        if (el) {
            el.style.opacity = '0';
            el.style.visibility = 'hidden';
            setTimeout(() => el.remove(), 250);
        }
    };
    window.habitinatorSubmitForm = function (formId) {
        const form = document.getElementById(formId);
        if (form) {
            form.submit();
        }
    };
</script>
<script>
    if ('serviceWorker' in navigator) {
        if ('@(HostEnvironment.IsDevelopment() ? "true" : "false")' === 'true') {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                for (let registration of registrations) {
                    registration.unregister();
                }
            });
            if ('caches' in window) {
                caches.keys().then(function(names) {
                    for (let name of names) {
                        caches.delete(name);
                    }
                });
            }
        } else {
            navigator.serviceWorker.register('service-worker.published.js');
        }
    }
</script>
</body>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IComponentRenderMode? GetRoutesRenderMode()
    {
        if (HttpContext?.User?.Identity?.IsAuthenticated == true)
        {
            return InteractiveWebAssembly;
        }
        return null;
    }

    private bool IsDarkTheme()
    {
        if (HttpContext is not null && HttpContext.Request.Cookies.TryGetValue("habitinator_theme", out var theme))
        {
            return theme == "dark";
        }
        return true;
    }

    private string GetInitialThemeClass()
    {
        if (HttpContext is not null && HttpContext.Request.Cookies.TryGetValue("habitinator_theme", out var theme))
        {
            return theme == "dark" ? "dark-theme" : "light-theme";
        }
        return "";
    }

    private string GetUserEmail()
    {
        return HttpContext?.User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value 
            ?? HttpContext?.User?.Identity?.Name 
            ?? "";
    }

    private string GetServerTheme()
    {
        return IsDarkTheme() ? "dark" : "light";
    }

    private bool IsLighthouseRequest()
    {
        return HttpContext?.Request?.Headers?.ContainsKey("x-lighthouse") == true;
    }
}

</html>
