    [JSInvokable]
    public async Task OnDigitPressed(int digit)
    {
        await InvokeAsync(async () =>
        {
            var index = digit - 1;
            if (index >= 0 && index <= 2)
            {
                _mobileSectionIndex = index;
                StateHasChanged();

                if (index == 0)
                {
                    if (_habitColumn is not null) await _habitColumn.FocusDraftAsync();
                    if (_habitColumnMobile is not null) await _habitColumnMobile.FocusDraftAsync();
                }
                else if (index == 1)
                {
                    if (_dailyColumn is not null) await _dailyColumn.FocusDraftAsync();
                    if (_dailyColumnMobile is not null) await _dailyColumnMobile.FocusDraftAsync();
                }
                else if (index == 2)
                {
                    if (_todoColumn is not null) await _todoColumn.FocusDraftAsync();
                    if (_todoColumnMobile is not null) await _todoColumnMobile.FocusDraftAsync();
                }
            }
        });
    }

