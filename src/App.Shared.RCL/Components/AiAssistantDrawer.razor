    private async Task DeleteThreadAsync(string threadId)
    {
        if (_threads.Count <= 1)
        {
            return;
        }
        var thread = _threads.FirstOrDefault(t => t.Id == threadId);
        if (thread is null)
        {
            return;
        }

        _threads.Remove(thread);
        if (_activeThreadId == threadId)
        {
            _activeThreadId = _threads[0].Id;
        }

        await PersistThreadsAsync();
        StateHasChanged();
    }

