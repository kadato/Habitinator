@inherits AutosaveEditDialogBase<EditHabitDialogResult>

<MudDialog Class="edit-daily-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(24rem, calc(100vw - 2rem));">
<DialogContent>
<div class="edit-daily-shell" @onclick="OnShellClick">
    <EditDialogHeader TitleText="Edit habit"
                      TitlePlaceholder="Habit title"
                      @bind-Title="_title"
                      @bind-Title:after="OnTitleEdited"
                      @bind-Notes="_notes"
                      @bind-Notes:after="OnNotesEdited"
                      OnClose="CloseAsync"
                      SaveStatus="SaveStatus"/>

    <div class="edit-daily-body">
        <ChecklistEditor @bind-Value="_checklistRows"
                         @bind-Value:after="OnChecklistEdited"/>

        <fieldset class="mb-3" style="border: none; padding: 0; margin: 0;">
            <legend class="edit-daily-label-body d-block mb-2" style="font-size: 0.75rem;">Which counters to show</legend>
            <div class="habit-track">
                <button type="button"
                        class="habit-track__option @(_trackPlus ? "habit-track__option--on-good" : string.Empty)"
                        @onclick="ToggleTrackPlus"
                        @attributes="PlusAria">
                    <span class="habit-track__circle habit-track__circle--good">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="habit-track__label">Plus</span>
                </button>
                <button type="button"
                        class="habit-track__option @(_trackMinus ? "habit-track__option--on-bad" : string.Empty)"
                        @onclick="ToggleTrackMinus"
                        @attributes="MinusAria">
                    <span class="habit-track__circle habit-track__circle--bad">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="habit-track__label">Minus</span>
                </button>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 mb-0">Turn on one or both. At least one stays on.</MudText>
        </fieldset>

        <fieldset class="mb-3" style="border: none; padding: 0; margin: 0;">
            <legend class="edit-daily-label-body d-block mb-1" style="font-size: 0.75rem;">Tags</legend>
            <TagPicker @bind-Tags="_tags"
                       @bind-Tags:after="OnTagsEdited"
                       TriggerId="edit-habit-tags-trigger" @ref="_tagPicker"/>
        </fieldset>

        <fieldset class="mb-3" style="border: none; padding: 0; margin: 0;">
            <legend class="edit-daily-label-body d-block mb-1 mt-2" style="font-size: 0.75rem;">Reset counter</legend>
            <MudSelect T="HabitResetPeriod"
                       @bind-Value="_resetPeriod"
                       @bind-Value:after="OnDiscreteEdited"
                       Variant="Variant.Outlined"
                       Class="edit-daily-field-body edit-habit-select"
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft"
                       Dense="true">
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Daily">Daily</MudSelectItem>
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Weekly">Weekly</MudSelectItem>
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Monthly">Monthly</MudSelectItem>
            </MudSelect>
        </fieldset>

        <MudExpansionPanels Class="edit-daily-advanced mt-2" Elevation="0">
            <MudExpansionPanel @bind-Expanded="_advancedOpen">
                <TitleContent>
                    <MudText Typo="Typo.body2" Class="edit-daily-label-body">Advanced settings</MudText>
                </TitleContent>
                <ChildContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">Adjust + count</MudText>
                    <div class="counter-adjust mb-3">
                        <button type="button"
                                class="counter-adjust__btn counter-adjust__btn--bad"
                                aria-label="Decrease + count"
                                @onclick="DecrementPlusLocal"
                                disabled="@(_counter < 1)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                        <MudNumericField @bind-Value="_counter"
                                         @bind-Value:after="OnCounterEdited"
                                         Variant="Variant.Outlined"
                                         Class="counter-adjust__field"
                                         Min="0"
                                         HideSpinButtons="true"
                                         Margin="Margin.Dense"/>
                        <button type="button"
                                class="counter-adjust__btn counter-adjust__btn--good"
                                aria-label="Increase + count"
                                @onclick="IncrementPlusLocal">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">Adjust − count</MudText>
                    <div class="counter-adjust">
                        <button type="button"
                                class="counter-adjust__btn counter-adjust__btn--bad"
                                aria-label="Decrease − count"
                                @onclick="DecrementMinusLocal"
                                disabled="@(_negativeCounter < 1)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                        <MudNumericField @bind-Value="_negativeCounter"
                                         @bind-Value:after="OnCounterEdited"
                                         Variant="Variant.Outlined"
                                         Class="counter-adjust__field"
                                         Min="0"
                                         HideSpinButtons="true"
                                         Margin="Margin.Dense"/>
                        <button type="button"
                                class="counter-adjust__btn counter-adjust__btn--good"
                                aria-label="Increase − count"
                                @onclick="IncrementMinusLocal">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                        </button>
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>

        <EditDialogFooterActions OnArchive="ArchiveAsync" OnDelete="DeleteAsync"/>
    </div>
</div>
</DialogContent>
</MudDialog>

@code {
    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private bool _trackPlus = true;
    private bool _trackMinus = true;
    private HabitResetPeriod _resetPeriod = HabitResetPeriod.Daily;
    private int _counter;
    private int _negativeCounter;
    private bool _advancedOpen;

    private List<ChecklistRow> _checklistRows = [];

    protected override string BatchDescription => $"Edit \"{Item.Title}\"";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _trackPlus = Item.TrackPlus;
        _trackMinus = Item.TrackMinus;
        _resetPeriod = Item.ResetPeriod;
        _counter = Item.Counter;
        _negativeCounter = Item.NegativeCounter;
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
    }

    private void OnShellClick()
    {
        _tagPicker?.Dismiss();
    }

    private void OnTitleEdited()
    {
        ScheduleSave();
    }

    private void OnNotesEdited()
    {
        ScheduleSave();
    }

    private Task OnTagsEdited()
    {
        return SaveNowAsync();
    }

    private void OnChecklistEdited()
    {
        ScheduleSave(300);
    }

    private void OnDiscreteEdited()
    {
        _ = SaveNowAsync();
    }

    private void OnCounterEdited()
    {
        ScheduleSave(400);
    }

    private void ToggleTrackPlus()
    {
        _trackPlus = !_trackPlus;
        if (!_trackPlus && !_trackMinus)
        {
            _trackMinus = true;
        }

        _ = SaveNowAsync();
    }

    private void ToggleTrackMinus()
    {
        _trackMinus = !_trackMinus;
        if (!_trackPlus && !_trackMinus)
        {
            _trackPlus = true;
        }

        _ = SaveNowAsync();
    }

    protected override async Task SaveValuesAsync(CancellationToken cancellationToken = default)
    {
        var title = string.IsNullOrWhiteSpace(_title) ? Item.Title : _title.Trim();
        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        await BoardData.UpdateHabitAsync(
            Item.Id,
            new UpdateHabitArgs(
                title,
                EditDialogHelpers.CleanStringPayload(_notes),
                tagsPayload,
                _trackPlus,
                _trackMinus,
                _resetPeriod,
                _counter,
                _negativeCounter,
                checklistPayload),
            cancellationToken);
    }

    protected override EditHabitDialogResult BuildResult(EditDialogAction action)
    {
        return new EditHabitDialogResult(
            action,
            _title.Trim(),
            EditDialogHelpers.CleanStringPayload(_notes),
            EditDialogHelpers.CleanStringPayload(_tags),
            _trackPlus,
            _trackMinus,
            _resetPeriod,
            _counter,
            _negativeCounter,
            EditDialogHelpers.SerializeChecklistRows(_checklistRows));
    }

    private void IncrementPlusLocal()
    {
        _counter++;
        _ = SaveNowAsync();
    }

    private void DecrementPlusLocal()
    {
        if (_counter > 0)
        {
            _counter--;
        }

        _ = SaveNowAsync();
    }

    private void IncrementMinusLocal()
    {
        _negativeCounter++;
        _ = SaveNowAsync();
    }

    private void DecrementMinusLocal()
    {
        if (_negativeCounter > 0)
        {
            _negativeCounter--;
        }

        _ = SaveNowAsync();
    }

    private void ArchiveAsync()
    {
        CloseWithAction(EditDialogAction.Archive);
    }

    private void DeleteAsync()
    {
        CloseWithAction(EditDialogAction.Delete);
    }

    private Dictionary<string, object> PlusAria => new() { { "aria-pressed", _trackPlus ? "true" : "false" } };
    private Dictionary<string, object> MinusAria => new() { { "aria-pressed", _trackMinus ? "true" : "false" } };
}
