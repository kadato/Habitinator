    private async Task DeleteAllCompletedTodosAsync()
    {
        if (Section != BoardSection.Todo || _todoFilter != TodoListFilter.Complete)
        {
            return;
        }

        var toDelete = FilterTodos();
        if (toDelete.Count == 0)
        {
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete all completed to-dos?",
            $"This will permanently remove {toDelete.Count} completed to-do(s) matching your current view. This cannot be undone.",
            "Delete all",
            null,
            "Cancel");

        if (confirmed != true)
        {
            return;
        }

        var deleted = 0;
        try
        {
            using (UndoService.BeginBatch($"Delete {toDelete.Count} completed to-dos"))
            {
                foreach (var item in toDelete)
                {
                    if (await BoardData.DeleteItemAsync(BoardSection.Todo, item.Id))
                    {
                        deleted++;
                    }
                }
            }

            await OnChanged.InvokeAsync();
            if (deleted == toDelete.Count)
            {
                await Notifier.NotifyAsync($"Deleted {deleted} completed to-do(s).", Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync(
                    $"Removed {deleted} of {toDelete.Count} to-do(s). Some could not be deleted.",
                    Severity.Warning);
            }
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Something went wrong. Check your connection and try again.", Severity.Error);
        }
    }

    private async Task<bool> TryMutateAsync(Func<Task> work)
    {
        try
        {
            await work();
            await OnChanged.InvokeAsync();
            return true;
        }
        catch (Exception)
        {
            await Notifier.NotifyAsync("Something went wrong. Check your connection and try again.", Severity.Error);
            return false;
        }
    }

