@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject GlobalTimerService TimerService
@implements IDisposable

<MudCard Class="timer-panel" Elevation="0" Outlined="true">
    <MudCardContent Class="pa-4">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudAvatar Class="timer-header-avatar" Color="Color.Tertiary" Variant="Variant.Filled" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Focus timer</MudText>
                    <MudText Typo="Typo.subtitle1" Class="timer-header-title">Global session clock</MudText>
                </MudStack>
                <MudSpacer />
                @if (TimerService.IsRunning)
                {
                    <MudChip T="string"
                             Class="timer-status-chip"
                             Icon="@Icons.Material.Filled.PlayCircle"
                             Color="Color.Success"
                             Size="Size.Small"
                             Variant="Variant.Filled"
                             Text="Running" />
                }
                else if (TimerService.Elapsed > TimeSpan.Zero)
                {
                    <MudChip T="string"
                             Class="timer-status-chip"
                             Icon="@Icons.Material.Filled.PauseCircle"
                             Color="Color.Warning"
                             Size="Size.Small"
                             Variant="Variant.Filled"
                             Text="Paused" />
                }
                else
                {
                    <MudChip T="string"
                             Class="timer-status-chip"
                             Icon="@Icons.Material.Filled.HourglassEmpty"
                             Color="Color.Default"
                             Size="Size.Small"
                             Variant="Variant.Outlined"
                             Text="Idle" />
                }
            </MudStack>

            <div class="timer-body-row">
                <div class="timer-main-col">
                    <div class="timer-main-inner">
                        <MudText Typo="Typo.h3" Class="timer-value">@TimerService.Elapsed.ToString(@"hh\:mm\:ss")</MudText>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="timer-target-input-row">
                            <MudIcon Icon="@GetTimerTargetLeadIcon()"
                                     Color="Color.Default"
                                     Size="Size.Small"
                                     Class="timer-target-type-icon"
                                     title="@GetTimerTargetLeadTitle()" />
                            <MudAutocomplete T="string"
                                             Value="@_sessionTargetText"
                                             ValueChanged="OnSessionTargetValueChanged"
                                             SearchFunc="SearchSessionTargetsAsync"
                                             Label="Session target"
                                             Placeholder="Search board or type a custom label"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Class="timer-target-field flex-grow-1"
                                             Immediate="true"
                                             CoerceValue="true"
                                             Strict="false"
                                             MinCharacters="0"
                                             Clearable="true"
                                             ResetValueOnEmptyText="true">
                                <ItemTemplate Context="rowKey">
                                    @{
                                        _sessionLabelToTarget.TryGetValue(rowKey, out (string TargetType, string TargetTitle, Guid _) entry);
                                    }
                                    <MudStack Row="true"
                                              Spacing="2"
                                              AlignItems="AlignItems.Center"
                                              Class="mud-width-full">
                                        <MudIcon Color="Color.Default"
                                                 Icon="@BoardSectionVisuals.GetMudIconForTargetType(entry.TargetType)"
                                                 Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@rowKey</MudText>
                                    </MudStack>
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudStack>
                    </div>
                </div>

                <div class="timer-actions-col">
                    <div class="timer-actions-stack">
                        <div class="timer-action-slot">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Class="timer-btn timer-btn--start"
                                       FullWidth="true"
                                       OnClick="Start"
                                       Disabled="@TimerService.IsRunning">
                                Start
                            </MudButton>
                        </div>
                        <div class="timer-action-slot">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Pause"
                                       Class="timer-btn timer-btn--pause"
                                       FullWidth="true"
                                       OnClick="Pause"
                                       Disabled="@(!TimerService.IsRunning)">
                                Pause
                            </MudButton>
                        </div>
                        <div class="timer-action-slot">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       Class="timer-btn timer-btn--stop"
                                       FullWidth="true"
                                       OnClick="StopAndLog">
                                Stop &amp; log
                            </MudButton>
                        </div>
                    </div>
                </div>
            </div>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public EventCallback<TimeSpan> OnLogSaved { get; set; }

    [Parameter]
    public IReadOnlyList<BoardItem> Habits { get; set; } = [];

    [Parameter]
    public IReadOnlyList<BoardItem> Dailies { get; set; } = [];

    [Parameter]
    public IReadOnlyList<BoardItem> Todos { get; set; } = [];

    private PeriodicTimer? _uiTick;
    private CancellationTokenSource? _uiTickCts;
    private string _sessionTargetText = string.Empty;
    private readonly List<string> _sessionTargetOptions = [];
    private readonly Dictionary<string, (string TargetType, string TargetTitle, Guid ItemId)> _sessionLabelToTarget = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _uiTickCts = new CancellationTokenSource();
        _uiTick = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunUiTickAsync(_uiTickCts.Token);
    }

    protected override void OnParametersSet()
    {
        RebuildSessionTargetOptions();
        _sessionTargetText = FormatTargetForField(TimerService);
    }

    private async Task RunUiTickAsync(CancellationToken cancellationToken)
    {
        if (_uiTick is null)
        {
            return;
        }

        try
        {
            while (await _uiTick.WaitForNextTickAsync(cancellationToken))
            {
                if (TimerService.IsRunning)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during disposal.
        }
    }

    private void RebuildSessionTargetOptions()
    {
        _sessionLabelToTarget.Clear();
        _sessionTargetOptions.Clear();

        var all = new List<(BoardSection Section, BoardItem Item)>();
        foreach (BoardItem h in Habits)
        {
            all.Add((BoardSection.Habit, h));
        }

        foreach (BoardItem d in Dailies)
        {
            all.Add((BoardSection.Daily, d));
        }

        foreach (BoardItem t in Todos)
        {
            all.Add((BoardSection.Todo, t));
        }

        IEnumerable<IGrouping<string, (BoardSection Section, BoardItem Item)>> groups = all
            .GroupBy(x => x.Item.Title, StringComparer.OrdinalIgnoreCase);

        foreach (IGrouping<string, (BoardSection Section, BoardItem Item)> g in groups)
        {
            bool disambiguate = g.Count() > 1;
            foreach ((BoardSection section, BoardItem item) in g
                         .OrderBy(x => x.Section)
                         .ThenBy(x => x.Item.Id))
            {
                string st = section.ToString();
                string key = disambiguate
                    ? item.Title + " · " + item.Id.ToString("N")[..4]
                    : item.Title;
                if (_sessionLabelToTarget.ContainsKey(key))
                {
                    key = item.Title + " · " + item.Id.ToString("N");
                }

                _sessionLabelToTarget[key] = (st, item.Title, item.Id);
                _sessionTargetOptions.Add(key);
            }
        }
    }

    private string FormatTargetForField(GlobalTimerService timer)
    {
        if (string.IsNullOrEmpty(timer.TargetId))
        {
            return string.Empty;
        }

        if (timer.TargetType is "Session" or null)
        {
            return timer.TargetId;
        }

        if (timer.TargetType is "Habit" or "Daily" or "Todo")
        {
            foreach (string k in _sessionTargetOptions)
            {
                if (_sessionLabelToTarget.TryGetValue(
                        k,
                        out (string TargetType, string TargetTitle, Guid ItemId) m)
                    && m.TargetType == timer.TargetType
                    && m.TargetTitle == timer.TargetId)
                {
                    return k;
                }
            }
        }

        return timer.TargetId;
    }

    private string GetTimerTargetLeadIcon()
    {
        if (string.IsNullOrEmpty(TimerService.TargetId))
        {
            return Icons.Material.Outlined.Label;
        }

        if (string.IsNullOrEmpty(TimerService.TargetType) || TimerService.TargetType == "Session")
        {
            return BoardSectionVisuals.GetMudIconForTargetType("Session");
        }

        return BoardSectionVisuals.GetMudIconForTargetType(TimerService.TargetType);
    }

    private string GetTimerTargetLeadTitle() =>
        string.IsNullOrEmpty(TimerService.TargetId)
            ? "No target"
            : (TimerService.TargetType switch
            {
                "Habit" => "Habit",
                "Daily" => "Daily",
                "Todo" => "To-do",
                "Session" => "Session",
                _ => "Session"
            });

    private Task<IEnumerable<string>> SearchSessionTargetsAsync(string value, CancellationToken cancellationToken) =>
        Task.FromResult(SearchSessionTargets(value));

    private IEnumerable<string> SearchSessionTargets(string value)
    {
        if (_sessionTargetOptions.Count == 0)
        {
            return Array.Empty<string>();
        }

        string v = value.Trim();
        if (v.Length == 0)
        {
            return _sessionTargetOptions;
        }

        return _sessionTargetOptions.Where(
            s =>
            {
                if (s.Contains(v, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }

                return _sessionLabelToTarget.TryGetValue(s, out var row)
                       && row.TargetTitle.Contains(v, StringComparison.OrdinalIgnoreCase);
            });
    }

    private void OnSessionTargetValueChanged(string? value)
    {
        string text = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            TimerService.SetManualTarget(null);
        }
        else if (_sessionLabelToTarget.TryGetValue(text, out (string TargetType, string TargetTitle, Guid ItemId) mapped))
        {
            TimerService.SelectTarget(mapped.TargetType, mapped.TargetTitle);
        }
        else
        {
            TimerService.SetManualTarget(text);
        }

        _sessionTargetText = FormatTargetForField(TimerService);
    }

    private void Start() => TimerService.Start();

    private void Pause() => TimerService.Pause();

    private async Task StopAndLog()
    {
        TimeSpan elapsed = TimerService.Stop();
        if (elapsed > TimeSpan.Zero)
        {
            await OnLogSaved.InvokeAsync(elapsed);
        }
    }

    public void Dispose()
    {
        _uiTickCts?.Cancel();
        _uiTick?.Dispose();
        _uiTickCts?.Dispose();
    }
}
