@using System.Globalization
@using App.Shared.RCL
@inject IUserPreferencesService PreferencesService
@inject IUserNotifier Notifier
@inject IUserTimeZoneService TimeZoneService

<MudStack Spacing="3">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5" HtmlTag="h2">Profile and preferences</MudText>
    }

    @if (_loadError is not null)
    {
        <div class="settings-load-fallback">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Large" Class="settings-load-fallback__icon"  aria-hidden="true" />
            <MudText Typo="Typo.subtitle2" Class="settings-load-fallback__title">Preferences unavailable</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Couldn't load preferences. Try again.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium" Class="mt-2" OnClick="RetryLoadAsync">Retry</MudButton>
        </div>
    }
    else if (_loading)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="120px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="250px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="150px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="160px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="350px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="180px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="80px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="280px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Account</MudText>
                <MudTextField T="string" Label="Display name"
                              Variant="Variant.Outlined"
                              dense="true"
                              MaxLength="40"
                              Immediate="true"
                              Error="@(_displayNameError is not null)"
                              ErrorText="@_displayNameError"
                              Value="_displayName"
                              ValueChanged="OnDisplayNameChanged"
                              OnBlur="AutoSaveAsync"/>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Pomodoro Timer</MudText>
                <div class="settings-stepper-grid">
                    <div class="settings-stepper">
                        <span class="settings-stepper__label">Work duration <span class="settings-stepper__unit">minutes</span></span>
                        <div class="settings-stepper__row">
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--minus" aria-label="Decrease work duration" @onclick="DecrementWorkDurationAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                            <MudNumericField T="int" aria-label="Work duration in minutes"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Min="1" Max="180"
                                             Class="settings-stepper__field"
                                             Value="_model.PomodoroWorkDurationMinutes"
                                             ValueChanged="OnWorkDurationChanged"
                                             Immediate="true"
                                             OnBlur="AutoSaveAsync" />
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--plus" aria-label="Increase work duration" @onclick="IncrementWorkDurationAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                        </div>
                    </div>
                    <div class="settings-stepper">
                        <span class="settings-stepper__label">Short break <span class="settings-stepper__unit">minutes</span></span>
                        <div class="settings-stepper__row">
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--minus" aria-label="Decrease short break" @onclick="DecrementShortBreakAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                            <MudNumericField T="int" aria-label="Short break in minutes"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Min="1" Max="60"
                                             Class="settings-stepper__field"
                                             Value="_model.PomodoroShortBreakMinutes"
                                             ValueChanged="OnShortBreakChanged"
                                             Immediate="true"
                                             OnBlur="AutoSaveAsync" />
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--plus" aria-label="Increase short break" @onclick="IncrementShortBreakAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                        </div>
                    </div>
                    <div class="settings-stepper">
                        <span class="settings-stepper__label">Long break <span class="settings-stepper__unit">minutes</span></span>
                        <div class="settings-stepper__row">
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--minus" aria-label="Decrease long break" @onclick="DecrementLongBreakAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                            <MudNumericField T="int" aria-label="Long break in minutes"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Min="1" Max="120"
                                             Class="settings-stepper__field"
                                             Value="_model.PomodoroLongBreakMinutes"
                                             ValueChanged="OnLongBreakChanged"
                                             Immediate="true"
                                             OnBlur="AutoSaveAsync" />
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--plus" aria-label="Increase long break" @onclick="IncrementLongBreakAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                        </div>
                    </div>
                    <div class="settings-stepper">
                        <span class="settings-stepper__label">Sessions before long break</span>
                        <div class="settings-stepper__row">
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--minus" aria-label="Decrease sessions before long break" @onclick="DecrementCyclesAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                            <MudNumericField T="int" aria-label="Sessions before long break"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Min="1" Max="12"
                                             Class="settings-stepper__field"
                                             Value="_model.PomodoroCyclesBeforeLongBreak"
                                             ValueChanged="OnCyclesChanged"
                                             Immediate="true"
                                             OnBlur="AutoSaveAsync" />
                            <button type="button" class="settings-stepper__btn settings-stepper__btn--plus" aria-label="Increase sessions before long break" @onclick="IncrementCyclesAsync"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                        </div>
                    </div>
                </div>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Date and time</MudText>
                <MudTextField T="string"
                              Label="Date format"
                              Variant="Variant.Outlined"
                              dense="true"
                              Value="_model.DateFormat"
                              ValueChanged="OnDateFormatChanged"
                              Immediate="true"
                              Error="@(_dateFormatError is not null)"
                              ErrorText="@_dateFormatError"
                              OnBlur="AutoSaveAsync"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Preview: @_datePreview
                </MudText>
                <MudSelect T="DayOfWeek" Label="Week starts on" Variant="Variant.Outlined" dense="true"
                           Value="_model.WeekStartDay" ValueChanged="OnWeekStartChanged">
                    <MudSelectItem Value="@DayOfWeek.Monday">Monday</MudSelectItem>
                    <MudSelectItem Value="@DayOfWeek.Sunday">Sunday</MudSelectItem>
                    <MudSelectItem Value="@DayOfWeek.Saturday">Saturday</MudSelectItem>
                </MudSelect>
                <MudTimePicker Label="Day starts at"
                               Time="_dayStart"
                               TimeChanged="OnDayStartChanged"
                               TimeEditMode="TimeEditMode.Normal"/>
                @if (_dayStartError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_dayStartError</MudText>
                }
                <MudSelect T="string" Label="Timezone" Variant="Variant.Outlined" dense="true"
                           Value="_timeZoneSelection" ValueChanged="OnTimeZoneChanged">
                    <MudSelectItem Value="@AutoTimeZoneValue">Auto (@_detectedTimeZoneLabel)</MudSelectItem>
                    @foreach (var tz in _timeZones)
                    {
                        <MudSelectItem Value="@tz.Id">@tz.Label</MudSelectItem>
                    }
                </MudSelect>
                @if (_timeZonesLoading)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Loading...</MudText>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Current: @_resolvedTimeZoneLabel
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Theme</MudText>
                <div class="d-flex flex-row align-center flex-wrap gap-2">
                    <MudSwitch T="bool"
                               Value="_useSystemTheme"
                               ValueChanged="OnUseSystemThemeChanged"
                               Color="Color.Primary"
                               Label="Sync with system" />
                    <MudButton Variant="@(_pinnedThemeBtnVariant)"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               Class="text-transform-none"
                               Disabled="@_useSystemTheme"
                               OnClick="TogglePinnedTheme">
                        @_pinnedThemeBtnLabel
                    </MudButton>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_themeStatusText
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Keyboard Shortcuts</MudText>
                <MudSwitch T="bool" Label="Enable keyboard shortcuts" Color="Color.Primary"
                           Value="_model.EnableKeyboardShortcuts" ValueChanged="OnEnableKeyboardShortcutsChanged" />
            </MudStack>
        </MudPaper>

        @* Settings are saved automatically on change or blur *@
    }
</MudStack>
