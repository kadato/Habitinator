@using Microsoft.JSInterop
@using App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Services.Remote
@inject IUserNotifier Notifier
@inject IAccountActionsService AccountActions
@inject IUserDataExportService Export
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IBoardSyncStatus BoardSync
@inject IUserDataImportService ImportService

<MudStack Spacing="3">
    @if (BoardSync.IsOffline)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" role="status">
            Offline. Showing the last synced data.
        </MudAlert>
    }
    @if (ImportService is RemoteUserDataImportService pendingImport && pendingImport.HasPendingImport())
    {
        <MudAlert Severity="Severity.Info" Dense="true" role="status">
            Restore is queued. It runs when you reconnect.
        </MudAlert>
    }
    @if (Export is RemoteUserDataExportService cachedExport && cachedExport.TryGetCachedExport(out _, out var cachedAt) && cachedAt is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">Last export saved @cachedAt.Value.LocalDateTime.</MudText>
    }
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5" HtmlTag="h2">Account actions</MudText>
    }

    <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Change password</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                You stay signed in.
            </MudText>
            <MudTextField T="string" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" dense="true"
                          Value="_currentPassword" ValueChanged="v => _currentPassword = v"
                          Error="_currentPasswordError is not null" ErrorText="@_currentPasswordError" />
            <MudTextField T="string" Label="New password" InputType="InputType.Password" Variant="Variant.Outlined" dense="true"
                          Value="_newPassword" ValueChanged="v => _newPassword = v"
                          Error="_newPasswordError is not null" ErrorText="@_newPasswordError" />
            <MudTextField T="string" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" dense="true"
                          Value="_confirmPassword" ValueChanged="v => _confirmPassword = v"
                          Error="_confirmPasswordError is not null" ErrorText="@_confirmPasswordError" />
            @if (_passwordFormError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" role="alert">@_passwordFormError</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="align-self-end" Disabled="_savingPassword" OnClick="ChangePasswordAsync">
                Change password
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Export your data</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Download your data as JSON. Max 50,000 rows.
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="align-self-end" Disabled="_exporting" OnClick="ExportDataAsync">
                Export data
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Import your data</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Restore replaces everything.
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="align-self-end" OnClick="OpenImportDialogAsync">
                Import data
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1" HtmlTag="h2" Class="mb-1">Delete account</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Delete account and all data. Cannot be undone.
            </MudText>
            @if (!_confirmingDelete)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="align-self-end" Disabled="_deleting" OnClick="StartDeleteAccount">
                    Delete account
                </MudButton>
            }
            else
            {
                <div class="pa-3 rounded border" role="group" aria-label="Confirm account deletion">
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Enter your current password to delete the account and all data. This cannot be undone.
                    </MudText>
                    <MudTextField T="string"
                                  Label="Current password"
                                  Variant="Variant.Outlined"
                                  dense="true"
                                  InputType="InputType.Password"
                                  Value="_deletePassword"
                                  ValueChanged="OnDeletePasswordChanged"
                                  Error="@(_deleteError is not null)"
                                  ErrorText="@_deleteError"
                                  Disabled="_deleting" />
                    <div class="d-flex align-center justify-end gap-2 mt-3">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Disabled="_deleting"
                                   OnClick="DeleteAccountAsync">
                            Delete account
                        </MudButton>
                        <MudButton Variant="Variant.Text" Disabled="_deleting" OnClick="CancelDeleteAccount">
                            Cancel
                        </MudButton>
                    </div>
                </div>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    [Parameter]
    public bool ShowTitle { get; set; } = true;

    /// <summary>Raised after the account has been deleted so the host can clear local session state.</summary>
    [Parameter]
    public EventCallback OnAccountDeleted { get; set; }

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _confirmingDelete;
    private string _deletePassword = string.Empty;
    private string? _deleteError;
    private string? _currentPasswordError;
    private string? _newPasswordError;
    private string? _confirmPasswordError;
    private string? _passwordFormError;
    private bool _savingPassword;
    private bool _deleting;
    private bool _exporting;

    private async Task ExportDataAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            UserDataExportDto data;
            try
            {
                data = await Export.ExportAsync();
            }
            catch when (BoardSync.IsOffline && Export is RemoteUserDataExportService cached && cached.TryGetCachedExport(out var cachedDto, out _) && cachedDto is not null)
            {
                data = cachedDto;
                await Notifier.NotifyAsync("Offline. Saved export.", Severity.Warning);
            }

            var json = await Task.Run(() => System.Text.Json.JsonSerializer.Serialize(data, JsonDefaults.Export));
            var fileName = $"habitinator-export-{data.ExportedAtUtc:yyyyMMdd-HHmm}.json";

            bool downloaded;
            try
            {
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardUiState.js");
                downloaded = await JS.InvokeAsync<bool>("habitinatorDownloadJson", fileName, json);
            }
            catch (Exception)
            {
                downloaded = false;
            }

            if (downloaded)
            {
                await Notifier.NotifyAsync("Export downloaded.", Severity.Success);
            }
            else
            {
                var options = DialogDefaults.Wide;
                await DialogService.ShowAsync<ExportDataDialog>(
                    "Your data export",
                    new DialogParameters<ExportDataDialog> { { x => x.JsonText, json } },
                    options);
            }
        }
        catch (Exception ex)
        {
            await Notifier.NotifyAsync(ex.Message, Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private async Task OpenImportDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = DialogDefaults.Wide.MaxWidth,
            FullWidth = true,
            CloseButton = false,
            CloseOnEscapeKey = true,
            NoHeader = true,
            BackdropClick = false
        };
        await DialogService.ShowAsync<ImportDataDialog>(string.Empty, options);
    }

    private async Task ChangePasswordAsync()
    {
        if (_savingPassword) return;

        _currentPasswordError = null;
        _newPasswordError = null;
        _confirmPasswordError = null;
        _passwordFormError = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _currentPasswordError = "Enter your current password.";
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _newPasswordError = "Enter a new password.";
        }
        else if (!_newPassword.Equals(_confirmPassword, StringComparison.Ordinal))
        {
            _confirmPasswordError = "Passwords do not match.";
        }

        if (_currentPasswordError is not null || _newPasswordError is not null || _confirmPasswordError is not null)
        {
            return;
        }

        _savingPassword = true;
        try
        {
            await AccountActions.ChangePasswordAsync(_currentPassword, _newPassword);
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            await Notifier.NotifyAsync("Password updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("current password", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("incorrect password", StringComparison.OrdinalIgnoreCase))
            {
                _currentPasswordError = ex.Message;
            }
            else if (ex.Message.Contains("password", StringComparison.OrdinalIgnoreCase))
            {
                _newPasswordError = ex.Message;
            }
            else
            {
                _passwordFormError = ex.Message;
            }
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private void StartDeleteAccount()
    {
        _confirmingDelete = true;
        _deletePassword = string.Empty;
        _deleteError = null;
    }

    private void CancelDeleteAccount()
    {
        _confirmingDelete = false;
        _deletePassword = string.Empty;
        _deleteError = null;
    }

    private void OnDeletePasswordChanged(string value)
    {
        _deletePassword = value;
        if (_deleteError is not null)
        {
            _deleteError = null;
        }
    }

    private async Task DeleteAccountAsync()
    {
        if (_deleting) return;

        if (string.IsNullOrWhiteSpace(_deletePassword))
        {
            _deleteError = "Enter your current password.";
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            await AccountActions.DeleteAccountAsync(_deletePassword);
            _deletePassword = string.Empty;
            _confirmingDelete = false;
            await Notifier.NotifyAsync("Account deleted.", Severity.Success);
            if (OnAccountDeleted.HasDelegate)
            {
                await OnAccountDeleted.InvokeAsync();
            }
            else
            {
                Nav.NavigateTo("/?accountDeleted=1", forceLoad: true);
            }
        }
        catch (InvalidOperationException ex)
        {
            _deleteError = ex.Message;
        }
        catch (Exception ex)
        {
            _deleteError = "Account deletion failed. Try again.";
            await Notifier.NotifyAsync(ex.Message, Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
