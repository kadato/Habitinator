@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.FileProviders
@inject IWebHostEnvironment HostEnvironment

@* 
    WasmPrefetchLinks: Emits <link rel="prefetch"> tags for all Blazor WebAssembly
    framework resources (_framework/*.wasm, *.js) so the browser downloads them
    in the background during idle time.

    This component is intended for unauthenticated (Static SSR) pages where the
    built-in <ResourcePreloader /> does not emit WASM preloads because no
    interactive WebAssembly render mode is active.

    Using rel="prefetch" (not "preload") ensures low-priority background fetching
    that won't compete with critical resources for the current page.
*@

@foreach (var url in GetFrameworkAssetUrls())
{
    <link rel="prefetch" href="@url" as="fetch" crossorigin="anonymous" />
}

@code {
    private IReadOnlyList<string> GetFrameworkAssetUrls()
    {
        var urls = new List<string>();

        try
        {
            var fileProvider = HostEnvironment.WebRootFileProvider;
            var frameworkDir = fileProvider.GetDirectoryContents("_framework");

            if (!frameworkDir.Exists)
                return urls;

            foreach (var file in frameworkDir)
            {
                if (file.IsDirectory)
                    continue;

                var name = file.Name;

                // Skip compressed variants — the browser/CDN handles Accept-Encoding
                if (name.EndsWith(".gz", StringComparison.OrdinalIgnoreCase) ||
                    name.EndsWith(".br", StringComparison.OrdinalIgnoreCase))
                    continue;

                // Skip source maps and PDB debug symbols
                if (name.EndsWith(".map", StringComparison.OrdinalIgnoreCase) ||
                    name.EndsWith(".pdb", StringComparison.OrdinalIgnoreCase))
                    continue;

                // Skip ICU globalization data files — HybridGlobalization uses browser APIs instead
                if (name.StartsWith("icudt_", StringComparison.OrdinalIgnoreCase) ||
                    name.StartsWith("icudt.", StringComparison.OrdinalIgnoreCase))
                    continue;

                // Include .wasm (assemblies + native runtime) and .js (dotnet runtime scripts)
                if (name.EndsWith(".wasm", StringComparison.OrdinalIgnoreCase) ||
                    name.EndsWith(".js", StringComparison.OrdinalIgnoreCase))
                {
                    urls.Add($"_framework/{name}");
                }
            }
        }
        catch
        {
            // Best-effort: if enumeration fails, render nothing
        }

        return urls;
    }
}
