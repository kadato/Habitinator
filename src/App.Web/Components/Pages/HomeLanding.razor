<MudStack Spacing="3" Class="pa-1" Style="max-width: 36rem;">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4">Welcome to Habitinator</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Habits, dailies, and to-dos on one board, plus one session timer—without RPG-style gamification.
        </MudText>
    </MudStack>

    <MudCard Elevation="2" Outlined="true" Class="home-landing-card">
        <MudCardContent>
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">Get started</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Href="auth/login">
                    Sign in
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           Href="auth/register">
                    Create account
                </MudButton>
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Prefer to look around first? The demo guest account loads sample board data.
                </MudText>
                <MudPaper Outlined="true" Class="pa-2 guest-login-paper">
                    <form method="post" action="/api/auth/guest-login" class="d-flex flex-column">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   FullWidth="true">
                            Continue as demo guest
                        </MudButton>
                    </form>
                </MudPaper>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudStack>
