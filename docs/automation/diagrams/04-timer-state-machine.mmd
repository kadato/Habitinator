%% Global Timer State Machine
%% Focus timer with auto-pause and milestone detection

stateDiagram-v2
    [*] --> Stopped: Initialize

    Stopped --> Running: StartTimer()
    
    Running --> Paused: PauseTimer()
    Running --> AwaitingPrompt: MilestoneReached
    
    Paused --> Running: ResumeTimer()
    Paused --> Stopped: StopAndLog()
    
    AwaitingPrompt --> Running: NotDone()
    AwaitingPrompt --> Stopped: Done()
    
    %% Transitions back to Stopped
    Running --> Stopped: StopAndLog()

    note right of Stopped
        _accumulated = 0
        _runningSince = null
        _nextFocusMilestone = null
        Elapsed = 0
    end note

    note right of Running
        _runningSince = UtcNow
        _accumulated = previous value
        Elapsed = _accumulated + (UtcNow - _runningSince)
    end note

    note right of Paused
        _accumulated += (UtcNow - _runningSince)
        _runningSince = null
        Elapsed = _accumulated
    end note

    note right of AwaitingPrompt
        FocusAlertAfter reached
        Show "Time's up!" prompt
        Pause time accumulation
        Wait for user response
    end note

    %% Milestone logic detail
    state MilestoneLogic <<choice>>
    Running --> MilestoneLogic: Check every tick
    MilestoneLogic --> AwaitingPrompt: Elapsed >= _nextFocusMilestoneAtElapsed
    MilestoneLogic --> Running: Elapsed < _nextFocusMilestoneAtElapsed
