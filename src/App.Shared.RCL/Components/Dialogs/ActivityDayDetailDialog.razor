@using Microsoft.Extensions.DependencyInjection
@using App.Shared.RCL.Services.Board.Local
@using Microsoft.JSInterop
@inject IActivityStatisticsReader Stats
@inject IBoardDataService BoardData
@inject IUserTimeZoneService TimeZoneService
@inject IUserDateFormatService DateFormatService
@inject IUserNotifier Notifier
@using Microsoft.Extensions.Logging;

@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog Class="hab-modal-dialog" ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--neutral hab-modal--wide hab-modal--day-details" data-dialog-label="Day details">
            <div class="hab-modal__grabber" aria-hidden="true"></div>
            <div class="hab-modal__header" @ref="_headerRef">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="CloseDialog" />
                </div>
                <MudText Typo="Typo.h6" Class="font-weight-bold">Day details</MudText>
                <div class="day-stepper" role="group" aria-label="Change day">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                   aria-label="Previous day"
                                   OnClick="() => StepDayAsync(-1)"
                                   Class="day-stepper__btn" />
                    <div class="day-stepper__date" aria-live="polite" aria-atomic="true" title="Scroll to change the day" @onwheel="OnDateWheelAsync" @onwheel:preventDefault="true">@_shownDateLabel</div>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                   aria-label="Next day"
                                   Disabled="@IsNextDisabled"
                                   OnClick="() => StepDayAsync(1)"
                                   Class="day-stepper__btn" />
                </div>
            </div>
            <div class="hab-modal__body" @ref="_bodyRef">
        @if (_loading)
        {            <div class="stats-day-timeline">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="stats-day-event stats-day-event--skeleton">
                        <span class="stats-day-event__time"><MudSkeleton Width="44px" Height="14px" /></span>
                        <span class="stats-day-event__icon"><MudSkeleton Width="18px" Height="18px" /></span>
                        <div class="stats-day-event__body"><MudSkeleton Width="160px" Height="16px" /></div>
                    </div>
                }
            </div>
        }
        else if (_error is not null)
        {
            <div class="dialog-inline-fallback">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Class="dialog-inline-fallback__icon"  aria-hidden="true" />
                <MudText Typo="Typo.subtitle2" Class="dialog-inline-fallback__title">Could not load details</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Check your connection and try again.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="ReloadAsync">Retry</MudButton>
            </div>
        }
        else if (_detail is { Events.Count: 0 })
        {
            @if (!string.IsNullOrWhiteSpace(TagFilter))
            {
                <div class="d-flex align-center gap-1 flex-wrap mb-3">
                    @foreach (var t in TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0">@t</MudChip>
                    }
                </div>
            }
            <div class="stats-day-empty">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Class="stats-day-empty__icon"  aria-hidden="true" />
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">No activity this day</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Logs for habits, dailies, todos and focus sessions appear here.</MudText>
            </div>
        }
        else if (_detail is not null)
        {
            @if (!string.IsNullOrWhiteSpace(TagFilter))
            {
                <div class="d-flex align-center gap-1 flex-wrap mb-3">
                    @foreach (var t in TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="ma-0">@t</MudChip>
                    }
                </div>
            }
            <div class="stats-day-timeline">
                @foreach (var ev in _detail.Events)
                {
                    <div class="stats-day-event">
                        <span class="stats-day-event__time">@FormatLocalTime(ev.OccurredAtUtc)</span>
                        <MudIcon Icon="@GetEventIcon(ev.EventType)" Size="Size.Small" Class="@($"stats-day-event__icon {GetIconClass(ev.EventType)}")" aria-hidden="true" />
                        <div class="stats-day-event__body">
                            <span class="stats-day-event__title">@GetEventTitle(ev)@FormatTimerSuffix(ev)</span>
                            <span class="stats-day-event__meta">@GetEventMeta(ev)</span>
                        </div>
                    </div>
                }
            </div>
        }
        @if (_showDayDailies)
        {
            var isTodayShown = _shownDate == DailySchedule.LocalToday(TimeZoneService);
            <div class="stats-day-dailies">
                <div class="stats-day-dailies__title">Dailies this day</div>
                <ul class="stats-day-dailies__list">
                    @foreach (var daily in _dayDailies)
                    {
                        var busy = IsDayDailyBusy(daily.Id);
                        <li class="stats-day-daily" @key="daily.Id">
                            <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Class="stats-day-daily__icon" aria-hidden="true" />
                            <div class="stats-day-daily__text">
                                <span class="stats-day-daily__title">@daily.Title</span>
                                <span class="stats-day-daily__meta">@DayDailyStatus(daily, isTodayShown)</span>
                            </div>
                            <div class="stats-day-daily__actions">
                                @if (isTodayShown)
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="@busy"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="@(() => ToggleDayDailyAsync(daily))">
                                        @(DailySchedule.IsCompletedForToday(daily.DailyLastCompletedOn, daily.IsCompleted, _shownDate) ? "Mark not done" : "Mark done")
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Default"
                                               Size="Size.Small"
                                               Disabled="@busy"
                                               StartIcon="@Icons.Material.Filled.NextPlan"
                                               OnClick="@(() => SkipDayDailyAsync(daily))">
                                        Skip
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="@(busy || !DayDailyCanMark(daily))"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="@(() => CompleteDayDailyAsync(daily))">
                                        Mark done
                                    </MudButton>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
            </div>
        @if (_showDailyFooter && _dailyItem is not null)
        {
            <div class="hab-modal__footer hab-modal__footer--end hab-modal__footer--daily">
                <span class="hab-modal__footer-note">@DueNoteFor(_dailyItem)</span>
                @if (_canToggleToday || _shownDate == DailySchedule.LocalToday(TimeZoneService))
                {
                    @if (_isDoneToday)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   Disabled="@_completing"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="ToggleTodayAsync">
                            Mark not done
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="@(_completing || !_canToggleToday)"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   OnClick="ToggleTodayAsync">
                            Mark done for today
                        </MudButton>
                    }
                }
                else
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               Disabled="@_completing"
                               StartIcon="@Icons.Material.Filled.NextPlan"
                               OnClick="SkipShownDateAsync">
                        Skip this day
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(_completing || !_canCompleteShownDate)"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="CompleteShownDateAsync">
                        Mark done for this day
                    </MudButton>
                }
            </div>
        }
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter] [EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public string? TagFilter { get; set; }

    private void LogFallback(Exception ex, string message) =>
        ServiceProvider.GetService<ILogger<ActivityDayDetailDialog>>()?.LogDebug(ex, "{Message}", message);

    /// <summary>When set, the dialog offers a retroactive check-in for this daily on the shown date.</summary>
    [Parameter] public Guid? BoardItemId { get; set; }

    private ActivityDayDetailDto? _detail;
    private bool _loading = true;
    private string? _error;
    private DateOnly _shownDate;
    private string _shownDateLabel = string.Empty;
    private ElementReference _headerRef;
    private ElementReference _bodyRef;
    private DotNetObjectReference<ActivityDayDetailDialog>? _swipeRef;
    private bool _swipeStarted;
    private BoardItem? _dailyItem;
    private bool _canCompleteShownDate;
    private bool _canToggleToday;
    private bool _isDoneToday;
    private bool _showDailyFooter;
    private bool _completing;
    private bool _mutated;
    private IReadOnlyList<BoardItem> _dayDailies = [];
    private bool _showDayDailies;
    private readonly HashSet<Guid> _dayDailyBusy = [];

    protected override async Task OnInitializedAsync()
    {
        _shownDate = Date;
        try
        {
            await DateFormatService.InitializeAsync();
        }
        catch
        {
            // Format falls back to default when preferences fail to load.
        }

        UpdateShownDateLabel();
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_swipeStarted)
        {
            _swipeStarted = true;
            try
            {
                _swipeRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/modalSwipe.js");
                await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _headerRef, _swipeRef,
                    new { horizontal = false, dismissDown = true });
                await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _bodyRef, _swipeRef,
                    new { horizontal = true, dismissDown = false });
            }
            catch
            {
                // Swipe gestures are a touch enhancement. Buttons always work.
            }
        }
    }

    /// <summary>Called from touch gestures. Swipe left for next day, right for previous.</summary>
    [JSInvokable]
    public Task OnModalSwipeAsync(int direction)
    {
        if (direction > 0 && IsNextDisabled)
        {
            return Task.CompletedTask;
        }

        return StepDayAsync(direction > 0 ? 1 : -1);
    }

    /// <summary>Called from touch gestures. Swipe down on the header closes the dialog.</summary>
    [JSInvokable]
    public Task OnModalSwipeDownAsync()
    {
        CloseDialog();
        return Task.CompletedTask;
    }

    /// <summary>Closes the dialog and reports whether a check-in changed anything so parents can reload.</summary>
    private void CloseDialog()
    {
        try
        {
            if (_mutated)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                MudDialog.Cancel();
            }
        }
        catch
        {
            // Dialog already closed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _headerRef);
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _bodyRef);
        }
        catch
        {
            // Ignored during disposal.
        }

        _swipeRef?.Dispose();
        _swipeRef = null;
    }

    private async Task StepDayAsync(int offset)
    {
        _shownDate = _shownDate.AddDays(offset);
        UpdateShownDateLabel();
        await LoadAsync();
        await InvokeAsync(StateHasChanged); // Plain reload. Stepping days never mutates.
    }

    private Task OnDateWheelAsync(WheelEventArgs e)
    {
        var offset = 0;
        if (e.DeltaY > 0 || e.DeltaX > 0)
        {
            offset = 1;
        }
        else if (e.DeltaY < 0 || e.DeltaX < 0)
        {
            offset = -1;
        }

        if (offset == 0)
        {
            return Task.CompletedTask;
        }

        if (offset > 0 && IsNextDisabled)
        {
            return Task.CompletedTask;
        }

        return StepDayAsync(offset);
    }


    private bool IsNextDisabled => _shownDate >= DailySchedule.LocalToday(TimeZoneService);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var tag = string.IsNullOrWhiteSpace(TagFilter) ? null : TagFilter;
            _detail = await Stats.GetActivityDayDetailAsync(_shownDate, tag);
        }
        catch (Exception ex)
        {
            var offline = ServiceProvider.GetService<OfflineActivityStatisticsProvider>();
            if (offline != null)
            {
                try
                {
                    var tag2 = string.IsNullOrWhiteSpace(TagFilter) ? null : TagFilter;
                    _detail = await offline.BuildDayDetailAsync(_shownDate, tag2);
                    try
                    {
                        await Notifier.NotifyAsync("Offline: showing locally computed details.", MudBlazor.Severity.Warning);
                    }
                    catch (Exception notifyEx)
                    {
                        LogFallback(notifyEx, "Offline fallback toast failed; details already shown.");
                    }

                    return;
                }
                catch (Exception fallbackEx)
                {
                    LogFallback(fallbackEx, "Offline fallback failed; showing the main error instead.");
                }
            }

            _error = ex.Message;
            try
            {
                await Notifier.NotifyAsync("Could not load day details. Please try again.", MudBlazor.Severity.Error);
            }
            catch (Exception notifyEx)
            {
                LogFallback(notifyEx, "Error toast failed; inline error already shown.");
            }
        }
        finally
        {
            _loading = false;
            await RefreshCompletionStateAsync();
            await RefreshDayDailiesAsync();
        }
    }

    /// <summary>Recomputes whether the shown date can still be checked off for the daily that opened this dialog.</summary>
    private async Task RefreshCompletionStateAsync()
    {
        _canCompleteShownDate = false;
        _canToggleToday = false;
        _isDoneToday = false;
        _showDailyFooter = false;
        _dailyItem = null;
        if (BoardItemId is not { } itemId)
        {
            return;
        }

        try
        {
            var item = await BoardData.GetItemAsync(itemId);
            if (item is null)
            {
                return;
            }

            var today = DailySchedule.LocalToday(TimeZoneService);
            _dailyItem = item;
            _showDailyFooter = _shownDate <= today;
            if (_shownDate == today)
            {
                _canToggleToday = DailySchedule.IsScheduledOn(item, today);
                _isDoneToday = DailySchedule.IsCompletedForToday(item.DailyLastCompletedOn, item.IsCompleted, today);
            }
            else if (_shownDate < today)
            {
                _canCompleteShownDate = DailySchedule.CanCompleteForDate(
                    item.DailyLastCompletedOn,
                    _shownDate,
                    today);
            }
        }
        catch
        {
            // This action is optional. On failure the dialog hides the action.
        }
    }

    /// <summary>Describes the due state of the selected daily on the shown date with its repeat schedule.</summary>
    private string DueNoteFor(BoardItem item)
    {
        var today = DailySchedule.LocalToday(TimeZoneService);
        var due = DailySchedule.IsScheduledOn(item.DailyStartDate, item.DailyRepeat, item.DailyRepeatInterval, _shownDate, item.DailyWeekdays);
        var when = _shownDate == today ? "today" : "this day";
        return $"{(due ? "Due" : "Not due")} {when}, {UpcomingSchedule.DescribeDaily(item)}";
    }

    /// <summary>Lists dailies scheduled on the shown date for retro actions when the single-daily footer stays hidden.</summary>
    private async Task RefreshDayDailiesAsync()
    {
        _dayDailies = [];
        _showDayDailies = false;
        if (_showDailyFooter)
        {
            return;
        }

        try
        {
            var snapshot = await BoardData.GetSnapshotAsync();
            if (snapshot is null)
            {
                return;
            }

            var today = DailySchedule.LocalToday(TimeZoneService);
            if (_shownDate > today)
            {
                return;
            }

            _dayDailies = [.. snapshot.Dailies
                .Where(d => DailySchedule.IsScheduledOn(d, _shownDate) || HasDailyEventThatDay(d))
                .OrderBy(d => d.Title, StringComparer.Ordinal)];
            _showDayDailies = _dayDailies.Count > 0;
        }
        catch
        {
            // These actions are optional. On failure the dialog hides the actions.
            _dayDailies = [];
            _showDayDailies = false;
        }
    }

    private bool IsDayDailyBusy(Guid id) => _dayDailyBusy.Contains(id);

    private bool DayDailyCanMark(BoardItem daily)
    {
        var today = DailySchedule.LocalToday(TimeZoneService);
        return DailySchedule.CanCompleteForDate(
            daily.DailyLastCompletedOn,
            _shownDate,
            today);
    }

    private string DayDailyStatus(BoardItem daily, bool isTodayShown)
    {
        string state;
        if (isTodayShown)
        {
            state = DailySchedule.IsCompletedForToday(daily.DailyLastCompletedOn, daily.IsCompleted, _shownDate)
                ? "Done today"
                : "Due today";
        }
        else
        {
            state = IsDoneOnShownDate(daily) ? "Done this day" : "Not done this day";
        }

        return $"{state}, {UpcomingSchedule.DescribeDaily(daily)}";
    }

    private bool IsDoneOnShownDate(BoardItem daily)
    {
        if (DailySchedule.IsCompleteForDate(daily, _shownDate))
        {
            return true;
        }

        return HasDailyEventThatDay(daily)
            && _detail?.Events.Any(e => e.EventType == ActivityEventType.DailyComplete
                && DailyTitleMatches(e, daily.Title)) == true;
    }

    /// <summary>Tells whether the day timeline holds a check-in or skip for this daily as evidence that the daily was actionable that day.</summary>
    private bool HasDailyEventThatDay(BoardItem daily) =>
        _detail?.Events.Any(e => (e.EventType == ActivityEventType.DailyComplete || e.EventType == ActivityEventType.DailySkip)
            && DailyTitleMatches(e, daily.Title)) == true;

    /// <summary>Old event titles stay in the custom label when the board title lookup missed.</summary>
    private static bool DailyTitleMatches(ActivityDayEventDto e, string title) =>
        string.Equals(e.BoardItemTitle, title, StringComparison.Ordinal)
        || string.Equals(e.CustomLabel, title, StringComparison.Ordinal);

    private async Task ToggleDayDailyAsync(BoardItem daily)
    {
        if (!_dayDailyBusy.Add(daily.Id))
        {
            return;
        }

        try
        {
            await BoardData.ToggleItemAsync(BoardSection.Daily, daily.Id);
            _mutated = true;
        }
        catch
        {
            await Notifier.NotifyAsync("Could not update this daily. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _dayDailyBusy.Remove(daily.Id);
        }

        await ReloadAfterMutationAsync();
    }

    private async Task CompleteDayDailyAsync(BoardItem daily)
    {
        if (!_dayDailyBusy.Add(daily.Id))
        {
            return;
        }

        try
        {
            var result = await BoardData.CompleteDailyForDateAsync(daily.Id, _shownDate);
            if (result is not null)
            {
                _mutated = true;
                await Notifier.NotifyAsync($"Marked {daily.Title} done for {_shownDateLabel}.", MudBlazor.Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync("This day can't be marked done.", MudBlazor.Severity.Error);
            }
        }
        catch
        {
            await Notifier.NotifyAsync("Could not mark this day done. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _dayDailyBusy.Remove(daily.Id);
        }

        await ReloadAfterMutationAsync();
    }

    private async Task SkipDayDailyAsync(BoardItem daily)
    {
        if (!_dayDailyBusy.Add(daily.Id))
        {
            return;
        }

        try
        {
            var result = await BoardData.SkipDailyForDateAsync(daily.Id, _shownDate);
            if (result is not null)
            {
                _mutated = true;
                await Notifier.NotifyAsync($"Skipped {daily.Title} for {_shownDateLabel}. Streak continues.", MudBlazor.Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync("This day can't be skipped.", MudBlazor.Severity.Error);
            }
        }
        catch
        {
            await Notifier.NotifyAsync("Could not skip this day. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _dayDailyBusy.Remove(daily.Id);
        }

        await ReloadAfterMutationAsync();
    }

    private async Task CompleteShownDateAsync()
    {
        if (_dailyItem is null || _completing)
        {
            return;
        }

        _completing = true;
        try
        {
            var result = await BoardData.CompleteDailyForDateAsync(_dailyItem.Id, _shownDate);
            if (result is not null)
            {
                _mutated = true;
                await Notifier.NotifyAsync($"Marked done for {_shownDateLabel}.", MudBlazor.Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync("This day can't be marked done.", MudBlazor.Severity.Error);
            }
        }
        catch
        {
            await Notifier.NotifyAsync("Could not mark this day done. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _completing = false;
        }

        await ReloadAfterMutationAsync();
    }

    private async Task ToggleTodayAsync()
    {
        if (_dailyItem is null || _completing)
        {
            return;
        }

        _completing = true;
        try
        {
            await BoardData.ToggleItemAsync(BoardSection.Daily, _dailyItem.Id);
            _mutated = true;
        }
        catch
        {
            await Notifier.NotifyAsync("Could not update this daily. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _completing = false;
        }

        await ReloadAfterMutationAsync();
    }

    private async Task SkipShownDateAsync()
    {
        if (_dailyItem is null || _completing)
        {
            return;
        }

        _completing = true;
        try
        {
            var result = await BoardData.SkipDailyForDateAsync(_dailyItem.Id, _shownDate);
            if (result is not null)
            {
                _mutated = true;
                await Notifier.NotifyAsync($"Skipped {_shownDateLabel}. Streak continues.", MudBlazor.Severity.Success);
            }
            else
            {
                await Notifier.NotifyAsync("This day can't be skipped.", MudBlazor.Severity.Error);
            }
        }
        catch
        {
            await Notifier.NotifyAsync("Could not skip this day. Try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _completing = false;
        }

        await ReloadAfterMutationAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        UpdateShownDateLabel();
        StateHasChanged();
    }

    /// <summary>Drains synced operations and clears cached stats first, so the reloaded details include the latest change instead of a stale cached day.</summary>
    private async Task ReloadAfterMutationAsync()
    {
        await DrainBoardSyncAsync();
        try
        {
            Stats.InvalidateCache();
        }
        catch
        {
            // Best-effort cleanup. A stale cache entry makes the next load retry.
        }

        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Tries an immediate sync. Stats read from the server right after.</summary>
    private async Task DrainBoardSyncAsync()
    {
        try
        {
            var sync = ServiceProvider.GetService<IBoardSyncRequestor>();
            if (sync is null)
            {
                return;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            await sync.SyncNowAsync(cts.Token);
        }
        catch
        {
            // If offline or slow, the periodic sync delivers the change. Reads use last known data.
        }
    }

    private void UpdateShownDateLabel()
    {
        try
        {
            _shownDateLabel = DateFormatService.Format(_shownDate);
        }
        catch
        {
            _shownDateLabel = _shownDate.ToString("yyyy-MM-dd");
        }
    }

    private string FormatLocalTime(DateTimeOffset utcTime) => TimeZoneService.ConvertToLocal(utcTime).ToString("HH:mm");

    private static string FormatTimerSuffix(ActivityDayEventDto e)
    {
        if (e.EventType != ActivityEventType.TimerSession || e.DurationSeconds is not int s || s <= 0) return string.Empty;
        var m = (s + 30) / 60;
        return m < 1 ? ", under 1 min" : $", {m} min";
    }

    private static string GetEventIcon(ActivityEventType t) => t switch
    {
        ActivityEventType.DailyComplete => Icons.Material.Filled.CheckCircle,
        ActivityEventType.DailySkip => Icons.Material.Filled.NextPlan,
        ActivityEventType.TodoComplete => Icons.Material.Filled.CheckBox,
        ActivityEventType.HabitPlus => Icons.Material.Filled.Add,
        ActivityEventType.HabitMinus => Icons.Material.Filled.Remove,
        ActivityEventType.TimerSession => Icons.Material.Filled.Timer,
        _ => Icons.Material.Filled.Label
    };

    private static string GetIconClass(ActivityEventType t) => t switch
    {
        ActivityEventType.DailyComplete => "stats-day-event__icon--daily",
        ActivityEventType.TodoComplete => "stats-day-event__icon--todo",
        ActivityEventType.HabitPlus => "stats-day-event__icon--plus",
        ActivityEventType.HabitMinus => "stats-day-event__icon--minus",
        ActivityEventType.TimerSession => "stats-day-event__icon--timer",
        _ => "stats-day-event__icon--default"
    };

    private static string GetEventMeta(ActivityDayEventDto e) => e.EventType switch
    {
        ActivityEventType.DailyComplete => "Daily completed",
        ActivityEventType.DailySkip => "Daily skipped",
        ActivityEventType.TodoComplete => "To-do completed",
        ActivityEventType.HabitPlus => "Habit plus",
        ActivityEventType.HabitMinus => "Habit minus",
        ActivityEventType.TimerSession => "Focus session",
        _ => e.EventType.ToString()
    };

    private static string GetEventTitle(ActivityDayEventDto e)
    {
        var name = e.BoardItemTitle ?? e.CustomLabel;
        if (!string.IsNullOrWhiteSpace(name)) return name;
        return e.EventType switch
        {
            ActivityEventType.DailyComplete => "Daily task completed",
            ActivityEventType.DailySkip => "Daily skipped",
            ActivityEventType.TodoComplete => "To-do completed",
            ActivityEventType.HabitPlus => "Habit logged +",
            ActivityEventType.HabitMinus => "Habit logged -",
            ActivityEventType.TimerSession => "Focus session completed",
            _ => e.EventType.ToString()
        };
    }
}
