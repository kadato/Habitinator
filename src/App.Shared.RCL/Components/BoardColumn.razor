@namespace App.Shared.RCL.Components

<MudCard Class="@($"board-column {GetAccentClass()}")" Elevation="0" Outlined="false">
    <MudCardHeader Class="pb-1">
        <CardHeaderContent>
            <div class="board-column-header-row">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="board-title-stack">
                    <span class="board-count-badge">@VisibleItems().Count<span class="hab-visually-hidden"> items</span></span>
                    <h2 class="board-title mud-typography mud-typography-subtitle1">@GetTitle()</h2>
                    <MudMenu Icon="@Icons.Material.Outlined.Info"
                             Size="Size.Small"
                             Dense="true"
                             AnchorOrigin="Origin.BottomLeft"
                             TransformOrigin="Origin.TopLeft"
                             PopoverClass="board-column-info-popover pa-3"
                             Class="board-column-info-btn"
                             aria-label="@($"About {GetTitle()}")"
                             title="@($"About {GetTitle()}")">
                        <ChildContent>
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Color="Color.Primary">@GetTitle()</MudText>
                            <MudText Typo="Typo.body2" Class="board-column-info-text">
                                @GetGlossaryText()
                            </MudText>
                        </ChildContent>
                    </MudMenu>
                </MudStack>
            </div>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="pt-0">
        <div class="board-filter-toolbar mb-2" role="toolbar" aria-label="@($"{GetTitle()} filters")">
            @if (Section == BoardSection.Habit)
            {
                <button type="button"
                        title="Show all habits"
                        aria-label="Show all habits"
                        aria-pressed="@(_habitFilter == HabitListFilter.All)"
                        class="@GetFilterBtnClass(_habitFilter == HabitListFilter.All)"
                        @onclick="@(() => SetHabitFilter(HabitListFilter.All))">
                    All
                </button>
                <button type="button"
                        title="Habits with fewer than 3 logs"
                        aria-label="Show new habits with fewer than 3 logs"
                        aria-pressed="@(_habitFilter == HabitListFilter.Weak)"
                        class="@GetFilterBtnClass(_habitFilter == HabitListFilter.Weak)"
                        @onclick="@(() => SetHabitFilter(HabitListFilter.Weak))">
                    New
                </button>
                <button type="button"
                        title="Habits with 3 or more logs"
                        aria-label="Show established habits with 3 or more logs"
                        aria-pressed="@(_habitFilter == HabitListFilter.Strong)"
                        class="@GetFilterBtnClass(_habitFilter == HabitListFilter.Strong)"
                        @onclick="@(() => SetHabitFilter(HabitListFilter.Strong))">
                    Established
                </button>
            }
            else if (Section == BoardSection.Daily)
            {
                <button type="button"
                        title="Show all dailies"
                        aria-label="Show all dailies"
                        aria-pressed="@(_dailyFilter == DailyListFilter.All)"
                        class="@GetFilterBtnClass(_dailyFilter == DailyListFilter.All)"
                        @onclick="@(() => SetDailyFilter(DailyListFilter.All))">
                    All
                </button>
                <button type="button"
                        title="Due today and overdue"
                        aria-label="Show dailies due now and overdue"
                        aria-pressed="@(_dailyFilter == DailyListFilter.Due)"
                        class="@GetFilterBtnClass(_dailyFilter == DailyListFilter.Due)"
                        @onclick="@(() => SetDailyFilter(DailyListFilter.Due))">
                    Due now
                </button>
                <button type="button"
                        title="Neither due nor overdue"
                        aria-label="Show dailies for later that are neither due nor overdue"
                        aria-pressed="@(_dailyFilter == DailyListFilter.NotDue)"
                        class="@GetFilterBtnClass(_dailyFilter == DailyListFilter.NotDue)"
                        @onclick="@(() => SetDailyFilter(DailyListFilter.NotDue))">
                    Later
                </button>
            }
            else
            {
                <button type="button"
                        title="Open to-dos"
                        aria-label="Show open to-dos"
                        aria-pressed="@(_todoFilter == TodoListFilter.Active)"
                        class="@GetFilterBtnClass(_todoFilter == TodoListFilter.Active)"
                        @onclick="@(() => SetTodoFilter(TodoListFilter.Active))">
                    Active
                </button>
                <button type="button"
                        title="Open to-dos with a due date"
                        aria-label="Show scheduled to-dos with a due date"
                        aria-pressed="@(_todoFilter == TodoListFilter.Scheduled)"
                        class="@GetFilterBtnClass(_todoFilter == TodoListFilter.Scheduled)"
                        @onclick="@(() => SetTodoFilter(TodoListFilter.Scheduled))">
                    Scheduled
                </button>
                <button type="button"
                        title="Completed to-dos"
                        aria-label="Show completed to-dos"
                        aria-pressed="@(_todoFilter == TodoListFilter.Done)"
                        class="@GetFilterBtnClass(_todoFilter == TodoListFilter.Done)"
                        @onclick="@(() => SetTodoFilter(TodoListFilter.Done))">
                    Done
                </button>
            }
        </div>
        @if (GetFilterHint() is { } filterHint)
        {
            <div class="board-filter-hint" role="status">@filterHint</div>
        }

        @if (Section == BoardSection.Todo
             && _todoFilter == TodoListFilter.Done
             && VisibleItems().Count > 0)
        {
            <MudButton Size="Size.Medium"
                       Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteSweep"
                       Class="align-self-end mb-2"
                       OnClick="DeleteAllDoneTodosAsync">
                Delete all done
            </MudButton>
        }
        <div @onkeydown="OnDraftKeyAsync" class="board-add-wrap">
            <MudTextField @bind-Value="_draft"
                          @bind-Value:after="ClearDraftError"
                          Class="board-add-field"
                          Placeholder="@GetAddPlaceholder()"
                          aria-label="@GetAddPlaceholder()"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Add"
                          AdornmentAriaLabel="@GetAddPlaceholder()"
                          OnAdornmentClick="AddFromDraftAsync"
                          Error="@_draftError"
                          ErrorText="Add a title."
                          Immediate="true"
                          InputMode="@InputMode.text"
                          enterkeyhint="done"
                          autocomplete="off"
                          autocapitalize="sentences"/>
            @if (_duplicateExistingTitle is not null)
            {
                <div class="board-duplicate-warning mt-1">
                    <MudText Typo="Typo.caption">Already exists: '@_duplicateExistingTitle'.</MudText>
                    <div class="d-flex justify-end gap-2 mt-1">
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="text-transform-none"
                                   OnClick="CreateDuplicateAnywayAsync">
                            Add anyway
                        </MudButton>
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Text"
                                   Class="text-transform-none"
                                   OnClick="CancelDuplicate">
                            Cancel
                        </MudButton>
                    </div>
                </div>
            }
        </div>

        <div class="board-list mt-2">
            @{
                var visibleItems = VisibleItems();
                var canReorder = IsItemDraggable();
            }
            @if (visibleItems.Count == 0)
            {
                <div class="board-column-empty-state">
                    @if (IsBoardFilterExcludingAll)
                    {
                        <div class="empty-state-icon-container empty-state-icon-container--filter">
                            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Class="empty-state-icon" aria-hidden="true" />
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="empty-state-title">No matches found</MudText>
                        <MudText Typo="Typo.caption" Class="empty-state-desc">Try a different search or clear tags.</MudText>
                    }
                    else if (IsColumnFilterHidingAll)
                    {
                        <div class="empty-state-icon-container empty-state-icon-container--filter">
                            <MudIcon Icon="@Icons.Material.Outlined.FilterListOff" Class="empty-state-icon" aria-hidden="true" />
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="empty-state-title">No matches for this filter</MudText>
                        <MudText Typo="Typo.caption" Class="empty-state-desc">"@GetColumnFilterName()" hides @EffectiveCount.</MudText>
                        <MudButton Size="Size.Medium"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Class="mt-2 text-transform-none"
                                   OnClick="ResetColumnFilter">
                            @GetResetFilterLabel()
                        </MudButton>
                    }
                    else
                    {
                        <div class="empty-state-icon-container">
                            <MudIcon Icon="@GetEmptyStateIcon()" Class="empty-state-icon" aria-hidden="true" />
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="empty-state-title">@GetEmptyStateTitle()</MudText>
                        <MudText Typo="Typo.caption" Class="empty-state-desc">@GetEmptyStateDesc()</MudText>
                    }
                </div>
            }
            else if (canReorder)
            {
                <div @ref="_containerRef" class="board-sortable-list mud-width-full" role="list" aria-label="@($"{GetTitle()} items. Drag to reorder, or use Options menu Move commands for keyboard reorder.")">
                    @foreach (var item in visibleItems)
                    {
                        <div @key="item.Id" data-id="@item.Id" class="board-sortable-item" role="listitem">
                            @ItemCard(item)
                        </div>
                    }
                </div>
            }
            else
            {
                <div role="list" aria-label="@($"{GetTitle()} items")">
                    @foreach (var item in visibleItems)
                    {
                        <div @key="item.Id" role="listitem">
                            @ItemCard(item)
                        </div>
                    }
                </div>
            }
        </div>
    </MudCardContent>

    @if (!string.IsNullOrEmpty(GetFooterText()))
    {
        <MudCardActions Class="board-col-foot pb-3 pt-0">
            <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFooterText()</MudText>
        </MudCardActions>
    }
</MudCard>

@code {
    private RenderFragment ItemCard(BoardItem item) => __builder =>
    {
        <BoardItemCard Item="item"
                       Section="Section"
                       CanReorder="IsItemDraggable()"
                       OverdueSince="@GetDailyOverdueSince(item)"
                       IsBusy="@IsItemBusy(item.Id)"
                       OnHabitUp="@(() => HabitUpAsync(item))"
                       OnHabitDown="@(() => HabitDownAsync(item))"
                       OnToggle="@(() => ToggleAsync(item))"
                       OnOpenEditor="@(() => OpenItemEditorAsync(item))"
                       OnMoveUp="@(() => MoveUpAsync(item))"
                       OnMoveDown="@(() => MoveDownAsync(item))"
                       OnMoveToTop="@(() => MoveToTopAsync(item))"
                       OnMoveToBottom="@(() => MoveToBottomAsync(item))"
                       OnDelete="@(() => DeleteAsync(item.Id, item.Title))"
                       OnSetChecklistItemDone="@(args => SetChecklistItemDoneAsync(item, args.ChecklistItemId, args.IsDone))"/>
    };
}
