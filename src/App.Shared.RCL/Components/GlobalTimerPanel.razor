@inject GlobalTimerService TimerService
@inject IUserPreferencesService PreferencesService
@implements IDisposable

<MudCard Class="@GetTimerPanelClass()" Elevation="0" Outlined="true">
    <div class="@MobileHeaderClass"
         @onclick="ToggleExpanded"
         @onkeydown="OnMobileHeaderKeyDown"
         role="button"
         tabindex="0"
         @attributes="MobileHeaderAria"
         aria-label="Toggle timer panel">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100 px-3 py-2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="min-w-0 flex-grow-1">
                <MudIcon Icon="@(TimerService.PomodoroModeEnabled ? Icons.Material.Filled.Alarm : Icons.Material.Filled.Timer)" Color="Color.Primary" Size="Size.Medium"/>
                @if (IsSessionActive)
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold timer-mobile-header-text">
                        @GetDisplayTime()
                        @if (!string.IsNullOrWhiteSpace(GetRunningTargetLabel()))
                        {
                            <span class="mud-text-secondary font-weight-normal text-truncate max-w-240"> · @GetRunningTargetLabel()</span>
                        }
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold timer-mobile-header-text">
                        <span class="timer-mobile-header-mode-badge">@(TimerService.PomodoroModeEnabled ? "Pomodoro" : "Stopwatch")</span>
                    </MudText>
                }
            </MudStack>
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Color="Color.Default"
                     Class="timer-mobile-expand-icon"
                     Size="Size.Medium"/>
        </MudStack>
    </div>

    <div class="timer-collapse-outer">
        <MudCollapse Expanded="@_expanded" Class="timer-collapse-wrapper">
            <MudCardContent Class="pa-2 pa-sm-3 timer-panel__content">
        @if (IsSessionActive)
        {
            <div class="timer-running-strip" role="group" aria-label="Active session timer">
                <div class="timer-running-strip__main">
                    <div class="timer-clock-header timer-clock-header--strip">
                        <MudText Typo="Typo.h5"
                                 Color="Color.Default"
                                 GutterBottom="false"
                                 Class="timer-value timer-value--strip"
                                 role="timer"
                                 aria-live="polite">
                            @GetDisplayTime()
                        </MudText>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(GetRunningTargetLabel()))
                    {
                        <MudText Typo="Typo.body2"
                                 Class="timer-running-target mud-text-secondary"
                                 title="@GetRunningTargetLabel()">
                            @GetRunningTargetLabel()
                        </MudText>
                    }
                    @if (TimerService.PomodoroModeEnabled)
                    {
                        <div class="timer-pomodoro-status-strip">
                            @if (TimerService.CurrentPomodoroState != PomodoroState.Idle && TimerService.CurrentPomodoroState != PomodoroState.Work)
                            {
                                <span class="timer-pomodoro-status-badge">@GetPomodoroStatusLabel()</span>
                            }
                            <span class="timer-pomodoro-status-badge timer-pomodoro-next-badge" title="Next pomodoro duration">
                                Next: @GetNextPomodoroLabelAndDuration()
                            </span>
                            <span class="timer-pomodoro-status-badge timer-pomodoro-done-badge" title="Total accomplished work sessions">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1 done-icon" Color="Color.Success" style="font-size: 0.85rem;" />
                                Done: @TimerService.CompletedWorkIntervalsCount
                            </span>
                            <span class="timer-pomodoro-status-badge timer-pomodoro-cycle-badge" title="Sessions completed in current cycle before long break">
                                Cycle: @GetCompletedInCurrentCycle()/@TimerService.IntervalsBeforeLongBreak
                            </span>
                            <div class="timer-pomodoro-progress-bar" title="Cycle progress: @GetCompletedInCurrentCycle() of @TimerService.IntervalsBeforeLongBreak completed before long break">
                                @for (int i = 0; i < TimerService.IntervalsBeforeLongBreak; i++)
                                {
                                    var completed = i < GetCompletedInCurrentCycle();
                                    <div class="@GetProgressSegmentClass(completed)"></div>
                                }
                            </div>
                        </div>
                    }
                    else if (TimerService.FocusAlertAfter.HasValue)
                    {
                        <div class="timer-pomodoro-status-strip">
                            <span class="timer-pomodoro-status-badge" style="color: var(--mud-palette-warning); background-color: color-mix(in srgb, var(--mud-palette-warning) 8%, transparent);">
                                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" Class="mr-1" style="font-size: 0.85rem;" />
                                Alert: @FocusDurationInput.FormatForAlertLabel(TimerService.FocusAlertAfter.Value)
                            </span>
                        </div>
                    }
                </div>
                <div class="timer-running-strip__actions">
                    @if (TimerService.PomodoroModeEnabled && (TimerService.CurrentPomodoroState == PomodoroState.ShortBreak || TimerService.CurrentPomodoroState == PomodoroState.LongBreak))
                    {
                        <MudIconButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Icon="@Icons.Material.Filled.SkipNext"
                                       Class="timer-icon-btn"
                                       OnClick="SkipBreak"
                                       aria-label="Skip break" />
                    }
                    @if (TimerService.IsRunning)
                    {
                        <MudIconButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       Icon="@Icons.Material.Filled.Pause"
                                       Class="timer-icon-btn timer-icon-btn--pause"
                                       OnClick="Pause"
                                       aria-label="Pause timer" />
                    }
                    else
                    {
                        <MudIconButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Icon="@Icons.Material.Filled.PlayArrow"
                                       Class="timer-icon-btn timer-icon-btn--start"
                                       OnClick="Start"
                                       Disabled="@(!CanStart)"
                                       aria-label="Resume timer" />
                    }
                    <MudIconButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Icon="@Icons.Material.Filled.Stop"
                                   Class="timer-icon-btn timer-icon-btn--stop"
                                   OnClick="StopAndLog"
                                   Disabled="@(!IsSessionActive)"
                                   aria-label="Stop and log session" />
                    <MudIconButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Icon="@Icons.Material.Filled.Refresh"
                                   Class="timer-icon-btn"
                                   OnClick="Reset"
                                   Disabled="@(!CanReset)"
                                   aria-label="Reset timer" />
                    <MudIconButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Icon="@(_settingsExpanded ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                   Class="timer-icon-btn"
                                   OnClick="ToggleSettings"
                                   aria-label="Toggle settings" />
                </div>
            </div>
            <MudCollapse Expanded="@_settingsExpanded">
                <div class="timer-settings-collapsed-content mt-2">
                    @RenderTimerInputs
                </div>
            </MudCollapse>
        }
        else
        {
            <div class="timer-compact timer-compact--idle">
                <div class="timer-compact__left-col">
                    <div class="custom-timer-toggle" role="group" aria-label="Timer mode selection">
                        <button type="button" 
                                class="@StopwatchToggleClass" 
                                @onclick="() => OnPomodoroModeToggleChanged(false)"
                                @attributes="StopwatchToggleAria"
                                aria-label="Stopwatch mode">
                            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Medium" aria-hidden="true"/>
                            <span class="toggle-btn-label">Stopwatch</span>
                        </button>
                        <button type="button" 
                                class="@PomodoroToggleClass" 
                                @onclick="() => OnPomodoroModeToggleChanged(true)"
                                @attributes="PomodoroToggleAria"
                                aria-label="Pomodoro mode">
                            <MudIcon Icon="@Icons.Material.Filled.Alarm" Size="Size.Medium" aria-hidden="true"/>
                            <span class="toggle-btn-label">Pomodoro</span>
                        </button>
                    </div>
                </div>



                <div class="timer-compact__right-col">
                    @RenderTimerInputs
                </div>

                <div class="timer-compact__actions">
                    <MudIconButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Icon="@Icons.Material.Filled.PlayArrow"
                                   Class="timer-icon-btn timer-icon-btn--start"
                                   OnClick="Start"
                                   Disabled="@(!CanStart)"
                                   aria-label="Start focus session" />
                    <MudIconButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Icon="@Icons.Material.Filled.Stop"
                                   Class="timer-icon-btn timer-icon-btn--stop"
                                   OnClick="StopAndLog"
                                   Disabled="@(!IsSessionActive)"
                                   aria-label="Stop and log session" />
                    <MudIconButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Icon="@Icons.Material.Filled.Refresh"
                                   Class="timer-icon-btn"
                                   OnClick="Reset"
                                   Disabled="@(!CanReset)"
                                   aria-label="Reset timer" />
                </div>
            </div>
        }
            </MudCardContent>
        </MudCollapse>
    </div>
</MudCard>

@code {
    [Parameter] public EventCallback<TimeSpan> OnLogSaved { get; set; }

    [Parameter] public IReadOnlyList<BoardItem> Habits { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Dailies { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Todos { get; set; } = [];

    private PeriodicTimer? _uiTick;
    private CancellationTokenSource? _uiTickCts;
    private string _sessionTargetText = string.Empty;
    private bool _sessionTargetFieldInitialized;
    private (string? TargetId, string? TargetType, Guid? BoardItemId) _lastSyncedSessionTarget;
    private bool _focusDurationFieldInitialized;
    private TimeSpan? _lastSyncedFocusAlertAfter;
    private string _focusDurationText = string.Empty;
    private bool _settingsExpanded;
    private bool _wasRunning;
    private bool _expanded;

    private bool IsSessionActive =>
        TimerService.IsRunning || TimerService.Elapsed > TimeSpan.Zero;

    private string MobileHeaderClass => _expanded ? "timer-mobile-header timer-mobile-header--expanded" : "timer-mobile-header timer-mobile-header--collapsed";
    private Dictionary<string, object> MobileHeaderAria => new()
    {
        { "aria-expanded", _expanded ? "true" : "false" }
    };
    private Dictionary<string, object> StopwatchToggleAria => new()
    {
        { "aria-pressed", TimerService.PomodoroModeEnabled ? "false" : "true" }
    };
    private Dictionary<string, object> PomodoroToggleAria => new()
    {
        { "aria-pressed", TimerService.PomodoroModeEnabled ? "true" : "false" }
    };
    private static string GetProgressSegmentClass(bool completed) => completed ? "progress-segment completed" : "progress-segment";
    private string StopwatchToggleClass => !TimerService.PomodoroModeEnabled ? "toggle-btn active" : "toggle-btn";
    private string PomodoroToggleClass => TimerService.PomodoroModeEnabled ? "toggle-btn active" : "toggle-btn";

    private string FocusDurationText
    {
        get => _focusDurationText;
        set
        {
            var v = value ?? string.Empty;
            if (_focusDurationText == v)
            {
                return;
            }

            _focusDurationText = v;
            _focusDurationParseError = false;
            if (string.IsNullOrWhiteSpace(_focusDurationText))
            {
                TimerService.FocusAlertAfter = null;
            }
        }
    }

    private bool _focusDurationParseError;

    private string? _focusDurationErrorText =>
        _focusDurationParseError ? FocusDurationInput.ParseErrorHint : null;

    /// <summary>Session target (board item or custom label) is required before starting.</summary>
    private bool CanStart =>
        !TimerService.IsRunning
        && !TimerService.AwaitingFocusTimeUpPrompt
        && (
            !string.IsNullOrWhiteSpace(TimerService.TargetId)
            || (TimerService.PomodoroModeEnabled && (TimerService.CurrentPomodoroState == PomodoroState.ShortBreak || TimerService.CurrentPomodoroState == PomodoroState.LongBreak))
        );

    /// <summary>Reset is allowed when timer is not running and there's elapsed time or a target set.</summary>
    private bool CanReset =>
        !TimerService.IsRunning
        && (
            !string.IsNullOrWhiteSpace(TimerService.TargetId)
            || TimerService.Elapsed > TimeSpan.Zero
            || (TimerService.PomodoroModeEnabled && TimerService.CurrentPomodoroState != PomodoroState.Idle)
        );

    private readonly List<string> _sessionTargetOptions = [];
    private readonly Dictionary<string, (string TargetType, string TargetTitle, Guid ItemId)> _sessionLabelToTarget = new(StringComparer.Ordinal);

    private string GetTimerPanelClass() =>
        IsSessionActive ? "timer-panel w-100 timer-panel--active" : "timer-panel w-100";

    private string GetRunningTargetLabel()
    {
        if (string.IsNullOrWhiteSpace(_sessionTargetText))
        {
            return FormatTargetForField(TimerService);
        }

        return _sessionTargetText;
    }
     private RenderFragment RenderTimerInputs => __builder =>
     {
          <div class="timer-inputs-pair">
             <div class="timer-target-input-row">
                 <MudAutocomplete T="string"
                                  Value="@_sessionTargetText"
                                  ValueChanged="OnSessionTargetValueChanged"
                                  SearchFunc="SearchSessionTargetsAsync"
                                  Label="Session target"
                                  Placeholder="Search board or type a custom label"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="timer-target-field flex-grow-1"
                                  Immediate="true"
                                  CoerceValue="true"
                                  Strict="false"
                                  MinCharacters="0"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@GetTimerTargetLeadIcon()"
                                  ResetValueOnEmptyText="true">
                     <ItemTemplate Context="rowKey">
                         @{
                             _sessionLabelToTarget.TryGetValue(rowKey, out (string TargetType, string TargetTitle, Guid _) entry);
                         }
                         <MudStack Row="true"
                                   Spacing="2"
                                   AlignItems="AlignItems.Center"
                                   Class="w-100">
                             <MudIcon Color="Color.Default"
                                      Icon="@BoardSectionVisuals.GetMudIconForTargetType(entry.TargetType)"
                                      Size="Size.Small"/>
                             <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@rowKey</MudText>
                         </MudStack>
                     </ItemTemplate>
                 </MudAutocomplete>
             </div>
             @if (!TimerService.PomodoroModeEnabled)
             {
                 <div class="timer-focus-field" @onkeydown="OnFocusDurationKeyDown">
                     <MudStack Row="true"
                                Spacing="0"
                                AlignItems="AlignItems.Center"
                                Class="timer-focus-input-row">
                         <MudTextField T="string"
                                       @bind-Text="FocusDurationText"
                                       OnBlur="OnFocusDurationBlur"
                                       Label="Time's up after"
                                       Placeholder="e.g. 25, 1:20, 90s, 0:0:30"
                                       Clearable="true"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Class="timer-focus-textfield w-100 flex-grow-1"
                                       Immediate="true"
                                       Error="@_focusDurationParseError"
                                       ErrorText="@_focusDurationErrorText"/>
                         <MudTooltip ShowOnHover="false"
                                     ShowOnClick="true"
                                     ShowOnFocus="true"
                                     Arrow="true"
                                     Placement="Placement.Top">
                             <ChildContent>
                                 <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                Variant="Variant.Text"
                                                Size="Size.Small"
                                                Color="Color.Default"
                                                Class="timer-focus-info-icon"
                                                aria-label="How time's up alert works"/>
                             </ChildContent>
                             <TooltipContent>
                                 <MudText Typo="Typo.caption" Class="focus-duration-help-text">
                                     @FocusDurationInput.HelpTooltip
                                 </MudText>
                             </TooltipContent>
                         </MudTooltip>
                     </MudStack>
                 </div>
             }
             else
             {
                  <div class="timer-pomodoro-info-field">
                      <MudField Label="Pomodoro session" Variant="Variant.Outlined" Margin="Margin.Dense" Class="timer-pomodoro-field-control" tabindex="-1">
                          <div class="timer-pomodoro-info-container" style="display: flex !important; align-items: center !important; justify-content: space-between !important; width: 100% !important; height: 100% !important; gap: 8px !important; white-space: nowrap !important; overflow: hidden !important;">
                              <div class="timer-pomodoro-info-item timer-pomodoro-info-item--next" style="display: inline-flex !important; align-items: center !important; white-space: nowrap !important; flex-shrink: 0 !important;" title="@GetNextPomodoroTitle()">
                                  <MudIcon Icon="@Icons.Material.Filled.ArrowCircleRight" Size="Size.Small" Class="mr-1 next-icon" />
                                  <span class="info-value next-value">@GetNextPomodoroLabelAndDuration()</span>
                              </div>
                              <div class="timer-pomodoro-info-divider"></div>
                              <div class="timer-pomodoro-info-item timer-pomodoro-info-item--done" style="display: inline-flex !important; align-items: center !important; white-space: nowrap !important; flex-shrink: 0 !important;" title="@GetCompletedPomodoroTitle()">
                                  <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1 done-icon" Color="Color.Success" />
                                   <span class="info-value total-value">@TimerService.CompletedWorkIntervalsCount - @GetCompletedInCurrentCycle()/@TimerService.IntervalsBeforeLongBreak</span>
                              </div>
                          </div>
                      </MudField>
                  </div>
              }
         </div>
     };

    protected override async Task OnInitializedAsync()
    {
        _uiTickCts = new CancellationTokenSource();
        _uiTick = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _expanded = IsSessionActive;
        _ = RunUiTickAsync(_uiTickCts.Token);

        try
        {
            var prefs = await PreferencesService.GetAsync();
            TimerService.WorkDuration = TimeSpan.FromMinutes(prefs.PomodoroWorkDurationMinutes);
            TimerService.ShortBreakDuration = TimeSpan.FromMinutes(prefs.PomodoroShortBreakMinutes);
            TimerService.LongBreakDuration = TimeSpan.FromMinutes(prefs.PomodoroLongBreakMinutes);
            TimerService.IntervalsBeforeLongBreak = prefs.PomodoroCyclesBeforeLongBreak;
        }
        catch
        {
            // fallback to defaults already defined
        }
    }

    protected override void OnParametersSet()
    {
        RebuildSessionTargetOptions();
        var wasRunning = _wasRunning;
        SyncTimerFieldsFromServiceIfNeeded();

        if (TimerService.IsRunning && !wasRunning)
        {
            _expanded = true; // Auto-expand when timer starts
        }
    }

    private void SyncFocusDurationFromServiceIfChanged()
    {
        if (_focusDurationFieldInitialized && TimerService.FocusAlertAfter == _lastSyncedFocusAlertAfter)
        {
            return;
        }

        _focusDurationFieldInitialized = true;
        _lastSyncedFocusAlertAfter = TimerService.FocusAlertAfter;
        _focusDurationText = FocusDurationInput.FormatForField(TimerService.FocusAlertAfter);
        _focusDurationParseError = false;
    }

    private void SyncTimerFieldsFromServiceIfNeeded()
    {
        var key = (TimerService.TargetId, TimerService.TargetType, TimerService.BoardItemId);
        if (!_sessionTargetFieldInitialized || key != _lastSyncedSessionTarget)
        {
            _lastSyncedSessionTarget = key;
            _sessionTargetFieldInitialized = true;
            _sessionTargetText = FormatTargetForField(TimerService);
        }

        SyncFocusDurationFromServiceIfChanged();

        if (TimerService.IsRunning && !_wasRunning)
        {
            _settingsExpanded = false;
        }

        _wasRunning = TimerService.IsRunning;
    }

    private void OnFocusDurationBlur()
    {
        ApplyFocusDurationFromText();
    }

    private void OnFocusDurationKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            ApplyFocusDurationFromText();
        }
    }

    private void ApplyFocusDurationFromText()
    {
        if (string.IsNullOrWhiteSpace(_focusDurationText))
        {
            TimerService.FocusAlertAfter = null;
            _focusDurationText = string.Empty;
            _focusDurationParseError = false;
            _lastSyncedFocusAlertAfter = null;
            return;
        }

        if (!FocusDurationInput.TryParse(_focusDurationText, out var parsed)
            || parsed is null
            || parsed <= TimeSpan.Zero)
        {
            _focusDurationParseError = true;
            return;
        }

        _focusDurationParseError = false;
        TimerService.FocusAlertAfter = parsed;
        _focusDurationText = FocusDurationInput.FormatForField(parsed);
        _lastSyncedFocusAlertAfter = parsed;
    }

    private async Task RunUiTickAsync(CancellationToken cancellationToken)
    {
        if (_uiTick is null)
        {
            return;
        }

        try
        {
            while (await _uiTick.WaitForNextTickAsync(cancellationToken))
            {
                SyncTimerFieldsFromServiceIfNeeded();
                if (TimerService.IsRunning)
                {
                    // Elapsed only changes while running skip re-renders while idle or paused.
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during disposal.
        }
    }

    private void RebuildSessionTargetOptions()
    {
        _sessionLabelToTarget.Clear();
        _sessionTargetOptions.Clear();

        var all = new List<(BoardSection Section, BoardItem Item)>();
        foreach (var h in Habits)
        {
            all.Add((BoardSection.Habit, h));
        }

        foreach (var d in Dailies)
        {
            all.Add((BoardSection.Daily, d));
        }

        foreach (var t in Todos)
        {
            all.Add((BoardSection.Todo, t));
        }

        var groups = all
            .GroupBy(x => x.Item.Title, StringComparer.OrdinalIgnoreCase);

        foreach (var g in groups)
        {
            var disambiguate = g.Count() > 1;
            foreach (var (section, item) in g
                         .OrderBy(x => x.Section)
                         .ThenBy(x => x.Item.Id))
            {
                var st = section.ToString();
                var key = disambiguate
                    ? item.Title + " · " + item.Id.ToString("N")[..4]
                    : item.Title;
                if (_sessionLabelToTarget.ContainsKey(key))
                {
                    key = item.Title + " · " + item.Id.ToString("N");
                }

                _sessionLabelToTarget[key] = (st, item.Title, item.Id);
                _sessionTargetOptions.Add(key);
            }
        }
    }

    private string FormatTargetForField(GlobalTimerService timer)
    {
        if (string.IsNullOrEmpty(timer.TargetId))
        {
            return string.Empty;
        }

        if (timer.TargetType is "Session" or null)
        {
            return timer.TargetId;
        }

        if (timer.TargetType is "Habit" or "Daily" or "Todo")
        {
            foreach (var k in _sessionTargetOptions)
            {
                if (_sessionLabelToTarget.TryGetValue(
                        k,
                        out var m)
                    && m.TargetType == timer.TargetType
                    && m.TargetTitle == timer.TargetId
                    && (timer.BoardItemId is null || m.ItemId == timer.BoardItemId))
                {
                    return k;
                }
            }
        }

        return timer.TargetId;
    }

    private string GetTimerTargetLeadIcon()
    {
        if (string.IsNullOrEmpty(TimerService.TargetId))
        {
            return Icons.Material.Outlined.Label;
        }

        if (string.IsNullOrEmpty(TimerService.TargetType) || TimerService.TargetType == "Session")
        {
            return BoardSectionVisuals.GetMudIconForTargetType("Session");
        }

        return BoardSectionVisuals.GetMudIconForTargetType(TimerService.TargetType);
    }

    private Task<IEnumerable<string>> SearchSessionTargetsAsync(string value, CancellationToken cancellationToken)
    {
        return Task.FromResult(SearchSessionTargets(value));
    }

    private IEnumerable<string> SearchSessionTargets(string value)
    {
        if (_sessionTargetOptions.Count == 0)
        {
            return Array.Empty<string>();
        }

        var v = value.Trim();
        if (v.Length == 0)
        {
            return _sessionTargetOptions;
        }

        return _sessionTargetOptions.Where(s =>
        {
            if (s.Contains(v, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return _sessionLabelToTarget.TryGetValue(s, out var row)
                   && row.TargetTitle.Contains(v, StringComparison.OrdinalIgnoreCase);
        });
    }

    private void OnSessionTargetValueChanged(string? value)
    {
        var text = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            TimerService.SetManualTarget(null);
        }
        else if (_sessionLabelToTarget.TryGetValue(text, out var mapped))
        {
            TimerService.SelectTarget(mapped.TargetType, mapped.TargetTitle, mapped.ItemId);
        }
        else
        {
            TimerService.SetManualTarget(text);
        }

        _sessionTargetText = FormatTargetForField(TimerService);
        _lastSyncedSessionTarget = (TimerService.TargetId, TimerService.TargetType, TimerService.BoardItemId);
        _sessionTargetFieldInitialized = true;
    }

    private void Start()
    {
        if (!CanStart)
        {
            return;
        }

        TimerService.Start();
        _settingsExpanded = false;
        _wasRunning = true;
    }

    private void Pause()
    {
        TimerService.Pause();
        _wasRunning = false;
    }

    private void Reset()
    {
        if (TimerService.PomodoroModeEnabled)
        {
            TimerService.ResetPomodoroSession();
        }
        else
        {
            TimerService.Reset();
        }
        _settingsExpanded = false;
    }

    private void SkipBreak()
    {
        TimerService.TransitionToWork();
        StateHasChanged();
    }

    private void OnPomodoroModeToggleChanged(bool enabled)
    {
        TimerService.PomodoroModeEnabled = enabled;
        if (enabled)
        {
            TimerService.ResetPomodoroSession();
        }
        else
        {
            TimerService.Reset();
        }
        _lastSyncedFocusAlertAfter = TimerService.FocusAlertAfter;
        _focusDurationText = FocusDurationInput.FormatForField(TimerService.FocusAlertAfter);
    }

    private string GetDisplayTime() => TimerService.GetDisplayTime();

    private string GetNextPomodoroLabelAndDuration()
    {
        var nextState = TimerService.CurrentPomodoroState switch
        {
            PomodoroState.Idle => "Work",
            PomodoroState.Work => (TimerService.CompletedWorkIntervalsCount + 1) % TimerService.IntervalsBeforeLongBreak == 0 ? "Long Break" : "Short Break",
            PomodoroState.ShortBreak => "Work",
            PomodoroState.LongBreak => "Work",
            _ => "Work"
        };

        var nextDuration = TimerService.CurrentPomodoroState switch
        {
            PomodoroState.Idle => TimerService.WorkDuration,
            PomodoroState.Work => (TimerService.CompletedWorkIntervalsCount + 1) % TimerService.IntervalsBeforeLongBreak == 0 ? TimerService.LongBreakDuration : TimerService.ShortBreakDuration,
            PomodoroState.ShortBreak => TimerService.WorkDuration,
            PomodoroState.LongBreak => TimerService.WorkDuration,
            _ => TimerService.WorkDuration
        };

        return $"{nextState}: {GlobalTimerService.FormatTimeSpan(nextDuration)}";
    }

    private string GetPomodoroStatusLabel() => TimerService.StatusLabel;

    private int GetCompletedInCurrentCycle()
    {
        if (TimerService.IntervalsBeforeLongBreak <= 0) return 0;
        var count = TimerService.CompletedWorkIntervalsCount % TimerService.IntervalsBeforeLongBreak;
        if (count == 0 && TimerService.CompletedWorkIntervalsCount > 0 && TimerService.CurrentPomodoroState == PomodoroState.LongBreak)
        {
            return TimerService.IntervalsBeforeLongBreak;
        }
        return count;
    }

    private async Task StopAndLog()
    {
        var elapsed = TimerService.Stop();
        if (elapsed > TimeSpan.Zero)
        {
            await OnLogSaved.InvokeAsync(elapsed);
        }
        TimerService.ClearTargetAndFocus();
        _sessionTargetText = string.Empty;
        _lastSyncedSessionTarget = (null, null, null);
        _focusDurationText = string.Empty;
        _lastSyncedFocusAlertAfter = null;
        _focusDurationFieldInitialized = true;
        _settingsExpanded = false;
        _wasRunning = false;
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }

    private void OnMobileHeaderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            ToggleExpanded();
        }
    }

    private string GetNextPomodoroTitle() => $"Next Pomodoro: {GetNextPomodoroLabelAndDuration()}";

    private string GetCompletedPomodoroTitle() =>
        $"Completed: {TimerService.CompletedWorkIntervalsCount} overall, {GetCompletedInCurrentCycle()} of {TimerService.IntervalsBeforeLongBreak} in current cycle";

    private void ToggleSettings()
    {
        _settingsExpanded = !_settingsExpanded;
    }

    public void Dispose()
    {
        _uiTickCts?.Cancel();
        _uiTick?.Dispose();
        _uiTickCts?.Dispose();
    }
}
