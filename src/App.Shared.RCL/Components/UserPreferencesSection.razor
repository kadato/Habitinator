@using System.Globalization
@using App.Shared.RCL
@inject IUserPreferencesService PreferencesService
@inject IUserNotifier Notifier
@inject IUserTimeZoneService TimeZoneService
@implements IDisposable

<MudStack Spacing="3">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5">Profile &amp; preferences</MudText>
    }

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
    }
    else if (_loading)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="120px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="250px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="150px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="160px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="350px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="100%" Height="40px" Class="mt-2" />
                <MudSkeleton Width="180px" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudSkeleton Width="80px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="280px" Height="16px" Class="mb-3" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Account</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    How your name and dates are shown across the app.
                </MudText>
                <MudTextField T="string" Label="Display name"
                              Variant="Variant.Outlined"
                              dense="true"
                              MaxLength="40"
                              Immediate="true"
                              Error="@(_displayNameError is not null)"
                              ErrorText="@_displayNameError"
                              Value="_displayName"
                              ValueChanged="OnDisplayNameChanged"
                              OnBlur="AutoSaveAsync"/>
                <MudTextField T="string"
                              Label="Date format"
                              Variant="Variant.Outlined"
                              dense="true"
                              Value="_model.DateFormat"
                              ValueChanged="OnDateFormatChanged"
                              Immediate="true"
                              Error="@(_dateFormatError is not null)"
                              ErrorText="@_dateFormatError"
                              OnBlur="AutoSaveAsync"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Preview: @_datePreview
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Pomodoro Timer</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Customize focus and break durations for the Pomodoro timer.
                </MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Work duration (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="180"
                                         Value="_model.PomodoroWorkDurationMinutes"
                                         ValueChanged="OnWorkDurationChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Short break (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="60"
                                         Value="_model.PomodoroShortBreakMinutes"
                                         ValueChanged="OnShortBreakChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Long break (minutes)"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="120"
                                         Value="_model.PomodoroLongBreakMinutes"
                                         ValueChanged="OnLongBreakChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="int" Label="Sessions before long break"
                                         Variant="Variant.Outlined" dense="true"
                                         Min="1" Max="20"
                                         Value="_model.PomodoroCyclesBeforeLongBreak"
                                         ValueChanged="OnCyclesChanged"
                                         Immediate="true"
                                         OnBlur="AutoSaveAsync" />
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Day start &amp; timezone</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Set when your day starts and override the detected timezone if you travel or prefer a fixed zone.
                </MudText>
                <MudTimePicker Label="Day starts at"
                               Time="_dayStart"
                               TimeChanged="OnDayStartChanged"
                               TimeEditMode="TimeEditMode.Normal"/>
                @if (_dayStartError is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@_dayStartError</MudText>
                }
                <MudSelect T="string" Label="Timezone" Variant="Variant.Outlined" dense="true"
                           Value="_timeZoneSelection" ValueChanged="OnTimeZoneChanged">
                    <MudSelectItem Value="@AutoTimeZoneValue">Auto (@_detectedTimeZoneLabel)</MudSelectItem>
                    @foreach (var tz in _timeZones)
                    {
                        <MudSelectItem Value="@tz.Id">@tz.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Current: @_resolvedTimeZoneLabel
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Theme</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Choose your visual theme or sync with system preferences.
                </MudText>
                <MudSelect T="AppTheme" Label="Theme mode" Variant="Variant.Outlined" dense="true"
                           Value="_themeSelection" ValueChanged="OnThemeChanged">
                    <MudSelectItem Value="@AppTheme.System">System default</MudSelectItem>
                    <MudSelectItem Value="@AppTheme.Light">Light mode</MudSelectItem>
                    <MudSelectItem Value="@AppTheme.Dark">Dark mode</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudPaper>

        @* Settings are saved automatically on change or blur *@
    }
</MudStack>

@code {
    [Parameter]
    public bool ShowTitle { get; set; } = true;

    private UserPreferences? _model;
    private bool _loading = true;
    private string? _loadError;
    private TimeSpan? _dayStart;
    private string _displayName = string.Empty;
    private string _datePreview = string.Empty;
    private string _timeZoneSelection = "Auto";
    private string _detectedTimeZoneLabel = "";
    private string _resolvedTimeZoneLabel = "";
    private const string AutoTimeZoneValue = "Auto";
    private string? _displayNameError;
    private string? _dateFormatError;
    private string? _dayStartError;
    private AppTheme _themeSelection = AppTheme.System;

    private readonly List<(string Id, string Label)> _timeZones = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var loaded = await PreferencesService.GetAsync();
            ApplyModel(loaded);
            ApplyTimeZoneOverride();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
    }

    private void ApplyModel(UserPreferences preferences)
    {
        _model = Clone(preferences);
        _dayStart = _model.DayStartLocalTime;
        _displayName = _model.DisplayName ?? string.Empty;
        _timeZoneSelection = string.IsNullOrWhiteSpace(_model.TimeZoneOverrideId)
            ? AutoTimeZoneValue
            : _model.TimeZoneOverrideId;
        _themeSelection = _model.Theme;
        _detectedTimeZoneLabel = TimeZoneService.TimeZoneId ?? "Unknown";
        UpdateTimeZoneList();
        UpdateDatePreview();
        UpdateResolvedTimeZoneLabel();
    }

    private void UpdateTimeZoneList()
    {
        _timeZones.Clear();
        foreach (var tz in TimeZoneInfo.GetSystemTimeZones())
        {
            _timeZones.Add((tz.Id, $"{tz.DisplayName} ({tz.Id})"));
        }
    }

    private void UpdateDatePreview()
    {
        if (_model is null) return;
        _dateFormatError = null;
        try
        {
            _datePreview = DateTime.Now.ToString(_model.DateFormat, CultureInfo.InvariantCulture);
        }
        catch (FormatException)
        {
            _datePreview = "Invalid format";
            _dateFormatError = "Date format is not valid.";
        }
    }

    private void UpdateResolvedTimeZoneLabel()
    {
        _resolvedTimeZoneLabel = _timeZoneSelection == "Auto"
            ? _detectedTimeZoneLabel
            : _timeZoneSelection;
    }

    private void ApplyTimeZoneOverride()
    {
        TimeZoneService.SetOverride(_model?.TimeZoneOverrideId);
    }

    private UserPreferences Clone(UserPreferences s)
    {
        return new UserPreferences
        {
            DateFormat = s.DateFormat,
            DayStartLocalTime = s.DayStartLocalTime,
            TimeZoneOverrideId = s.TimeZoneOverrideId,
            DisplayName = s.DisplayName,
            Theme = s.Theme,
            PomodoroWorkDurationMinutes = s.PomodoroWorkDurationMinutes,
            PomodoroShortBreakMinutes = s.PomodoroShortBreakMinutes,
            PomodoroLongBreakMinutes = s.PomodoroLongBreakMinutes,
            PomodoroCyclesBeforeLongBreak = s.PomodoroCyclesBeforeLongBreak
        };
    }

    private async Task AutoSaveAsync()
    {
        if (_model is null) return;
        if (!ValidateInputs()) return;
        try
        {
            await PreferencesService.SaveAsync(_model);
            ApplyTimeZoneOverride();
        }
        catch (Exception ex)
        {
            await Notifier.NotifyAsync($"Could not save preferences: {ex.Message}", Severity.Error);
        }
    }

    private void OnDisplayNameChanged(string value)
    {
        if (_model is null) return;
        // Strip Zalgo characters silently before storing — the sanitised value is
        // what the user will see after blur, which makes the effect self-evident.
        var sanitized = ZalgoSanitizer.Sanitize(value);
        _displayName = sanitized ?? string.Empty;
        _model.DisplayName = string.IsNullOrWhiteSpace(sanitized) ? null : sanitized.Trim();
        _displayNameError = null;
    }

    private void OnDateFormatChanged(string value)
    {
        if (_model is null) return;
        _model.DateFormat = value;
        UpdateDatePreview();
    }


    private async Task OnDayStartChanged(TimeSpan? value)
    {
        if (_model is null || value is null) return;
        _dayStart = value;
        _model.DayStartLocalTime = value.Value;
        await AutoSaveAsync();
    }

    private async Task OnTimeZoneChanged(string value)
    {
        if (_model is null) return;
        _timeZoneSelection = value;
        _model.TimeZoneOverrideId = value == AutoTimeZoneValue ? null : value;
        UpdateResolvedTimeZoneLabel();
        await AutoSaveAsync();
    }

    private async Task OnThemeChanged(AppTheme value)
    {
        if (_model is null) return;
        _themeSelection = value;
        _model.Theme = value;
        await AutoSaveAsync();
    }

    private void OnWorkDurationChanged(int value)
    {
        if (_model is null) return;
        _model.PomodoroWorkDurationMinutes = Math.Clamp(value, 1, 180);
    }

    private void OnShortBreakChanged(int value)
    {
        if (_model is null) return;
        _model.PomodoroShortBreakMinutes = Math.Clamp(value, 1, 60);
    }

    private void OnLongBreakChanged(int value)
    {
        if (_model is null) return;
        _model.PomodoroLongBreakMinutes = Math.Clamp(value, 1, 120);
    }

    private void OnCyclesChanged(int value)
    {
        if (_model is null) return;
        _model.PomodoroCyclesBeforeLongBreak = Math.Clamp(value, 1, 20);
    }

    private bool ValidateInputs()
    {
        _displayNameError = null;
        _dateFormatError = null;
        _dayStartError = null;

        if (_model is null) return false;

        if (!string.IsNullOrWhiteSpace(_model.DisplayName) && _model.DisplayName.Length > 40)
        {
            _displayNameError = "Display name must be 40 characters or fewer.";
        }

        try
        {
            _ = DateTime.Now.ToString(_model.DateFormat, CultureInfo.InvariantCulture);
        }
        catch (FormatException)
        {
            _dateFormatError = "Date format is not valid.";
        }

        if (_model.DayStartLocalTime < TimeSpan.Zero || _model.DayStartLocalTime >= TimeSpan.FromDays(1))
        {
            _dayStartError = "Day start must be within a single day (00:00 - 23:59).";
        }

        return _displayNameError is null && _dateFormatError is null && _dayStartError is null;
    }
}
