@using Microsoft.AspNetCore.Components
@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@using System.Text.Json
@implements IDisposable
@inject BoardUiSessionState UiSessionState
@inject IUserPreferencesService PreferencesService
@inject IAiAssistantService AiService
@inject IBoardDataService BoardData
@inject IRemoteBoardRefreshService RemoteRefresh
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IBoardSyncStatus BoardSync

<MudDrawer @bind-Open="UiSessionState.IsAiDrawerOpen"
           Anchor="@DrawerAnchor"
           Elevation="4"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           Width="min(480px, 100%)"
           Class="ai-assistant-drawer"
           ClipMode="DrawerClipMode.Never">
    <div class="ai-drawer-container d-flex flex-column h-100" role="dialog" aria-modal="true" aria-label="AI assistant" tabindex="-1" @onkeydown="OnDrawerKeyDown">
        <div class="ai-drawer-grabber" aria-hidden="true"></div>
        <div class="ai-drawer-header px-3 py-2 d-flex align-center justify-space-between gap-1" @ref="_sheetHeaderRef">
            <div class="d-flex align-center gap-2 min-w-0 flex-shrink-1 flex-grow-1 ai-header-main">
                <div class="ai-header-avatar flex-shrink-0" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Style="color: #ffffff !important;" />
                </div>
                @if (_preferences?.Ai.Enabled == true)
                {
                    <MudMenu dense="true"
                             Class="ai-model-menu-container"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             PopoverFixed="true"
                             PopoverClass="ai-model-dropdown-popover">
                        <ActivatorContent Context="modelMenu">
                            <button type="button"
                                    class="ai-model-pill"
                                    title="Switch AI model: @GetModelFullName(_activeModel)"
                                    aria-label="Select AI model: @_activeModel"
                                    @onclick="@(e => modelMenu.ToggleAsync(e))">
                                <span class="ai-model-pill__name">@GetActiveModelShortName()</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="ai-model-pill__chevron" />
                            </button>
                        </ActivatorContent>
                        <ChildContent>
                            <div class="px-3 py-1-5 border-bottom ai-dropdown-header">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block font-weight-bold text-truncate">
                                    Provider: @_preferences.Ai.Provider
                                </MudText>
                            </div>
                            <div class="ai-model-menu-list" role="presentation">
                            @foreach (var opt in AiModelCatalog.GetModelsForProvider(_preferences.Ai.Provider))
                            {
                                var isCurrent = string.Equals(_activeModel, opt.Id, StringComparison.OrdinalIgnoreCase);
                                <MudMenuItem OnClick="() => SwitchModelAsync(opt.Id)"
                                             Class="ai-model-menu-item">
                                    <div class="d-flex align-center justify-space-between gap-2 w-100 min-w-0 ai-dropdown-row"
                                         title="@AiModelCatalog.GetModelTooltip(opt.DisplayName, opt.Description)">
                                        <div class="min-w-0 flex-grow-1 overflow-hidden">
                                            <div class="d-flex align-center gap-1 min-w-0">
                                                @if (isCurrent)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" Class="ai-menu-check-icon flex-shrink-0" />
                                                }
                                                <span class="ai-dropdown-title text-truncate @(isCurrent ? "font-weight-bold text-primary" : "")">
                                                    @opt.DisplayName
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(opt.Description))
                                            {
                                                <span class="ai-dropdown-desc text-truncate d-block">
                                                    @opt.Description
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(opt.Badge))
                                        {
                                            <span class="ai-dropdown-badge flex-shrink-0">@opt.Badge</span>
                                        }
                                    </div>
                                </MudMenuItem>
                            }
                            </div>
                        </ChildContent>
                    </MudMenu>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-truncate ai-header-title">
                        Habitinator AI
                    </MudText>
                }
            </div>
            <div class="d-flex align-center gap-0 flex-shrink-0">
                <MudMenu Icon="@Icons.Material.Filled.Forum"
                         Size="Size.Small"
                         Color="Color.Inherit"
                         Class="ai-header-btn"
                         aria-label="View all chat threads"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         PopoverClass="ai-model-menu-popover"
                         PopoverFixed="true">
                    <div class="px-3 py-2 border-bottom d-flex align-center justify-space-between ai-threads-header" style="min-width: 240px;">
                        <MudText Typo="Typo.caption" Class="font-weight-bold">Chat Threads (@_threads.Count)</MudText>
                        <MudButton Size="Size.Medium" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Text" OnClick="NewThreadAsync">New</MudButton>
                    </div>
                    <div class="ai-threads-list" role="presentation">
                    @foreach (var t in _threads)
                    {
                        var isActive = t.Id == _activeThreadId;
                        <MudMenuItem Class="@(isActive ? "mud-theme-primary-hover font-weight-bold" : "")">
                            <div class="d-flex align-center justify-space-between w-100 gap-2">
                                <div class="d-flex align-center gap-1 min-w-0 flex-grow-1" @onclick="() => SwitchThreadAsync(t.Id)">
                                    @if (isActive)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                    }
                                    <span class="text-truncate">@t.Title</span>
                                </div>
                                @if (_threads.Count > 1)
                                {
                                    <span @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Medium"
                                                       Color="Color.Default"
                                                       Class="pa-1 ai-thread-delete"
                                                       title="Delete thread"
                                                       aria-label="Delete thread"
                                                       OnClick="() => DeleteThreadAsync(t.Id)" />
                                    </span>
                                }
                            </div>
                        </MudMenuItem>
                    }
                    </div>
                </MudMenu>
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Size="Size.Medium"
                               Color="Color.Inherit"
                               Class="ai-header-btn ai-header-btn--collapse"
                               aria-label="New chat thread"
                               OnClick="NewThreadAsync" />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                               Size="Size.Medium"
                               Color="Color.Inherit"
                               Class="ai-header-btn ai-header-btn--collapse"
                               aria-label="Clear chat history"
                               OnClick="ClearChat" />
                <MudIconButton Icon="@Icons.Material.Filled.Settings"
                               Size="Size.Medium"
                               Color="Color.Inherit"
                               Class="ai-header-btn ai-header-btn--collapse"
                               aria-label="AI settings"
                               OnClick="NavigateToSettings" />
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Size="Size.Small"
                         Color="Color.Inherit"
                         Class="ai-header-more"
                         aria-label="More assistant actions"
                         Dense="true"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         PopoverClass="ai-model-menu-popover"
                         PopoverFixed="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="NewThreadAsync">New chat thread</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.DeleteSweep" OnClick="ClearChat">Clear chat history</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="NavigateToSettings">AI settings</MudMenuItem>
                </MudMenu>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Medium"
                               Color="Color.Inherit"
                               Class="ai-header-btn ai-header-btn--close"
                               aria-label="Close assistant"
                               OnClick="() => UiSessionState.SetAiDrawer(false)" />
            </div>
        </div>
        @if (BoardSync.IsOffline)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mx-3 mt-2" role="status">Offline. AI needs internet.</MudAlert>
        }

        @if (_threads.Count > 1)
        {
            <div class="px-3 py-1 d-flex align-center gap-1 flex-wrap border-bottom">
                @foreach (var t in _threads.Take(4))
                {
                    var isActive = t.Id == _activeThreadId;
                    <MudChip T="string" Size="Size.Small" Color="@(isActive ? Color.Primary : Color.Default)" OnClick="() => SwitchThreadAsync(t.Id)">
                        @t.Title
                    </MudChip>
                }
                @if (_threads.Count > 4)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">+@(_threads.Count - 4) more</MudText>
                }
            </div>
        }

        <div id="ai-messages-scroll-area" class="ai-drawer-body flex-grow-1 px-4 py-3 overflow-y-auto">
            @if (_preferences?.Ai.Enabled != true)
            {
                <div class="ai-unconfigured-card mb-4 pa-3 rounded-lg">
                    <div class="d-flex align-center justify-space-between">
                        <div>
                            <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="font-weight-bold mb-1">
                                AI is off
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Turn it on in Settings.
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Settings"
                                   OnClick="NavigateToSettings">
                            Settings
                        </MudButton>
                    </div>
                </div>
            }

            @if (ActiveEntries.Count <= 1)
            {
                <div class="ai-empty-state mb-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="font-weight-bold mb-1">
                        Ask about your board
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Plan today, check pending, or get ideas.
                    </MudText>

                    <div class="ai-prompts-grid">
                        @foreach (var qp in _quickPrompts)
                        {
                            <button type="button"
                                    class="ai-prompt-pill"
                                    @onclick="() => SendQuickPromptAsync(qp.Prompt)">
                                <MudIcon Icon="@qp.Icon" Size="Size.Small" Class="ai-prompt-pill__icon" />
                                <span class="ai-prompt-pill__text">@qp.Label</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="ai-message-list d-flex flex-column gap-3">
                @{
                    var entryIndex = -1;
                }
                @foreach (var entry in ActiveEntries.Where(e => e.Message.Role != "system" && e.Message.Role != "tool"))
                {
                    entryIndex++;
                    var localIndex = ActiveEntries.IndexOf(entry);
                    var isUser = entry.Message.Role == "user";
                    var isLast = localIndex == ActiveEntries.Count - 1;
                    var isError = !isUser && (entry.Message.Content?.StartsWith("⚠️", StringComparison.Ordinal) == true);
                    <div class="ai-message @(isUser ? "ai-message--user" : "ai-message--assistant") d-flex flex-column">
                        <div class="ai-message-bubble pa-3 rounded-lg position-relative">
                            @if (!isUser)
                            {
                                var isCurrentlyStreaming = _isStreaming && isLast;
                                <div class="ai-rendered-markdown">
                                    @((MarkupString)MarkdownFormatter.ToHtml(entry.Message.Content))
                                    @if (isCurrentlyStreaming)
                                    {
                                        <span class="ai-streaming-cursor" aria-hidden="true">▍</span>
                                    }
                                </div>
                                @if (ExtractSuggestions(entry.Message.Content) is { Count: > 0 } suggestions)
                                {
                                    <div class="d-flex flex-wrap gap-1 mt-2 pt-1 border-top">
                                        @foreach (var s in suggestions)
                                        {
                                            <button type="button"
                                                    class="ai-prompt-pill"
                                                    style="font-size: 0.75rem; padding: 2px 8px;"
                                                    @onclick="() => QuickAddFromAiAsync(s.Section, s.Title)">
                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="ai-prompt-pill__icon" />
                                                <span class="ai-prompt-pill__text">+ Add @s.Section: @s.Title</span>
                                            </button>
                                        }
                                    </div>
                                }
                                @if (entry.Tools.Count > 0)
                                {
                                    <div class="ai-tools-card pa-3 rounded-lg border mt-2">
                                        <div class="d-flex align-center justify-space-between mb-2">
                                            <div class="d-flex align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Color="Color.Primary" />
                                                <MudText Typo="Typo.caption" Class="font-weight-bold">
                                                    Board actions (@entry.Tools.Count)
                                                </MudText>
                                            </div>
                                            <MudButton Variant="Variant.Text"
                                                       Size="Size.Medium"
                                                       Color="Color.Default"
                                                       Class="ai-details-toggle-btn"
                                                       OnClick="() => ToggleToolDetails(entry)">
                                                @(entry.ShowDetails ? "Hide details" : "Show details")
                                            </MudButton>
                                        </div>
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var tool in entry.Tools)
                                            {
                                                <div class="ai-tool-item d-flex align-center justify-space-between pa-2 rounded">
                                                    <div class="d-flex align-center gap-2 min-w-0">
                                                        <MudIcon Icon="@GetToolIcon(tool.ToolName)"
                                                                 Size="Size.Small"
                                                                 Color="@(tool.IsSuccess ? Color.Success : Color.Error)" />
                                                        <div class="min-w-0">
                                                            <div class="d-flex align-center gap-1 flex-wrap">
                                                                <code class="ai-tool-name-code">@tool.ToolName</code>
                                                                <MudText Typo="Typo.caption" Class="font-weight-bold text-truncate">
                                                                    @GetFriendlyToolTitle(tool.ToolName)
                                                                </MudText>
                                                            </div>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate">
                                                                @tool.Result
                                                            </MudText>
                                                        </div>
                                                    </div>
                                                    <span class="ai-status-pill @(tool.IsSuccess ? "ai-status-pill--success" : "ai-status-pill--error")">
                                                        @(tool.IsSuccess ? "Success" : "Failed")
                                                    </span>
                                                </div>
                                                @if (entry.ShowDetails && !string.IsNullOrWhiteSpace(tool.Arguments) && tool.Arguments != "{}")
                                                {
                                                    <pre class="ai-code-block mt-1 pa-2 rounded" style="font-size: 0.75rem;"><code>@tool.Arguments</code></pre>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="white-space-pre-wrap">@entry.Message.Content</MudText>
                            }
                        </div>
                        <div class="ai-message-actions">
                            <div class="ai-message-actions-row" role="toolbar" aria-label="Message actions">
                                @if (!isUser)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Medium"
                                                   Color="Color.Default"
                                                   aria-label="Copy response"
                                                   OnClick="() => CopyToClipboardAsync(entry.Message.Content)" />
                                    @if (isLast && !_isSending)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                                       Size="Size.Medium"
                                                       Color="Color.Default"
                                                       aria-label="Regenerate response"
                                                       OnClick="RegenerateAsync" />
                                    }
                                    @if (isError)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Replay"
                                                       Size="Size.Medium"
                                                       Color="Color.Warning"
                                                       aria-label="Retry request"
                                                       OnClick="RetryLastAsync" />
                                    }
                                }
                                else
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                                   Size="Size.Medium"
                                                   Color="Color.Default"
                                                   aria-label="Copy message"
                                                   OnClick="() => CopyToClipboardAsync(entry.Message.Content)" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Medium"
                                                   Color="Color.Default"
                                                   aria-label="Edit and resend"
                                                   Disabled="_isSending"
                                                   OnClick="() => EditUserMessageAsync(localIndex)" />
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (_isSending && !_isStreaming)
                {
                    <div class="ai-message ai-message--assistant d-flex flex-column">
                        <div class="ai-message-bubble ai-message-bubble--pending pa-3 rounded-lg" role="status">
                            <span class="ai-visually-hidden">Working on your request…</span>
                            <span class="ai-typing-dots" aria-hidden="true">
                                <span class="ai-dot"></span>
                                <span class="ai-dot"></span>
                                <span class="ai-dot"></span>
                            </span>
                        </div>
                    </div>
                }

                <div id="ai-messages-bottom"></div>
            </div>
        </div>

        <div class="ai-drawer-footer px-4 py-3">
            @if (_mentionItems.Count > 0)
            {
                <div class="d-flex flex-column gap-1 mb-2 pa-2 rounded border">
                    @foreach (var m in _mentionItems)
                    {
                        <button type="button" class="ai-prompt-pill" @onclick="() => PickMentionAsync(m.Title)">
                            <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Class="ai-prompt-pill__icon" />
                            <span class="ai-prompt-pill__text">@m.Title (@m.Section)</span>
                        </button>
                    }
                </div>
            }
            <div class="ai-input-row d-flex align-stretch gap-2">
                <MudTextField T="string"
                              Value="_inputText"
                              ValueChanged="OnInputChangedAsync"
                              Placeholder="@(BoardSync.IsOffline ? "AI needs internet" : "Ask AI...")"
                              Variant="Variant.Outlined"
                              dense="true"
                              margin="Margin.None"
                              Lines="1"
                              Sizing="InputSizing.Auto"
                              MaxLines="4"
                              Immediate="true"
                              aria-label="Message AI assistant"
                              OnKeyDown="HandleKeyDown"
                              Disabled="BoardSync.IsOffline || _isSending || _isStreaming"
                              Class="ai-text-field flex-grow-1"
                              InputMode="@InputMode.text"
                              enterkeyhint="send"
                              autocomplete="off"
                              autocapitalize="sentences" />
                <MudButton Variant="Variant.Filled"
                           Color="@(_isStreaming ? Color.Error : Color.Primary)"
                           Class="ai-send-btn"
                           aria-label="@GetSendButtonAriaLabel()"
                           Disabled="@(BoardSync.IsOffline || (!_isStreaming && (_isSending || string.IsNullOrWhiteSpace(_inputText))))"
                           OnClick="HandleSendOrStopAsync">
                    @if (_isStreaming)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Stop" Size="Size.Medium" />
                    }
                    else if (_isSending)
                    {
                        <span class="ai-spinner" aria-hidden="true"></span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Medium" />
                    }
                </MudButton>
            </div>
            <div class="ai-input-hint mt-2 d-flex align-center justify-space-between px-1">
                <span class="ai-hint-shortcuts">
                    <kbd class="ai-kbd">Enter</kbd>
                    <span class="ai-hint-sep">send</span>
                    <span class="ai-hint-dot">,</span>
                    
                </span>
                <span class="ai-safe-tools-tag">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="ai-safe-tools-icon" />
                    Safe tools
                </span>
            </div>
        </div>
    </div>
</MudDrawer>

@code {
    private sealed class ChatEntry
    {
        public AiChatMessage Message { get; set; } = new();
        public List<AiToolExecution> Tools { get; set; } = [];
        public bool ShowDetails { get; set; }
    }

    private sealed class AiThread
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public string Title { get; set; } = "New chat";
        public List<ChatEntry> Entries { get; set; } = [];
        public DateTime UpdatedAt { get; set; } = DateTime.UtcNow;
    }

    private sealed record QuickPrompt(string Label, string Prompt, string Icon);

    private sealed record MentionItem(string Title, string Section);

    private readonly List<AiThread> _threads = [];
    private string _activeThreadId = string.Empty;
    private List<ChatEntry> ActiveEntries => _threads.FirstOrDefault(t => t.Id == _activeThreadId)?.Entries ?? [];
    private readonly List<QuickPrompt> _quickPrompts =
    [
        new("Plan my day", "Plan my day based on today dailies and active todos", Icons.Material.Filled.WbSunny),
        new("What is pending?", "What dailies and todos do I have left for today?", Icons.Material.Filled.Checklist),
        new("Suggest habits", "Suggest 3 positive daily habits for better focus and health", Icons.Material.Filled.Lightbulb),
        new("Focus stats", "Show my timer summary and focus minutes", Icons.Material.Filled.Timer),
    ];

    private readonly List<MentionItem> _mentionItems = [];
    private BoardSnapshot? _boardSnapshot;
    private string _inputText = string.Empty;
    private string? _activeModel;
    private bool _isSending;
    private bool _isStreaming;
    private CancellationTokenSource? _streamCts;
    private UserPreferences? _preferences;

    /// <summary>On phones, the drawer opens as a bottom sheet. On wider screens, the drawer docks on the side.</summary>
    private bool _isPhoneSheet;

    private bool _sheetScriptsStarted;
    private DotNetObjectReference<AiAssistantDrawer>? _sheetRef;
    private ElementReference _sheetHeaderRef;

    /// <summary>Id of the greeting created into an empty state. Boot restore removes it after stored threads load. Server prerendering has no local storage, so stored threads always arrive after the greeting.</summary>
    private string? _bootGreetingId;

    /// <summary>True after the drawer reads stored threads from the interactive runtime. The drawer retries while storage stays unreachable.</summary>
    private bool _threadsRestored;

    private Anchor DrawerAnchor => _isPhoneSheet ? Anchor.Bottom : Anchor.Right;

    protected override async Task OnInitializedAsync()
    {
        UiSessionState.OnAiDrawerChanged += HandleDrawerChanged;
        await LoadPreferencesAsync();
        await LoadThreadsAsync();
        EnsureThread();
    }

    private void EnsureThread()
    {
        if (_threads.Count == 0)
        {
            var thread = new AiThread
            {
                Title = "New chat",
                Entries =
                [
                    new ChatEntry { Message = AiChatMessage.Assistant("Hi! I can help plan, break down tasks, and coach habits. What do you want to work on?", _activeModel) }
                ]
            };
            _threads.Add(thread);
            _activeThreadId = thread.Id;
            _bootGreetingId ??= thread.Id;
        }
        else if (string.IsNullOrEmpty(_activeThreadId) || _threads.All(t => t.Id != _activeThreadId))
        {
            _activeThreadId = _threads[0].Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_sheetScriptsStarted)
        {
            _sheetScriptsStarted = true;
            await StartSheetScriptsAsync();
        }

        if (!_threadsRestored)
        {
            await RestoreThreadsAfterBootAsync();
        }
    }

    /// <summary>
    /// On phones, this drawer opens as a bottom sheet. The drawer reads the
    /// viewport once before the first open, so the first open uses the right
    /// anchor. The drawer then tracks rotation. The header supports swipe down to close.
    /// </summary>
    private async Task StartSheetScriptsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/boardViewport.js");
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/modalSwipe.js");
            await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/aiChat.js");
            try
            {
                _isPhoneSheet = await JS.InvokeAsync<bool>("HabitinatorBoardViewport.isPhone");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or TaskCanceledException or InvalidOperationException)
            {
                _isPhoneSheet = false;
            }
            _sheetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("HabitinatorBoardViewport.watchPhoneSheet", _sheetRef);
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _sheetHeaderRef, _sheetRef,
                new { horizontal = false, dismissDown = true });
