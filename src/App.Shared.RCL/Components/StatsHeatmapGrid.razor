@namespace App.Shared.RCL.Components
@using App.Shared.RCL.Services
@inject IJSRuntime JS

<div class="stats-heatmap-container @ContainerClass">
    <div class="stats-heatmap-rowlabels" aria-hidden="true">
        <span>Mon</span>
        <span></span>
        <span>Wed</span>
        <span></span>
        <span>Fri</span>
        <span></span>
        <span>Sun</span>
    </div>
    <div class="stats-heatmap-wrap" tabindex="0" role="region" aria-label="@RegionLabel">
        <span class="hab-visually-hidden">Rows are Monday to Sunday, columns are weeks. Press Tab to reach days, then use arrow keys to move between days.</span>
        @if (ShowMonthLabels)
        {
            <div class="stats-heatmap-months" aria-hidden="true" style="--stats-cols: @Columns;">
                @for (var c = 0; c < Columns; c++)
                {
                    var label = _monthLabels != null && c < _monthLabels.Length ? _monthLabels[c] : GetMonthLabel(c);
                    <span class="stats-heatmap-month @(string.IsNullOrEmpty(label) ? "stats-heatmap-month--empty" : string.Empty)">@label</span>
                }
            </div>
        }
        <div class="stats-heatmap-grid" style="--stats-cols: @Columns;" data-grid="@_gridId" @onkeydown="OnGridKeyDown">
            @for (var r = 0; r < 7; r++)
            {
                @for (var c = 0; c < Columns; c++)
                {
                    var row = r;
                    var col = c;
                    if (Cells.TryGetValue((row, col), out var cell))
                    {
                        if (cell.InDataRange)
                        {
                            var cellClass = CellClassFunc is not null ? CellClassFunc(cell) : GetCellClass(row, col);
                            var cellTitle = CellTitleFunc is not null ? CellTitleFunc(cell) : GetCellTitle(row, col);
                            var cellAria = CellAriaLabelFunc is not null ? CellAriaLabelFunc(cell) : GetCellAriaLabel(row, col);
                            var isToday = IsTodayFunc is not null ? IsTodayFunc(cell.Date) : IsToday(row, col);
                            if (OnCellClick is not null)
                            {
                                <button type="button"
                                        @key="(row, col)"
                                        class="@cellClass stats-heatmap-day-btn"
                                        title="@cellTitle"
                                        aria-label="@cellAria"
                                        aria-current="@(isToday ? "date" : null)"
                                        data-row="@row"
                                        data-col="@col"
                                        tabindex="@CellTabindex(row, col)"
                                        @onclick="() => OnCellClickAsync(row, col)">
                                </button>
                            }
                            else
                            {
                                <div @key="(row, col)"
                                     class="@cellClass"
                                     role="img"
                                     title="@cellTitle"
                                     aria-label="@cellAria"
                                     aria-current="@(isToday ? "date" : null)"></div>
                            }
                        }
                        else
                        {
                            <div @key="(row, col)" class="stats-cell stats-lvl-na" title=""></div>
                        }
                    }
                    else
                    {
                        <div @key="(row, col)" class="stats-cell stats-lvl-na" title=""></div>
                    }
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Columns { get; set; }
    [Parameter] public string ContainerClass { get; set; } = string.Empty;
    [Parameter] public bool ShowMonthLabels { get; set; } = true;
    [Parameter] public IReadOnlyDictionary<(int R, int C), ActivityHeatmapCellDto> Cells { get; set; } = new Dictionary<(int, int), ActivityHeatmapCellDto>();
    [Parameter] public Func<int, int, bool> IsToday { get; set; } = (_, _) => false;
    [Parameter] public Func<int, int, string> GetCellClass { get; set; } = (_, _) => string.Empty;
    [Parameter] public Func<int, int, string?> GetCellTitle { get; set; } = (_, _) => null;
    [Parameter] public Func<int, int, string?> GetCellAriaLabel { get; set; } = (_, _) => null;
    [Parameter] public Func<ActivityHeatmapCellDto, string>? CellClassFunc { get; set; }
    [Parameter] public Func<ActivityHeatmapCellDto, string?>? CellTitleFunc { get; set; }
    [Parameter] public Func<ActivityHeatmapCellDto, string?>? CellAriaLabelFunc { get; set; }
    [Parameter] public Func<DateOnly, bool>? IsTodayFunc { get; set; }
    [Parameter] public Func<int, int, Task>? OnCellClick { get; set; }

    /// <summary>Accessible name for the scrollable heatmap region. Pass a unique label per grid.</summary>
    [Parameter] public string RegionLabel { get; set; } = "Activity heatmap";

    private string[]? _monthLabels;
    private readonly string _gridId = Guid.NewGuid().ToString("N");
    private int _focusRow = -1;
    private int _focusCol = -1;

    protected override void OnParametersSet()
    {
        if (ShowMonthLabels && Columns > 0)
        {
            _monthLabels = new string[Columns];
            for (var c = 0; c < Columns; c++)
            {
                _monthLabels[c] = GetMonthLabel(c);
            }
        }
        else
        {
            _monthLabels = null;
        }

        if (!IsInRange(_focusRow, _focusCol))
        {
            var (row, col) = FindInitialFocus();
            _focusRow = row;
            _focusCol = col;
        }
    }

    private bool IsInRange(int row, int col) =>
        Cells.TryGetValue((row, col), out var cell) && cell.InDataRange;

    private (int Row, int Col) FindInitialFocus()
    {
        (int Row, int Col)? today = null;
        (int Row, int Col) last = (-1, -1);
        foreach (var ((row, col), cell) in Cells)
        {
            if (!cell.InDataRange)
            {
                continue;
            }

            var isToday = IsTodayFunc is not null ? IsTodayFunc(cell.Date) : IsToday(row, col);
            if (isToday)
            {
                today = (row, col);
            }

            if (col > last.Col || (col == last.Col && row > last.Row))
            {
                last = (row, col);
            }
        }

        return today ?? (last.Row >= 0 ? last : (-1, -1));
    }

    private string CellTabindex(int row, int col) =>
        row == _focusRow && col == _focusCol ? "0" : "-1";

    private async Task OnGridKeyDown(KeyboardEventArgs e)
    {
        var (row, col) = e.Key switch
        {
            "ArrowLeft" => StepTo(_focusRow, _focusCol, 0, -1),
            "ArrowRight" => StepTo(_focusRow, _focusCol, 0, 1),
            "ArrowUp" => StepTo(_focusRow, _focusCol, -1, 0),
            "ArrowDown" => StepTo(_focusRow, _focusCol, 1, 0),
            _ => (-1, -1)
        };

        if (row < 0)
        {
            return;
        }

        _focusRow = row;
        _focusCol = col;
        try
        {
            await JS.InvokeVoidAsync("focusHeatmapCell", _gridId, row, col);
        }
        catch (Exception)
        {
            // Ignored. Roving state still updates, so Tab order stays correct.
        }
    }

    private (int Row, int Col) StepTo(int row, int col, int dRow, int dCol)
    {
        var r = row + dRow;
        var c = col + dCol;
        while (r >= 0 && r < 7 && c >= 0 && c < Columns)
        {
            if (IsInRange(r, c))
            {
                return (r, c);
            }

            r += dRow;
            c += dCol;
        }

        return (-1, -1);
    }

    private Task OnCellClickAsync(int r, int c) => OnCellClick is null ? Task.CompletedTask : OnCellClick(r, c);

    private string GetMonthLabel(int col)
    {
        var firstDate = FindFirstDateInColumn(col);
        if (firstDate is null || firstDate.Value.Day > 7)
        {
            return string.Empty;
        }

        var label = firstDate.Value.ToString("MMM");
        if (HasSameLabelInRecentColumns(col, label))
        {
            return string.Empty;
        }

        return label;
    }

    private DateOnly? FindFirstDateInColumn(int col)
    {
        DateOnly? earliest = null;
        for (var r = 0; r < 7; r++)
        {
            if (Cells.TryGetValue((r, col), out var cell) && cell.InDataRange && (earliest is null || cell.Date < earliest.Value))
            {
                earliest = cell.Date;
            }
        }

        return earliest;
    }

    private bool HasSameLabelInRecentColumns(int col, string label)
    {
        for (var prev = col - 1; prev >= 0 && prev >= col - 2; prev--)
        {
            var prevDate = FindFirstDateInColumn(prev);
            if (prevDate is not null && prevDate.Value.Day <= 7 && prevDate.Value.ToString("MMM") == label)
            {
                return true;
            }
        }

        return false;
    }
}
