@page "/auth/forgot-password"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Forgot password")"
          Description="Request a password reset link for your Habitinator account."
          CanonicalPath="/auth/forgot-password"
          Robots="@SeoDefaults.NoIndexRobots"/>

<AuthPageShell Title="Forgot password"
               Subtitle="Enter your email for a reset link."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="@(_hasError ? "alert" : "status")" id="forgot-status">@_message</div>
        }

        <form method="post" action="/api/auth/forgot-password-form" aria-describedby="forgot-status">
        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" name="Email" type="email" autocomplete="email" inputmode="email" enterkeyhint="go" required aria-required="true" aria-invalid="@(_hasError ? "true" : "false")" aria-describedby="forgot-status" value="@_email" />
        </div>
        <div class="auth-form-actions">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Send reset link
            </MudButton>
        </div>
        </form>
    </ChildContent>
    <Footer>
        <a href="/auth/login" data-enhance-nav="false">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string? _message;
    private bool _hasError;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.ContainsKey("sent"))
        {
            _message = "If an account exists for this email, a reset link is on its way.";
            _hasError = false;
        }
        else if (query.ContainsKey("error"))
        {
            _message = "Enter your email and try again.";
            _hasError = true;
        }
    }
}
