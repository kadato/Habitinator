@page "/auth/forgot-password"
@layout GuestLayout
@using App.Shared.RCL.Models
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Forgot password")"
          Description="Request a password reset link for your Habitinator account."
          CanonicalPath="/auth/forgot-password"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Forgot password"
               Subtitle="Enter your email. If an account exists, the server sends a reset link."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" type="email" autocomplete="email" @bind="_email" disabled="@_busy" />
        </div>
        <div class="auth-form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_busy"
                       OnClick="SubmitAsync">
                Send reset link
            </MudButton>
        </div>
    </ChildContent>
    <Footer>
        <a href="/auth/login" data-enhance-nav="false">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var client = HttpFactory.CreateClient("api");
            using var res = await client.PostAsJsonAsync(
                "api/auth/forgot-password",
                new ForgotPasswordRequest(_email),
                JsonDefaults.Api);
            _message = "If an account exists for this email, the server sent a reset link.";
            _hasError = false;
        }
        catch
        {
            _message = "Could not reach the server. Try again.";
            _hasError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
