@page "/auth/register"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<AuthPageShell MaxWidth="24rem">
    <h1>Register</h1>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-warning" role="alert">@_message</div>
    }

    <form method="post" action="/api/auth/register-form">
        <RegisterFormFields IsInteractive="false" FormEmail="@_email"/>
        <button class="btn btn-primary" type="submit">Create account</button>
    </form>
    <div class="mt-3">
        <a class="btn btn-link p-0" href="/auth/login">Back to sign in</a>
    </div>
</AuthPageShell>

@code {
    private string? _message;
    private string _email = string.Empty;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (q.TryGetValue("email", out var email) && !string.IsNullOrWhiteSpace(email))
        {
            _email = email.ToString();
        }

        if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Registration could not be completed. Check the password length, or try another email if this one is already registered.";
        }
    }

}
