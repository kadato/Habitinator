@inject IActivityStatisticsReader Stats

<MudDialog Class="activity-day-detail-dialog"
           ContentClass="activity-day-detail-dialog__content">
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2"/>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
        }
        else if (_detail is { Events.Count: 0 })
        {
            <MudText Color="Color.Secondary">No logged events for this day.</MudText>
        }
        else if (_detail is not null)
        {
            <MudTable Items="_detail.Events"
                      Dense="true"
                      Hover="true"
                      Bordered="false"
                      Striped="false"
                      Elevation="0"
                      Class="activity-day-detail-table">
                <HeaderContent>
                    <MudTh>Time (UTC)</MudTh>
                    <MudTh>Event</MudTh>
                    <MudTh>Item</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Time(UTC)">@context.OccurredAtUtc.ToString("HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Event">@context.Label@FormatTimerSuffix(context)</MudTd>
                    <MudTd DataLabel="Item">@(context.BoardItemTitle ?? context.CustomLabel ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] [EditorRequired] public DateOnly Date { get; set; }

    [Parameter] public string? TagFilter { get; set; }

    private ActivityDayDetailDto? _detail;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var tag = string.IsNullOrWhiteSpace(TagFilter) ? null : TagFilter;
            _detail = await Stats.GetActivityDayDetailAsync(Date, tag);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close()
    {
        MudDialog?.Cancel();
    }

    private static string FormatTimerSuffix(ActivityDayEventDto e)
    {
        if (e.EventType != ActivityEventType.TimerSession || e.DurationSeconds is not int s || s <= 0)
        {
            return string.Empty;
        }

        var m = (s + 30) / 60;
        return m < 1 ? " (< 1 min)" : $" ({m} min)";
    }

}