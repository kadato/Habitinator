@implements IDisposable
@inject NavigationManager Nav

@{
    var navClass = Mode == AppNavMode.AuthLinks
        ? "app-header-nav app-header-nav--auth d-flex flex-wrap align-center"
        : "app-header-nav d-flex flex-wrap align-center";
}
<div class="@navClass">
    @if (Mode is AppNavMode.Full or AppNavMode.BoardOnly)
    {
        <MudButton Href="/"
                   Variant="@(IsActivePath("", NavLinkMatch.All) ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   StartIcon="@Icons.Material.Filled.SpaceDashboard"
                   Class="app-header-nav-btn text-transform-none">
            Board
        </MudButton>
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/stats"
                           Variant="@(IsActivePath("stats", NavLinkMatch.Prefix) ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.BarChart"
                           Class="app-header-nav-btn text-transform-none">
                    Statistics
                </MudButton>
                <MudButton Href="/settings"
                           Variant="@(IsActivePath("settings", NavLinkMatch.Prefix) ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.Notifications"
                           Class="app-header-nav-btn text-transform-none">
                    Settings
                </MudButton>
            </Authorized>
        </AuthorizeView>
    }
    @if (Mode is AppNavMode.Full)
    {
        <AuthorizeView>
            <NotAuthorized>
                @AuthLinkButtons
            </NotAuthorized>
        </AuthorizeView>
    }
    @if (Mode is AppNavMode.AuthLinks)
    {
        <AuthorizeView>
            <NotAuthorized>
                @AuthLinkButtons
            </NotAuthorized>
        </AuthorizeView>
    }
</div>

@code {
    [Parameter] public AppNavMode Mode { get; set; } = AppNavMode.Full;

    private RenderFragment AuthLinkButtons => __builder =>
    {
        <MudButton Href="auth/login"
                   Variant="@(IsActivePath("auth/login", NavLinkMatch.Prefix) ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Secondary"
                   Size="Size.Medium"
                   StartIcon="@Icons.Material.Filled.Login"
                   Class="app-header-nav-btn text-transform-none">
            Login
        </MudButton>
        <MudButton Href="auth/register"
                   Variant="@(IsActivePath("auth/register", NavLinkMatch.Prefix) ? Variant.Filled : Variant.Outlined)"
                   Color="Color.Secondary"
                   Size="Size.Medium"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Class="app-header-nav-btn text-transform-none">
            Register
        </MudButton>
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool IsActivePath(string path, NavLinkMatch match)
    {
        var rel = Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').TrimEnd('/');
        var p = path.TrimStart('/').TrimEnd('/');

        if (match == NavLinkMatch.All)
        {
            if (string.IsNullOrEmpty(p))
            {
                return string.IsNullOrEmpty(rel);
            }

            return string.Equals(rel, p, StringComparison.OrdinalIgnoreCase);
        }

        if (string.IsNullOrEmpty(p))
        {
            return true;
        }

        return rel.StartsWith(p, StringComparison.OrdinalIgnoreCase);
    }

}