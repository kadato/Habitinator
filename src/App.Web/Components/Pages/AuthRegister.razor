@page "/auth/register"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageTitle>Register</PageTitle>

<h1>Register</h1>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-warning" role="alert">@_message</div>
}

<form method="post" action="/api/auth/register-form">
    <div class="mb-3">
        <label for="reg-email">Email</label>
        <input class="form-control" id="reg-email" name="Email" type="email" required autocomplete="username" value=""/>
    </div>
    <div class="mb-3">
        <label for="reg-password">Password</label>
        <input class="form-control" id="reg-password" name="Password" type="password" required minlength="8" autocomplete="new-password" value=""/>
    </div>
    <div class="mb-3">
        <label for="reg-tz">Timezone</label>
        <input class="form-control" id="reg-tz" name="Timezone" type="text" value="Europe/Budapest"/>
    </div>
    <button class="btn btn-primary" type="submit">Create account</button>
</form>

@code {
    private string? _message;

    protected override void OnInitialized()
    {
        var q = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (q.ContainsKey("error") && q["error"] == "1")
        {
            _message = "Registration failed. Check password policy (8+ characters with upper, lower, and digit) and that the email is not already used.";
        }
    }

}