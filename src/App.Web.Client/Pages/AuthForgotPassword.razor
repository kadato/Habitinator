@page "/auth/forgot-password"
@layout GuestLayout
@using App.Shared.RCL.Models
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Forgot password")"
          Description="Request a password reset link for your Habitinator account."
          CanonicalPath="/auth/forgot-password"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Forgot password"
               Subtitle="Enter your email for a reset link."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="@(_hasError ? "alert" : "status")" id="forgot-status">@_message</div>
        }

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" aria-describedby="forgot-status">
        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" name="email" type="email" autocomplete="email" inputmode="email" enterkeyhint="go" required aria-required="true" aria-invalid="@(_hasError ? "true" : "false")" aria-describedby="forgot-status" @bind="_email" disabled="@_busy" />
        </div>
        <div class="auth-form-actions">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_busy">
                Send reset link
            </MudButton>
        </div>
        </form>
    </ChildContent>
    <Footer>
        <a href="/auth/login" data-enhance-nav="false">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var client = HttpFactory.CreateClient("api");
            using var res = await client.PostAsJsonAsync(
                "api/auth/forgot-password",
                new ForgotPasswordRequest(_email),
                JsonDefaults.Api);
            _message = "If it exists, a reset link was sent.";
            _hasError = false;
        }
        catch
        {
            _message = "Offline. Try again.";
            _hasError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
