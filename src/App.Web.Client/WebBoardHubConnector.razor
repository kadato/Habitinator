@inject IJSRuntime JS
@inject BoardRemoteNotifyBridge RefreshBridge
@inject IInitialBoardLoadGate InitialBoardLoad
@using Microsoft.JSInterop
@using global::App.Shared.RCL.Services
@implements IAsyncDisposable

@code {
    private DotNetObjectReference<BoardRemoteNotifyBridge>? _dotNetRef;
    private bool _hubStarted;

    protected override void OnInitialized()
    {
        if (InitialBoardLoad.IsComplete)
        {
            _ = StartHubAsync();
        }
        else
        {
            InitialBoardLoad.Completed += OnInitialBoardLoadCompleted;
        }
    }

    private void OnInitialBoardLoadCompleted()
    {
        InitialBoardLoad.Completed -= OnInitialBoardLoadCompleted;
        _ = InvokeAsync(StartHubAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && InitialBoardLoad.IsComplete && !_hubStarted)
        {
            await StartHubAsync();
        }
    }

    private async Task StartHubAsync()
    {
        if (_hubStarted)
        {
            return;
        }

        _hubStarted = true;
        _dotNetRef = DotNetObjectReference.Create(RefreshBridge);
        try
        {
            await JS.InvokeVoidAsync("habitinatorLoadScript", "lib/microsoft-signalr/signalr.min.js");
            await JS.InvokeVoidAsync("habitinatorLoadScript", "js/boardHub.js");
            await JS.InvokeVoidAsync("HabitinatorBoardHub.start", _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation
        }
        catch (InvalidOperationException)
        {
            // Ignored during page navigation
        }
        catch (JSException)
        {
            // Ignored during page navigation
        }
    }

    public async ValueTask DisposeAsync()
    {
        InitialBoardLoad.Completed -= OnInitialBoardLoadCompleted;
        if (_hubStarted)
        {
            try
            {
                await JS.InvokeVoidAsync("HabitinatorBoardHub.stop");
            }
            catch (JSDisconnectedException)
            {
                // Ignored during page navigation
            }
            catch (JSException)
            {
                // Ignored during page navigation
            }
            catch (TaskCanceledException)
            {
                // Ignored during page navigation
            }
            catch (InvalidOperationException)
            {
                // Ignored during page navigation
            }
        }

        _dotNetRef?.Dispose();
    }

}
