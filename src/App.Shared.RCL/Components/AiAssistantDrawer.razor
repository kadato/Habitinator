    private static readonly JsonSerializerOptions ThreadJsonOptions = new() { PropertyNameCaseInsensitive = true };

    /// <summary>Reads stored threads. Returns false when storage is unreachable so the caller can retry later. Skips threads that are already loaded.</summary>
    private async Task<bool> LoadThreadsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", CancellationToken.None, new object?[] { "habitinator-ai-threads" });
            if (!string.IsNullOrWhiteSpace(json))
            {
                var stored = await Task.Run(() => JsonSerializer.Deserialize<List<StoredThread>>(json, ThreadJsonOptions));
                if (stored is not null)
                {
                    var knownIds = _threads.Select(t => t.Id).ToHashSet(StringComparer.Ordinal);
                    foreach (var s in stored.Take(20))
                    {
                        if (knownIds.Contains(s.Id ?? string.Empty))
                        {
                            continue;
                        }
                        var entries = s.Messages?.Take(100).Select(m => new ChatEntry { Message = m }).ToList() ?? [];
                        if (entries.Count == 0)
                        {
                            continue;
                        }
                        _threads.Add(new AiThread { Id = s.Id ?? Guid.NewGuid().ToString("N"), Title = s.Title ?? "Chat", Entries = entries, UpdatedAt = s.UpdatedAt });
                    }
                }
            }
            return true;
        }
        catch
        {
            // Ignore load failures. Chat stays usable without local history.
            return false;
        }
    }

    /// <summary>
    /// Server prerendering has no local storage, so the first load always starts
    /// with the greeting. Once the interactive runtime takes over, this pulls stored
    /// threads in and resumes the most recent one. Returning users see their history.
    /// </summary>
    private async Task RestoreThreadsAfterBootAsync()
    {
        var greeting = _bootGreetingId is null
            ? null
            : _threads.FirstOrDefault(t => t.Id == _bootGreetingId && t.Entries.Count == 1);
        if (!await LoadThreadsAsync())
        {
            return;
        }
        _threadsRestored = true;
        if (greeting is not null && _threads.Count > 1)
        {
            _threads.Remove(greeting);
            var newest = _threads.MaxBy(t => t.UpdatedAt);
            if (newest is not null)
            {
                _activeThreadId = newest.Id;
            }
            EnsureThread();
            StateHasChanged();
        }
    }

    private async Task PersistThreadsAsync()
    {
        try
        {
            var stored = _threads.Take(20).Select(t => new StoredThread
            {
                Id = t.Id,
                Title = t.Title,
                UpdatedAt = t.UpdatedAt,
                Messages = t.Entries.Take(100).Select(e => e.Message).ToList()
            }).ToList();
            var json = await Task.Run(() => JsonSerializer.Serialize(stored, ThreadJsonOptions));
            if (json.Length < 400000)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", CancellationToken.None, new object?[] { "habitinator-ai-threads", json });
            }
        }
        catch
        {
            // Ignore load failures. Chat stays usable without local history.
        }
    }

