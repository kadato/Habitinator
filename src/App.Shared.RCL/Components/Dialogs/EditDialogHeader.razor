<div class="edit-daily-header">
    <div class="edit-daily-header__toolbar">
        <MudText Typo="Typo.subtitle1" Class="edit-daily-header__title">@TitleText</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            @if (!string.IsNullOrEmpty(SaveStatus))
            {
                <span class="edit-daily-header__status @SaveStatusClass">@SaveStatusText</span>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Class="edit-daily-header__close"
                           aria-label="Close"
                           Size="Size.Small"
                           title="Close"
                           OnClick="OnClose"/>
        </MudStack>
    </div>

    <MudStack Spacing="0">
        <MudText Typo="Typo.caption" Class="edit-daily-label-header">Title*</MudText>
        <MudTextField Value="@_title"
                      ValueChanged="@((string value) => OnTitleValueChanged(value))"
                      Variant="Variant.Outlined"
                      Class="edit-daily-field-header"
                      Placeholder="@TitlePlaceholder"
                      Immediate="true"
                      Margin="Margin.Dense"/>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-2 mb-1">
            <MudText Typo="Typo.caption" Class="edit-daily-label-header">Notes</MudText>
        </MudStack>
        <MudTextField Value="@_notes"
                      ValueChanged="@((string value) => OnNotesValueChanged(value))"
                      Variant="Variant.Outlined"
                      Class="edit-daily-field-header"
                      Placeholder="Add notes"
                      Lines="3"
                      Immediate="true"
                      Margin="Margin.Dense"/>
    </MudStack>
</div>

@code {
    [Parameter] public string TitleText { get; set; } = string.Empty;
    [Parameter] public string TitlePlaceholder { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TitleChanged { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public EventCallback<string?> NotesChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string SaveStatus { get; set; } = string.Empty;

    private string _title = string.Empty;
    private string? _notes;

    protected override void OnParametersSet()
    {
        _title = Title;
        _notes = Notes;
    }

    private string SaveStatusText => SaveStatus switch
    {
        "saving" => "Saving…",
        "error" => "Save failed",
        "saved" => "Saved",
        _ => string.Empty
    };

    private string SaveStatusClass => SaveStatus switch
    {
        "saving" => "edit-daily-header__status--saving",
        "error" => "edit-daily-header__status--error",
        "saved" => "edit-daily-header__status--saved",
        _ => string.Empty
    };

    private void OnTitleValueChanged(string value)
    {
        _title = value;
        _ = TitleChanged.InvokeAsync(value);
    }

    private void OnNotesValueChanged(string? value)
    {
        _notes = value;
        _ = NotesChanged.InvokeAsync(value);
    }
}
