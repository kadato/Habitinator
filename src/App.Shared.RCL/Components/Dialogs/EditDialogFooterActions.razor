    <button type="button" class="mud-button-root mud-button mud-button-text mud-button-text-error mud-button-text-size-small" @onclick="OnDelete" style="text-transform:none; font-weight:700; border-radius:8px; padding:6px 10px; display:inline-flex; align-items:center; gap:6px; color:var(--mud-palette-error); border:1px solid color-mix(in srgb, var(--mud-palette-error) 18%, transparent); background: color-mix(in srgb, var(--mud-palette-error) 7%, transparent);">
