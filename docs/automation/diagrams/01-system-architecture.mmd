%% System Architecture Overview
%% Habitinator - Cross-Platform Habit Tracking Application

flowchart TB
    subgraph Clients["Client Applications"]
        direction TB
        Web["🌐 Web Application<br/>Blazor Server + MudBlazor"]
        MAUI["📱 MAUI Application<br/>.NET MAUI + Blazor Hybrid"]
    end

    subgraph Shared["Shared Components"]
        direction TB
        RCL["📦 Razor Class Library<br/>Shared UI Components"]
        Models["📋 Shared Models & DTOs"]
        Services["⚙️ Shared Services<br/>Timer, Statistics"]
    end

    subgraph Server["Server Infrastructure"]
        direction TB
        API["🔌 ASP.NET Core API<br/>Minimal APIs + SignalR"]
        Auth["🔐 Authentication<br/>Cookie + JWT"]
        Business["💼 Business Logic<br/>Board Services"]
    end

    subgraph Data["Data Layer"]
        direction TB
        PG["🐘 PostgreSQL<br/>Server Database"]
        SQLite["🗃️ SQLite<br/>MAUI Local Storage"]
        EF["🔄 Entity Framework Core"]
    end

    subgraph DevOps["Development & Operations"]
        direction TB
        Aspire["☁️ .NET Aspire<br/>Local Orchestration"]
        Tests["🧪 Testing Suite<br/>Unit + Integration + E2E"]
        Azure["🏗️ Azure Deployment<br/>App Service + PostgreSQL"]
    end

    %% Client connections
    Web --> RCL
    MAUI --> RCL
    
    %% Shared to Server
    RCL --> Models
    Services --> Models
    
    %% Server layer
    Web --> API
    MAUI --> API
    API --> Auth
    API --> Business
    
    %% Data connections
    Business --> EF
    EF --> PG
    MAUI -.->|"Sync (Outbox Pattern)"| SQLite
    SQLite -.->|"Background Sync"| API
    
    %% DevOps
    Aspire -.-> PG
    Aspire -.-> API
    Aspire -.-> MAUI
    API -.-> Tests
    API -.-> Azure

    %% Styling
    classDef clientClass fill:#e1f5fe
    classDef sharedClass fill:#fff3e0
    classDef serverClass fill:#f3e5f5
    classDef dataClass fill:#e8f5e9
    classDef devopsClass fill:#fce4ec
    
    class Web,MAUI clientClass
    class RCL,Models,Services sharedClass
    class API,Auth,Business serverClass
    class PG,SQLite,EF dataClass
    class Aspire,Tests,Azure devopsClass
