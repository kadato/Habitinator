@page "/settings"
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BoardUiSessionState UiSessionState

<PageMeta Title="@PageTitles.Page("Settings")"
          Description="Notification preferences, account, and app settings."
          CanonicalPath="/settings"/>

<h1 class="hab-visually-hidden">Settings</h1>

<AuthorizeView>
    <NotAuthorized>
        <SignInPrompt Title="Settings" Message="Sign in to manage notification preferences."/>
    </NotAuthorized>
    <Authorized>
        <div class="settings-page-wrapper">
            <SettingsSectionSwitcher ActiveIndex="_settingsIndex" ActiveIndexChanged="OnSettingsIndexChanged"/>

            <div class="settings-section-content">
                @if (_settingsIndex == 0)
                {
                    <UserPreferencesSection ShowTitle="false"/>
                }
                else if (_settingsIndex == 1)
                {
                    <NotificationSettingsSection ShowTitle="false"/>
                }
                else
                {
                    <MudPaper Class="pa-4 mb-3" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1" Class="mb-1">Session</MudText>
                            <SyncStatusIndicator IconOnly="false" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                                Sign out of Habitinator on this device.
                            </MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">
                                Log out
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    <AccountActionsSection ShowTitle="false" OnAccountDeleted="HandleAccountDeleted"/>
                }
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private int _settingsIndex;

    protected override void OnInitialized()
    {
        _settingsIndex = UiSessionState.SettingsSectionIndex;
    }

    private void OnSettingsIndexChanged(int value)
    {
        _settingsIndex = value;
        UiSessionState.SettingsSectionIndex = value;
    }

    private Task LogoutAsync() =>
        JS.InvokeVoidAsync("habitinatorSubmitForm", "globalLogoutForm").AsTask();

    private Task HandleAccountDeleted()
    {
        Nav.NavigateTo("/?accountDeleted=1", forceLoad: true);
        return Task.CompletedTask;
    }
}
