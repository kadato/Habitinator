@inject GlobalTimerService TimerService
@inject IUserNotifier UserNotifier
@inject IFocusTimerClientAlerts FocusClientAlerts
@inject IDialogService DialogService
@inject ITimerSessionLogService TimerSessionLog
@inject IAppWindowProgressService AppWindowProgress
@implements IDisposable

@* Runs on every authenticated page so "time's up" dialogs are not tied to the board timer panel. *@

@if (TimerService.IsRunning)
{
    <PageTitle>@GetTabTitle()</PageTitle>
}

@code {
    private bool _wasRunningForTitle;

    protected override void OnInitialized()
    {
        TimerService.Ticked += OnTimerTicked;
    }

    private string GetTabTitle()
    {
        var timeStr = TimerService.GetDisplayTime();
        var statusStr = TimerService.CurrentPomodoroState switch
        {
            PomodoroState.Work => "Work",
            PomodoroState.ShortBreak => "Break",
            PomodoroState.LongBreak => "Break",
            _ => TimerService.PomodoroModeEnabled ? "Ready" : "Focus"
        };
        return $"{timeStr} {statusStr} - Habitinator";
    }

    private void OnTimerTicked()
    {
        _ = InvokeAsync(async () =>
        {
            bool isRunning = TimerService.IsRunning;
            await UpdateTitleIfStateChangedAsync(isRunning);

            if (isRunning && TimerService.TryConsumeFocusDurationReached())
            {
                HandleFocusDurationReached(CancellationToken.None);
            }
        });
    }

    private async Task UpdateTitleIfStateChangedAsync(bool isRunning)
    {
        if (isRunning || isRunning != _wasRunningForTitle)
        {
            _wasRunningForTitle = isRunning;
            await InvokeAsync(StateHasChanged);
            UpdateNativeWindowProgress(isRunning);
        }
    }

    private void UpdateNativeWindowProgress(bool isRunning)
    {
        if (!isRunning)
        {
            AppWindowProgress.SetTitle("Habitinator");
            AppWindowProgress.ClearTaskbarBadge();
            return;
        }

        var title = GetTabTitle();
        AppWindowProgress.SetTitle(title);

        int remainingMinutes = 0;
        if (TimerService.FocusAlertAfter.HasValue)
        {
            var remaining = TimerService.FocusAlertAfter.Value - TimerService.Elapsed;
            remainingMinutes = (int)Math.Max(0, Math.Ceiling(remaining.TotalMinutes));
        }
        else
        {
            remainingMinutes = (int)TimerService.Elapsed.TotalMinutes;
        }

        AppWindowProgress.SetTaskbarTimeBadge(remainingMinutes);
    }

    private void HandleFocusDurationReached(CancellationToken cancellationToken)
    {
        if (TimerService.PomodoroModeEnabled)
        {
            TimerService.PauseForFocusTimeUp();
            var state = TimerService.CurrentPomodoroState;
            _ = InvokeAsync(async () =>
            {
                await OnPomodoroDurationReachedAsync(state, cancellationToken);
            });
        }
        else
        {
            var label = string.IsNullOrEmpty(TimerService.TargetId) ? "Open session" : TimerService.TargetId;
            var dur = FocusDurationInput.FormatForAlertLabel(TimerService.FocusAlertAfter ?? TimeSpan.Zero);
            var message = $"Time's up - {dur}: {label}";
            TimerService.PauseForFocusTimeUp();
            _ = InvokeAsync(async () =>
            {
                await OnFocusDurationReachedAsync(message, dur, label, cancellationToken);
            });
        }
    }

    private async Task OnPomodoroDurationReachedAsync(PomodoroState state, CancellationToken cancellationToken)
    {
        if (state == PomodoroState.Work)
        {
            await OnPomodoroWorkDurationReachedAsync(cancellationToken);
        }
        else if (state == PomodoroState.ShortBreak || state == PomodoroState.LongBreak)
        {
            await OnPomodoroBreakDurationReachedAsync(cancellationToken);
        }
    }

    private async Task OnPomodoroWorkDurationReachedAsync(CancellationToken cancellationToken)
    {
        var label = string.IsNullOrEmpty(TimerService.TargetId) ? "Focus Session" : TimerService.TargetId;
        var durLabel = FocusDurationInput.FormatForAlertLabel(TimerService.FocusAlertAfter ?? TimeSpan.Zero);
        var message = $"Focus session complete - {durLabel}: {label}";

        try
        {
            await FocusClientAlerts.NotifyTimeUpAsync("Focus Complete", message, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        bool? confirmed;
        try
        {
            confirmed = await DialogService.ShowMessageBoxAsync(
                "Focus session complete!",
                $"Focus session complete for \"{label}\".\nLog this session to the board?",
                "Yes, log session",
                "No");
        }
        catch (Exception)
        {
            await UserNotifier.NotifyAsync("Focus complete. Log progress using Stop and log on the timer.", Severity.Info, cancellationToken);
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        if (confirmed == true)
        {
            var logDuration = TimerService.FocusAlertAfter;
            var elapsed = TimerService.Stop();
            var duration = logDuration ?? elapsed;
            if (duration > TimeSpan.Zero)
            {
                var result = await TimerSessionLog.LogStoppedSessionAsync(duration, cancellationToken);
                // When board progress was made, the undo toast for that action is the notification.
                if (result.BoardUpdateFailed || !result.BoardProgressed)
                {
                    await UserNotifier.NotifyAsync(result.UserMessage, result.BoardUpdateFailed ? Severity.Error : Severity.Success, cancellationToken);
                }
            }
        }
        else
        {
            TimerService.Stop();
        }

        TimerService.IncrementCompletedIntervals();
        TimerService.TransitionToBreak();
    }

    private async Task OnPomodoroBreakDurationReachedAsync(CancellationToken cancellationToken)
    {
        var message = "Break is over! Time to start the next focus session.";
        try
        {
            await FocusClientAlerts.NotifyBreakTimeUpAsync("Break Complete", message, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        try
        {
            await DialogService.ShowMessageBoxAsync(
                "Break complete",
                message,
                "OK");
        }
        catch (Exception)
        {
            await UserNotifier.NotifyAsync(message, Severity.Info, cancellationToken);
        }

        TimerService.TransitionToWork();
    }

    private async Task OnFocusDurationReachedAsync(
        string notifyMessage,
        string durationLabel,
        string targetLabel,
        CancellationToken cancellationToken)
    {
        try
        {
            await FocusClientAlerts.NotifyTimeUpAsync("Time's up", notifyMessage, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        bool? confirmed;
        try
        {
            confirmed = await DialogService.ShowMessageBoxAsync(
                "Time's up",
                durationLabel + " complete for \"" + targetLabel + "\".\nLog this session to the board?",
                "Yes, log session",
                "Not done");
        }
        catch (Exception)
        {
            await UserNotifier.NotifyAsync(
                "Time's up. Open the board to log your session, or use Stop and log on the timer.",
                Severity.Info,
                cancellationToken);
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        if (confirmed != true)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        // Log the configured focus length, not extra elapsed while the dialog was open.
        var logDuration = TimerService.FocusAlertAfter;
        var elapsed = TimerService.Stop();
        var duration = logDuration ?? elapsed;
        if (duration > TimeSpan.Zero)
        {
            var result = await TimerSessionLog.LogStoppedSessionAsync(duration, cancellationToken);
            // When board progress was made, the undo toast for that action is the notification.
            if (result.BoardUpdateFailed || !result.BoardProgressed)
            {
                await UserNotifier.NotifyAsync(result.UserMessage, result.BoardUpdateFailed ? Severity.Error : Severity.Success, cancellationToken);
            }
        }

        TimerService.ClearTargetAndFocus();
    }

    public void Dispose()
    {
        TimerService.Ticked -= OnTimerTicked;
        AppWindowProgress.ClearTaskbarBadge();
        AppWindowProgress.SetTitle("Habitinator");
    }
}
