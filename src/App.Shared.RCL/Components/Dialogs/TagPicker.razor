@inject IBoardDataService BoardData

<div class="habit-tag-picker @(_tagPickerOpen ? "habit-tag-picker--open" : null)"
     @onclick:stopPropagation="true">
    <div class="habit-tag-picker__control"
         role="combobox"
         tabindex="0"
         @onclick="ToggleTagPicker"
         @onkeydown="OnControlKeydown"
         aria-haspopup="listbox"
         aria-label="Tags"
         aria-controls="@ListboxId"
         @attributes="TagTriggerAria"
         id="@TriggerId">
        <div class="habit-tag-picker__chips">
            @if (_selectedTags.Count == 0)
            {
                <span class="habit-tag-picker__placeholder">Add tag</span>
            }
            else
            {
                @foreach (var tag in _selectedTags)
                {
                    <span class="habit-tag-chip" @key="tag" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <span class="habit-tag-chip__text">@tag</span>
                        <button type="button"
                                class="habit-tag-chip__remove"
                                @onclick="() => RemoveTag(tag)"
                                @onclick:stopPropagation="true"
                                aria-label="@($"Remove {tag}")">
                            <svg aria-hidden="true" viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: block;">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </span>
                }
            }
        </div>
        <span class="habit-tag-picker__chevron" aria-hidden="true">▾</span>
    </div>
    <div class="@DropdownClass" id="@ListboxId"
         role="listbox"
         aria-labelledby="@(TriggerAriaLabelledBy ?? TriggerId)"
         @attributes="DropdownAria">
        <input type="text"
               class="habit-tag-picker__search"
               @bind="_tagSearch"
               @bind:event="oninput"
               @bind:after="ResetActiveOption"
               @onkeydown="OnTagSearchKeydown"
               @onkeydown:stopPropagation="true"
               @ref="_tagSearchField"
               aria-label="Search or add a tag"
               aria-autocomplete="list"
               aria-activedescendant="@(_activeOptionIndex >= 0 ? OptionId(_activeOptionIndex) : null)"
               placeholder="Tag"/>
        <div class="habit-tag-picker__list">
            @{
                var options = VisibleOptions();
            }
            @if (options.Count == 0)
            {
                <div class="habit-tag-picker__empty">
                    @if (string.IsNullOrWhiteSpace(_tagSearch))
                    {
                        <text>Search or type, Enter to add</text>
                    }
                    else
                    {
                        <text>No matches</text>
                    }
                </div>
            }
            @for (var i = 0; i < options.Count; i++)
            {
                var index = i;
                var option = options[i];
                <button type="button" @key="option.Key"
                        class="habit-tag-picker__option @(option.IsAdd ? "habit-tag-picker__option--add" : null) @(index == _activeOptionIndex ? "habit-tag-picker__option--active" : null)"
                        role="option"
                        id="@OptionId(index)"
                        aria-selected="@(index == _activeOptionIndex ? "true" : "false")"
                        @onclick="() => ChooseOption(option)">
                    @if (option.IsAdd)
                    {
                        <text>Add "@option.Label"</text>
                    }
                    else
                    {
                        @option.Label
                    }
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Tags { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TagsChanged { get; set; }
    [Parameter] public string TriggerId { get; set; } = string.Empty;
    [Parameter] public string? TriggerAriaLabelledBy { get; set; }
    [Parameter] public IReadOnlyList<BoardItem>? Habits { get; set; }
    [Parameter] public IReadOnlyList<BoardItem>? Dailies { get; set; }
    [Parameter] public IReadOnlyList<BoardItem>? Todos { get; set; }

    private List<string> _selectedTags = [];
    private List<string> _allKnownTags = [];
    private bool _tagPickerOpen;
    private string _tagSearch = string.Empty;
    private ElementReference _tagSearchField;
    private string _appliedTags = string.Empty;
    private int _activeOptionIndex = -1;
    private string ListboxId => string.IsNullOrWhiteSpace(TriggerId) ? "tag-picker-listbox" : $"{TriggerId}-listbox";

    private sealed record TagPickerOption(string Label, bool IsAdd)
    {
        public string Key => IsAdd ? $"add:{Label}" : Label;
    }

    protected override void OnParametersSet()
    {
        if (string.Equals(_appliedTags, Tags, StringComparison.Ordinal))
        {
            return;
        }

        _appliedTags = Tags;
        _selectedTags = BoardTagUtil.ParseTags(Tags).ToList();
    }

    public void Dismiss()
    {
        if (!_tagPickerOpen)
        {
            return;
        }

        _tagPickerOpen = false;
        _tagSearch = string.Empty;
        _activeOptionIndex = -1;
    }

    private async Task LoadTagSuggestionsAsync()
    {
        IReadOnlyList<BoardItem> habits = Habits ?? [];
        IReadOnlyList<BoardItem> dailies = Dailies ?? [];
        IReadOnlyList<BoardItem> todos = Todos ?? [];
        if (Habits is null && Dailies is null && Todos is null)
        {
            var snapshot = await BoardData.GetSnapshotAsync();
            habits = snapshot.Habits;
            dailies = snapshot.Dailies;
            todos = snapshot.Todos;
        }

        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var t in _selectedTags)
        {
            set.Add(t);
        }

        foreach (var item in habits)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        foreach (var item in dailies)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        foreach (var item in todos)
        {
            foreach (var t in BoardTagUtil.ParseTags(item.Tags))
            {
                set.Add(t);
            }
        }

        _allKnownTags = set.OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private IReadOnlyList<string> FilteredTagSuggestions()
    {
        var q = _tagSearch.Trim();
        return _allKnownTags
            .Where(t => _selectedTags.All(s => !s.Equals(t, StringComparison.OrdinalIgnoreCase)))
            .Where(t => q.Length == 0 || t.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private IReadOnlyList<TagPickerOption> VisibleOptions()
    {
        List<TagPickerOption> options = [.. FilteredTagSuggestions().Select(t => new TagPickerOption(t, IsAdd: false))];
        if (CanAddNewTagFromSearch() && !string.IsNullOrWhiteSpace(_tagSearch))
        {
            options.Add(new TagPickerOption(_tagSearch.Trim(), IsAdd: true));
        }

        return options;
    }

    private string OptionId(int index) => $"{ListboxId}-option-{index}";

    private bool CanAddNewTagFromSearch()
    {
        var t = _tagSearch.Trim();
        if (t.Length == 0)
        {
            return false;
        }

        if (_selectedTags.Any(x => x.Equals(t, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        if (_allKnownTags.Any(x => x.Equals(t, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        return true;
    }

    private async Task ToggleTagPicker()
    {
        _tagPickerOpen = !_tagPickerOpen;
        if (_tagPickerOpen)
        {
            _tagSearch = string.Empty;
            await LoadTagSuggestionsAsync();
            await Task.Delay(100);
            try
            {
                await _tagSearchField.FocusAsync();
            }
            catch
            {
                // Ignored when the field is not focusable, e.g. during dialog teardown
            }
        }
    }

    private void AddTag(string tag)
    {
        var t = tag.Trim();
        if (t.Length == 0)
        {
            return;
        }

        if (_selectedTags.Any(x => x.Equals(t, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        var candidate = _selectedTags.Concat([t]).ToList();
        if (string.Join(",", candidate).Length > BoardTagUtil.MaxTagsLength)
        {
            return;
        }

        _selectedTags.Add(t);
        if (_allKnownTags.All(x => !x.Equals(t, StringComparison.OrdinalIgnoreCase)))
        {
            _allKnownTags.Add(t);
            _allKnownTags.Sort(StringComparer.OrdinalIgnoreCase);
        }

        _tagSearch = string.Empty;
        _activeOptionIndex = -1;
        _ = TagsChanged.InvokeAsync(string.Join(",", _selectedTags));
    }

    private void AddTagFromSearch()
    {
        AddTag(_tagSearch);
    }

    private void OnTagSearchKeydown(KeyboardEventArgs e)
    {
        var options = VisibleOptions();
        switch (e.Key)
        {
            case "ArrowDown":
                MoveActiveOption(options.Count, 1);
                break;
            case "ArrowUp":
                MoveActiveOption(options.Count, -1);
                break;
            case "Enter":
                if (_activeOptionIndex >= 0 && _activeOptionIndex < options.Count)
                {
                    ChooseOption(options[_activeOptionIndex]);
                    _activeOptionIndex = -1;
                }
                else if (options.Count == 1)
                {
                    ChooseOption(options[0]);
                }
                else if (CanAddNewTagFromSearch() && _tagSearch.Trim().Length > 0)
                {
                    AddTagFromSearch();
                }

                break;
            case "Escape":
                _tagPickerOpen = false;
                _tagSearch = string.Empty;
                _activeOptionIndex = -1;
                break;
        }
    }

    private void MoveActiveOption(int optionCount, int direction)
    {
        if (optionCount <= 0)
        {
            _activeOptionIndex = -1;
            return;
        }

        if (_activeOptionIndex < 0)
        {
            _activeOptionIndex = direction > 0 ? 0 : optionCount - 1;
            return;
        }

        _activeOptionIndex = (_activeOptionIndex + direction + optionCount) % optionCount;
    }

    private void ResetActiveOption() => _activeOptionIndex = -1;

    private void ChooseOption(TagPickerOption option)
    {
        if (option.IsAdd)
        {
            AddTagFromSearch();
        }
        else
        {
            AddTag(option.Label);
        }
    }

    private void RemoveTag(string tag)
    {
        var i = _selectedTags.FindIndex(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase));
        if (i >= 0)
        {
            _selectedTags.RemoveAt(i);
        }

        _ = TagsChanged.InvokeAsync(string.Join(",", _selectedTags));
    }

    private async Task OnControlKeydown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            await ToggleTagPicker();
        }
        else if (e.Key is "ArrowDown" or "ArrowUp")
        {
            if (!_tagPickerOpen)
            {
                await ToggleTagPicker();
            }

            MoveActiveOption(VisibleOptions().Count, e.Key == "ArrowDown" ? 1 : -1);
        }
    }

    private string DropdownClass => _tagPickerOpen ? "habit-tag-picker__dropdown habit-tag-picker__dropdown--open" : "habit-tag-picker__dropdown";
    private Dictionary<string, object> TagTriggerAria => new() { { "aria-expanded", _tagPickerOpen ? "true" : "false" } };
    private Dictionary<string, object> DropdownAria => new() { { "aria-hidden", !_tagPickerOpen ? "true" : "false" } };
}
