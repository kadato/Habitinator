@inject INotificationSettingsService NotificationSettingsService
@inject IRemoteBoardRefreshService RemoteBoardRefresh
@inject IUserNotifier Notifier
@inject IUserTimeZoneService TimeZoneService
@implements IDisposable

<MudStack Spacing="3">
    @if (ShowTitle)
    {
        <MudText Typo="Typo.h5">Notifications</MudText>
    }

    @if (_loadError is not null)
    {
        <div class="settings-load-fallback">
            <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Large" Class="settings-load-fallback__icon" />
            <MudText Typo="Typo.subtitle2" Class="settings-load-fallback__title">Notifications unavailable</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">We couldn't load your notification settings. Try again in a moment.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="RetryLoadAsync">Retry</MudButton>
        </div>
    }
    else if (_loading)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudSkeleton Width="150px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="90%" Height="32px" Class="mb-2" />
                
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudSkeleton Width="200px" Height="20px" />
                    <MudSkeleton Width="40px" Height="24px" SkeletonType="SkeletonType.Rectangle" Class="rounded-pill" />
                </MudStack>
                <MudSkeleton Width="80%" Height="16px" Class="mb-2" />

                @for (int j = 0; j < 3; j++)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudSkeleton Width="160px" Height="20px" />
                        <MudSkeleton Width="40px" Height="24px" SkeletonType="SkeletonType.Rectangle" Class="rounded-pill" />
                    </MudStack>
                }
                <MudSkeleton Width="85%" Height="32px" Class="my-2" />
                
                <MudSkeleton Width="100%" Height="40px" />
                <MudSkeleton Width="70%" Height="16px" />
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudSkeleton Width="220px" Height="24px" Class="mb-1" />
                <MudSkeleton Width="95%" Height="48px" Class="mb-2" />
                
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudSkeleton Width="150px" Height="20px" />
                    <MudSkeleton Width="40px" Height="24px" SkeletonType="SkeletonType.Rectangle" Class="rounded-pill" />
                </MudStack>
                <MudSkeleton Width="90%" Height="32px" />
                
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudDivider Class="my-2" />

                @for (int j = 0; j < 3; j++)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudSkeleton Width="180px" Height="20px" />
                        <MudSkeleton Width="40px" Height="24px" SkeletonType="SkeletonType.Rectangle" Class="rounded-pill" />
                    </MudStack>
                    <MudSkeleton Width="85%" Height="16px" Class="mb-2" />
                }
                <MudDivider Class="my-2" />

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudSkeleton Width="120px" Height="20px" />
                    <MudSkeleton Width="40px" Height="24px" SkeletonType="SkeletonType.Rectangle" Class="rounded-pill" />
                </MudStack>
                <MudSkeleton Width="90%" Height="32px" />

                <MudStack Row="true" Spacing="2">
                    <MudSkeleton Width="50%" Height="40px" />
                    <MudSkeleton Width="50%" Height="40px" />
                </MudStack>
            </MudStack>
        </MudPaper>
    }
    else if (_model is not null)
    {
        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-1">In-app messages</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Short on-screen messages when actions complete, need attention, or fail.
            </MudText>
            <MudStack Spacing="2">
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.InAppMessagesEnabled"
                           ValueChanged="OnInAppChanged"
                           Label="Enable in-app messages"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Turn this off to hide all in-app messages at once.
                </MudText>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.ShowSuccessToasts"
                           ValueChanged="OnShowSuccessToastsChanged"
                           Disabled="!_model.InAppMessagesEnabled"
                           Label="Show success messages"/>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.ShowWarningToasts"
                           ValueChanged="OnShowWarningToastsChanged"
                           Disabled="!_model.InAppMessagesEnabled"
                           Label="Show warnings"/>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.ShowErrorToasts"
                           ValueChanged="OnShowErrorToastsChanged"
                           Disabled="!_model.InAppMessagesEnabled"
                           Label="Show errors"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Shown when an action completes, when something is uncertain, and when the app reports a problem.
                </MudText>
                <MudSelect T="NotificationToastDuration"
                           Label="How long messages stay visible"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Value="_model.ToastDuration"
                           ValueChanged="OnToastDurationChanged"
                           Disabled="!_model.InAppMessagesEnabled">
                    <MudSelectItem T="NotificationToastDuration" Value="NotificationToastDuration.Short">Short</MudSelectItem>
                    <MudSelectItem T="NotificationToastDuration" Value="NotificationToastDuration.Normal">Default</MudSelectItem>
                    <MudSelectItem T="NotificationToastDuration" Value="NotificationToastDuration.Long">Long</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    How long each in-app message remains on screen before it dismisses.
                </MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 settings-section-paper" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-1">Scheduled and device alerts</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                Scheduled reminders and system notifications using your local device clock.
            </MudText>
            <MudStack Spacing="2">
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.DailyReminderEnabled"
                           ValueChanged="OnDailyReminderEnabledChanged"
                           Label="Daily reminder"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Sends a daily notification with due dailies and pending to-dos.
                </MudText>
                <MudTimePicker Label="Daily reminder time"
                               Time="_dailyReminderTime"
                               TimeChanged="OnDailyReminderTimeChanged"
                               Disabled="!_model.DailyReminderEnabled"
                               TimeEditMode="TimeEditMode.Normal"
                               Class="mb-1"/>
                <MudDivider Class="my-2"/>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.FocusTimerAlertsEnabled"
                           ValueChanged="OnFocusTimerAlertsEnabledChanged"
                           Label="Focus timer alerts"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Shows a dialog and optional sound when the timer finishes. Leave empty for a stopwatch.
                </MudText>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.SyncFailureAlertsEnabled"
                           ValueChanged="OnSyncFailureAlertsEnabledChanged"
                           Label="Sync / offline issue alerts"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Get alerted when the app cannot reach the server or data fails to sync.
                </MudText>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.SoundEnabledForDeviceNotifications"
                           ValueChanged="OnSoundEnabledForDeviceNotificationsChanged"
                           Label="Sound for device notifications"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                    Plays a sound with push or system notifications on a phone or tablet, along with any on-screen alert.
                </MudText>
                <MudDivider Class="my-2"/>
                <MudSwitch T="bool"
                           Color="Color.Primary"
                           Value="_model.QuietHoursEnabled"
                           ValueChanged="OnQuietHoursEnabledChanged"
                           Label="Quiet hours"/>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    In this window, in-app success and warning messages are hidden so the app stays calmer. Error messages are still shown so you do not miss real problems. Times are in your local timezone (@GetTimeZoneDisplay()).
                </MudText>
                <MudStack Row="true" Spacing="2" Style="flex-wrap: wrap;">
                    <MudTimePicker Label="Quiet start"
                                   Time="_quietStart"
                                   TimeChanged="OnQuietStartChanged"
                                   Disabled="!_model.QuietHoursEnabled"
                                   TimeEditMode="TimeEditMode.Normal"/>
                    <MudTimePicker Label="Quiet end"
                                   Time="_quietEnd"
                                   TimeChanged="OnQuietEndChanged"
                                   Disabled="!_model.QuietHoursEnabled"
                                   TimeEditMode="TimeEditMode.Normal"/>
                </MudStack>
            </MudStack>
        </MudPaper>

        @* Settings are saved automatically on change *@
    }
</MudStack>
