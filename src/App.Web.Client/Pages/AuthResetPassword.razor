@page "/auth/reset-password"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Reset password")"
          Description="Choose a new password for your Habitinator account."
          CanonicalPath="/auth/reset-password"
          Robots="@SeoDefaults.NoIndexRobots"/>

<AuthPageShell Title="Reset password"
               Subtitle="Enter email and new password."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="@(_hasError ? "alert" : "status")" id="reset-status">@_message</div>
        }

        <form method="post" action="/api/auth/reset-password-form" aria-describedby="reset-status">
        <input type="hidden" name="Email" value="@_email" />
        <input type="hidden" name="Token" value="@_token" />
        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" name="EmailDisplay" type="email" autocomplete="email" inputmode="email" enterkeyhint="next" required aria-required="true" aria-invalid="@(_hasError ? "true" : "false")" value="@_email" disabled="true" />
        </div>
        <div class="mb-3">
            <label for="password">New password</label>
            <input class="form-control" id="password" name="NewPassword" type="password" autocomplete="new-password" enterkeyhint="go" required minlength="8" aria-required="true" aria-invalid="@(_hasError ? "true" : "false")" aria-describedby="password-hint reset-status" />
            <div class="auth-form-hint" id="password-hint">8+ characters.</div>
        </div>
        <div class="auth-form-actions">
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                Reset password
            </MudButton>
        </div>
        </form>
        @if (_hasError)
        {
            <p class="mt-2 mb-0">
                <a href="/auth/forgot-password" data-enhance-nav="false">Request a new reset link</a>
            </p>
        }
    </ChildContent>
    <Footer>
        <a href="/auth/login" data-enhance-nav="false">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string _token = string.Empty;
    private string? _message;
    private bool _hasError;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("email", out var email))
        {
            _email = email.ToString();
        }

        if (query.TryGetValue("token", out var token))
        {
            _token = token.ToString();
        }

        if (query.ContainsKey("error"))
        {
            _message = "Invalid or expired reset link. Request a new one.";
            _hasError = true;
        }
    }
}
