@using System.Globalization
@using Microsoft.JSInterop
@using App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Models
@inject IActivityStatisticsReader Stats
@inject IDialogService DialogService
@inject IUserDateFormatService DateFormatService
@inject IUserTimeZoneService TimeZoneService
@inject IJSRuntime JSRuntime
@inject PersistentComponentState ApplicationState
@implements IDisposable

<MudStack Spacing="2" Class="stats-panel">
    <MudText Typo="Typo.h4" Class="app-page-title stats-panel__title">Statistics</MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
    }
    else if (_loading)
    {
        <!-- Main Dashboard Layout Grid Skeleton -->
        <MudGrid Spacing="3">
            <!-- Left Main Column (Charts & Heatmaps) -->
            <MudItem xs="12" lg="9" Class="order-2 order-lg-1">
                <!-- Activity Heatmap Card Skeleton -->
                <MudPaper Class="pa-4 stats-dashboard-card" Elevation="0" Outlined="true">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                        <div>
                            <MudSkeleton Width="140px" Height="24px" Class="mb-1" />
                            <MudSkeleton Width="280px" Height="16px" />
                        </div>
                        <MudSkeleton Width="150px" Height="16px" />
                    </div>
                    <MudSkeleton Width="100%" Height="120px" SkeletonType="SkeletonType.Rectangle" />
                </MudPaper>

                <!-- Weekly Activity Card Skeleton -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudSkeleton Width="180px" Height="24px" Class="mb-1" />
                    <MudSkeleton Width="220px" Height="16px" Class="mb-4" />
                    <MudSkeleton Width="100%" Height="100px" SkeletonType="SkeletonType.Rectangle" />
                </MudPaper>

                <!-- Dailies performance Card Skeleton -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudSkeleton Width="150px" Height="24px" Class="mb-4" />
                    <MudGrid Spacing="3">
                        @for (int i = 0; i < 2; i++)
                        {
                            <MudItem xs="12" md="6">
                                <div class="pa-3 border rounded mud-border-lines-default" style="background: var(--mud-palette-background-gray);">
                                    <div class="d-flex align-center justify-space-between mb-3">
                                        <MudSkeleton Width="120px" Height="20px" />
                                        <MudSkeleton Width="100px" Height="16px" />
                                    </div>
                                    <MudSkeleton Width="100%" Height="60px" SkeletonType="SkeletonType.Rectangle" />
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <!-- Right Sidebar Column (Filters + KPIs) -->
            <MudItem xs="12" lg="3" Class="order-1 order-lg-2">
                <div class="stats-sidebar-column">
                    <div class="stats-sidebar-block stats-sidebar-controls">
                        <div class="stats-filters-mobile-header @(_filtersExpanded ? "stats-filters-mobile-header--expanded" : "")"
                             @onclick="ToggleFiltersExpanded"
                             @onkeydown="OnToggleFiltersKeyDown"
                             role="button"
                             tabindex="0"
                             aria-expanded="@(_filtersExpanded ? "true" : "false")"
                             aria-label="Toggle statistics filters">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100 stats-filters-mobile-header-inner">
                                <MudStack Spacing="0" Class="min-w-0 flex-grow-1">
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Color="Color.Primary" aria-hidden="true"/>
                                        <MudText Typo="Typo.subtitle2" Class="stats-filters-mobile-header-text">Filters</MudText>
                                    </MudStack>
                                </MudStack>
                                <MudIcon Icon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Class="stats-filters-mobile-expand-icon"
                                         Size="Size.Medium"
                                         aria-hidden="true"/>
                            </MudStack>
                        </div>
                        <div class="stats-filters-collapse-outer">
                            <MudCollapse Expanded="@_filtersExpanded" Class="stats-filters-collapse-wrapper">
                                <MudStack Spacing="2" Class="stats-sidebar-filters stats-sidebar-filters--body">
                                    <MudSkeleton Width="100%" Height="36px" />
                                    <MudSkeleton Width="100%" Height="36px" />
                                    <MudSkeleton Width="100%" Height="14px" />
                                </MudStack>
                            </MudCollapse>
                        </div>
                    </div>
                    <div class="stats-kpi-strip stats-kpi-strip--mobile">
                        <div class="stats-kpi-strip__grid">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="stats-kpi-strip__item">
                                    <MudSkeleton Width="40px" Height="10px" />
                                    <MudSkeleton Width="32px" Height="16px" Class="mt-1" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="stats-kpi-cards stats-kpi-cards--desktop">
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudPaper Class="stats-kpi-card stats-kpi-card--sidebar" Elevation="0" Outlined="false">
                                <MudSkeleton Width="100px" Height="14px" />
                                <MudSkeleton Width="72px" Height="24px" Class="mt-1" />
                                <MudSkeleton Width="120px" Height="12px" Class="mt-1" />
                            </MudPaper>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
    else if (_data is null)
    {
        <MudText>No data.</MudText>
    }
    else
    {
        @if (_data.TotalEvents == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">No activity logged yet. Use habits, dailies, to-dos, or the focus timer on the board.</MudAlert>
        }

        <!-- Main Dashboard Layout Grid -->
        <MudGrid Spacing="3">
            <!-- Left Main Column (Charts & Heatmaps) -->
            <MudItem xs="12" lg="9" Class="order-2 order-lg-1">
                <!-- Activity Heatmap Card -->
                <MudPaper Class="pa-4 stats-dashboard-card" Elevation="0" Outlined="true">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Activity heatmap</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Click a day to see all logged events for that day.</MudText>
                        </div>
                        <div class="stats-heatmap-legend-inline d-flex align-center gap-1">
                            <span class="text-secondary-caption mr-1" style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">Less</span>
                            <div class="stats-cell stats-legend-swatch stats-lvl-0"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-1"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-2"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-3"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-4"></div>
                            <span class="text-secondary-caption ml-1" style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">More</span>
                        </div>
                    </div>

                    <div class="stats-heatmap-container stats-heatmap-container--large">
                        <div class="stats-heatmap-rowlabels" aria-hidden="true">
                            <span>M</span>
                            <span></span>
                            <span>W</span>
                            <span></span>
                            <span>F</span>
                            <span></span>
                            <span>S</span>
                        </div>
                        <div class="stats-heatmap-wrap">
                            <div class="stats-heatmap-grid" style="--stats-cols: @_data.GridWeekColumns;">
                                @for (var r = 0; r < 7; r++)
                                {
                                    @for (var c = 0; c < _data.GridWeekColumns; c++)
                                    {
                                        if (_cellIndex.TryGetValue((r, c), out var cell))
                                        {
                                            if (cell.InDataRange)
                                            {
                                                <button type="button"
                                                        class="@($"stats-heatmap-day-btn stats-cell stats-lvl-{cell.Intensity}{(IsHeatmapToday(cell.Date) ? " stats-heatmap-day--today" : "")}")"
                                                        title="@HeatmapDayTitle(cell.Date, cell.Count)"
                                                        aria-current="@(IsHeatmapToday(cell.Date) ? "date" : null)"
                                                        data-row="@r"
                                                        data-col="@c"
                                                        tabindex="0"
                                                        @onclick="() => OpenDayDetailAsync(cell.Date)">
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="stats-cell stats-lvl-na" title=""></div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="stats-cell stats-lvl-na" title=""></div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </MudPaper>

                <!-- Weekly Activity Card -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">All activity by week</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                        @FormatRange(_data.WeekBarsRangeStart, _data.WeekBarsRangeEnd) · @(_data.WeekBars.Count) week(s)
                    </MudText>
                    
                    <div class="stats-week-bars" style="--stats-week-bar-max: @(_weekBarMax == 0 ? 1 : _weekBarMax);">
                        @foreach (var w in _data.WeekBars)
                        {
                            var h = _weekBarMax == 0 ? 0 : (int)Math.Round(100.0 * w.EventCount / _weekBarMax);
                            <div class="stats-week-bar-wrap" title="@($"{DateFormatService.Format(w.WeekStart)} week: {w.EventCount} events, {w.FocusMinutes} min focus")">
                                <div class="stats-week-bar" style="height: @(h)%"></div>
                            </div>
                        }
                    </div>
                </MudPaper>

                <!-- Dailies performance Card -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Dailies graphs</MudText>

                    @if (_loadingDailies)
                    {
                        <MudGrid Spacing="3" Class="stats-dailies-grid">
                            @for (int i = 0; i < 2; i++)
                            {
                                <MudItem xs="12" md="6">
                                    <div class="pa-3 border rounded mud-border-lines-default" style="background: var(--mud-palette-background-gray);">
                                        <div class="d-flex align-center justify-space-between mb-3">
                                            <MudSkeleton Width="120px" Height="20px" />
                                            <MudSkeleton Width="100px" Height="16px" />
                                        </div>
                                        <MudSkeleton Width="100%" Height="60px" SkeletonType="SkeletonType.Rectangle" />
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (_dailyError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">@_dailyError</MudAlert>
                    }
                    else if (_dailyView is not null)
                    {
                        @if (_dailyView.Graphs.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No daily activities on your board yet.</MudText>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="stats-dailies-grid">
                                @foreach (var daily in _dailyView.Graphs)
                                {
                                    var cellIx = daily.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
                                    <MudItem xs="12" md="6">
                                        <div class="stats-daily-block pa-3 border rounded mud-border-lines-default" style="background: var(--mud-palette-background-gray);">
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold stats-daily-title ma-0 mb-2">@daily.Title</MudText>

                                            <div class="stats-heatmap-container">
                                                <div class="stats-heatmap-rowlabels" aria-hidden="true">
                                                    <span>M</span>
                                                    <span></span>
                                                    <span>W</span>
                                                    <span></span>
                                                    <span>F</span>
                                                    <span></span>
                                                    <span>S</span>
                                                </div>
                                                <div class="stats-heatmap-wrap">
                                                    <div class="stats-heatmap-grid" style="--stats-cols: @daily.GridWeekColumns;">
                                                        @for (var r = 0; r < 7; r++)
                                                        {
                                                            @for (var c = 0; c < daily.GridWeekColumns; c++)
                                                            {
                                                                if (cellIx.TryGetValue((r, c), out var cell))
                                                                {
                                                                    if (cell.InDataRange)
                                                                    {
                                                                        <div class="@($"stats-cell {(cell.Count > 0 ? "stats-daily-done" : "stats-daily-missed")}{(IsHeatmapToday(cell.Date) ? " stats-heatmap-day--today" : "")}")"
                                                                             title="@DailyHeatmapDayTitle(cell.Date, cell.Count)"
                                                                             aria-current="@(IsHeatmapToday(cell.Date) ? "date" : null)">
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="stats-cell stats-lvl-na" title=""></div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="stats-cell stats-lvl-na" title=""></div>
                                                                }
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    }
                </MudPaper>
            </MudItem>

            <!-- Right Sidebar Column (Filters + KPIs) -->
            <MudItem xs="12" lg="3" Class="order-1 order-lg-2">
                <div class="stats-sidebar-column">
                    <div class="stats-sidebar-block stats-sidebar-controls">
                        <div class="stats-filters-mobile-header @(_filtersExpanded ? "stats-filters-mobile-header--expanded" : "")"
                             @onclick="ToggleFiltersExpanded"
                             @onkeydown="OnToggleFiltersKeyDown"
                             role="button"
                             tabindex="0"
                             aria-expanded="@(_filtersExpanded ? "true" : "false")"
                             aria-label="Toggle statistics filters">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100 stats-filters-mobile-header-inner">
                                <MudStack Spacing="0" Class="min-w-0 flex-grow-1">
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Color="Color.Primary" aria-hidden="true"/>
                                        <MudText Typo="Typo.subtitle2" Class="stats-filters-mobile-header-text">Filters</MudText>
                                    </MudStack>
                                    @if (!_filtersExpanded)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="stats-filters-mobile-header-summary text-truncate">
                                            @GetFiltersHeaderSummary()
                                        </MudText>
                                    }
                                </MudStack>
                                <MudIcon Icon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                         Class="stats-filters-mobile-expand-icon"
                                         Size="Size.Medium"
                                         aria-hidden="true"/>
                            </MudStack>
                        </div>
                        <div class="stats-filters-collapse-outer">
                            <MudCollapse Expanded="@_filtersExpanded" Class="stats-filters-collapse-wrapper">
                                <MudStack Spacing="2" Class="stats-sidebar-filters stats-sidebar-filters--body">
                                    @if ((_data.AvailableTags?.Count ?? 0) > 0)
                                    {
                                        <MudSelect T="string"
                                                   Label="Tags"
                                                   Variant="Variant.Outlined"
                                                   Dense="true"
                                                   Margin="Margin.Dense"
                                                   MultiSelection="true"
                                                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))"
                                                   SelectedValues="_selectedTags"
                                                   SelectedValuesChanged="OnSelectedTagsChanged"
                                                   Clearable="true"
                                                   Class="stats-tag-select-sidebar">
                                            @foreach (var t in _data.AvailableTags ?? [])
                                            {
                                                <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }

                                    <MudSelect T="string"
                                               Label="Period"
                                               Variant="Variant.Outlined"
                                               Dense="true"
                                               Margin="Margin.Dense"
                                               Value="_selectedPeriodKey"
                                               ValueChanged="OnStatsPeriodChanged"
                                               Class="stats-year-select-sidebar">
                                        @if (_periodOptions is not null)
                                        {
                                            @foreach (var opt in _periodOptions)
                                            {
                                                <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>

                                    @if (_periodBusy)
                                    {
                                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-0"/>
                                    }

                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="stats-sidebar-range">
                                        @FormatRange(_data.RangeStart, _data.RangeEnd)
                                    </MudText>
                                </MudStack>
                            </MudCollapse>
                        </div>
                    </div>

                    <div class="stats-kpi-strip stats-kpi-strip--mobile">
                        <div class="stats-kpi-strip__grid">
                            <div class="stats-kpi-strip__item stats-kpi-strip__item--events">
                                <span class="stats-kpi-strip__label">Events</span>
                                <span class="stats-kpi-strip__value">@_data.TotalEvents</span>
                            </div>
                            <div class="stats-kpi-strip__item stats-kpi-strip__item--focus">
                                <span class="stats-kpi-strip__label">Focus</span>
                                <span class="stats-kpi-strip__value">@FormatFocus(_data.TotalFocusMinutes)</span>
                            </div>
                            <div class="stats-kpi-strip__item stats-kpi-strip__item--peak">
                                <span class="stats-kpi-strip__label">Busiest</span>
                                @if (_data.BusiestDay is null || _data.MaxDayCount == 0)
                                {
                                    <span class="stats-kpi-strip__value">—</span>
                                }
                                else
                                {
                                    <span class="stats-kpi-strip__value stats-kpi-strip__value--date" title="@FormatBusiestDayDetail(_data.BusiestDay.Value, _data.MaxDayCount)">@FormatBusiestDayShort(_data.BusiestDay.Value)</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="stats-kpi-cards stats-kpi-cards--desktop">
                        <MudPaper Class="stats-kpi-card stats-kpi-card--sidebar stats-kpi-card--plain stats-kpi-card--events" Elevation="0" Outlined="false">
                            <div class="stats-kpi-card__head">
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__label">Total events</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.ViewTimeline" Class="stats-kpi-card__icon" Size="Size.Small" aria-hidden="true"/>
                            </div>
                            <MudText Typo="Typo.h6" Class="stats-kpi-card__value">@_data.TotalEvents</MudText>
                            <MudText Typo="Typo.caption" Class="stats-kpi-card__detail">Logged in this period</MudText>
                        </MudPaper>
                        <MudPaper Class="stats-kpi-card stats-kpi-card--sidebar stats-kpi-card--plain stats-kpi-card--focus" Elevation="0" Outlined="false">
                            <div class="stats-kpi-card__head">
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__label">Focus time</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Timer" Class="stats-kpi-card__icon" Size="Size.Small" aria-hidden="true"/>
                            </div>
                            <MudText Typo="Typo.h6" Class="stats-kpi-card__value">@FormatFocus(_data.TotalFocusMinutes)</MudText>
                            <MudText Typo="Typo.caption" Class="stats-kpi-card__detail">From focus timer sessions</MudText>
                        </MudPaper>
                        <MudPaper Class="stats-kpi-card stats-kpi-card--sidebar stats-kpi-card--plain stats-kpi-card--peak" Elevation="0" Outlined="false">
                            <div class="stats-kpi-card__head">
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__label">Busiest day</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="stats-kpi-card__icon" Size="Size.Small" aria-hidden="true"/>
                            </div>
                            @if (_data.BusiestDay is null || _data.MaxDayCount == 0)
                            {
                                <MudText Typo="Typo.h6" Class="stats-kpi-card__value">—</MudText>
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__detail">No activity in range</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Class="stats-kpi-card__value">@DateFormatService.Format(_data.BusiestDay.Value)</MudText>
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__detail">
                                    @FormatBusiestDayDetail(_data.BusiestDay.Value, _data.MaxDayCount)
                                </MudText>
                            }
                        </MudPaper>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private PersistingComponentStateSubscription _subscription;
    private ActivityDashboardDto? _data;
    private IReadOnlyList<DailyGraphPeriodOption>? _periodOptions;
    private Dictionary<(int R, int C), ActivityHeatmapCellDto> _cellIndex = [];
    private int _weekBarMax;
    private bool _loading = true;
    private bool _periodBusy;
    private string? _error;

    private DailyContributionsViewDto? _dailyView;
    private string _selectedPeriodKey = DailyGraphPeriods.Rolling370Days;
    private string _tagFilter = "";
    private IReadOnlyCollection<string> _selectedTags = Array.Empty<string>();
    private bool _loadingDailies;
    private string? _dailyError;
    private bool _shouldScrollToEnd;
    private bool _filtersExpanded;
    private DateOnly _heatmapToday;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToEnd)
        {
            _shouldScrollToEnd = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
                await JSRuntime.InvokeVoidAsync("initializeHeatmapRovingTabindex");
            }
            catch (Exception)
            {
                // Ignore JS errors if components disappear or JS isn't ready
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistStatisticsData);
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        try
        {
            await DateFormatService.InitializeAsync();
            await LoadStatisticsAsync(_selectedPeriodKey);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingDailies = false;
            _loading = false;
        }
    }

    private Task PersistStatisticsData()
    {
        if (_data is not null)
        {
            ApplicationState.PersistAsJson("stats_dashboard_data", _data);
        }
        if (_dailyView is not null)
        {
            ApplicationState.PersistAsJson("stats_daily_view_data", _dailyView);
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }

    private async Task LoadStatisticsAsync(string periodKey)
    {
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        _loadingDailies = true;
        _dailyError = null;
        try
        {
            var tag = string.IsNullOrEmpty(_tagFilter) ? null : _tagFilter;
            if (ApplicationState.TryTakeFromJson<ActivityDashboardDto>("stats_dashboard_data", out var restoredDashboard) && restoredDashboard is not null)
            {
                _data = restoredDashboard;
            }
            else
            {
                _data = await Stats.GetDashboardAsync(periodKey, tag);
            }

            if (ApplicationState.TryTakeFromJson<DailyContributionsViewDto>("stats_daily_view_data", out var restoredDailyView) && restoredDailyView is not null)
            {
                _dailyView = restoredDailyView;
            }
            else
            {
                _dailyView = await Stats.GetDailyContributionsAsync(periodKey, tag);
            }

            _selectedPeriodKey = _data.PeriodKey;
            var tagList = _data.AvailableTags ?? [];

            if (!string.IsNullOrEmpty(_tagFilter))
            {
                var splitFilter = _tagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var validTags = splitFilter.Where(t => tagList.Contains(t, StringComparer.OrdinalIgnoreCase)).ToList();
                _selectedTags = validTags;
                _tagFilter = string.Join(",", _selectedTags);
            }
            else
            {
                _selectedTags = Array.Empty<string>();
                _tagFilter = "";
            }

            _periodOptions = _dailyView.PeriodOptions;
            _cellIndex = _data.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
            _weekBarMax = _data.WeekBars.Count == 0
                ? 0
                : _data.WeekBars.Max(x => x.EventCount);
            _shouldScrollToEnd = true;
        }
        catch (Exception dex)
        {
            _error = dex.Message;
            _dailyError = dex.Message;
            _data = null;
            _dailyView = null;
            _periodOptions = null;
            _cellIndex = [];
        }
        finally
        {
            _loadingDailies = false;
        }
    }

    private async Task OnStatsPeriodChanged(string? periodKey)
    {
        if (_loading)
        {
            return;
        }

        var newPeriod = string.IsNullOrEmpty(periodKey) ? DailyGraphPeriods.Rolling370Days : periodKey;
        if (newPeriod == _selectedPeriodKey)
        {
            return;
        }

        _selectedPeriodKey = newPeriod;
        _periodBusy = true;
        _error = null;
        _dailyError = null;
        try
        {
            await LoadStatisticsAsync(_selectedPeriodKey);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _periodBusy = false;
        }
    }

    private void ToggleFiltersExpanded()
    {
        _filtersExpanded = !_filtersExpanded;
    }

    private void OnToggleFiltersKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            ToggleFiltersExpanded();
        }
    }

    private string GetFiltersHeaderSummary()
    {
        if (_data is null)
        {
            return "Filters";
        }

        var period = GetSelectedPeriodLabel();
        var tags = _selectedTags.Count switch
        {
            0 => "All tags",
            1 => _selectedTags.First(),
            _ => $"{_selectedTags.Count} tags"
        };
        return $"{period} · {tags}";
    }

    private string GetSelectedPeriodLabel()
    {
        if (_periodOptions is null)
        {
            return "Period";
        }

        return _periodOptions.FirstOrDefault(o => o.Key == _selectedPeriodKey)?.Label ?? "Period";
    }

    private string FormatBusiestDayShort(DateOnly day)
    {
        return DateFormatService.Format(day);
    }

    private static string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues is null || selectedValues.Count == 0)
        {
            return "All tags";
        }
        return string.Join(", ", selectedValues);
    }

    private async Task OnSelectedTagsChanged(IReadOnlyCollection<string> values)
    {
        if (_loading)
        {
            return;
        }

        var newTags = values ?? Array.Empty<string>();
        if (newTags.Count == _selectedTags.Count && newTags.All(_selectedTags.Contains))
        {
            return;
        }

        _selectedTags = newTags;
        _tagFilter = string.Join(",", _selectedTags);
        _periodBusy = true;
        _error = null;
        _dailyError = null;
        try
        {
            await LoadStatisticsAsync(_selectedPeriodKey);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _periodBusy = false;
        }
    }

    private async Task OpenDayDetailAsync(DateOnly date)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var filterTag = string.IsNullOrEmpty(_tagFilter) ? null : _tagFilter;
        var parameters = new DialogParameters<ActivityDayDetailDialog>
        {
            { x => x.Date, date },
            { x => x.TagFilter, filterTag }
        };
        await DialogService.ShowAsync<ActivityDayDetailDialog>(
            FormatDateWithWeekday(date),
            parameters,
            options);
    }

    private static string FormatBusiestDayDetail(DateOnly day, int eventCount)
    {
        var weekday = day.ToString("dddd", CultureInfo.InvariantCulture);
        var eventsLabel = eventCount == 1 ? "1 event" : $"{eventCount} events";
        return $"{weekday} · {eventsLabel}";
    }

    private static string FormatFocus(int totalMinutes)
    {
        if (totalMinutes <= 0)
        {
            return "—";
        }

        if (totalMinutes < 60)
        {
            return $"{totalMinutes} min";
        }

        return $"{totalMinutes / 60}h {totalMinutes % 60}m";
    }

    private string FormatRange(DateOnly from, DateOnly to)
    {
        return $"{DateFormatService.Format(from)} → {DateFormatService.Format(to)}";
    }

    private string FormatDateWithWeekday(DateOnly date)
    {
        var formatted = DateFormatService.Format(date);
        var weekday = date.ToString("dddd", CultureInfo.InvariantCulture);
        return $"{formatted} ({weekday})";
    }

    private bool IsHeatmapToday(DateOnly date) => date == _heatmapToday;


    private string HeatmapDayTitle(DateOnly date, int count)
    {
        var baseTitle = $"{DateFormatService.Format(date)}: {count} event(s) — view details";
        return IsHeatmapToday(date) ? $"Today · {baseTitle}" : baseTitle;
    }

    private string DailyHeatmapDayTitle(DateOnly date, int count)
    {
        var status = count > 0 ? $"{count} complete(s)" : "not completed";
        var baseTitle = $"{DateFormatService.Format(date)}: {status}";
        return IsHeatmapToday(date) ? $"Today · {baseTitle}" : baseTitle;
    }

}