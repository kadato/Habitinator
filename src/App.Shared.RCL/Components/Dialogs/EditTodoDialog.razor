@inherits AutosaveEditDialogBase<EditTodoDialogResult>
@inject IUserDateFormatService DateFormatService

<MudDialog Class="edit-daily-dialog hab-modal-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(26rem, calc(100vw - 1rem));">
    <DialogContent>
        <div class="hab-modal hab-modal--todo edit-daily-shell edit-daily-shell--todo" data-dialog-label="Edit todo" aria-label="Edit todo" role="group" @onclick="OnShellClick">
            <EditDialogHeader TitleText="Edit todo"
                              TitlePlaceholder="To-do title"
                              @bind-Title="_title"
                              @bind-Title:after="() => ScheduleSave()"
                              OnClose="CloseAsync"
                              SaveStatus="SaveStatus"
                              Section="BoardSection.Todo"/>

            <div class="hab-modal__body edit-daily-body">
                <EditDialogNotes @bind-Notes="_notes"
                                 @bind-Notes:after="() => ScheduleSave()"/>

                <div class="hab-modal__section" style="padding:0.7rem 0.75rem;">
                    <span class="hab-modal__section-label">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        Due date
                    </span>
                    <MudDatePicker @bind-Date="_dueDate" @bind-Date:after="() => { _ = SaveNowAsync(); }" Variant="Variant.Outlined" Editable="true" Class="hab-modal__field" DateFormat="@DateFormatService.DateFormat" Placeholder="No due date" Clearable="true" Margin="Margin.Dense" aria-label="Due date"/>
                </div>

                <div class="hab-advanced @(_checklistOpen ? "hab-advanced--open" : string.Empty)">
                    <button type="button" class="hab-advanced__trigger" @onclick="() => _checklistOpen = !_checklistOpen" aria-expanded="@(_checklistOpen ? "true" : "false")">
                        <span>Checklist@(_checklistRows.Count > 0 ? $" ({_checklistRows.Count(x => x.IsDone)}/{_checklistRows.Count})" : string.Empty)</span>
                        <span class="hab-advanced__chevron" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </span>
                    </button>
                    @if (_checklistOpen)
                    {
                        <div class="hab-advanced__body">
                            <div class="hab-checklist">
                                <div class="hab-checklist__list">
                                    <ChecklistEditor @bind-Value="_checklistRows" @bind-Value:after="() => ScheduleSave(300)"/>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="hab-advanced @(_tagsOpen ? "hab-advanced--open" : string.Empty)">
                    <button type="button" class="hab-advanced__trigger" @onclick="() => _tagsOpen = !_tagsOpen" aria-expanded="@(_tagsOpen ? "true" : "false")">
                        <span>Tags@(string.IsNullOrWhiteSpace(_tags) ? string.Empty : $" ({EditDialogHelpers.FormatTags(_tags).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length})")</span>
                        <span class="hab-advanced__chevron" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </span>
                    </button>
                    @if (_tagsOpen)
                    {
                        <div class="hab-advanced__body">
                            <TagPicker @bind-Tags="_tags" @bind-Tags:after="() => SaveNowAsync()" TriggerId="edit-todo-tags-trigger" @ref="_tagPicker"/>
                        </div>
                    }
                </div>

                <EditDialogFooterActions OnArchive="() => CloseWithAction(EditDialogAction.Archive)" OnDelete="() => CloseWithAction(EditDialogAction.Delete)"/>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private List<ChecklistRow> _checklistRows = [];
    private DateTime? _dueDate;
    private bool _checklistOpen;
    private bool _tagsOpen;

    protected override string BatchDescription => $"Edit \"{Item.Title}\"";

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _dueDate = Item.TodoDueDate?.ToDateTime(TimeOnly.MinValue);
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
    }

    private void OnShellClick() => _tagPicker?.Dismiss();

    protected override async Task SaveValuesAsync(CancellationToken cancellationToken = default)
    {
        var title = string.IsNullOrWhiteSpace(_title) ? Item.Title : _title.Trim();
        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        DateOnly? due = _dueDate is { } d ? DateOnly.FromDateTime(d.Date) : null;
        await BoardData.UpdateTodoAsync(Item.Id, new UpdateTodoArgs(title, EditDialogHelpers.CleanStringPayload(_notes), tagsPayload, checklistPayload, due), cancellationToken);
    }

    protected override EditTodoDialogResult BuildResult(EditDialogAction action)
    {
        DateOnly? due = _dueDate is { } d ? DateOnly.FromDateTime(d.Date) : null;
        return new EditTodoDialogResult(action, _title.Trim(), EditDialogHelpers.CleanStringPayload(_notes), EditDialogHelpers.CleanStringPayload(_tags), EditDialogHelpers.SerializeChecklistRows(_checklistRows), due);
    }
}
