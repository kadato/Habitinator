@inject IUserNotifier Notifier
@inject IUserDateFormatService DateFormatService
@inject IDialogService DialogService

<MudDialog Class="edit-daily-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(24rem, calc(100vw - 2rem));">
<DialogContent>
    <div class="edit-daily-shell" @onclick="OnShellClick">
        <EditDialogHeader TitleText="Edit Daily"
                          TitlePlaceholder="Daily title"
                          @bind-Title="_title"
                          @bind-Notes="_notes"
                          OnCancel="Cancel"
                          OnSave="SaveAsync"/>

        <div class="edit-daily-body">
            <button type="button" class="edit-daily-heatmap-btn" @onclick="OpenHeatmapDialogAsync">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="edit-daily-heatmap-btn__icon" />
                <span>View Heatmap</span>
            </button>

            <ChecklistEditor @bind-Value="_checklistRows"/>

            <MudText Typo="Typo.caption" Class="edit-daily-label-body d-block mb-1 mt-2">Start date</MudText>
            <MudDatePicker @bind-Date="_startDate"
                           Variant="Variant.Outlined"
                           Editable="true"
                           Class="edit-daily-field-body edit-daily-date"
                           DateFormat="@DateFormatService.DateFormat"
                           Margin="Margin.Dense"/>

            <MudText Typo="Typo.caption" Class="edit-daily-label-body d-block mb-1 mt-2">Repeats</MudText>
            <MudSelect T="DailyRepeatType"
                       @bind-Value="_repeat"
                       Variant="Variant.Outlined"
                       Class="edit-daily-field-body edit-daily-repeat-select"
                       Margin="Margin.Dense"
                       Dense="true"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft">
                <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Daily">Daily</MudSelectItem>
                <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Weekly">Weekly</MudSelectItem>
                <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Monthly">Monthly</MudSelectItem>
                <MudSelectItem T="DailyRepeatType" Value="DailyRepeatType.Yearly">Yearly</MudSelectItem>
            </MudSelect>

            <MudText Typo="Typo.caption" Class="edit-daily-label-body d-block mb-1 mt-2">Repeat every</MudText>
            <div class="edit-daily-repeat-every">
                <MudNumericField @bind-Value="_repeatInterval"
                                 Variant="Variant.Outlined"
                                 Class="edit-daily-repeat-every__n"
                                 Min="1"
                                 Max="999"
                                 HideSpinButtons="true"
                                 Margin="Margin.Dense"/>
                <MudText Typo="Typo.body2" Class="edit-daily-repeat-every__unit">@RepeatUnitLabel()</MudText>
            </div>

            <fieldset class="mb-3" style="border: none; padding: 0; margin: 0;">
                <legend class="edit-daily-label-body d-block mb-1 mt-2" style="font-size: 0.75rem;">Tags</legend>
                <TagPicker @bind-Tags="_tags" TriggerId="edit-daily-tags-trigger" @ref="_tagPicker"/>
            </fieldset>

            <MudExpansionPanels Class="edit-daily-advanced mt-2" Elevation="0">
                <MudExpansionPanel @bind-Expanded="_advancedOpen">
                    <TitleContent>
                        <MudText Typo="Typo.body2" Class="edit-daily-label-body">Advanced settings</MudText>
                    </TitleContent>
                    <ChildContent>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                            Backfill past days to match this streak. Today is left unchanged.
                        </MudText>
                        <div class="edit-daily-streak-input">
                            <span class="edit-daily-streak-input__icon" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Size="Size.Small"/>
                            </span>
                            <MudNumericField @bind-Value="_counter"
                                             Variant="Variant.Outlined"
                                             Class="edit-daily-streak-input__field"
                                             Min="0"
                                             Max="9999"
                                             HideSpinButtons="true"
                                             Margin="Margin.Dense"/>
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <EditDialogFooterActions OnArchive="ArchiveAsync" OnDelete="DeleteAsync"/>
        </div>
    </div>
</DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }

    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private DateTime? _startDate;
    private DailyRepeatType _repeat = DailyRepeatType.Daily;
    private int _repeatInterval = 1;
    private List<ChecklistRow> _checklistRows = [];
    private int _counter;
    private bool _advancedOpen;

    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _counter = Item.Counter;
        _startDate = Item.DailyStartDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
        _repeat = Item.DailyRepeat;
        _repeatInterval = Item.DailyRepeatInterval < 1 ? 1 : Item.DailyRepeatInterval;
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
    }

    private void OnShellClick()
    {
        _tagPicker?.Dismiss();
    }

    private string RepeatUnitLabel()
    {
        return _repeat switch
        {
            DailyRepeatType.Daily => _repeatInterval == 1 ? "day" : "days",
            DailyRepeatType.Weekly => _repeatInterval == 1 ? "week" : "weeks",
            DailyRepeatType.Monthly => _repeatInterval == 1 ? "month" : "months",
            DailyRepeatType.Yearly => _repeatInterval == 1 ? "year" : "years",
            _ => "days"
        };
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            await Notifier.NotifyAsync("Title is required.", Severity.Warning);
            return;
        }

        if (_startDate is null)
        {
            await Notifier.NotifyAsync("Start date is required.", Severity.Warning);
            return;
        }

        if (_repeatInterval < 1)
        {
            await Notifier.NotifyAsync("Repeat every must be at least 1.", Severity.Warning);
            return;
        }

        if (_counter is < 0 or > 9999)
        {
            await Notifier.NotifyAsync("Streak must be between 0 and 9999.", Severity.Warning);
            return;
        }

        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        var start = DateOnly.FromDateTime(_startDate.Value);
        var result = new EditDailyDialogResult(
            EditDialogAction.Save,
            _title.Trim(),
            EditDialogHelpers.CleanStringPayload(_notes),
            tagsPayload,
            start,
            _repeat,
            _repeatInterval,
            checklistPayload,
            _counter
        );
        MudDialog.Close(DialogResult.Ok(result));
    }

    private void ArchiveAsync()
    {
        var result = new EditDailyDialogResult(
            EditDialogAction.Archive,
            "", null, null, default, default, 0, "", 0
        );
        MudDialog.Close(DialogResult.Ok(result));
    }

    private void DeleteAsync()
    {
        var result = new EditDailyDialogResult(
            EditDialogAction.Delete,
            "", null, null, default, default, 0, "", 0
        );
        MudDialog.Close(DialogResult.Ok(result));
    }

    private async Task OpenHeatmapDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var parameters = new DialogParameters<DailyHeatmapDialog>
        {
            { x => x.BoardItemId, Item.Id },
            { x => x.Title, string.IsNullOrWhiteSpace(_title) ? Item.Title : _title }
        };
        await DialogService.ShowAsync<DailyHeatmapDialog>(string.Empty, parameters, options);
    }
}
