@page "/privacy"
@layout GuestLayout

<PageMeta Title="@PageTitles.Page("Privacy")"
          Description="How Habitinator handles cookies, local data, and your account."
          CanonicalPath="/privacy"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Privacy"
               Subtitle="Essential cookies only. No trackers."
               MaxWidth="40rem">
    <ChildContent>
        <h2>What we store</h2>
        <p>Only what sign-in needs.</p>
        <ul>
            <li>Sign-in cookie keeps you signed in.</li>
            <li>Theme cookie remembers light or dark.</li>
            <li>Device stores name, timezone, timer.</li>
        </ul>
        <h2>What we avoid</h2>
        <ul>
            <li>No ad trackers.</li>
            <li>No data sold.</li>
            <li>Board stays private.</li>
        </ul>
        <h2>Your controls</h2>
        <p>Control your data in Settings.</p>
        <ul>
            <li>Export in Settings, Account.</li>
            <li>Delete in Settings, Account.</li>
            <li>Clear site data to remove theme and prefs.</li>
        </ul>
        <p>
            Report issues in
            <a href="/.well-known/security.txt" target="_self">security.txt</a>.
        </p>
    </ChildContent>
    <Footer>
        <a href="/" data-enhance-nav="false">Home</a>
        <a href="/auth/login" data-enhance-nav="false">Sign in</a>
    </Footer>
</AuthPageShell>
