@inject IJSRuntime JS
@inject BoardRemoteNotifyBridge RefreshBridge
@inject IInitialBoardLoadGate InitialBoardLoad
@inject BoardSyncStatus SyncStatus
@inject BoardSyncPausePreference PausePreference
@using Microsoft.JSInterop
@using global::App.Shared.RCL.Services
@using global::App.Shared.RCL.Services.Board.Local
@implements IAsyncDisposable

@code {
    private DotNetObjectReference<BoardRemoteNotifyBridge>? _dotNetRef;
    private bool _hubStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            PausePreference.PausedChanged += OnPauseChanged;
            if (InitialBoardLoad.IsComplete)
            {
                await StartHubAsync();
            }
            else
            {
                InitialBoardLoad.Completed += OnInitialBoardLoadCompleted;
            }
        }
    }

    private void OnInitialBoardLoadCompleted(object? sender, EventArgs e)
    {
        InitialBoardLoad.Completed -= OnInitialBoardLoadCompleted;
        _ = InvokeAsync(StartHubAsync);
    }

    private void OnPauseChanged(object? sender, bool paused)
    {
        _ = InvokeAsync(async () =>
        {
            if (paused)
            {
                await StopHubAsync();
            }
            else
            {
                await StartHubAsync();
            }
        });
    }

    private async Task StartHubAsync()
    {
        if (_hubStarted || SyncStatus.IsPaused)
        {
            return;
        }

        _hubStarted = true;
        _dotNetRef ??= DotNetObjectReference.Create(RefreshBridge);
        try
        {
            await JS.InvokeVoidAsync("habitinatorLoadScript", "lib/microsoft-signalr/signalr.min.js");
            await JS.InvokeVoidAsync("habitinatorLoadScript", "js/boardHub.js");
            await JS.InvokeVoidAsync("HabitinatorBoardHub.start", _dotNetRef);
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation
        }
        catch (InvalidOperationException)
        {
            // Ignored during page navigation
        }
        catch (JSException)
        {
            // Ignored during page navigation
        }
    }

    private async Task StopHubAsync()
    {
        if (!_hubStarted)
        {
            return;
        }

        _hubStarted = false;
        try
        {
            await JS.InvokeVoidAsync("HabitinatorBoardHub.stop");
        }
        catch (JSDisconnectedException)
        {
            // Ignored during page navigation
        }
        catch (JSException)
        {
            // Ignored during page navigation
        }
        catch (TaskCanceledException)
        {
            // Ignored during page navigation
        }
        catch (InvalidOperationException)
        {
            // Ignored during page navigation
        }
    }

    public async ValueTask DisposeAsync()
    {
        InitialBoardLoad.Completed -= OnInitialBoardLoadCompleted;
        PausePreference.PausedChanged -= OnPauseChanged;
        await StopHubAsync();

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

}
