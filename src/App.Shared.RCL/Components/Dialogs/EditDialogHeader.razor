@using App.Shared.RCL.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="hab-modal__header" @ref="_headerRef">
    <div class="hab-modal__grabber" aria-hidden="true"></div>
    <div class="hab-modal__topbar hab-modal__topbar--minimal">
        <span class="hab-modal__actions" style="margin-left:auto;">
            @if (!string.IsNullOrEmpty(SaveStatus))
            {
                <span class="hab-modal__save @SaveStatusClass" aria-live="polite">
                    @SaveStatusText
                </span>
            }
            <DialogCloseButton OnClose="OnClose" />
        </span>
    </div>

    <div class="hab-modal__title-field">
        @if (!string.IsNullOrWhiteSpace(TitleText))
        {
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="letter-spacing:-0.02em;">@TitleText</MudText>
        }
        <MudText Typo="Typo.caption" Class="edit-daily-label-header">Title</MudText>
        <MudTextField Value="@_title"
                      ValueChanged="@((string value) => OnTitleValueChanged(value))"
                      Variant="Variant.Outlined"
                      Class="hab-modal__title-input edit-daily-field-header"
                      Placeholder="@TitlePlaceholder"
                      Immediate="true"
                      Margin="Margin.Dense"
                      aria-label="Title"/>
    </div>

    <div class="hab-modal__title-field mt-2">
        <MudText Typo="Typo.caption" Class="edit-daily-label-header">Notes</MudText>
        <MudTextField Value="@_notes"
                      ValueChanged="@((string value) => OnNotesValueChanged(value))"
                      Variant="Variant.Outlined"
                      Class="hab-modal__notes-field edit-daily-field-header"
                      Placeholder="Add notes, context, or why this matters"
                      Lines="3"
                      Immediate="true"
                      Margin="Margin.Dense"
                      aria-label="Notes"/>
    </div>
</div>

@code {
    [Parameter] public string TitleText { get; set; } = string.Empty;
    [Parameter] public string TitlePlaceholder { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TitleChanged { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public EventCallback<string?> NotesChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string SaveStatus { get; set; } = string.Empty;
    [Parameter] public BoardSection? Section { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private DotNetObjectReference<EditDialogHeader>? _swipeRef;
    private ElementReference _headerRef;
    private bool _swipeStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_swipeStarted)
        {
            _swipeStarted = true;
            try
            {
                _swipeRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/modalSwipe.js");
                await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _headerRef, _swipeRef,
                    new { horizontal = false, dismissDown = true });
            }
            catch
            {
                // Swipe gestures are a touch enhancement. The close button always works.
            }
        }
    }

    /// <summary>Called from touch gestures. Swipe down on the header closes the dialog.</summary>
    [JSInvokable]
    public Task OnModalSwipeDownAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _headerRef);
        }
        catch
        {
            // Ignored during disposal.
        }

        _swipeRef?.Dispose();
        _swipeRef = null;
    }

    protected override void OnParametersSet()
    {
        _title = Title;
        _notes = Notes;
    }

    private string SaveStatusText => SaveStatus switch
    {
        "saving" => "Saving…",
        "error" => "Save failed",
        "saved" => "Saved",
        _ => string.Empty
    };

    private string SaveStatusClass => SaveStatus switch
    {
        "saving" => "hab-modal__save--saving",
        "error" => "hab-modal__save--error",
        "saved" => "hab-modal__save--saved",
        _ => string.Empty
    };

    private void OnTitleValueChanged(string value)
    {
        _title = value;
        _ = TitleChanged.InvokeAsync(value);
    }

    private void OnNotesValueChanged(string? value)
    {
        _notes = value;
        _ = NotesChanged.InvokeAsync(value);
    }
}
