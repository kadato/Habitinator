@inject IBoardSyncStatus BoardSync
@inject IUserNotifier UserNotifier
@inject INotificationSettingsService SettingsService
@implements IDisposable

@code {
    // Sync health lives in `SyncStatusIndicator`, a cloud icon plus text with `role=status`.
    // Toasts fire when sync goes offline, when sync fails, or when the client merges a conflict.
    private NotificationSettings? _settings;
    private bool _wasOffline;
    private string? _lastProblem;
    private int _lastConflictCount;

    protected override async Task OnInitializedAsync()
    {
        BoardSync.Changed += OnBoardSyncChanged;
        SettingsService.Changed += OnSettingsChanged;
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = null;
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSettingsAsync();
            StateHasChanged();
        });
    }

    private void OnBoardSyncChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(HandleSyncStatusChangeAsync);
    }

    private async Task HandleSyncStatusChangeAsync()
    {
        if (_settings is null)
        {
            await LoadSettingsAsync();
        }

        var isOffline = BoardSync.IsOffline;
        var problem = BoardSync.SyncProblemMessage;
        var conflictCount = BoardSync.RecentConflicts.Count;
        var alertsEnabled = _settings is null || _settings.SyncFailureAlertsEnabled;

        try
        {
            if (alertsEnabled && isOffline && !_wasOffline)
            {
                await UserNotifier.NotifyAsync("You are offline. The client sends changes when you reconnect.", Severity.Warning);
            }
            else if (alertsEnabled && !isOffline && !string.IsNullOrEmpty(problem) && !string.Equals(problem, _lastProblem, StringComparison.Ordinal))
            {
                await UserNotifier.NotifyAsync($"Sync issue: {problem}", Severity.Error);
            }

            if (conflictCount > _lastConflictCount && BoardSync.RecentConflicts.Count > 0)
            {
                var latest = BoardSync.RecentConflicts[0];
                var detail = string.IsNullOrWhiteSpace(latest.ChangedFields) ? string.Empty : $" ({latest.ChangedFields})";
                await UserNotifier.NotifyAsync($"The client merged {latest.Title}{detail}. Tap the sync icon for details.", Severity.Info);
            }
        }
        catch
        {
            // Best-effort toast. The SyncStatusIndicator still shows the state.
        }
        finally
        {
            _wasOffline = isOffline;
            _lastProblem = problem;
            _lastConflictCount = conflictCount;
        }
    }

    public void Dispose()
    {
        Dispose(disposing: true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!disposing)
        {
            return;
        }

        BoardSync.Changed -= OnBoardSyncChanged;
        SettingsService.Changed -= OnSettingsChanged;
    }
}
