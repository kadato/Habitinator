<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <SiteHead/>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <style>
        :root {
            --hab-bg-light: #f8fafc;
            --hab-bg-dark: #0b0f19;
        }
        html, body {
            background-color: var(--hab-bg-light);
        }
        @@media (prefers-color-scheme: dark) {
            html, body {
                background-color: var(--hab-bg-dark);
            }
        }
    </style>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.css"]"/>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]"/>
    <link rel="stylesheet" href="_content/App.Shared.RCL/css/typography.css"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="_content/App.Shared.RCL/css/auth-pages.css"/>
    <link rel="stylesheet" href="@Assets["App.Web.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" href="/favicon.ico" sizes="any"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    @* Fallback until the interactive circuit updates head; must match Routes render mode. *@
    <title>@SeoDefaults.DefaultTitle</title>
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))"/>
</head>

<body>
<CascadingAuthenticationState>
    <Routes/>
</CascadingAuthenticationState>
<ReconnectModal/>
<script src="_content/App.Shared.RCL/js/scriptLoader.js"></script>
<script src="lib/microsoft-signalr/signalr.min.js"></script>
<script src="js/boardHub.js"></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
<script src="@Assets["_content/App.Shared.RCL/js/sortable.min.js"]"></script>
<script src="@Assets["_content/App.Shared.RCL/js/boardSortable.js"]"></script>
<script src="@Assets["_content/App.Shared.RCL/js/focusTimerAlert.js"]"></script>
<script src="_content/App.Shared.RCL/js/userTimezone.js"></script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
