@page "/auth/login"
@layout GuestLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

<PageMeta Title="@PageTitles.Page("Sign in")"
          Description="Sign in to Habitinator."
          CanonicalPath="/auth/login"
          Robots="@SeoDefaults.IndexRobots"/>

<AuthPageShell Title="Sign in"
               Subtitle="Email and password to sign in."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="alert" id="@(_hasError ? "auth-error" : null)">@_message</div>
        }

        <form method="post" action="/api/auth/cookie-login">
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            }
            <LoginFormFields HasError="@_hasError" ErrorId="auth-error"/>
            <div class="auth-form-actions">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large">
                    Sign in
                </MudButton>
            </div>
        </form>

        <div class="auth-form-divider" role="presentation">or</div>

        <form method="post" action="/api/auth/guest-login" class="d-flex flex-column guest-login-form" onsubmit="return habitinatorGuestSubmit(this)">
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            }
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       FullWidth="true"
                       Size="Size.Large">
                <span class="guest-login-label">Try demo</span>
            </MudButton>
            <p class="guest-login-status" role="status" hidden>Seeding your demo board… this takes a few seconds.</p>
        </form>
    </ChildContent>
    <Footer>
        <span>New here?</span>
        <a href="/auth/register" data-enhance-nav="false">Create account</a>
        <a href="/auth/forgot-password" data-enhance-nav="false">Forgot password</a>
        <a href="/privacy" data-enhance-nav="false">Privacy</a>
    </Footer>
</AuthPageShell>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string? _message;
    private bool _hasError;

    protected override void OnInitialized()
    {
        _message = AuthQueryMessages.Resolve(Navigation);
        _hasError = HasErrorQuery(Navigation);
    }

    private static bool HasErrorQuery(NavigationManager navigation)
    {
        var query = navigation.ToAbsoluteUri(navigation.Uri).Query;
        return query.Contains("error=1", StringComparison.Ordinal);
    }

}
