@inject GlobalTimerService TimerService
@inject IUserPreferencesService PreferencesService
@implements IDisposable

<div class="timer-panel w-100">
    <div class="@MobileHeaderClass"
         @onclick="ToggleExpanded"
         @onkeydown="OnMobileHeaderKeyDown"
         role="button"
         tabindex="0"
         @attributes="MobileHeaderAttributes">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="w-100 px-3 py-2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="min-w-0 flex-grow-1">
                @if (TimerService.PomodoroModeEnabled)
                {
                    <PomodoroIcon Size="Size.Medium" Plain="true" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Color="Color.Default" Size="Size.Medium"/>
                }
                @if (IsSessionActive)
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold timer-mobile-header-text">
                        @GetDisplayTime()
                        @if (!string.IsNullOrWhiteSpace(GetRunningTargetLabel()))
                        {
                            <span class="mud-text-secondary font-weight-normal text-truncate max-w-240"> · @GetRunningTargetLabel()</span>
                        }
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold timer-mobile-header-text">
                        <span class="timer-mobile-header-mode-badge">@(TimerService.PomodoroModeEnabled ? "Pomodoro" : "Stopwatch")</span>
                    </MudText>
                }
            </MudStack>
            <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                     Color="Color.Default"
                     Class="timer-mobile-expand-icon"
                     Size="Size.Medium"/>
        </MudStack>
    </div>

    <div class="timer-collapse-outer">
        <MudCollapse Expanded="@_expanded" Class="timer-collapse-wrapper">
            <div class="pa-2 pa-sm-3 timer-panel__content">
                <div class="timer-main">
                    <div class="timer-clock-block">
                        <div class="timer-clock-header">
                            <MudText Typo="Typo.h5"
                                     Color="Color.Default"
                                     GutterBottom="false"
                                     Class="timer-value"
                                     role="timer"
                                     aria-live="polite">
                                @GetDisplayTime()
                            </MudText>
                        </div>
                        <div class="custom-timer-toggle" role="group" aria-label="Timer mode selection">
                            <button type="button"
                                    class="@StopwatchToggleClass"
                                    @onclick="() => OnPomodoroModeToggleChanged(false)"
                                    @attributes="GetModeToggleAttributes(false)"
                                    aria-label="Stopwatch mode">
                                <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" aria-hidden="true" />
                                <span class="toggle-btn-label">Stopwatch</span>
                            </button>
                            <button type="button"
                                    class="@PomodoroToggleClass"
                                    @onclick="() => OnPomodoroModeToggleChanged(true)"
                                    @attributes="GetModeToggleAttributes(true)"
                                    aria-label="Pomodoro mode">
                                <PomodoroIcon Size="Size.Small" Plain="true" />
                                <span class="toggle-btn-label">Pomodoro</span>
                            </button>
                        </div>
                    </div>

                    <div class="timer-controls">
                        @RenderTimerInputs

                        <div class="timer-toolbar__actions">
                            @if (TimerService.PomodoroModeEnabled && (TimerService.CurrentPomodoroState == PomodoroState.ShortBreak || TimerService.CurrentPomodoroState == PomodoroState.LongBreak))
                            {
                                <MudIconButton Variant="Variant.Outlined"
                                               Color="Color.Default"
                                               Icon="@Icons.Material.Filled.SkipNext"
                                               Class="timer-icon-btn"
                                               OnClick="SkipBreak"
                                               aria-label="Skip break" />
                            }
                            @if (TimerService.IsRunning)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Pause"
                                           Class="timer-primary-action timer-start--text"
                                           OnClick="Pause"
                                           aria-label="Pause timer">
                                    Pause
                                </MudButton>
                                <MudIconButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Icon="@Icons.Material.Filled.Pause"
                                               Class="timer-icon-btn timer-icon-btn--primary timer-start--icon"
                                               OnClick="Pause"
                                               aria-label="Pause timer" />
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           Class="timer-primary-action timer-start--text"
                                           OnClick="Start"
                                           Disabled="@(!CanStart)"
                                           aria-label="@(TimerService.Elapsed > TimeSpan.Zero ? "Resume timer" : "Start timer")">
                                    @(TimerService.Elapsed > TimeSpan.Zero ? "Resume" : "Start")
                                </MudButton>
                                <MudIconButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Icon="@Icons.Material.Filled.PlayArrow"
                                               Class="timer-icon-btn timer-icon-btn--primary timer-start--icon"
                                               OnClick="Start"
                                               Disabled="@(!CanStart)"
                                               aria-label="@(TimerService.Elapsed > TimeSpan.Zero ? "Resume timer" : "Start timer")" />
                            }
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       Class="timer-secondary-action timer-stop--text"
                                       OnClick="StopAndLog"
                                       Disabled="@(!IsSessionActive)"
                                       aria-label="Stop and log session">
                                Stop
                            </MudButton>
                            <MudIconButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Icon="@Icons.Material.Filled.Stop"
                                           Class="timer-icon-btn timer-stop--icon"
                                           OnClick="StopAndLog"
                                           Disabled="@(!IsSessionActive)"
                                           aria-label="Stop and log session" />
                            <MudIconButton Variant="Variant.Outlined"
                                           Color="Color.Default"
                                           Icon="@Icons.Material.Filled.Refresh"
                                           Class="timer-icon-btn"
                                           OnClick="Reset"
                                           Disabled="@(!CanReset)"
                                           aria-label="Reset timer" />
                        </div>
                    </div>
                </div>
            </div>
        </MudCollapse>
    </div>
</div>

@code {
    private Dictionary<string, object> MobileHeaderAttributes => new()
    {
        ["aria-expanded"] = _expanded ? "true" : "false",
    };

    private Dictionary<string, object> GetModeToggleAttributes(bool isPomodoro) => new()
    {
        ["aria-pressed"] = TimerService.PomodoroModeEnabled == isPomodoro ? "true" : "false",
    };

    [Parameter] public EventCallback<TimeSpan> OnLogSaved { get; set; }

    [Parameter] public IReadOnlyList<BoardItem> Habits { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Dailies { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Todos { get; set; } = [];

    private string _sessionTargetText = string.Empty;
    private bool _sessionTargetFieldInitialized;
    private (string? TargetId, string? TargetType, Guid? BoardItemId) _lastSyncedSessionTarget;
    private bool _focusDurationFieldInitialized;
    private TimeSpan? _lastSyncedFocusAlertAfter;
    private string _focusDurationText = string.Empty;
    private bool _wasRunning;
    private bool _expanded;

    private bool IsSessionActive =>
        TimerService.IsRunning || TimerService.Elapsed > TimeSpan.Zero;

    private string MobileHeaderClass => _expanded ? "timer-mobile-header timer-mobile-header--expanded" : "timer-mobile-header timer-mobile-header--collapsed";
    private string StopwatchToggleClass => !TimerService.PomodoroModeEnabled ? "toggle-btn active" : "toggle-btn";
    private string PomodoroToggleClass => TimerService.PomodoroModeEnabled ? "toggle-btn active" : "toggle-btn";

    private string FocusDurationText
    {
        get => _focusDurationText;
        set
        {
            var v = value ?? string.Empty;
            if (_focusDurationText == v)
            {
                return;
            }

            _focusDurationText = v;
            _focusDurationParseError = false;
            if (string.IsNullOrWhiteSpace(_focusDurationText))
            {
                TimerService.FocusAlertAfter = null;
            }
        }
    }

    private bool _focusDurationParseError;

    private string? _focusDurationErrorText =>
        _focusDurationParseError ? FocusDurationInput.ParseErrorHint : null;

    private bool _showFocusHelp;

    private string FocusHelperText => _showFocusHelp
        ? "Optional one-time alert. An empty field means no alert."
        : "Examples: 25, 1:20, 90s";

    private void ToggleFocusHelp() => _showFocusHelp = !_showFocusHelp;

    private string GetPomodoroCycleHint() =>
        $"{GlobalTimerService.FormatTimeSpan(TimerService.WorkDuration)} work, " +
        $"{GlobalTimerService.FormatTimeSpan(TimerService.ShortBreakDuration)} short, " +
        $"long every {TimerService.IntervalsBeforeLongBreak}";

    /// <summary>
    ///     You can start with no target. If you leave the target empty, the timer runs an open session.
    ///     The timer logs focus time without board progress.
    ///     You pick a target to filter the list.
    /// </summary>
    private bool CanStart =>
        !TimerService.IsRunning
        && !TimerService.AwaitingFocusTimeUpPrompt;

    /// <summary>Reset is allowed when timer is not running and there's elapsed time or a target set.</summary>
    private bool CanReset =>
        !TimerService.IsRunning
        && (
            !string.IsNullOrWhiteSpace(TimerService.TargetId)
            || TimerService.Elapsed > TimeSpan.Zero
            || (TimerService.PomodoroModeEnabled && TimerService.CurrentPomodoroState != PomodoroState.Idle)
        );

    private readonly Dictionary<string, (string TargetType, string TargetTitle, Guid ItemId)> _sessionLabelToTarget = new(StringComparer.Ordinal);

    private string GetRunningTargetLabel()
    {
        if (string.IsNullOrWhiteSpace(_sessionTargetText))
        {
            return FormatTargetForField(TimerService);
        }

        return _sessionTargetText;
    }
     private RenderFragment RenderTimerInputs => __builder =>
     {
          <div class="timer-inputs-pair">
             <div class="timer-target-input-row">
                 <MudAutocomplete T="string"
                                  Value="@_sessionTargetText"
                                  ValueChanged="OnSessionTargetValueChanged"
                                  SearchFunc="SearchSessionTargetsAsync"
                                  Label="Session target"
                                  Placeholder="Search board or type a custom label"
                                  HelperText="If you leave the target empty, the timer runs an open session."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="timer-target-field flex-grow-1"
                                  Immediate="true"
                                  CoerceValue="true"
                                  Strict="false"
                                  MinCharacters="0"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@GetTimerTargetLeadIcon()"
                                  ResetValueOnEmptyText="true">
                     <ItemTemplate Context="rowKey">
                         @{
                             _sessionLabelToTarget.TryGetValue(rowKey, out (string TargetType, string TargetTitle, Guid _) entry);
                         }
                         <MudStack Row="true"
                                   Spacing="2"
                                   AlignItems="AlignItems.Center"
                                   Class="w-100">
                             <MudIcon Color="Color.Default"
                                      Icon="@BoardSectionVisuals.GetMudIconForTargetType(entry.TargetType)"
                                      Size="Size.Small"/>
                             <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@rowKey</MudText>
                         </MudStack>
                     </ItemTemplate>
                 </MudAutocomplete>
             </div>
             @if (!TimerService.PomodoroModeEnabled)
             {
                 <div class="timer-focus-field" @onkeydown="OnFocusDurationKeyDown">
                     <MudTextField T="string"
                                   @bind-Text="FocusDurationText"
                                   OnBlur="OnFocusDurationBlur"
                                   Label="Time's up after"
                                   Placeholder="25, 1:20, 90s, 0:0:30"
                                   HelperText="@FocusHelperText"
                                   Clearable="true"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="timer-focus-textfield w-100 flex-grow-1"
                                   Immediate="true"
                                   Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Outlined.Info"
                                   AdornmentAriaLabel="About time's up alerts"
                                   OnAdornmentClick="ToggleFocusHelp"
                                   Error="@_focusDurationParseError"
                                   ErrorText="@_focusDurationErrorText"/>
                 </div>
             }
             else
             {
                  <div class="timer-pomodoro-info-field">
                      <MudField Label="Pomodoro session" Variant="Variant.Outlined" Margin="Margin.Dense" Class="timer-pomodoro-field-control" tabindex="-1">
                          <div class="timer-pomodoro-info-container" title="@GetPomodoroCycleTitle()">
                              <span class="timer-pomodoro-info-item timer-pomodoro-info-item--next">
                                  <MudIcon Icon="@Icons.Material.Filled.ArrowCircleRight" Size="Size.Small" Class="next-icon" />
                                  <span class="info-value next-value">@GetNextPomodoroLabelAndDuration()</span>
                              </span>
                              <span class="timer-pomodoro-info-item timer-pomodoro-info-item--done" title="@GetCompletedPomodoroTitle()">
                                  <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="done-icon" Color="Color.Success" />
                                  <span class="info-value total-value">@GetCompletedInCurrentCycle()/@TimerService.IntervalsBeforeLongBreak</span>
                              </span>
                          </div>
                      </MudField>
                      <div class="timer-field-sub">
                          <MudText Typo="Typo.caption" Color="Color.Secondary">@GetPomodoroCycleHint()</MudText>
                      </div>
                  </div>
              }
         </div>
     };
}
