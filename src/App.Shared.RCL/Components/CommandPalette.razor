@namespace App.Shared.RCL.Components
@using App.Shared.RCL.Services.CommandPalette
@inject ICommandPaletteService PaletteService
@inject IJSRuntime JS
@implements IDisposable

@if (PaletteService.IsOpen)
{
    <div class="cmd-palette-backdrop" @onclick="PaletteService.Close" role="presentation">
        <div class="cmd-palette-dialog"
             @onclick:stopPropagation="true"
             role="dialog"
             aria-modal="true"
             aria-label="Command palette">

            <!-- Search bar with optional breadcrumbs -->
            <div class="cmd-palette-header">
                @if (_breadcrumbs.Count > 0)
                {
                    <div class="cmd-palette-breadcrumbs" aria-label="Current path">
                        @foreach (var crumb in _breadcrumbs)
                        {
                            <span class="cmd-palette-crumb">@crumb</span>
                            <span class="cmd-palette-crumb-sep" aria-hidden="true">/</span>
                        }
                    </div>
                }
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="cmd-palette-search-icon" aria-hidden="true" />
                <input class="cmd-palette-input"
                       type="text"
                       placeholder="@GetSearchPlaceholder()"
                       value="@_query"
                       @oninput="OnQueryInput"
                       @onkeydown="HandleKeyDown"
                       role="combobox"
                       aria-expanded="true"
                       aria-autocomplete="list"
                       aria-controls="cmd-palette-results"
                       aria-activedescendant="@GetActiveDescendantId()" />
                <button type="button" class="cmd-palette-close-btn" @onclick="PaletteService.Close" aria-label="Close command palette">
                    <kbd class="cmd-palette-kbd">Esc</kbd>
                </button>
            </div>

            <!-- Grouped command results -->
            <div class="cmd-palette-results" id="cmd-palette-results" role="listbox" aria-label="Commands and search results">
                @if (_flatVisibleItems.Count == 0)
                {
                    <div class="cmd-palette-empty">No matching commands or items</div>
                }
                else
                {
                    @foreach (var group in _groupedItems)
                    {
                        <div class="cmd-palette-group" role="group" aria-label="@group.Key">
                            <div class="cmd-palette-group-title" aria-hidden="true">@group.Key</div>
                            @foreach (var item in group)
                            {
                                var isSelected = SelectedItemId is not null && item.Id == SelectedItemId;
                                var isDanger = item.IsDanger;
                                var itemDomId = $"cmd-item-{item.Id}";
                                <div id="@itemDomId"
                                     class="cmd-palette-item @(isSelected ? "cmd-palette-item--selected" : "") @(isDanger ? "cmd-palette-item--danger" : "")"
                                     role="option"
                                     aria-selected="@(isSelected ? "true" : "false")"
                                     @onclick="() => ExecuteItemAsync(item)"
                                     @onmouseenter="() => SelectItem(item)">
                                    @if (!string.IsNullOrEmpty(item.Icon))
                                    {
                                        <MudIcon Icon="@item.Icon" Class="cmd-palette-item-icon" aria-hidden="true" />
                                    }
                                    <div class="cmd-palette-item-body">
                                        <span class="cmd-palette-item-title">@item.Title</span>
                                        @if (!string.IsNullOrEmpty(item.Subtitle))
                                        {
                                            <span class="cmd-palette-item-subtitle">@item.Subtitle</span>
                                        }
                                    </div>
                                    @if (item.ChildrenProvider is not null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="cmd-palette-item-chevron" aria-hidden="true" />
                                    }
                                    else if (!string.IsNullOrEmpty(item.ShortcutBadge))
                                    {
                                        <div class="cmd-palette-badge-wrap">
                                            @foreach (var part in GetShortcutParts(item.ShortcutBadge))
                                            {
                                                <kbd class="cmd-palette-kbd">@part</kbd>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Bottom helper bar -->
            <div class="cmd-palette-footer" aria-hidden="true">
                <span class="cmd-palette-footer-item"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
                <span class="cmd-palette-footer-item"><kbd>↵</kbd> Select</span>
                @if (_breadcrumbs.Count > 0)
                {
                    <span class="cmd-palette-footer-item"><kbd>⌫</kbd> Back</span>
                }
                <span class="cmd-palette-footer-item"><kbd>Esc</kbd> Close</span>
            </div>
        </div>
    </div>
}
