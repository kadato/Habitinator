@using System.Globalization
@using Microsoft.JSInterop
@using App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Models
@inject IActivityStatisticsReader Stats
@inject IBoardDataService BoardData
@inject IDialogService DialogService
@inject IUserDateFormatService DateFormatService
@inject IUserTimeZoneService TimeZoneService
@inject IUserNotifier Notifier
@inject IJSRuntime JSRuntime
@inject PersistentComponentState ApplicationState
@implements IDisposable

<MudStack Spacing="2" Class="stats-panel">

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
    }
    else if (_loading)
    {
        <!-- Main Dashboard Layout Skeleton -->
        <div class="stats-dashboard-layout">
            <div class="stats-dashboard-main">
                <MudPaper Class="pa-4 stats-dashboard-card" Elevation="0" Outlined="true">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                        <div>
                            <MudSkeleton Width="140px" Height="24px" Class="mb-1" />
                            <MudSkeleton Width="280px" Height="16px" />
                        </div>
                        <MudSkeleton Width="150px" Height="16px" />
                    </div>
                    <MudSkeleton Width="100%" Height="120px" SkeletonType="SkeletonType.Rectangle" />
                </MudPaper>

                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudSkeleton Width="180px" Height="24px" Class="mb-1" />
                    <MudSkeleton Width="220px" Height="16px" Class="mb-4" />
                    <MudSkeleton Width="100%" Height="100px" SkeletonType="SkeletonType.Rectangle" />
                </MudPaper>

                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudSkeleton Width="150px" Height="24px" Class="mb-4" />
                    <MudGrid Spacing="3">
                        @for (int i = 0; i < 2; i++)
                        {
                            <MudItem xs="12" md="6">
                                <div class="pa-3 border rounded mud-border-lines-default stats-block-bg">
                                    <div class="d-flex align-center justify-space-between mb-3">
                                        <MudSkeleton Width="120px" Height="20px" />
                                        <MudSkeleton Width="100px" Height="16px" />
                                    </div>
                                    <MudSkeleton Width="100%" Height="60px" SkeletonType="SkeletonType.Rectangle" />
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </div>

            <div class="stats-dashboard-sidebar">
                <div class="stats-sidebar-column">
                    <MudPaper Class="pa-4 stats-dashboard-card stats-filter-card" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudSkeleton Width="80px" Height="20px" />
                            <MudSkeleton Width="100%" Height="36px" />
                            <MudSkeleton Width="100%" Height="36px" />
                        </MudStack>
                    </MudPaper>
                    <div class="stats-kpi-strip stats-kpi-strip--mobile">
                        <div class="stats-kpi-strip__grid">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="stats-kpi-strip__item">
                                    <div class="stats-kpi-strip__head">
                                        <MudSkeleton Width="40px" Height="10px" />
                                    </div>
                                    <MudSkeleton Width="32px" Height="16px" Class="mt-1" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="stats-kpi-cards stats-kpi-cards--desktop">
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudPaper Class="stats-kpi-card stats-kpi-card--sidebar" Elevation="0" Outlined="false">
                                <MudSkeleton Width="100px" Height="14px" />
                                <MudSkeleton Width="72px" Height="24px" Class="mt-1" />
                                <MudSkeleton Width="120px" Height="12px" Class="mt-1" />
                            </MudPaper>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_data is null)
    {
        <MudText>No data.</MudText>
    }
    else
    {
        <!-- Main Dashboard Layout -->
        <div class="stats-dashboard-layout">
            <div class="stats-dashboard-main">
                @if (_weeklyReview is { } week)
                {
                    <!-- Weekly review card -->
                    <MudPaper Class="pa-4 stats-dashboard-card stats-weekly-card mb-4" Elevation="0" Outlined="true">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">This week</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @FormatRange(week.WeekStart, week.WeekEnd)
                            </MudText>
                        </div>
                        <div class="stats-weekly-grid">
                            <div class="stats-weekly-tile">
                                <span class="stats-weekly-tile__label">Events</span>
                                <span class="stats-weekly-tile__value">@week.Events</span>
                                <span class="@GetWeeklyDeltaClass(week.PercentChange)">
                                    @(week.PercentChange >= 0 ? "▲" : "▼") @Math.Abs(week.PercentChange)% vs last week
                                </span>
                            </div>
                            <div class="stats-weekly-tile">
                                <span class="stats-weekly-tile__label">Focus</span>
                                <span class="stats-weekly-tile__value">@FormatFocus(week.FocusMinutes)</span>
                                <span class="stats-weekly-tile__delta stats-weekly-tile__delta--flat">timer sessions</span>
                            </div>
                            <div class="stats-weekly-tile">
                                <span class="stats-weekly-tile__label">Dailies completed</span>
                                <span class="stats-weekly-tile__value">@week.DailiesCompleted</span>
                                <span class="stats-weekly-tile__delta stats-weekly-tile__delta--flat">check-ins logged</span>
                            </div>
                        </div>
                    </MudPaper>
                }

                <!-- Activity Heatmap Card -->
                <MudPaper Class="pa-4 stats-dashboard-card" Elevation="0" Outlined="true">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Activity heatmap</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Click a day to see all logged events for that day.</MudText>
                        </div>
                        <div class="stats-heatmap-legend-inline d-flex align-center gap-1">
                            <span class="text-secondary-caption mr-1" style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">Less</span>
                            <div class="stats-cell stats-legend-swatch stats-lvl-0"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-1"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-2"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-3"></div>
                            <div class="stats-cell stats-legend-swatch stats-lvl-4"></div>
                            <span class="text-secondary-caption ml-1" style="font-size: 0.72rem; color: var(--mud-palette-text-secondary);">More</span>
                        </div>
                    </div>

                    <StatsHeatmapGrid Columns="_data.GridWeekColumns"
                                      ContainerClass="stats-heatmap-container--large"
                                      IncludeRovingTabindex="true"
                                      Cells="_cellIndex"
                                      IsToday="@((r, c) => _cellIndex.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                      GetCellClass="@((r, c) => ActivityHeatmapCellClass(_cellIndex[(r, c)]))"
                                      GetCellTitle="@((r, c) => HeatmapDayTitle(_cellIndex[(r, c)].Date, _cellIndex[(r, c)].Count))"
                                      OnCellClick="@((r, c) => OpenDayDetailAsync(_cellIndex[(r, c)].Date))"/>
                </MudPaper>

                <!-- Weekly Activity Card -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">All activity by week</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                        @FormatRange(_data.WeekBarsRangeStart, _data.WeekBarsRangeEnd) · @(_data.WeekBars.Count) @(_data.WeekBars.Count == 1 ? "week" : "weeks")
                    </MudText>
                    
                    <div class="stats-week-bars" style="--stats-week-bar-max: @(_weekBarMax == 0 ? 1 : _weekBarMax);">
                        @foreach (var w in _data.WeekBars)
                        {
                            var h = _weekBarMax == 0 ? 0 : (int)Math.Round(100.0 * w.EventCount / _weekBarMax);
                            <div class="stats-week-bar-wrap" title="@FormatWeekBarTooltip(w)">
                                <div class="stats-week-bar" style="height: @(h)%"></div>
                            </div>
                        }
                    </div>
                </MudPaper>

                <!-- Dailies performance Card -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Dailies graphs</MudText>

                    @if (_loadingDailies)
                    {
                        <MudGrid Spacing="3" Class="stats-dailies-grid">
                            @for (int i = 0; i < 2; i++)
                            {
                                <MudItem xs="12" md="6">
                                    <div class="pa-3 border rounded mud-border-lines-default stats-block-bg">
                                        <div class="d-flex align-center justify-space-between mb-3">
                                            <MudSkeleton Width="120px" Height="20px" />
                                            <MudSkeleton Width="100px" Height="16px" />
                                        </div>
                                        <MudSkeleton Width="100%" Height="60px" SkeletonType="SkeletonType.Rectangle" />
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (_dailyError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">@_dailyError</MudAlert>
                    }
                    else if (_dailyView is not null)
                    {
                        @if (_dailyView.Graphs.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No daily activities on your board yet.</MudText>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="stats-dailies-grid">
                                @foreach (var daily in _dailyView.Graphs)
                                {
                                    var cellIx = GetDailyCellIndex(daily);
                                    <MudItem xs="12" md="6">
                                        <div class="stats-daily-block pa-3 border rounded mud-border-lines-default stats-block-bg">
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold stats-daily-title ma-0 mb-2">@daily.Title</MudText>

                                            <StatsHeatmapGrid Columns="daily.GridWeekColumns"
                                                              Cells="cellIx"
                                                              IsToday="@((r, c) => cellIx.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                                              GetCellClass="@((r, c) => DailyHeatmapCellClass(cellIx[(r, c)]))"
                                                              GetCellTitle="@((r, c) => DailyHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"
                                                              GetCellAriaLabel="@((r, c) => DailyHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"/>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    }
                </MudPaper>

                <!-- Habits performance Card -->
                <MudPaper Class="pa-4 stats-dashboard-card mt-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Habits graphs</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                        Days with at least one +/− log, with the share of days you were active.
                    </MudText>

                    @if (_loadingHabits)
                    {
                        <MudGrid Spacing="3" Class="stats-habits-grid">
                            @for (int i = 0; i < 2; i++)
                            {
                                <MudItem xs="12" md="6">
                                    <div class="pa-3 border rounded mud-border-lines-default stats-block-bg">
                                        <div class="d-flex align-center justify-space-between mb-3">
                                            <MudSkeleton Width="120px" Height="20px" />
                                            <MudSkeleton Width="100px" Height="16px" />
                                        </div>
                                        <MudSkeleton Width="100%" Height="60px" SkeletonType="SkeletonType.Rectangle" />
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (_habitError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2">@_habitError</MudAlert>
                    }
                    else if (_habitView is not null)
                    {
                        @if (_habitView.Graphs.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No habits on your board yet.</MudText>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="stats-habits-grid">
                                @foreach (var habit in _habitView.Graphs)
                                {
                                    var cellIx = GetHabitCellIndex(habit);
                                    <MudItem xs="12" md="6">
                                        <div class="stats-habit-block pa-3 border rounded mud-border-lines-default stats-block-bg">
                                            <div class="d-flex align-center justify-space-between gap-2 mb-2">
                                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold stats-habit-title ma-0">@habit.Title</MudText>
                                                <span class="stats-habit-ratio" title="@FormatHabitRatioTooltip(habit.ActiveDayCount, habit.PeriodDayCount)">
                                                    @HabitActiveRatioLabel(habit.ActiveDayCount, habit.PeriodDayCount)
                                                </span>
                                            </div>

                                            <StatsHeatmapGrid Columns="habit.GridWeekColumns"
                                                              Cells="cellIx"
                                                              IsToday="@((r, c) => cellIx.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                                              GetCellClass="@((r, c) => HabitHeatmapCellClass(cellIx[(r, c)]))"
                                                              GetCellTitle="@((r, c) => HabitHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"
                                                              GetCellAriaLabel="@((r, c) => HabitHeatmapDayTitle(cellIx[(r, c)].Date, cellIx[(r, c)].Count))"/>
                                        </div>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    }
                </MudPaper>
            </div>

            <div class="stats-dashboard-sidebar">
                <div class="stats-sidebar-column">
                    <MudPaper Class="pa-4 stats-dashboard-card stats-filter-card" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <div class="stats-filter-card__header">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Filters</MudText>
                            </div>
                            <div class="stats-filter-row">
                                <MudSelect T="string"
                                           Label="Tags"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           MultiSelection="true"
                                           SelectAll="true"
                                           SelectAllText="All tags"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Outlined.LocalOffer"
                                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))"
                                           SelectedValues="_selectedTags"
                                           SelectedValuesChanged="OnSelectedTagsChanged"
                                           Clearable="true"
                                           Disabled="@((_data.AvailableTags?.Count ?? 0) == 0)"
                                           AnchorOrigin="Origin.BottomLeft"
                                           TransformOrigin="Origin.TopLeft"
                                           MaxHeight="300"
                                           Style="width:100%"
                                           Class="stats-tag-select-sidebar">
                                    @if ((_data.AvailableTags?.Count ?? 0) > 0)
                                    {
                                        @foreach (var t in _data.AvailableTags ?? [])
                                        {
                                            <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                                        }
                                    }
                                    else
                                    {
                                        <MudSelectItem T="string" Value="@(string.Empty)" Disabled="true">No tags created yet</MudSelectItem>
                                    }
                                </MudSelect>

                                <MudSelect T="string"
                                           Label="Period"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Margin="Margin.Dense"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Outlined.DateRange"
                                           Value="_selectedPeriodKey"
                                           ValueChanged="OnStatsPeriodChanged"
                                           AnchorOrigin="Origin.BottomLeft"
                                           TransformOrigin="Origin.TopLeft"
                                           MaxHeight="300"
                                           Style="width:100%"
                                           Class="stats-year-select-sidebar">
                                    @if (_periodOptions is not null)
                                    {
                                        @foreach (var opt in _periodOptions)
                                        {
                                            <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>

                            @if (_selectedTags.Count > 0)
                            {
                                <div class="d-flex flex-wrap align-center gap-1 mt-1">
                                    @foreach (var tag in _selectedTags)
                                    {
                                        <MudChip T="string"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Outlined"
                                                 Size="Size.Small"
                                                 OnClose="() => OnRemoveTagFilterAsync(tag)"
                                                 Class="ma-0">
                                            @tag
                                        </MudChip>
                                    }
                                    @if (_selectedTags.Count > 1)
                                    {
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Secondary"
                                                   Size="Size.Small"
                                                   OnClick="OnClearTagFiltersAsync"
                                                   Class="pa-0 min-w-0 font-size-xs ms-1">
                                            Clear all
                                        </MudButton>
                                    }
                                </div>
                            }

                            @if (_periodBusy)
                            {
                                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-0"/>
                            }

                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="stats-sidebar-range">
                                @FormatRange(_data.RangeStart, _data.RangeEnd)
                            </MudText>
                        </MudStack>
                    </MudPaper>

                    <div class="stats-kpi-strip stats-kpi-strip--mobile">
                        <div class="stats-kpi-strip__grid">
                            @foreach (var kpi in Kpis(_data))
                            {
                                <div class="stats-kpi-strip__item @kpi.StripAccent">
                                    <div class="stats-kpi-strip__head">
                                        <span class="stats-kpi-strip__label">@kpi.StripLabel</span>
                                        <MudIcon Icon="@kpi.Icon" Class="stats-kpi-strip__icon" Size="Size.Small" aria-hidden="true"/>
                                    </div>
                                    <span class="@($"stats-kpi-strip__value {kpi.StripValueClass}".Trim())" title="@kpi.StripTitle()">@kpi.StripValue()</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="stats-kpi-cards stats-kpi-cards--desktop">
                        @foreach (var kpi in Kpis(_data))
                        {
                            <MudPaper Class="@($"stats-kpi-card stats-kpi-card--sidebar stats-kpi-card--plain {kpi.CardAccent}")" Elevation="0" Outlined="false">
                                <div class="stats-kpi-card__head">
                                    <MudText Typo="Typo.caption" Class="stats-kpi-card__label">@kpi.CardLabel</MudText>
                                    <MudIcon Icon="@kpi.Icon" Class="stats-kpi-card__icon" Size="Size.Small" aria-hidden="true"/>
                                </div>
                                <MudText Typo="Typo.h6" Class="stats-kpi-card__value">@kpi.CardValue()</MudText>
                                <MudText Typo="Typo.caption" Class="stats-kpi-card__detail">@kpi.CardDetail()</MudText>
                            </MudPaper>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</MudStack>

@code {
    private PersistingComponentStateSubscription _subscription;
    private ActivityDashboardDto? _data;
    private IReadOnlyList<DailyGraphPeriodOption>? _periodOptions;
    private Dictionary<(int R, int C), ActivityHeatmapCellDto> _cellIndex = [];

    private int _weekBarMax;
    private bool _loading = true;
    private bool _periodBusy;
    private string? _error;

    private DailyContributionsViewDto? _dailyView;
    private HabitContributionsViewDto? _habitView;
    private string _selectedPeriodKey = DailyGraphPeriods.Rolling370Days;
    private string _tagFilter = "";
    private IReadOnlyCollection<string> _selectedTags = Array.Empty<string>();
    private bool _loadingDailies;
    private string? _dailyError;
    private bool _loadingHabits;
    private string? _habitError;
    private int _bestStreakDays;
    private string? _bestStreakTitle;
    private WeeklyReview? _weeklyReview;
    private bool _shouldScrollToEnd;
    private DateOnly _heatmapToday;

    private sealed record WeeklyReview(
        DateOnly WeekStart,
        DateOnly WeekEnd,
        int Events,
        int FocusMinutes,
        int DailiesCompleted,
        int PercentChange);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToEnd)
        {
            _shouldScrollToEnd = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
                await JSRuntime.InvokeVoidAsync("initializeHeatmapRovingTabindex");
            }
            catch (Exception)
            {
                // Ignore JS errors if components disappear or JS isn't ready
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _subscription = ApplicationState.RegisterOnPersisting(PersistStatisticsData);
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        try
        {
            await DateFormatService.InitializeAsync();
            await LoadStatisticsAsync(_selectedPeriodKey);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingDailies = false;
            _loading = false;
        }
    }

    private Task PersistStatisticsData()
    {
        if (_data is not null)
        {
            ApplicationState.PersistAsJson("stats_dashboard_data", _data);
        }
        if (_dailyView is not null)
        {
            ApplicationState.PersistAsJson("stats_daily_view_data", _dailyView);
        }
        if (_habitView is not null)
        {
            ApplicationState.PersistAsJson("stats_habit_view_data", _habitView);
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _subscription.Dispose();
    }

    private async Task LoadStatisticsAsync(string periodKey)
    {
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        _loadingDailies = true;
        _dailyError = null;
        _loadingHabits = true;
        _habitError = null;
        try
        {
            var tag = string.IsNullOrEmpty(_tagFilter) ? null : _tagFilter;
            if (ApplicationState.TryTakeFromJson<ActivityDashboardDto>("stats_dashboard_data", out var restoredDashboard) && restoredDashboard is not null)
            {
                _data = restoredDashboard;
            }
            else
            {
                _data = await Stats.GetDashboardAsync(periodKey, tag);
            }

            if (ApplicationState.TryTakeFromJson<DailyContributionsViewDto>("stats_daily_view_data", out var restoredDailyView) && restoredDailyView is not null)
            {
                _dailyView = restoredDailyView;
            }
            else
            {
                _dailyView = await Stats.GetDailyContributionsAsync(periodKey, tag);
            }

            if (ApplicationState.TryTakeFromJson<HabitContributionsViewDto>("stats_habit_view_data", out var restoredHabitView) && restoredHabitView is not null)
            {
                _habitView = restoredHabitView;
            }
            else
            {
                _habitView = await Stats.GetHabitContributionsAsync(periodKey, tag);
            }

            _selectedPeriodKey = _data.PeriodKey;
            var tagList = _data.AvailableTags ?? [];

            if (!string.IsNullOrEmpty(_tagFilter))
            {
                var splitFilter = _tagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var validTags = splitFilter.Where(t => tagList.Contains(t, StringComparer.OrdinalIgnoreCase)).ToList();
                _selectedTags = validTags;
                _tagFilter = string.Join(",", _selectedTags);
            }
            else
            {
                _selectedTags = Array.Empty<string>();
                _tagFilter = "";
            }

            _periodOptions = _dailyView.PeriodOptions;
            _cellIndex = _data.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
            _dailyCellIndices.Clear();
            _habitCellIndices.Clear();
            _weekBarMax = _data.WeekBars.Count == 0
                ? 0
                : _data.WeekBars.Max(x => x.EventCount);
            _shouldScrollToEnd = true;
            ComputeWeeklyReview();
            await LoadBestStreakAsync();
        }
        catch (Exception dex)
        {
            _error = dex.Message;
            _dailyError = dex.Message;
            _habitError = dex.Message;
            _data = null;
            _dailyView = null;
            _habitView = null;
            _periodOptions = null;
            _cellIndex = [];
            _dailyCellIndices.Clear();
            _habitCellIndices.Clear();
        }
        finally
        {
            _loadingDailies = false;
            _loadingHabits = false;
        }
    }

    private Dictionary<(int Row, int Col), ActivityHeatmapCellDto> GetDailyCellIndex(DailyContributionGraphDto daily)
    {
        if (_dailyCellIndices.TryGetValue(daily.BoardItemId, out var map))
        {
            return map;
        }

        map = daily.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
        _dailyCellIndices[daily.BoardItemId] = map;
        return map;
    }

    private Dictionary<(int Row, int Col), ActivityHeatmapCellDto> GetHabitCellIndex(HabitContributionGraphDto habit)
    {
        if (_habitCellIndices.TryGetValue(habit.BoardItemId, out var map))
        {
            return map;
        }

        map = habit.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
        _habitCellIndices[habit.BoardItemId] = map;
        return map;
    }

    private void ComputeWeeklyReview()
    {
        if (_data is null)
        {
            _weeklyReview = null;
            return;
        }

        var weekStart = _heatmapToday.AddDays(-(((int)_heatmapToday.DayOfWeek + 6) % 7));
        var weekEnd = _heatmapToday;

        var events = 0;
        var prevEvents = 0;
        foreach (var cell in _data.Heatmap)
        {
            if (!cell.InDataRange)
            {
                continue;
            }

            if (cell.Date >= weekStart && cell.Date <= weekEnd)
            {
                events += cell.Count;
            }
            else if (cell.Date >= weekStart.AddDays(-7) && cell.Date < weekStart)
            {
                prevEvents += cell.Count;
            }
        }

        var focusMinutes = _data.WeekBars
            .Where(w => w.WeekStart == weekStart)
            .Select(w => w.FocusMinutes)
            .DefaultIfEmpty(0)
            .Sum();

        var dailiesCompleted = 0;
        if (_dailyView is not null)
        {
            foreach (var graph in _dailyView.Graphs)
            {
                foreach (var cell in graph.Heatmap)
                {
                    if (cell.InDataRange && cell.Count > 0 && cell.Date >= weekStart && cell.Date <= weekEnd)
                    {
                        dailiesCompleted++;
                    }
                }
            }
        }

        int percentChange;
        if (prevEvents > 0)
        {
            percentChange = (int)Math.Round(100.0 * (events - prevEvents) / prevEvents);
        }
        else
        {
            percentChange = events > 0 ? 100 : 0;
        }

        _weeklyReview = new WeeklyReview(weekStart, weekEnd, events, focusMinutes, dailiesCompleted, percentChange);
    }

    private async Task LoadBestStreakAsync()
    {
        try
        {
            var streaks = await BoardData.GetStreakMapAsync();
            _bestStreakDays = 0;
            _bestStreakTitle = null;
            if (_dailyView is not null)
            {
                foreach (var graph in _dailyView.Graphs)
                {
                    if (streaks.TryGetValue(graph.BoardItemId, out var streak) && streak > _bestStreakDays)
                    {
                        _bestStreakDays = streak;
                        _bestStreakTitle = graph.Title;
                    }
                }
            }
        }
        catch (Exception)
        {
            // Ignored. The KPI simply stays empty
        }
    }

