@inherits LayoutComponentBase
@using MudBlazor
@using global::App.Shared.RCL.Themes

<MudThemeProvider Theme="@HabitinatorMudTheme.Default" IsDarkMode="@IsDarkMode"/>

<MudLayout Class="app-shell-layout">
    <MudAppBar Elevation="0" Dense="true" Class="app-top-bar app-top-bar--guest" ToolBarClass="app-top-bar-toolbar" role="banner">
        <a href="/" data-enhance-nav="false" class="text-decoration-none"><MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText></a>
        <MudSpacer />
    </MudAppBar>
    <MudMainContent Class="app-shell-main">
        <main id="main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-3 px-4 px-sm-5 board-main-container">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; } = true;
}
