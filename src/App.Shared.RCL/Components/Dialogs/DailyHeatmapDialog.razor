@namespace App.Shared.RCL.Components.Dialogs
@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@inject IActivityStatisticsReader Stats
@inject IUserTimeZoneService TimeZoneService
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject IUserDateFormatService DateFormatService
@inject IUserNotifier Notifier
@using Microsoft.Extensions.Logging;

@inject IServiceProvider ServiceProvider

<MudDialog Class="hab-modal-dialog" ContentClass="hab-modal-content">
    <DialogContent>
        <div class="hab-modal hab-modal--daily hab-modal--wide hab-modal--heatmap" data-dialog-label="Daily heatmap" @onclick:stopPropagation="true">
            <div class="hab-modal__header">
                <div class="hab-modal__topbar hab-modal__topbar--minimal">
                    <DialogCloseButton OnClose="CloseDialog" />
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Style="letter-spacing:-0.02em;">@DisplayTitle</MudText>
                    @if (_graph is not null)
                    {
                        <span class="stats-habit-ratio" title="@RatioTooltip">@RatioLabel</span>
                    }
                </div>
                @if (_periodOptions.Count > 1)
                {
                    <div class="stats-segment mt-3" role="tablist" aria-label="Period">
                        @foreach (var opt in _periodOptions)
                        {
                            <button type="button" role="tab" @attributes="GetPeriodTabAttrs(opt.Key)" class="stats-segment__btn @(_selectedPeriodKey == opt.Key ? "stats-segment__btn--active" : string.Empty)" @onclick="() => OnPeriodChangedAsync(opt.Key)">@opt.Label</button>
                        }
                    </div>
                }
            </div>

            <div class="hab-modal__body">
                @if (_loading && _graph is null)
                {
                    <div class="pa-2">
                        <MudSkeleton Width="100%" Height="110px" SkeletonType="SkeletonType.Rectangle" />
                        <MudSkeleton Width="60%" Height="14px" Class="mt-3" />
                    </div>
                }
                else if (_error is not null && _graph is null)
                {
                    <div class="dialog-inline-fallback">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Class="dialog-inline-fallback__icon"  aria-hidden="true" />
                        <MudText Typo="Typo.subtitle2" Class="dialog-inline-fallback__title">Could not load heatmap</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Try again or pick a different period.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" OnClick="LoadDataAsync">Retry</MudButton>
                    </div>
                }
                else if (_graph is not null)
                {
                    <div class="daily-heatmap-grid-container">
                        <StatsHeatmapGrid Columns="_graph.GridWeekColumns"
                                           RegionLabel="@($"Activity heatmap for {DisplayTitle}")"
                                           ContainerClass="stats-heatmap-container--large"
                                           ShowMonthLabels="false"
                                           Cells="_cellIndex"
                                           IsToday="@((r, c) => _cellIndex.TryGetValue((r, c), out var cell) && IsHeatmapToday(cell.Date))"
                                           GetCellClass="@((r, c) => DailyHeatmapCellClass(_cellIndex[(r, c)]))"
                                           GetCellTitle="@((r, c) => DailyHeatmapDayTitle(_cellIndex[(r, c)]))"
                                           GetCellAriaLabel="@((r, c) => DailyHeatmapDayTitle(_cellIndex[(r, c)]))"
                                           IncludeRovingTabindex="true"
                                           OnCellClick="OnCellClickAsync"/>
                    </div>
                    <div class="daily-heatmap-legend">
                        <span class="daily-heatmap-legend__item"><span class="daily-heatmap-legend__sw daily-heatmap-legend__sw--done"></span>Done</span>
                        <span class="daily-heatmap-legend__item"><span class="daily-heatmap-legend__sw daily-heatmap-legend__sw--due"></span>Due</span>
                        <span class="daily-heatmap-legend__item"><span class="daily-heatmap-legend__sw daily-heatmap-legend__sw--open"></span>Not due</span>
                    </div>
                }
                else
                {
                    <div class="stats-empty">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" Class="stats-empty__icon"  aria-hidden="true" />
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">No heatmap yet</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Complete this daily to build its history.</MudText>
                    </div>
                }
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter] [EditorRequired] public Guid BoardItemId { get; set; }
    [Parameter] public string Title { get; set; } = "Daily";

    private string _selectedPeriodKey = DailyGraphPeriods.Rolling370Days;
    private IReadOnlyList<DailyGraphPeriodOption> _periodOptions = [];
    private DailyContributionGraphDto? _graph;

    private bool _shouldScrollToEnd;
    private Dictionary<(int R, int C), ActivityHeatmapCellDto> _cellIndex = [];
    private bool _loading = true;
    private string? _error;
    private DateOnly _heatmapToday;
    private bool _mutatedBelow;

    private string DisplayTitle => string.IsNullOrWhiteSpace(Title) ? "Daily" : Title;
    private string RatioLabel
    {
        get
        {
            if (_graph is null) return string.Empty;
            var active = _graph.Heatmap.Count(x => x.InDataRange && x.Count > 0);
            var total = _graph.Heatmap.Count(x => x.InDataRange);
            var pct = total == 0 ? 0 : (int)Math.Round(100.0 * active / total);
            return $"{active} of {total}, {pct}%";
        }
    }
    private string RatioTooltip
    {
        get
        {
            if (_graph is null) return string.Empty;
            var active = _graph.Heatmap.Count(x => x.InDataRange && x.Count > 0);
            var total = _graph.Heatmap.Count(x => x.InDataRange);
            return $"{active} active of {total} in this period";
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await DateFormatService.InitializeAsync();
        _heatmapToday = DailySchedule.LocalToday(TimeZoneService);
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shouldScrollToEnd)
        {
            return;
        }

        _shouldScrollToEnd = false;
        try
        {
            // Ensure the helper exists first. On cold open this render can win the race
            // against the page script loader, and a missed snap is never retried.
            await JSRuntime.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/statisticsScrolling.js");
            await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
            await JSRuntime.InvokeVoidAsync("initializeHeatmapRovingTabindex");
        }
        catch (Exception ex)
        {
            LogFallback(ex, "Heatmap JS init failed; the grid still renders without it.");
        }
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var data = await Stats.GetDailyContributionsAsync(_selectedPeriodKey);
            ApplyContributionData(data);
        }
        catch (Exception ex)
        {
            if (await TryLoadOfflineFallbackAsync())
            {
                return;
            }

            _error = ex.Message;
            await NotifySafeAsync("Could not load daily history. Please try again.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyContributionData(DailyContributionsViewDto data)
    {
        _periodOptions = data.PeriodOptions;
        if (!string.IsNullOrEmpty(data.PeriodKey))
        {
            _selectedPeriodKey = data.PeriodKey;
        }

        _graph = data.Graphs.FirstOrDefault(g => g.BoardItemId == BoardItemId)
                 ?? (!string.IsNullOrWhiteSpace(Title)
                     ? data.Graphs.FirstOrDefault(g => string.Equals(g.Title, Title, StringComparison.OrdinalIgnoreCase))
                     : null);

        if (_graph is not null)
        {
            _cellIndex = _graph.Heatmap.ToDictionary(x => (x.DayRow, x.WeekCol));
            _periodOptions = _periodOptions.Where(o => _graph.AvailablePeriodKeys.Contains(o.Key)).ToList();
            _shouldScrollToEnd = true;
        }
        else
        {
            _cellIndex = [];
        }
    }

    private async Task<bool> TryLoadOfflineFallbackAsync()
    {
        var offline = ServiceProvider.GetService<OfflineActivityStatisticsProvider>();
        if (offline is null)
        {
            return false;
        }

        try
        {
            var data = await offline.BuildDailyContributionsAsync(_selectedPeriodKey, null);
            ApplyContributionData(data);
            _error = null;
            await NotifySafeAsync("Offline: showing locally computed heatmap.", MudBlazor.Severity.Warning);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void LogFallback(Exception ex, string message) =>
        ServiceProvider.GetService<ILogger<DailyHeatmapDialog>>()?.LogDebug(ex, "{Message}", message);

    private async Task NotifySafeAsync(string message, MudBlazor.Severity severity)
    {
        try
        {
            await Notifier.NotifyAsync(message, severity);
        }
        catch
        {
            // Shows a best-effort toast. The dialog still shows the data.
        }
    }

    private async Task OnPeriodChangedAsync(string newPeriod)
    {
        _selectedPeriodKey = newPeriod;
        await LoadDataAsync();
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollHeatmapsToEnd");
        }
        catch (Exception ex)
        {
            LogFallback(ex, "Heatmap JS init failed; the grid still renders without it.");
        }
    }

    private Dictionary<string, object> GetPeriodTabAttrs(string key) => new()
    {
        { "aria-selected", _selectedPeriodKey == key ? "true" : "false" }
    };
    private bool IsHeatmapToday(DateOnly date) => date == _heatmapToday;
    private string DailyHeatmapCellClass(ActivityHeatmapCellDto cell)
    {
        var cls = $"stats-cell stats-lvl-{cell.Intensity}{(IsHeatmapToday(cell.Date) ? " stats-heatmap-day--today" : "")}";
        if (cell.InDataRange && cell.Due)
        {
            cls += " stats-daily-due";
        }

        return cls;
    }
    private string DailyHeatmapDayTitle(ActivityHeatmapCellDto cell)
    {
        string status;
        if (cell.Count > 0)
        {
            status = cell.Due ? "Done" : "Done, not due";
        }
        else
        {
            status = cell.Due ? "Due, not done" : "Not due";
        }

        var dateStr = DateFormatService.Format(cell.Date);
        var baseTitle = $"{dateStr}, {status}";
        return IsHeatmapToday(cell.Date) ? $"Today, {baseTitle}" : baseTitle;
    }
    private async Task OnCellClickAsync(int row, int col)
    {
        if (_cellIndex.TryGetValue((row, col), out var cell) && cell.InDataRange)
        {
            var options = DialogDefaults.Wide;
            var parameters = new DialogParameters<ActivityDayDetailDialog>
            {
                { x => x.Date, cell.Date },
                { x => x.BoardItemId, BoardItemId }
            };
            var dialog = await DialogService.ShowAsync<ActivityDayDetailDialog>(string.Empty, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: false } && result.Data is true)
            {
                _mutatedBelow = true;
            }

            // Reload on every close, not on reported mutations alone. Dismissing by clicking
            // away reports Cancel with no payload, so the result alone cannot prove that
            // nothing changed. Drain and invalidate first so the grid reads fresh state.
            await ReloadAfterMutationAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Drains synced operations first, so the reloaded heatmap includes the latest change.</summary>
    private async Task ReloadAfterMutationAsync()
    {
        await DrainBoardSyncAsync();
        try
        {
            Stats.InvalidateCache();
        }
        catch
        {
            // Best-effort cleanup. A stale cache entry makes the next load retry.
        }

        await LoadDataAsync();
    }

    /// <summary>Tries an immediate sync. Stats read from the server right after.</summary>
    private async Task DrainBoardSyncAsync()
    {
        try
        {
            var sync = ServiceProvider.GetService<App.Shared.RCL.Services.Board.Local.IBoardSyncRequestor>();
            if (sync is null)
            {
                return;
            }

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            await sync.SyncNowAsync(cts.Token);
        }
        catch
        {
            // If offline or slow, the periodic sync delivers the change. Reads use last known data.
        }
    }

    /// <summary>Closes the dialog and reports check-ins made below so parents can reload.</summary>
    private void CloseDialog()
    {
        try
        {
            if (_mutatedBelow)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                MudDialog.Cancel();
            }
        }
        catch
        {
            // Dialog already closed.
        }
    }
}
