@namespace App.Shared.RCL.Components

<MudCard Class="@($"board-column {GetAccentClass()}")" Elevation="0" Outlined="false">
    <MudCardHeader Class="pb-2">
        <CardHeaderContent>
            <MudStack Spacing="1">
                <div class="board-column-header-flex">
                    <div class="board-column-header-left board-column-header-row">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="board-title-stack">
                            <span class="board-count-badge">@VisibleItems().Count</span>
                            <MudText Typo="Typo.subtitle1" Class="board-title">@GetTitle()</MudText>
                            <MudMenu Icon="@Icons.Material.Outlined.Info"
                                     Size="Size.Small"
                                     Dense="true"
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft"
                                     PopoverClass="board-column-info-popover pa-3"
                                     Class="board-column-info-btn"
                                     title="What is this column?">
                                <ChildContent>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-1" Color="Color.Primary">@GetTitle()</MudText>
                                    <MudText Typo="Typo.body2" Class="board-column-info-text">
                                        @GetGlossaryText()
                                    </MudText>
                                </ChildContent>
                            </MudMenu>
                        </MudStack>
                    </div>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap board-filter-toolbar" role="toolbar">
                        @if (Section == BoardSection.Habit)
                        {
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.All)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetHabitFilter(HabitListFilter.All))">
                                All
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.Weak)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetHabitFilter(HabitListFilter.Weak))">
                                Weak
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.Strong)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetHabitFilter(HabitListFilter.Strong))">
                                Strong
                            </MudButton>
                        }
                        else if (Section == BoardSection.Daily)
                        {
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.All)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetDailyFilter(DailyListFilter.All))">
                                All
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.Due)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetDailyFilter(DailyListFilter.Due))">
                                Due
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.NotDue)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetDailyFilter(DailyListFilter.NotDue))">
                                Not due
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Active)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetTodoFilter(TodoListFilter.Active))">
                                Active
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Scheduled)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetTodoFilter(TodoListFilter.Scheduled))">
                                Scheduled
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="board-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Done)"
                                       Color="Color.Primary"
                                       OnClick="@(() => SetTodoFilter(TodoListFilter.Done))">
                                Done
                            </MudButton>
                        }
                    </MudStack>
                </div>
                @if (Section == BoardSection.Todo
                     && _todoFilter == TodoListFilter.Done
                     && VisibleItems().Count > 0)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Class="align-self-start"
                               OnClick="DeleteAllDoneTodosAsync">
                        Delete all done
                    </MudButton>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="pt-0">
        <div @onkeydown="OnDraftKeyAsync" class="board-add-wrap">
            <MudTextField @ref="_draftField"
                          @bind-Value="_draft"
                          Class="board-add-field"
                          Placeholder="@GetAddPlaceholder()"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Add"
                          OnAdornmentClick="AddFromDraftAsync"
                          Immediate="true"/>
        </div>

        <div class="board-list mt-2">
            @{
                var visibleItems = VisibleItems();
                var canReorder = IsItemDraggable();
            }
            @if (visibleItems.Count == 0)
            {
                <div class="board-column-empty-state">
                    @if (IsBoardFilterExcludingAll)
                    {
                        <div class="empty-state-icon-container empty-state-icon-container--filter">
                            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Class="empty-state-icon"/>
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="empty-state-title">No matches found</MudText>
                        <MudText Typo="Typo.caption" Class="empty-state-desc">Try adjusting your search text or removing selected tags.</MudText>
                    }
                    else
                    {
                        <div class="empty-state-icon-container">
                            <MudIcon Icon="@GetEmptyStateIcon()" Class="empty-state-icon"/>
                        </div>
                        <MudText Typo="Typo.subtitle2" Class="empty-state-title">@GetEmptyStateTitle()</MudText>
                        <MudText Typo="Typo.caption" Class="empty-state-desc">@GetEmptyStateDesc()</MudText>
                    }
                </div>
            }
            else if (canReorder)
            {
                <div @ref="_containerRef" class="board-sortable-list mud-width-full">
                    @foreach (var item in visibleItems)
                    {
                        <div @key="item.Id" data-id="@item.Id" class="board-sortable-item">
                            <BoardItemCard Item="item"
                                           Section="Section"
                                           CanReorder="canReorder"
                                           OnHabitUp="@(() => HabitUpAsync(item))"
                                           OnHabitDown="@(() => HabitDownAsync(item))"
                                           OnToggle="@(() => ToggleAsync(item))"
                                           OnOpenEditor="@(() => OpenItemEditorAsync(item))"
                                           OnMoveToTop="@(() => MoveToTopAsync(item))"
                                           OnMoveToBottom="@(() => MoveToBottomAsync(item))"
                                           OnDelete="@(() => DeleteAsync(item.Id))"
                                           OnSetChecklistItemDone="@(args => SetChecklistItemDoneAsync(item, args.ChecklistItemId, args.IsDone))" />
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var item in visibleItems)
                {
                    <BoardItemCard Item="item"
                                   Section="Section"
                                   CanReorder="canReorder"
                                   OnHabitUp="@(() => HabitUpAsync(item))"
                                   OnHabitDown="@(() => HabitDownAsync(item))"
                                   OnToggle="@(() => ToggleAsync(item))"
                                   OnOpenEditor="@(() => OpenItemEditorAsync(item))"
                                   OnMoveToTop="@(() => MoveToTopAsync(item))"
                                   OnMoveToBottom="@(() => MoveToBottomAsync(item))"
                                   OnDelete="@(() => DeleteAsync(item.Id))"
                                   OnSetChecklistItemDone="@(args => SetChecklistItemDoneAsync(item, args.ChecklistItemId, args.IsDone))" />
                }
            }
        </div>
    </MudCardContent>

    <MudCardActions Class="board-col-foot px-4 pb-3 pt-0">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFooterText()</MudText>
    </MudCardActions>
</MudCard>
