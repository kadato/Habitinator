    private async Task TestMcpConnectionAsync()
    {
        if (_mcpTokenResponse is null)
        {
            return;
        }

        _testingMcp = true;
        _mcpTestResult = null;
        StateHasChanged();
        try
        {
            var client = HttpFactory.CreateClient("api");
            using var request = new HttpRequestMessage(HttpMethod.Post, _mcpTokenResponse.Endpoint);
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _mcpTokenResponse.Token);
            request.Headers.Accept.ParseAdd("application/json");
            request.Headers.Accept.ParseAdd("text/event-stream");
            request.Content = new StringContent(
                """{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}""",
                Encoding.UTF8,
                "application/json");
            using var response = await client.SendAsync(request);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                _mcpTestSeverity = Severity.Error;
                _mcpTestResult = $"MCP test failed: {(int)response.StatusCode}. Check the token and try again.";
                return;
            }

            var toolCount = TryCountTools(body);
            _mcpTestSeverity = Severity.Success;
            _mcpTestResult = toolCount is null
                ? "MCP connected."
                : $"MCP connected. {toolCount} tools available.";
        }
        catch (Exception ex)
        {
            _mcpTestSeverity = Severity.Error;
            _mcpTestResult = $"MCP test failed: {ex.Message}";
        }
        finally
        {
            _testingMcp = false;
            StateHasChanged();
        }
    }

    private static int? TryCountTools(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("result", out var result)
                && result.TryGetProperty("tools", out var tools)
                && tools.ValueKind == JsonValueKind.Array)
            {
                return tools.GetArrayLength();
            }
        }
        catch (JsonException)
        {
            // SSE framing falls through to a plain success message.
        }

        return null;
    }

    private async Task CopyTextAsync(string text, string successMessage)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("habitinatorCopyText", text);
            if (ok)
            {
                Snackbar.Add(successMessage, Severity.Success, o => o.VisibleStateDuration = 1200);
            }
            else
            {
                Snackbar.Add("Copy failed.", Severity.Warning);
            }
        }
        catch
        {
            Snackbar.Add("Copy failed.", Severity.Warning);
        }
    }
}
