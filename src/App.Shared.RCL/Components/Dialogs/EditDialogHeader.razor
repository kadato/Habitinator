@using App.Shared.RCL.Models
@using App.Shared.RCL.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="hab-modal__header hab-modal__header--edit" @ref="_headerRef">
    <div class="hab-modal__grabber" aria-hidden="true"></div>
    <div class="hab-modal__edit-top">
        @if (!string.IsNullOrWhiteSpace(TitleText))
        {
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold hab-modal__edit-title" Style="letter-spacing:-0.02em;">@TitleText</MudText>
        }
        else
        {
            <span class="hab-modal__edit-title-spacer" aria-hidden="true"></span>
        }
        <span class="hab-modal__actions">
            @if (!string.IsNullOrEmpty(SaveStatus))
            {
                <span class="hab-modal__save @SaveStatusClass" aria-live="polite">
                    @SaveStatusText
                </span>
            }
            <DialogCloseButton OnClose="OnClose" />
        </span>
    </div>

    <div class="hab-modal__title-field">
        <MudTextField @ref="_titleInput"
                      Value="@_title"
                      ValueChanged="@((string value) => OnTitleValueChanged(value))"
                      Variant="Variant.Outlined"
                      Class="hab-modal__title-input edit-daily-field-header"
                      Placeholder="@TitlePlaceholder"
                      Immediate="true"
                      AutoFocus="false"
                      Margin="Margin.Dense"
                      aria-label="@(string.IsNullOrWhiteSpace(TitlePlaceholder) ? "Title" : TitlePlaceholder)"/>
    </div>
</div>

@code {
    [Parameter] public string TitleText { get; set; } = string.Empty;
    [Parameter] public string TitlePlaceholder { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TitleChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string SaveStatus { get; set; } = string.Empty;
    [Parameter] public BoardSection? Section { get; set; }

    private string _title = string.Empty;
    private MudTextField<string>? _titleInput;
    private DotNetObjectReference<EditDialogHeader>? _swipeRef;
    private ElementReference _headerRef;
    private bool _swipeStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_titleInput is not null && await ShouldAutoFocusAsync())
            {
                try
                {
                    await _titleInput.FocusAsync();
                    await _titleInput.SelectAsync();
                }
                catch
                {
                    // Focus/selection is best-effort.
                }
            }

            if (!_swipeStarted)
            {
                _swipeStarted = true;
                try
                {
                    _swipeRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("habitinatorLoadScript", "_content/App.Shared.RCL/js/modalSwipe.js");
                    await JS.InvokeVoidAsync("HabitinatorModalSwipe.init", _headerRef, _swipeRef,
                        new { horizontal = false, dismissDown = true });
                }
                catch
                {
                    // Swipe gestures are a touch enhancement. The close button always works.
                }
            }
        }
    }

    /// <summary>Touch gestures call this method. Swipe down on the header closes the dialog.</summary>
    [JSInvokable]
    public Task OnModalSwipeDownAsync() => OnClose.InvokeAsync();

    /// <summary>Desktop keeps autofocus. Touch devices and MAUI open dialogs unfocused, so the keyboard stays down.</summary>
    private async Task<bool> ShouldAutoFocusAsync()
    {
        try
        {
            return await DialogFocusJs.ShouldAutoFocusAsync(JS);
        }
        catch
        {
            return true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("HabitinatorModalSwipe.destroy", _headerRef);
        }
        catch
        {
            // Ignored during disposal.
        }

        _swipeRef?.Dispose();
        _swipeRef = null;
    }

    protected override void OnParametersSet()
    {
        _title = Title;
    }

    private string SaveStatusText => SaveStatus switch
    {
        "saving" => "Saving…",
        "error" => "Save failed",
        "saved" => "Saved",
        _ => string.Empty
    };

    private string SaveStatusClass => SaveStatus switch
    {
        "saving" => "hab-modal__save--saving",
        "error" => "hab-modal__save--error",
        "saved" => "hab-modal__save--saved",
        _ => string.Empty
    };

    private void OnTitleValueChanged(string value)
    {
        _title = value;
        _ = TitleChanged.InvokeAsync(value);
    }
}
