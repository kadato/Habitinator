# Handle line endings automatically for files detected as text
* text=auto

# Use LF line endings everywhere to align with .editorconfig
*.cs text eol=lf
*.razor text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bash text eol=lf
