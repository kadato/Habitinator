@page "/auth/login"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<PageTitle>Login</PageTitle>

<h1>Login</h1>
<p>Demo account: <strong>guest@habitinator.local</strong> / <strong>Guest123!</strong></p>

<EditForm Model="_model" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="_model.Email" />
    </div>
    <div class="mb-3">
        <label>Password</label>
        <InputText class="form-control" type="password" @bind-Value="_model.Password" />
    </div>
    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="_model.RememberMe" />
        <label class="form-check-label">Remember me</label>
    </div>
    <button class="btn btn-primary me-2" type="submit">Login</button>
    <button class="btn btn-outline-secondary" type="button" @onclick="GuestLoginAsync">Use demo guest</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <p class="mt-3">@_message</p>
}

@code {
    private LoginModel _model = new();
    private string? _message;

    private async Task LoginAsync()
    {
        var response = await Http.PostAsJsonAsync("/api/auth/login", new
        {
            _model.Email,
            _model.Password,
            _model.RememberMe
        });

        _message = response.IsSuccessStatusCode
            ? "Login request accepted. Cookie and token endpoint are active."
            : "Login failed. Check credentials.";
    }

    private async Task GuestLoginAsync()
    {
        var response = await Http.PostAsync("/api/auth/guest-login", null);
        _message = response.IsSuccessStatusCode
            ? "Demo guest login request accepted."
            : "Demo guest login failed.";
    }

    private sealed class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
