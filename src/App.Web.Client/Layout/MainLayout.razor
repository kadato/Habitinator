@using System.Security.Claims
@using global::App.Shared.RCL
@using global::App.Shared.RCL.Themes
@using Microsoft.AspNetCore.WebUtilities
@inherits ThemeLayoutBase

<PageTitle>@SeoDefaults.DefaultTitle</PageTitle>

<MudThemeProvider @ref="MudThemeProviderRef" Theme="@HabitinatorMudTheme.Default" @bind-IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider BackdropClick="true"/>
<MudSnackbarProvider/>
<TimeZoneInitializer />

<AuthorizeView>
    <Authorized>
        <div id="habitinator-loading-bar"></div>
    </Authorized>
</AuthorizeView>

<form id="globalLogoutForm" method="post" action="/api/auth/cookie-logout" style="display: none;"></form>

<a class="skip-link" href="#main-content">Skip to main content</a>

<MudLayout Class="app-shell-layout">
    <AuthorizeView>
        <Authorized Context="auth">
            <MudAppBar Elevation="0" Dense="true" Class="app-top-bar" ToolBarClass="app-top-bar-toolbar" role="banner">
                <div class="app-top-bar__stack w-100">
                    <div class="app-top-bar__row d-flex">
                        <div class="app-top-bar__left d-flex align-center">
                            <div class="app-branding app-branding--header d-flex flex-column justify-center">
                                <MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText>
                            </div>
                            <div class="app-show-desktop-only align-center">
                                <NavMenu/>
                            </div>
                        </div>
                        <div class="app-top-bar__flex-spacer" aria-hidden="true"></div>
                        <div class="app-top-bar__right d-flex align-center">
                            <div class="app-header-user-rail d-flex align-center">
                                <SyncStatusIndicator IconOnly="true" />
                                <MudMenu AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Dense="true"
                                         PopoverFixed="true"
                                         PopoverClass="app-profile-menu-popover">
                                    <ActivatorContent Context="profileMenu">
                                        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                                                       Color="Color.Primary"
                                                       Size="Size.Medium"
                                                       Class="app-header-profile-btn app-show-mobile-only"
                                                       aria-label="Account menu"
                                                       OnClick="@(e => profileMenu.ToggleAsync(e))" />
                                        <MudButton StartIcon="@Icons.Material.Filled.AccountCircle"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Filled"
                                                   Size="Size.Medium"
                                                   Class="app-header-username-btn text-transform-none app-show-desktop-only"
                                                   OnClick="@(e => profileMenu.ToggleAsync(e))">
                                            @GetDisplayName(auth)
                                        </MudButton>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <div class="px-4 py-3 border-bottom d-flex flex-column dropdown-header" style="min-width: 220px;">
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold dropdown-name">@GetDisplayName(auth)</MudText>
                                            <MudText Typo="Typo.caption" Class="text-secondary text-truncate dropdown-email">@auth.User.FindFirst(ClaimTypes.Email)?.Value</MudText>
                                        </div>
                                        <MudDivider Class="my-1"/>
                                        <SyncStatusIndicator IconOnly="false" />
                                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" Class="text-danger" OnClick="TriggerLogout">
                                            <MudText Color="Color.Error" Class="font-weight-semibold">Log out</MudText>
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                        </div>
                    </div>
                    <NavMenu MobileTopBar="true" />
                </div>
            </MudAppBar>
        </Authorized>
        <NotAuthorized>
            <MudAppBar Elevation="0" Dense="true" Class="app-top-bar app-top-bar--guest" ToolBarClass="app-top-bar-toolbar" role="banner">
                <a href="/" data-enhance-nav="false" class="text-decoration-none app-branding app-branding--header"><MudText Typo="Typo.h6" Class="app-top-bar__title mb-0">Habitinator</MudText></a>
                <MudSpacer />
                @if (!IsWelcomePage)
                {
                    <MudButton Href="/auth/login" Target="_self" data-enhance-nav="false" Variant="Variant.Text" Color="Color.Inherit" Class="text-transform-none app-show-mobile-only">Sign in</MudButton>
                    <MudButton Href="/auth/register" Target="_self" data-enhance-nav="false" Variant="Variant.Filled" Color="Color.Primary" Class="text-transform-none ms-1">Register</MudButton>
                }
            </MudAppBar>
        </NotAuthorized>
    </AuthorizeView>
    <MudMainContent Class="app-shell-main">
        <main id="main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-1 pb-3 px-4 px-sm-5 board-main-container">
                @Body
            </MudContainer>
        </main>
    </MudMainContent>
</MudLayout>

<AuthorizeView>
    <Authorized>
        <GlobalTimerFocusAlertHost/>
        <GlobalSyncAlertHost/>
        <WebBoardHubConnector/>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool IsWelcomePage =>
        string.IsNullOrEmpty(Nav.ToBaseRelativePath(Nav.Uri).Trim('/'));

    private async Task TriggerLogout()
    {
        await JS.InvokeVoidAsync("habitinatorSubmitForm", "globalLogoutForm");
    }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool CascadedIsDarkMode { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        IsDarkMode = GetInitialDarkMode();

        // Parse query parameter to avoid flash of wrong theme during loading
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("theme", out var themeValues))
        {
            var theme = themeValues.ToString();
            if (string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase))
            {
                IsDarkMode = false;
            }
            else if (string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase))
            {
                IsDarkMode = true;
            }
        }

        await LoadPreferencesAsync();
    }

    protected override async Task OnAfterFirstRenderAsync()
    {
        // 3. Finally, remove the loading bar
        try
        {
            await JS.InvokeVoidAsync("habitinatorRemoveLoadingBar");
        }
        catch
        {
            // Ignore early JS interop failures
        }
    }

    private string GetFullIdentity(AuthenticationState auth)
    {
        var email = auth.User.FindFirst(ClaimTypes.Email)?.Value
                    ?? auth.User.Identity?.Name
                    ?? "User";
        var displayName = Preferences?.DisplayName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            return email;
        }

        return $"{displayName} ({email})";
    }

    private string GetDisplayName(AuthenticationState auth)
    {
        var displayName = Preferences?.DisplayName;
        if (!string.IsNullOrWhiteSpace(displayName))
        {
            return displayName;
        }

        var full = GetFullIdentity(auth);
        var at = full.IndexOf('@');
        return at > 0 ? full[..at] : full;
    }

    private bool GetInitialDarkMode()
    {
        if (JS is Microsoft.JSInterop.IJSInProcessRuntime jsInProcess)
        {
            try
            {
                var isDarkClass = jsInProcess.Invoke<bool>("eval", "document.documentElement.classList.contains('dark-theme')");
                if (isDarkClass) return true;

                var isLightClass = jsInProcess.Invoke<bool>("eval", "document.documentElement.classList.contains('light-theme')");
                if (isLightClass) return false;
            }
            catch
            {
                // Ignore and fall back
            }
        }
        return GetSystemDarkMode();
    }

    protected override bool GetSystemDarkMode()
    {
        if (JS is Microsoft.JSInterop.IJSInProcessRuntime jsInProcess)
        {
            try
            {
                return jsInProcess.Invoke<bool>("eval", "window.matchMedia('(prefers-color-scheme: dark)').matches");
            }
            catch
            {
                // Ignore and fall back
            }
        }
        return CascadedIsDarkMode; // Fall back to the server-resolved cascading theme
    }

}
