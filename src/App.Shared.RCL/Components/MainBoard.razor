@inject IBoardDataService BoardDataService
@inject ITimerSessionLogService TimerSessionLog
@inject IDialogService DialogService
@inject IDailyRetroPromptStore DailyRetroStore
@inject IRemoteBoardRefreshService RemoteBoardRefresh
@inject BoardRemoteNotifyBridge BoardNotifyBridge
@inject IBoardSyncStatus BoardSync
@inject App.Shared.RCL.Services.Board.Local.IBoardSyncRequestor BoardSyncRequestor
@inject IClientSessionProvider ClientSession
@inject IJSRuntime JS
@inject IUserTimeZoneService TimeZoneService
@inject IUserPreferencesService PreferencesService
@inject IUserDateFormatService DateFormatService
@inject IUndoService UndoService
@inject IInitialBoardLoadGate InitialBoardLoad
@inject IUserNotifier Notifier
@inject PersistentComponentState ApplicationState
@inject BoardUiSessionState UiSessionState
@inject ICommandPaletteService CommandPalette
@inject IHttpClientFactory HttpFactory



<MudStack Class="board-shell w-100" Spacing="1">
    <h1 class="hab-visually-hidden" tabindex="-1">Board</h1>
    @if (BoardSync.IsOffline)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="my-1" role="status">
            You're offline.
        </MudAlert>
    }
    else if (BoardSync.IsPaused)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1" role="status">
            <div class="d-flex align-center flex-wrap gap-2">
                <span>
                    Auto-sync is off.
                </span>
                <MudButton Variant="Variant.Outlined" Size="Size.Medium" Disabled="@BoardSync.IsSyncing" OnClick="() => BoardSyncRequestor.RequestSync()">Sync now</MudButton>
            </div>
        </MudAlert>
    }
    else if (!string.IsNullOrEmpty(BoardSync.SyncProblemMessage))
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1" role="status">
            <div class="d-flex align-center flex-wrap gap-2">
                <span>
                    Couldn't sync.
                </span>
                <MudButton Variant="Variant.Outlined" Size="Size.Medium" Disabled="@BoardSync.IsSyncing" OnClick="() => BoardSyncRequestor.RequestSync()">Retry</MudButton>
            </div>
        </MudAlert>
    }
    @if (!ClientSession.IsLoggedIn && _initialLoadComplete && HasBoardItems())
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="my-1" role="status">
            Offline. Showing saved copy. Connect to sign in.
        </MudAlert>
    }
    @if (_isLoading && _initialLoadComplete)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
    }

    @if (_loadError is not null)
    {
        <div class="board-load-fallback">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="board-load-fallback__icon"  aria-hidden="true" />
            <MudText Typo="Typo.subtitle2" Class="board-load-fallback__title">Couldn't load board</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="board-load-fallback__hint">Check connection and try again.</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_isLoading"
                       OnClick="RetryLoadAsync"
                       Size="Size.Medium"
                       Class="mt-2">
                Retry
            </MudButton>
        </div>
    }

    @if (_initialLoadComplete && _loadError is null && !HasBoardItems() && BoardSync.IsOffline)
    {
        <div class="board-load-fallback">
            <MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" Class="board-load-fallback__icon" aria-hidden="true" />
            <MudText Typo="Typo.subtitle2" Class="board-load-fallback__title">You're offline</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="board-load-fallback__hint">Connect once to load.</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_isLoading"
                       OnClick="RetryLoadAsync"
                       Size="Size.Medium"
                       Class="mt-2">
                Retry
            </MudButton>
        </div>
    }



    <GlobalTimerPanel OnLogSaved="HandleTimerLogSavedAsync"
                      Habits="Habits"
                      Dailies="Dailies"
                      Todos="Todos"/>

    @if (_initialLoadComplete && _loadError is null)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">

                <div class="board-stat-filters">
                    <div class="board-search-wrapper flex-grow-1" style="position: relative; display: flex; align-items: center;">
                        <MudTextField @bind-Value="_searchText"
                                      @bind-Value:after="OnSearchTextChanged"
                                      Placeholder="Search"
                                      aria-label="Search board items"
                                      AdornmentAriaLabel="Search"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="board-search-field board-search-pill w-100"
                                      InputType="InputType.Search"
                                      Immediate="true"
                                      Clearable="true"
                                      InputMode="@InputMode.search"
                                      enterkeyhint="search"
                                      autocomplete="off"
                                      autocapitalize="off"
                                      autocorrect="off"/>

                    </div>
                    <div class="board-tags-menu-activator">
                        <MudMenu @ref="_tagsMenu" AnchorOrigin="@TagsMenuAnchor"
                                 TransformOrigin="@TagsMenuTransform"
                                 PopoverFixed="true"
                                 RelativeWidth="DropdownWidth.Ignore"
                                 PopoverClass="board-tags-menu-popover">
                            <ActivatorContent Context="tagMenu">
                                <button type="button"
                                        class="@GetTagsTriggerClass()"
                                        aria-haspopup="true"
                                        title="@GetTagsTriggerTitle()"
                                        @onclick="@(e => tagMenu.ToggleAsync(e))">
                                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="board-trigger-icon" aria-hidden="true" />
                                    <span class="board-trigger-label">@(SelectedFilterTagCount > 0 ? $"Tags ({SelectedFilterTagCount})" : "Tags")</span>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="board-trigger-chevron" aria-hidden="true" />
                                </button>
                            </ActivatorContent>
                            <ChildContent>
                                <MudPaper Class="board-tags-menu-panel pa-3" Elevation="0">
                                    <MudText Typo="Typo.subtitle1" Class="mb-1">Tags</MudText>
                                    @if (GetAllTagNamesForMenu().Count == 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">No tags yet.</MudText>
                                    }
                                    else
                                    {
                                        <div class="board-tag-filter-grid board-tags-menu-body">
                                            @foreach (var tag in GetAllTagNamesForMenu())
                                            {
                                                <MudCheckBox @key="tag" Value="IsFilterTagSelected(tag)"
                                                             ValueChanged="@((bool b) => OnFilterTagChanged(tag, b))"
                                                             Label="@tag"
                                                             Color="Color.Primary"
                                                             Dense="true"
                                                             Class="ma-0"/>
                                            }
                                        </div>
                                    }
                                    <MudStack Row="true" Spacing="1" Justify="Justify.SpaceBetween" Class="mt-2 pt-2 board-tags-menu-footer" Style="border-top: 1px solid var(--mud-palette-divider);">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   Size="Size.Medium"
                                                   OnClick="ClearBoardFilters"
                                                   Disabled="@(string.IsNullOrWhiteSpace(_searchText) && SelectedFilterTagCount == 0)">
                                            Clear all filters
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                                <MudMenuItem OnClick="OpenArchivedItemsDialogAsync" Icon="@Icons.Material.Filled.Archive">Open archive</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </div>
                    <button type="button"
                            class="board-trigger-btn board-archive-trigger"
                            aria-label="Open archive"
                            title="Open archive"
                            @onclick="OpenArchivedItemsDialogAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Archive" Class="board-trigger-icon" aria-hidden="true" />
                        <span class="board-trigger-label app-show-desktop-only">Archive</span>
                    </button>
                    <button type="button"
                            class="board-trigger-btn board-bar-extra board-bar-extra--command"
                            aria-label="Command palette (Ctrl+K)"
                            title="Open command palette (Ctrl+K)"
                            @onclick="() => CommandPalette.Toggle()">
                        <MudIcon Icon="@Icons.Material.Filled.Keyboard" Class="board-trigger-icon" aria-hidden="true" />
                    </button>
                    <button type="button"
                            class="board-trigger-btn board-bar-extra board-bar-extra--ai"
                            aria-label="AI assistant"
                            title="Open AI assistant"
                            @onclick="() => UiSessionState.ToggleAiDrawer()">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="board-trigger-icon" aria-hidden="true" />
                    </button>
                    @if (_shortcutsEnabled)
                    {
                        <button type="button"
                                class="board-shortcuts-hint mud-text-secondary app-show-desktop-only"
                                title="Press Ctrl+K or Cmd+K to open command palette"
                                aria-label="Open command palette (Ctrl+K)"
                                @onclick="() => CommandPalette.Toggle()">
                            <kbd class="board-kbd">Ctrl</kbd><span class="board-shortcuts-hint__plus" aria-hidden="true">+</span><kbd class="board-kbd">K</kbd>
                        </button>
                    }
                </div>
            </div>
        </MudPaper>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <MudPaper Class="px-3 py-2 board-stat-strip" Outlined="false" Elevation="0">
            <div class="board-stat-strip-row">

                <div class="board-stat-filters d-flex gap-2 w-100">
                    <MudSkeleton Height="36px" SkeletonType="SkeletonType.Rectangle" Class="board-skel-search" />
                    <MudSkeleton Width="90px" Height="36px" SkeletonType="SkeletonType.Rectangle" Class="board-skel-trigger" />
                    <MudSkeleton Width="90px" Height="36px" SkeletonType="SkeletonType.Rectangle" Class="board-skel-trigger" />
                </div>
            </div>
        </MudPaper>
    }

    @if (_initialLoadComplete && _loadError is null)
    {
        <BoardPersistOnHide />
        @if (ShowOnboarding)
        {
            <EmptyBoardOnboarding OnStartFromGoal="OnboardingStartFromGoalAsync"
                                  OnLoadDemo="OnboardingLoadDemoAsync"
                                  OnDismiss="OnboardingDismissAsync" />
        }
        <div class="board-columns-stage">
            @if (_isMobileViewport.GetValueOrDefault())
            {
                <div class="board-columns-mobile" @ref="_swipeAreaRef">
                <div class="board-section-switcher" role="tablist" aria-label="Board sections">
                    <button type="button"
                            role="tab"
                            id="board-tab-0"
                            aria-controls="board-tab-panel-0"
                            aria-selected="@(_mobileSectionIndex == 0)"
                            tabindex="@(_mobileSectionIndex == 0 ? "0" : "-1")"
                            class="@GetSectionSwitcherClass(0)"
                            @onclick="() => SetMobileSectionIndex(0)"
                            @onkeydown="OnMobileSectionKeyDown">
                        <span class="board-section-switcher__label">Habits</span>
                        <span class="board-section-switcher__count">@FilteredHabits.Count</span>
                    </button>
                    <button type="button"
                            role="tab"
                            id="board-tab-1"
                            aria-controls="board-tab-panel-1"
                            aria-selected="@(_mobileSectionIndex == 1)"
                            tabindex="@(_mobileSectionIndex == 1 ? "0" : "-1")"
                            class="@GetSectionSwitcherClass(1)"
                            @onclick="() => SetMobileSectionIndex(1)"
                            @onkeydown="OnMobileSectionKeyDown">
                        <span class="board-section-switcher__label">Dailies</span>
                        <span class="board-section-switcher__count">@DailiesDueOpenCount</span>
                    </button>
                    <button type="button"
                            role="tab"
                            id="board-tab-2"
                            aria-controls="board-tab-panel-2"
                            aria-selected="@(_mobileSectionIndex == 2)"
                            tabindex="@(_mobileSectionIndex == 2 ? "0" : "-1")"
                            class="@GetSectionSwitcherClass(2)"
                            @onclick="() => SetMobileSectionIndex(2)"
                            @onkeydown="OnMobileSectionKeyDown">
                        <span class="board-section-switcher__label">To-dos</span>
                        <span class="board-section-switcher__count">@OpenTodoCount</span>
                    </button>
                </div>

                <div class="board-section-tab-content" id="board-tab-panel-@_mobileSectionIndex" role="tabpanel" tabindex="0" aria-labelledby="board-tab-@_mobileSectionIndex">
                    @foreach (var col in BoardColumns)
                    {
                        if (col.Section == (BoardSection)_mobileSectionIndex)
                        {
                            <BoardColumn @key="col.Section" Section="col.Section"
                                         Items="col.Items"
                                         IsBoardFilterExcludingAll="col.IsExcluded"
                                         OnChanged="OnBoardChanged"/>
                        }
                    }
                </div>
                </div>
            }
            else
            {
                <div class="board-columns-desktop">
                    <MudGrid Spacing="2" Class="board-columns-grid w-100">
                        @foreach (var col in BoardColumns)
                        {
                            <MudItem xs="12" md="4" @key="col.Section">
                                <BoardColumn Section="col.Section"
                                             Items="col.Items"
                                             IsBoardFilterExcludingAll="col.IsExcluded"
                                             OnChanged="OnBoardChanged"/>
                            </MudItem>
                        }
                    </MudGrid>
                </div>
            }
        </div>
    }
    else if (_isLoading && !_initialLoadComplete)
    {
        <div class="board-columns-stage">
            @if (_isMobileViewport.GetValueOrDefault())
            {
                <div class="board-columns-mobile">
                    <div class="board-section-switcher" role="group" aria-label="Loading board sections" aria-busy="true">
                        <button type="button" class="board-section-switcher__btn board-section-switcher__btn--active" disabled aria-pressed="true">
                            <span class="board-section-switcher__label">Habits</span>
                            <MudSkeleton Width="24px" Height="20px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />
                        </button>
                        <button type="button" class="board-section-switcher__btn" disabled aria-pressed="false">
                            <span class="board-section-switcher__label">Dailies</span>
                            <MudSkeleton Width="24px" Height="20px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />
                        </button>
                        <button type="button" class="board-section-switcher__btn" disabled aria-pressed="false">
                            <span class="board-section-switcher__label">To-dos</span>
                            <MudSkeleton Width="24px" Height="20px" SkeletonType="SkeletonType.Rectangle" Class="rounded" />
                        </button>
                    </div>
                    <BoardColumnSkeleton Section="BoardSection.Habit" />
                </div>
            }
            else
            {
                <div class="board-columns-desktop">
                    <MudGrid Spacing="2" Class="board-columns-grid w-100">
                        <MudItem xs="12" md="4">
                            <BoardColumnSkeleton Section="BoardSection.Habit" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <BoardColumnSkeleton Section="BoardSection.Daily" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <BoardColumnSkeleton Section="BoardSection.Todo" />
                        </MudItem>
                    </MudGrid>
                </div>
            }
        </div>
    }
</MudStack>
