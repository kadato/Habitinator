@page "/auth/login"
@page "/login"
@using global::App.Shared.RCL.Models
@inject ApiAuthService Auth
@inject IApiSession Session
@inject NavigationManager Nav

@* Inlined like Register - WebView + child components can break password/email binding. *@

<PageTitle>@PageTitles.Page("Sign in")</PageTitle>

<AuthPageShell Title="Sign in"
               Subtitle="Use your email and password, or try the demo guest."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="alert alert-info" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" type="email" autocomplete="email"
                   value="@_email" @oninput="OnEmailInput" @attributes="FormControlAttrs"/>
        </div>
        <div class="mb-3">
            <label for="password">Password</label>
            <input class="form-control" id="password" type="password" autocomplete="current-password"
                   value="@_password" @oninput="OnPasswordInput" @attributes="FormControlAttrs"/>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" id="remember" type="checkbox" @bind="_rememberMe" @attributes="FormControlAttrs"/>
            <label class="form-check-label" for="remember">Remember me</label>
        </div>
        <div class="auth-form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       OnClick="LoginAsync">
                Sign in
            </MudButton>
        </div>

        <div class="auth-form-divider" role="presentation">or</div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   FullWidth="true"
                   Size="Size.Large"
                   Disabled="_busy"
                   OnClick="GuestAsync">
            Continue as demo guest
        </MudButton>
    </ChildContent>
    <Footer>
        <span>New here?</span>
        <a href="/auth/register">Create account</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _message;
    private bool _busy;
    private bool _rememberMe;

    private Dictionary<string, object> FormControlAttrs => _busy
        ? new Dictionary<string, object> { ["disabled"] = true }
        : [];

    private void OnEmailInput(ChangeEventArgs e) => _email = e.Value?.ToString() ?? string.Empty;

    private void OnPasswordInput(ChangeEventArgs e) => _password = e.Value?.ToString() ?? string.Empty;

    protected override void OnInitialized()
    {
        _message = AuthQueryMessages.Resolve(Nav);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (Session.IsLoggedIn)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        try
        {
            var r = await Auth.LoginAsync(new LoginRequest(_email, _password, _rememberMe));
            if (r is null)
            {
                _message = "Invalid email or password.";
                return;
            }

            _message = null;
            await Session.SetSessionAsync(r);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task GuestAsync()
    {
        _busy = true;
        try
        {
            var r = await Auth.GuestJwtLoginAsync();
            if (r is null)
            {
                _message = "Demo guest is not available. Is the server running?";
                return;
            }

            _message = null;
            await Session.SetSessionAsync(r);
            Nav.NavigateTo("/");
        }
        finally
        {
            _busy = false;
        }
    }

}
