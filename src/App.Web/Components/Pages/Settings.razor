@page "/settings"

<PageTitle>Settings — Habitinator</PageTitle>
<SeoHead Title="Settings — Habitinator"
         Description="Notification preferences, account, and app settings."
         CanonicalPath="/settings"/>

<AuthorizeView>
    <NotAuthorized>
        <MudText Typo="Typo.h4">Settings</MudText>
        <MudText Class="mb-2">Sign in to manage notification preferences.</MudText>
        <MudButton Href="auth/login" Variant="Variant.Filled" Color="Color.Primary">Log in</MudButton>
    </NotAuthorized>
    <Authorized>
        <div class="settings-page-wrapper">
            <MudText Typo="Typo.h4" Class="app-page-title">Settings</MudText>
            <MudTabs Elevation="0" Outlined="false" Color="Color.Primary" Rounded="true" Class="settings-tabs">
                <MudTabPanel Text="Profile &amp; Preferences" Icon="@Icons.Material.Filled.Person">
                    <UserPreferencesSection ShowTitle="false"/>
                </MudTabPanel>
                <MudTabPanel Text="Notifications" Icon="@Icons.Material.Filled.Notifications">
                    <NotificationSettingsSection ShowTitle="false"/>
                </MudTabPanel>
                <MudTabPanel Text="Security &amp; Account" Icon="@Icons.Material.Filled.Security">
                    <AccountActionsSection ShowTitle="false"/>
                </MudTabPanel>
            </MudTabs>
        </div>
    </Authorized>
</AuthorizeView>