@inject GlobalTimerService TimerService
@inject IUserNotifier UserNotifier
@inject IFocusTimerClientAlerts FocusClientAlerts
@inject IDialogService DialogService
@implements IDisposable

<MudCard Class="timer-panel w-100" Elevation="0" Outlined="true">
    <MudCardContent Class="pa-2 pa-sm-3 timer-panel__content">
        <div class="timer-compact">
            <MudStack Row="true"
                      Spacing="2"
                      AlignItems="AlignItems.Center"
                      Class="timer-clock-header"
                      Wrap="Wrap.NoWrap"
                      role="group"
                      aria-label="Session timer">
                <MudIcon Icon="@Icons.Material.Filled.AccessTime"
                         Color="Color.Tertiary"
                         Size="Size.Large"
                         Class="timer-clock-icon"
                         title="Session timer"/>
                <MudText Typo="Typo.h4"
                         Color="Color.Default"
                         GutterBottom="false"
                         Class="timer-value"
                         role="timer"
                         aria-live="polite">
                    @TimerService.Elapsed.ToString(@"hh\:mm\:ss")
                </MudText>
            </MudStack>
            <div class="timer-inputs-pair">
                <div class="timer-target-input-row">
                    <MudAutocomplete T="string"
                                     Value="@_sessionTargetText"
                                     ValueChanged="OnSessionTargetValueChanged"
                                     SearchFunc="SearchSessionTargetsAsync"
                                     Label="Session target"
                                     Placeholder="Search board or type a custom label"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Class="timer-target-field flex-grow-1"
                                     Immediate="true"
                                     CoerceValue="false"
                                     Strict="false"
                                     MinCharacters="0"
                                     Clearable="true"
                                     Adornment="Adornment.Start"
                                     AdornmentIcon="@GetTimerTargetLeadIcon()"
                                     ResetValueOnEmptyText="true">
                        <ItemTemplate Context="rowKey">
                            @{
                                _sessionLabelToTarget.TryGetValue(rowKey, out (string TargetType, string TargetTitle, Guid _) entry);
                            }
                            <MudStack Row="true"
                                      Spacing="2"
                                      AlignItems="AlignItems.Center"
                                      Class="w-100">
                                <MudIcon Color="Color.Default"
                                         Icon="@BoardSectionVisuals.GetMudIconForTargetType(entry.TargetType)"
                                         Size="Size.Small"/>
                                <MudText Typo="Typo.body2" Class="flex-grow-1 text-truncate">@rowKey</MudText>
                            </MudStack>
                        </ItemTemplate>
                    </MudAutocomplete>
                </div>
                <div class="timer-focus-field" @onkeydown="OnFocusDurationKeyDown">
                    <MudStack Row="true"
                              Spacing="0"
                              AlignItems="AlignItems.Center"
                              Class="timer-focus-input-row">
                        <MudTextField T="string"
                                      @bind-Text="FocusDurationText"
                                      OnBlur="OnFocusDurationBlur"
                                      Label="Time's up after"
                                      Placeholder="e.g. 25, 1:20, 90s, 0:0:30"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="timer-focus-textfield w-100 flex-grow-1"
                                      Immediate="true"
                                      Error="@_focusDurationParseError"
                                      ErrorText="@_focusDurationErrorText"/>
                        <MudTooltip ShowOnHover="true"
                                    ShowOnClick="true"
                                    ShowOnFocus="true"
                                    Delay="100"
                                    Arrow="true"
                                    Placement="Placement.Top">
                            <ChildContent>
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Variant="Variant.Text"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Class="timer-focus-info-icon"
                                               aria-label="How time's up alert works"/>
                            </ChildContent>
                            <TooltipContent>
                                <MudText Typo="Typo.caption" Class="focus-duration-help-text">
                                    @FocusDurationInput.HelpTooltip
                                </MudText>
                            </TooltipContent>
                        </MudTooltip>
                    </MudStack>
                </div>
            </div>

            <div class="timer-compact__actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Class="timer-btn timer-btn--start"
                           OnClick="Start"
                           Size="Size.Small"
                           Disabled="@(!CanStart)">
                    Start
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Pause"
                           Class="timer-btn timer-btn--pause"
                           OnClick="Pause"
                           Size="Size.Small"
                           Disabled="@(!TimerService.IsRunning)">
                    Pause
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Stop"
                           Class="timer-btn timer-btn--stop"
                           OnClick="StopAndLog"
                           Size="Size.Small">
                    Stop &amp; log
                </MudButton>
            </div>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EventCallback<TimeSpan> OnLogSaved { get; set; }

    [Parameter] public IReadOnlyList<BoardItem> Habits { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Dailies { get; set; } = [];

    [Parameter] public IReadOnlyList<BoardItem> Todos { get; set; } = [];

    private PeriodicTimer? _uiTick;
    private CancellationTokenSource? _uiTickCts;
    private string _sessionTargetText = string.Empty;
    private bool _sessionTargetFieldInitialized;
    private (string? TargetId, string? TargetType, Guid? BoardItemId) _lastSyncedSessionTarget;
    private string _focusDurationText = string.Empty;

    private string FocusDurationText
    {
        get => _focusDurationText;
        set
        {
            var v = value ?? string.Empty;
            if (_focusDurationText == v)
            {
                return;
            }

            _focusDurationText = v;
            _focusDurationParseError = false;
            if (string.IsNullOrWhiteSpace(_focusDurationText))
            {
                TimerService.FocusAlertAfter = null;
            }
        }
    }

    private bool _focusDurationParseError;

    private string? _focusDurationErrorText =>
        _focusDurationParseError ? FocusDurationInput.ParseErrorHint : null;

    /// <summary>Session target (board item or custom label) is required before starting.</summary>
    private bool CanStart =>
        !TimerService.IsRunning
        && !TimerService.AwaitingFocusTimeUpPrompt
        && !string.IsNullOrWhiteSpace(TimerService.TargetId);

    private readonly List<string> _sessionTargetOptions = [];
    private readonly Dictionary<string, (string TargetType, string TargetTitle, Guid ItemId)> _sessionLabelToTarget = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        _uiTickCts = new CancellationTokenSource();
        _uiTick = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunUiTickAsync(_uiTickCts.Token);
    }

    protected override void OnParametersSet()
    {
        RebuildSessionTargetOptions();
        // Only sync the text box from TimerService when the *service* target changes. Otherwise every
        // MainBoard re-render (board refresh, remote update) overwrites the field while the user is
        // still typing a label that has not yet been committed to the service.
        var key = (TimerService.TargetId, TimerService.TargetType, TimerService.BoardItemId);
        if (!_sessionTargetFieldInitialized || key != _lastSyncedSessionTarget)
        {
            _lastSyncedSessionTarget = key;
            _sessionTargetFieldInitialized = true;
            _sessionTargetText = FormatTargetForField(TimerService);
        }

        SyncFocusDurationFromService();
    }

    private void SyncFocusDurationFromService()
    {
        _focusDurationText = FocusDurationInput.FormatForField(TimerService.FocusAlertAfter);
        _focusDurationParseError = false;
    }

    private void OnFocusDurationBlur()
    {
        ApplyFocusDurationFromText();
    }

    private void OnFocusDurationKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
        {
            ApplyFocusDurationFromText();
        }
    }

    private void ApplyFocusDurationFromText()
    {
        if (string.IsNullOrWhiteSpace(_focusDurationText))
        {
            TimerService.FocusAlertAfter = null;
            _focusDurationText = string.Empty;
            _focusDurationParseError = false;
            return;
        }

        if (!FocusDurationInput.TryParse(_focusDurationText, out var parsed)
            || parsed is null
            || parsed <= TimeSpan.Zero)
        {
            _focusDurationParseError = true;
            return;
        }

        _focusDurationParseError = false;
        TimerService.FocusAlertAfter = parsed;
        _focusDurationText = FocusDurationInput.FormatForField(parsed);
    }

    private async Task RunUiTickAsync(CancellationToken cancellationToken)
    {
        if (_uiTick is null)
        {
            return;
        }

        try
        {
            while (await _uiTick.WaitForNextTickAsync(cancellationToken))
            {
                if (TimerService.IsRunning && TimerService.TryConsumeFocusDurationReached())
                {
                    var label = string.IsNullOrEmpty(TimerService.TargetId) ? "Open session" : TimerService.TargetId;
                    var dur = FocusDurationInput.FormatForAlertLabel(TimerService.FocusAlertAfter!.Value);
                    var message = $"Time's up ({dur}) — {label}";
                    TimerService.PauseForFocusTimeUp();
                    // Do not await: show prompt without blocking the UI tick (display stays on the frozen time).
                    _ = InvokeAsync(async () => { await OnFocusDurationReachedAsync(message, dur, label, cancellationToken); });
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected during disposal.
        }
    }

    private void RebuildSessionTargetOptions()
    {
        _sessionLabelToTarget.Clear();
        _sessionTargetOptions.Clear();

        var all = new List<(BoardSection Section, BoardItem Item)>();
        foreach (var h in Habits)
        {
            all.Add((BoardSection.Habit, h));
        }

        foreach (var d in Dailies)
        {
            all.Add((BoardSection.Daily, d));
        }

        foreach (var t in Todos)
        {
            all.Add((BoardSection.Todo, t));
        }

        var groups = all
            .GroupBy(x => x.Item.Title, StringComparer.OrdinalIgnoreCase);

        foreach (var g in groups)
        {
            var disambiguate = g.Count() > 1;
            foreach (var (section, item) in g
                         .OrderBy(x => x.Section)
                         .ThenBy(x => x.Item.Id))
            {
                var st = section.ToString();
                var key = disambiguate
                    ? item.Title + " · " + item.Id.ToString("N")[..4]
                    : item.Title;
                if (_sessionLabelToTarget.ContainsKey(key))
                {
                    key = item.Title + " · " + item.Id.ToString("N");
                }

                _sessionLabelToTarget[key] = (st, item.Title, item.Id);
                _sessionTargetOptions.Add(key);
            }
        }
    }

    private string FormatTargetForField(GlobalTimerService timer)
    {
        if (string.IsNullOrEmpty(timer.TargetId))
        {
            return string.Empty;
        }

        if (timer.TargetType is "Session" or null)
        {
            return timer.TargetId;
        }

        if (timer.TargetType is "Habit" or "Daily" or "Todo")
        {
            foreach (var k in _sessionTargetOptions)
            {
                if (_sessionLabelToTarget.TryGetValue(
                        k,
                        out var m)
                    && m.TargetType == timer.TargetType
                    && m.TargetTitle == timer.TargetId
                    && (timer.BoardItemId is null || m.ItemId == timer.BoardItemId))
                {
                    return k;
                }
            }
        }

        return timer.TargetId;
    }

    private string GetTimerTargetLeadIcon()
    {
        if (string.IsNullOrEmpty(TimerService.TargetId))
        {
            return Icons.Material.Outlined.Label;
        }

        if (string.IsNullOrEmpty(TimerService.TargetType) || TimerService.TargetType == "Session")
        {
            return BoardSectionVisuals.GetMudIconForTargetType("Session");
        }

        return BoardSectionVisuals.GetMudIconForTargetType(TimerService.TargetType);
    }

    private string GetTimerTargetLeadTitle()
    {
        return string.IsNullOrEmpty(TimerService.TargetId)
            ? "No target"
            : TimerService.TargetType switch
            {
                "Habit" => "Habit",
                "Daily" => "Daily",
                "Todo" => "To-do",
                "Session" => "Session",
                _ => "Session"
            };
    }

    private Task<IEnumerable<string>> SearchSessionTargetsAsync(string value, CancellationToken cancellationToken)
    {
        return Task.FromResult(SearchSessionTargets(value));
    }

    private IEnumerable<string> SearchSessionTargets(string value)
    {
        if (_sessionTargetOptions.Count == 0)
        {
            return Array.Empty<string>();
        }

        var v = value.Trim();
        if (v.Length == 0)
        {
            return _sessionTargetOptions;
        }

        return _sessionTargetOptions.Where(s =>
        {
            if (s.Contains(v, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            return _sessionLabelToTarget.TryGetValue(s, out var row)
                   && row.TargetTitle.Contains(v, StringComparison.OrdinalIgnoreCase);
        });
    }

    private void OnSessionTargetValueChanged(string? value)
    {
        var text = value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(text))
        {
            TimerService.SetManualTarget(null);
        }
        else if (_sessionLabelToTarget.TryGetValue(text, out var mapped))
        {
            TimerService.SelectTarget(mapped.TargetType, mapped.TargetTitle, mapped.ItemId);
        }
        else
        {
            TimerService.SetManualTarget(text);
        }

        _sessionTargetText = FormatTargetForField(TimerService);
        _lastSyncedSessionTarget = (TimerService.TargetId, TimerService.TargetType, TimerService.BoardItemId);
        _sessionTargetFieldInitialized = true;
    }

    private void Start()
    {
        if (!CanStart)
        {
            return;
        }

        TimerService.Start();
    }

    private void Pause()
    {
        TimerService.Pause();
    }

    /// <summary>
    ///     The timer is already paused at the milestone. Logging only if the user confirms; "not done" resumes counting.
    /// </summary>
    private async Task OnFocusDurationReachedAsync(
        string notifyMessage,
        string durationLabel,
        string targetLabel,
        CancellationToken cancellationToken)
    {
        try
        {
            await FocusClientAlerts.NotifyTimeUpAsync("Time's up", notifyMessage, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        try
        {
            await UserNotifier.NotifyFocusTimerEndAsync(notifyMessage, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        bool? confirmed;
        try
        {
            confirmed = await DialogService.ShowMessageBoxAsync(
                "Time's up",
                "(" + durationLabel + ") is up for \"" + targetLabel + "\". "
                + "The timer is paused. If you actually finished, log this session and update the board. "
                + "If you are not done yet, choose Not done — the timer will continue from this time.",
                "Yes, log session",
                "Not done");
        }
        catch (Exception)
        {
            await UserNotifier.NotifyAsync(
                "Time's up — open the timer panel to log your session, or use Stop & log.",
                Severity.Info,
                cancellationToken);
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        if (confirmed != true)
        {
            TimerService.ResumeAfterFocusPromptNotDone();
            return;
        }

        var elapsed = TimerService.Stop();
        if (elapsed > TimeSpan.Zero)
        {
            await OnLogSaved.InvokeAsync(elapsed);
        }
    }

    private async Task StopAndLog()
    {
        var elapsed = TimerService.Stop();
        if (elapsed > TimeSpan.Zero)
        {
            await OnLogSaved.InvokeAsync(elapsed);
        }
    }

    public void Dispose()
    {
        _uiTickCts?.Cancel();
        _uiTick?.Dispose();
        _uiTickCts?.Dispose();
    }

}