@page "/settings"
@using global::App.Shared.RCL.Services
@inject IApiSession Session
@inject IAppUpdaterService UpdaterService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>@PageTitles.Page("Settings")</PageTitle>

<div class="settings-page-wrapper">

    <SettingsSectionSwitcher @bind-ActiveIndex="_settingsIndex"/>

<div class="settings-section-content">
    @if (_settingsIndex == 0)
    {
        <UserPreferencesSection ShowTitle="false"/>
    }
    else if (_settingsIndex == 1)
    {
        <NotificationSettingsSection ShowTitle="false"/>
    }
    else
    {
        <MudPaper Class="pa-4 mb-3" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">Account</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1 d-block">
                    Signed in as <strong>@Session.Email</strong>
                </MudText>
                <SyncStatusIndicator IconOnly="false" />
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="mt-2" OnClick="LogoutAsync">
                    Log out
                </MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mb-3" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Class="mb-1">App Updates</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Check for new releases and update the application.
                </MudText>

                <div class="d-flex align-center justify-space-between">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Current version</MudText>
                        <MudText Typo="Typo.body2" Class="font-weight-bold">v@_currentVersion</MudText>
                    </div>

                    @if (UpdaterService.IsSupported)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="CheckForUpdatesAsync"
                                   Disabled="@_isChecking"
                                   StartIcon="@Icons.Material.Filled.SystemUpdate">
                            @if (_isChecking)
                            {
                                <span class="mr-2">Checking...</span>
                                <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <span>Check for updates</span>
                            }
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Managed by platform
                        </MudText>
                    }
                </div>
            </MudStack>
        </MudPaper>

        <AccountActionsSection ShowTitle="false" OnAccountDeleted="LogoutAsync"/>
    }
</div>
</div>

@code {
    private int _settingsIndex;
    private string _currentVersion = "1.0.0";
    private bool _isChecking;

    protected override void OnInitialized()
    {
        try
        {
            _currentVersion = Microsoft.Maui.ApplicationModel.AppInfo.Current.VersionString;
        }
        catch
        {
            // Fallback for Web/tests
        }
    }

    private async Task LogoutAsync()
    {
        // Go to the welcome page first so the main layout's session-change guard sees a
        // public path. Clearing the session here fires the guard while the current path is still
        // /settings, which would redirect to the sign-in page instead of the welcome page.
        Nav.NavigateTo("/");
        await Session.ClearSessionAsync();
    }

    private async Task CheckForUpdatesAsync()
    {
        _isChecking = true;

        var result = await UpdaterService.CheckForUpdateAsync();

        _isChecking = false;

        if (!string.IsNullOrEmpty(result.ErrorMessage))
        {
            AppSnackbar.AddMessage(Snackbar, result.ErrorMessage, 6_000, Severity.Error);
            return;
        }

        if (result.UpdateAvailable)
        {
            await UpdateDialogHelper.ShowUpdateDialogAsync(
                DialogService,
                result.LatestVersion,
                result.ReleaseNotes,
                result.DownloadUrl);
        }
        else
        {
            AppSnackbar.AddMessage(Snackbar, "Habitinator is up to date!", 6_000, Severity.Success);
        }
    }
}
