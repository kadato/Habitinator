@page "/stats"

<PageMeta Title="@PageTitles.Page("Statistics")"
          Description="Activity heatmap, focus time, and productivity statistics."
          CanonicalPath="/stats"/>

<AuthorizeView>
    <NotAuthorized>
        <SignInPrompt Title="Statistics" Message="Sign in to see your activity and focus time."/>
    </NotAuthorized>
    <Authorized>
        <div class="stats-page-wrapper">
            <StatisticsPanel/>
            <StatisticsPageScripts/>
        </div>
    </Authorized>
</AuthorizeView>
