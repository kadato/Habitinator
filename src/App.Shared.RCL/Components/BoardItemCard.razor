<div class="@CardClass">
    @if (Section == BoardSection.Habit)
    {
        <div class="board-card__habit-btns board-card__left">
            @if (Item.TrackPlus)
            {
                <button type="button" class="board-sq board-sq--good" title="Log +" draggable="false" @onclick="OnHabitUp" @onclick:stopPropagation="true">
                    <svg class="board-habit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
            }
            @if (Item.TrackMinus)
            {
                <button type="button" class="board-sq board-sq--bad" title="Log −" draggable="false" @onclick="OnHabitDown" @onclick:stopPropagation="true">
                    <svg class="board-habit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
            }
        </div>
    }
    else
    {
        <div class="board-card__check-col board-card__left">
            <button type="button"
                    class="board-check @CheckClass"
                    title="Toggle"
                    draggable="false"
                    @onclick="OnToggle"
                    @onclick:stopPropagation="true"
                    @attributes="CheckButtonAttributes"
                    role="checkbox">
                @if (Item.IsCompleted)
                {
                    <svg class="board-check-glyph"
                         viewBox="0 0 24 24"
                         width="14"
                         height="14"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">
                        <path d="M5 12l5 5L19 5"
                              stroke="currentColor"
                              stroke-width="2.6"
                              stroke-linecap="round"
                              stroke-linejoin="round"/>
                    </svg>
                }
            </button>
        </div>
    }
    <div class="board-card__head">
        <div class="board-card__title" role="button" tabindex="0" @onclick="OnOpenEditor" @onkeydown="OnTitleKeyDown">
            <span class="board-card__title-text">@Item.Title</span>
        </div>
        <div class="board-card__head-actions">
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Dense="true">
                <ActivatorContent Context="itemMenu">
                    <span @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                                       Size="Size.Small"
                                       Class="ma-0 board-card__delete"
                                       title="Options"
                                       OnClick="@(e => itemMenu.ToggleAsync(e))"/>
                    </span>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem OnClick="OnOpenEditor">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"/>
                            <MudText Typo="Typo.body2">Edit</MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem OnClick="OnMoveToTop" Disabled="@(!CanReorder)">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"/>
                            <MudText Typo="Typo.body2">Move to Top</MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem OnClick="OnMoveToBottom" Disabled="@(!CanReorder)">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"/>
                            <MudText Typo="Typo.body2">Move to Bottom</MudText>
                        </div>
                    </MudMenuItem>
                    <MudMenuItem OnClick="OnDelete">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.DeleteOutline" Size="Size.Small" Color="Color.Error"/>
                            <MudText Typo="Typo.body2" Color="Color.Error">Delete</MudText>
                        </div>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </div>
    </div>
    @if (HasBodyExtra)
    {
        <div class="board-card__extra">
            @if (TagsList.Count > 0)
            {
                <div class="board-card__tags">
                    @if (TagsList.Count <= 3)
                    {
                        @foreach (var tag in TagsList)
                        {
                            <span class="board-card__tag-badge" style="@TagBadgeStyle(tag)" title="@tag">
                                <span class="board-card__tag-badge__text">@tag</span>
                            </span>
                        }
                    }
                    else
                    {
                        @foreach (var tag in TagsList.Take(2))
                        {
                            <span class="board-card__tag-badge" style="@TagBadgeStyle(tag)" title="@tag">
                                <span class="board-card__tag-badge__text">@tag</span>
                            </span>
                        }
                        <span class="board-card__tag-badge board-card__tag-badge--more" title='@(string.Join(", ", TagsList.Skip(2)))'>+@(TagsList.Count - 2)</span>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Notes))
            {
                <MudText Typo="Typo.caption" Class="board-card__notes" Color="Color.Secondary">@Item.Notes</MudText>
            }
            @if (SubTotal > 0)
            {
                <button type="button"
                        class="board-subtask-pill"
                        @onclick="ToggleSubtasksExpand"
                        @onclick:stopPropagation="true"
                        @attributes="SubtasksToggleAttributes"
                        aria-label="@($"Subtasks: {SubDone} completed out of {SubTotal}")">
                    <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="me-1" aria-hidden="true"/>
                    <span class="board-subtask-pill__count">@SubDone / @SubTotal</span>
                    <MudIcon Icon="@(_subtasksExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Class="ms-1" aria-hidden="true"/>
                </button>
            }
            @if (SubTotal > 0 && _subtasksExpanded)
            {
                <ul class="board-subtask-list">
                    @foreach (var line in Checklist)
                    {
                        <li class="board-subtask-list__row" @key="line.Id">
                            <MudCheckBox T="bool"
                                         Value="line.IsDone"
                                         ValueChanged="@(v => OnSetChecklistItemDone.InvokeAsync((line.Id, v)))"
                                         Label="@line.Text"
                                         Class="ma-0 board-subtask-cb"
                                         Color="Color.Secondary"
                                         Dense="true"/>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    @if (ShouldShowItemFooter(Section, Item))
    {
        <div class="board-card__foot">
            <div class="board-card__foot-left">
                @if (Section == BoardSection.Todo && Item.TodoDueDate is { } due)
                {
                    <div class="@TodoDueCssClass(due)">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="me-1" Size="Size.Small"/>
                        <span class="board-todo-due__date">@DateFormatService.Format(due)</span>
                        <span class="board-todo-due__sep" aria-hidden="true">·</span>
                        <span class="board-todo-due__relative">@TodoDueRelativeLabel(due)</span>
                    </div>
                }
                @if (Section == BoardSection.Habit)
                {
                    <div class="board-habit-counters" title="@HabitCounterTitle()">
                        @if (Item.TrackPlus)
                        {
                            <span class="board-habit-badge board-habit-badge--plus" title="Positive logs">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                @Item.Counter
                            </span>
                        }
                        @if (Item.TrackMinus)
                        {
                            <span class="board-habit-badge board-habit-badge--minus" title="Negative logs">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="me-1"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                @Item.NegativeCounter
                            </span>
                        }
                        @if (Item.ResetPeriod != HabitResetPeriod.Daily)
                        {
                            <span class="board-habit-badge board-habit-badge--period" title="Counter reset period">@ResetPeriodLabel</span>
                        }
                    </div>
                }
            </div>
            <div class="board-card__foot-right">
                @if (Section == BoardSection.Daily)
                {
                    @if (Item.Counter > 0)
                    {
                        <div class="board-streak board-streak--active" title="Daily streak: @Item.Counter days">
                            <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" Class="me-1 streak-flame-icon"/>
                            <span class="board-streak__text">@Item.Counter</span>
                        </div>
                    }
                    else
                    {
                        <div class="board-streak board-streak--inactive" title="No current streak">
                            <MudIcon Icon="@Icons.Material.Outlined.Whatshot" Size="Size.Small" Class="me-1 streak-flame-icon-inactive"/>
                            <span class="board-streak__text">0</span>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>
