@page "/auth/forgot-password"
@using global::App.Shared.RCL.Models
@inject ApiAuthService Auth
@inject NavigationManager Nav

<PageTitle>@PageTitles.Page("Forgot password")</PageTitle>

<AuthPageShell Title="Forgot password"
               Subtitle="Enter your email. If an account exists, the server sends a reset link."
               MaxWidth="28rem">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@(_hasError ? "alert alert-danger" : "alert alert-info")" role="alert">@_message</div>
        }

        <div class="mb-3">
            <label for="email">Email</label>
            <input class="form-control" id="email" type="email" autocomplete="email"
                   value="@_email" @oninput="OnEmailInput" disabled="@_busy" />
        </div>
        <div class="auth-form-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="_busy"
                       OnClick="SubmitAsync">
                Send reset link
            </MudButton>
        </div>
    </ChildContent>
    <Footer>
        <a href="/auth/login">Back to sign in</a>
    </Footer>
</AuthPageShell>

@code {
    private string _email = string.Empty;
    private string? _message;
    private bool _hasError;
    private bool _busy;

    private void OnEmailInput(ChangeEventArgs e) => _email = e.Value?.ToString() ?? string.Empty;

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            await Auth.ForgotPasswordAsync(_email);
            _message = "If an account exists for this email, the server sent a reset link.";
            _hasError = false;
        }
        finally
        {
            _busy = false;
        }
    }
}
