@inject IBoardSyncStatus BoardSync
@inject IUserNotifier UserNotifier
@inject INotificationSettingsService SettingsService
@implements IDisposable

@code {
    // Sync status is now surfaced only via the minimal SyncStatusIndicator.
    // Toast spam for transient offline or sync problem states is suppressed to keep the
    // app calm when the server is unreachable. The indicator shows the small dot,
    // toasts are reserved for explicit user actions and real errors.
    private NotificationSettings? _settings;

    protected override async Task OnInitializedAsync()
    {
        BoardSync.Changed += OnBoardSyncChanged;
        SettingsService.Changed += OnSettingsChanged;
        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch
        {
            _settings = null;
        }
    }

    private void OnSettingsChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSettingsAsync();
            StateHasChanged();
        });
    }

    private void OnBoardSyncChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(HandleSyncStatusChangeAsync);
    }

    private async Task HandleSyncStatusChangeAsync()
    {
        if (_settings is null)
        {
            await LoadSettingsAsync();
        }

        // No toasts are emitted here. The small SyncStatusIndicator dot is the single source
        // of truth for sync health, and it never shows a false resolved state.
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        BoardSync.Changed -= OnBoardSyncChanged;
        SettingsService.Changed -= OnSettingsChanged;
    }
}
