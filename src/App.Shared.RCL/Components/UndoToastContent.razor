<div class="undo-toast-body"
     @onclick="HandleDismiss"
     @onclick:stopPropagation="true"
     @onkeydown="HandleKeyDown"
     role="button"
     tabindex="0"
     aria-label="Dismiss notification">
    <span class="undo-toast-message">@Description</span>
    <button class="undo-toast-btn" @onclick="HandleUndo" @onclick:stopPropagation="true">
        Undo
    </button>
</div>

@code {
    [Parameter] public string Description { get; set; } = string.Empty;

    /// <summary>Invoked when the Undo button is clicked.</summary>
    [Parameter] public Func<Task>? OnUndo { get; set; }

    /// <summary>Invoked when the card body is clicked (dismiss).</summary>
    [Parameter] public Func<Task>? OnDismiss { get; set; }

    private async Task HandleUndo()
    {
        if (OnUndo is not null)
            await OnUndo();
    }

    private async Task HandleDismiss()
    {
        if (OnDismiss is not null)
            await OnDismiss();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            await HandleDismiss();
        }
    }
}
