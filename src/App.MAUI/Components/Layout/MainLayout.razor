@inherits LayoutComponentBase
@using global::App.Shared.RCL.Themes

<MudThemeProvider Theme="@HabitinatorMudTheme.Default" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer"
                       aria-label="Open navigation" />
        <MudText Typo="Typo.h6" Class="ml-1">Habitinator</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mud-opacity-60 d-none d-sm-block">Blazor Hybrid Android Host</MudText>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen"
               Class="app-nav-drawer"
               Width="200px"
               Elevation="1"
               Variant="@DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="py-4 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
