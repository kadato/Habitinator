@inherits AutosaveEditDialogBase<EditHabitDialogResult>

<MudDialog Class="edit-daily-dialog hab-modal-dialog"
           ContentClass="edit-daily-dialog__content"
           Style="width: min(26rem, calc(100vw - 1rem));">
<DialogContent>
<div class="hab-modal hab-modal--habit edit-daily-shell edit-daily-shell--habit" @onclick="OnShellClick">
    <EditDialogHeader TitleText="Edit habit"
                      TitlePlaceholder="Habit title"
                      @bind-Title="_title"
                      @bind-Title:after="OnTitleEdited"
                      @bind-Notes="_notes"
                      @bind-Notes:after="OnNotesEdited"
                      OnClose="CloseAsync"
                      SaveStatus="SaveStatus"
                      Section="BoardSection.Habit"/>

    <div class="hab-modal__body edit-daily-body">
        <div class="hab-checklist">
            <div class="hab-checklist__head">
                <span class="hab-checklist__head-title">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Checklist
                </span>
                @if (_checklistRows.Count > 0)
                {
                    <span class="hab-checklist__count">@_checklistRows.Count(x => x.IsDone) / @_checklistRows.Count</span>
                }
            </div>
            <div class="hab-checklist__list">
                <ChecklistEditor @bind-Value="_checklistRows"
                                 @bind-Value:after="OnChecklistEdited"/>
            </div>
        </div>

        <div class="hab-modal__section">
            <span class="hab-modal__section-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 12h8"></path><path d="M12 8v8"></path></svg>
                Track which counters
            </span>
            <div class="habit-track">
                <button type="button"
                        class="habit-track__option @(_trackPlus ? "habit-track__option--on-good" : string.Empty)"
                        @onclick="ToggleTrackPlus"
                        @attributes="PlusAria">
                    <span class="habit-track__circle habit-track__circle--good">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="habit-track__label">Plus</span>
                </button>
                <button type="button"
                        class="habit-track__option @(_trackMinus ? "habit-track__option--on-bad" : string.Empty)"
                        @onclick="ToggleTrackMinus"
                        @attributes="MinusAria">
                    <span class="habit-track__circle habit-track__circle--bad">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </span>
                    <span class="habit-track__label">Minus</span>
                </button>
            </div>
            <span style="font-size:0.72rem; color:var(--mud-palette-text-secondary); margin-top:0.1rem;">At least one counter stays on. Counters appear as board badges.</span>
        </div>

        <div class="hab-modal__section">
            <span class="hab-modal__section-label">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                Tags
            </span>
            <TagPicker @bind-Tags="_tags"
                       @bind-Tags:after="OnTagsEdited"
                       TriggerId="edit-habit-tags-trigger" @ref="_tagPicker"/>
        </div>

        <div class="hab-modal__section hab-modal__section--plain">
            <MudText Typo="Typo.caption" Class="edit-daily-label-body" Style="margin-bottom:0.35rem;">Reset counter</MudText>
            <MudSelect T="HabitResetPeriod"
                       @bind-Value="_resetPeriod"
                       @bind-Value:after="OnDiscreteEdited"
                       Variant="Variant.Outlined"
                       Class="hab-modal__field edit-habit-select"
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomLeft"
                       TransformOrigin="Origin.TopLeft"
                       Dense="true">
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Daily">Daily</MudSelectItem>
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Weekly">Weekly</MudSelectItem>
                <MudSelectItem T="HabitResetPeriod" Value="HabitResetPeriod.Monthly">Monthly</MudSelectItem>
            </MudSelect>
        </div>

        <div class="hab-advanced @(_advancedOpen ? "hab-advanced--open" : string.Empty)">
            <button type="button" class="hab-advanced__trigger" @onclick="() => _advancedOpen = !_advancedOpen">
                <span>Advanced tuning</span>
                <svg class="hab-advanced__chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            @if (_advancedOpen)
            {
                <div class="hab-advanced__body">
                    <span style="font-size:0.78rem; color:var(--mud-palette-text-secondary);">Adjust logged totals. Values are stored as mono badges.</span>
                    <div style="display:flex; flex-direction:column; gap:0.7rem;">
                        <span class="edit-daily-label-body" style="margin:0;">Adjust + count</span>
                        <div class="counter-adjust">
                            <button type="button" class="counter-adjust__btn counter-adjust__btn--bad" aria-label="Decrease + count" @onclick="DecrementPlusLocal" disabled="@(_counter < 1)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </button>
                            <MudNumericField @bind-Value="_counter" @bind-Value:after="OnCounterEdited" Variant="Variant.Outlined" Class="counter-adjust__field" Min="0" HideSpinButtons="true" Margin="Margin.Dense"/>
                            <button type="button" class="counter-adjust__btn counter-adjust__btn--good" aria-label="Increase + count" @onclick="IncrementPlusLocal">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </button>
                        </div>
                        <span class="edit-daily-label-body" style="margin:0;">Adjust − count</span>
                        <div class="counter-adjust">
                            <button type="button" class="counter-adjust__btn counter-adjust__btn--bad" aria-label="Decrease − count" @onclick="DecrementMinusLocal" disabled="@(_negativeCounter < 1)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </button>
                            <MudNumericField @bind-Value="_negativeCounter" @bind-Value:after="OnCounterEdited" Variant="Variant.Outlined" Class="counter-adjust__field" Min="0" HideSpinButtons="true" Margin="Margin.Dense"/>
                            <button type="button" class="counter-adjust__btn counter-adjust__btn--good" aria-label="Increase − count" @onclick="IncrementMinusLocal">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <EditDialogFooterActions OnArchive="ArchiveAsync" OnDelete="DeleteAsync"/>
    </div>
</div>
</DialogContent>
</MudDialog>

@code {
    [Parameter] [EditorRequired] public required BoardItem Item { get; set; }

    private string _title = string.Empty;
    private string? _notes;
    private string _tags = string.Empty;
    private TagPicker? _tagPicker;
    private bool _trackPlus = true;
    private bool _trackMinus = true;
    private HabitResetPeriod _resetPeriod = HabitResetPeriod.Daily;
    private int _counter;
    private int _negativeCounter;
    private bool _advancedOpen;

    private List<ChecklistRow> _checklistRows = [];

    protected override string BatchDescription => $"Edit \"{Item.Title}\"";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _title = Item.Title;
        _notes = Item.Notes;
        _tags = EditDialogHelpers.FormatTags(Item.Tags);
        _trackPlus = Item.TrackPlus;
        _trackMinus = Item.TrackMinus;
        _resetPeriod = Item.ResetPeriod;
        _counter = Item.Counter;
        _negativeCounter = Item.NegativeCounter;
        _checklistRows = EditDialogHelpers.ParseChecklistRows(Item.ChecklistJson);
    }

    private void OnShellClick() => _tagPicker?.Dismiss();
    private void OnTitleEdited() => ScheduleSave();
    private void OnNotesEdited() => ScheduleSave();
    private Task OnTagsEdited() => SaveNowAsync();
    private void OnChecklistEdited() => ScheduleSave(300);
    private void OnDiscreteEdited() => _ = SaveNowAsync();
    private void OnCounterEdited() => ScheduleSave(400);

    private void ToggleTrackPlus()
    {
        _trackPlus = !_trackPlus;
        if (!_trackPlus && !_trackMinus) _trackMinus = true;
        _ = SaveNowAsync();
    }
    private void ToggleTrackMinus()
    {
        _trackMinus = !_trackMinus;
        if (!_trackPlus && !_trackMinus) _trackPlus = true;
        _ = SaveNowAsync();
    }

    protected override async Task SaveValuesAsync(CancellationToken cancellationToken = default)
    {
        var title = string.IsNullOrWhiteSpace(_title) ? Item.Title : _title.Trim();
        var tagsPayload = EditDialogHelpers.CleanStringPayload(_tags);
        var checklistPayload = EditDialogHelpers.SerializeChecklistRows(_checklistRows);
        await BoardData.UpdateHabitAsync(Item.Id, new UpdateHabitArgs(title, EditDialogHelpers.CleanStringPayload(_notes), tagsPayload, _trackPlus, _trackMinus, _resetPeriod, _counter, _negativeCounter, checklistPayload), cancellationToken);
    }

    protected override EditHabitDialogResult BuildResult(EditDialogAction action)
    {
        return new EditHabitDialogResult(action, _title.Trim(), EditDialogHelpers.CleanStringPayload(_notes), EditDialogHelpers.CleanStringPayload(_tags), _trackPlus, _trackMinus, _resetPeriod, _counter, _negativeCounter, EditDialogHelpers.SerializeChecklistRows(_checklistRows));
    }

    private void IncrementPlusLocal()
    {
        _counter++;
        _ = SaveNowAsync();
    }

    private void DecrementPlusLocal()
    {
        if (_counter > 0)
        {
            _counter--;
        }

        _ = SaveNowAsync();
    }

    private void IncrementMinusLocal()
    {
        _negativeCounter++;
        _ = SaveNowAsync();
    }

    private void DecrementMinusLocal()
    {
        if (_negativeCounter > 0)
        {
            _negativeCounter--;
        }

        _ = SaveNowAsync();
    }
    private void ArchiveAsync() => CloseWithAction(EditDialogAction.Archive);
    private void DeleteAsync() => CloseWithAction(EditDialogAction.Delete);
    private Dictionary<string, object> PlusAria => new() { { "aria-pressed", _trackPlus ? "true" : "false" } };
    private Dictionary<string, object> MinusAria => new() { { "aria-pressed", _trackMinus ? "true" : "false" } };
}
