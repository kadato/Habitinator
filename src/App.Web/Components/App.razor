@using Microsoft.AspNetCore.Components.Web
@using global::App.Web.Client
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <SiteHead/>
    <script>
        (function () {
            try {
                const stored = localStorage.getItem('user_preferences_v1');
                let isDark = false;
                if (stored) {
                    const prefs = JSON.parse(stored);
                    if (prefs && typeof prefs.theme === 'number') {
                        if (prefs.theme === 2) {
                            isDark = true;
                        } else if (prefs.theme === 0) {
                            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        }
                    }
                } else {
                    isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                }

                const root = document.documentElement;
                if (isDark) {
                    root.classList.add('dark-theme');
                    root.classList.remove('light-theme');
                    root.style.colorScheme = 'dark';
                } else {
                    root.classList.add('light-theme');
                    root.classList.remove('dark-theme');
                    root.style.colorScheme = 'light';
                }
            } catch (e) {
                console.error(e);
            }
        })();
    </script>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="_content/App.Shared.RCL/fonts/PlusJakartaSans-Bold.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_framework/blazor.web.js"]" as="script" crossorigin="anonymous"/>
    <link rel="preload" href="@Assets["_content/MudBlazor/MudBlazor.min.js"]" as="script" crossorigin="anonymous"/>

    <style>
        :root {
            --hab-bg-light: #f8fafc;
            --hab-bg-dark: #0b0f19;
        }
        html, body {
            background-color: var(--hab-bg-light);
        }
        html.dark-theme, html.dark-theme body {
            background-color: var(--hab-bg-dark);
        }
        @@media (prefers-color-scheme: dark) {
            html:not(.light-theme), html:not(.light-theme) body {
                background-color: var(--hab-bg-dark);
            }
        }
    </style>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.css"]"/>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]"/>
    <link rel="stylesheet" href="_content/App.Shared.RCL/css/typography.css"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="_content/App.Shared.RCL/css/auth-pages.css"/>
    <link rel="stylesheet" href="@Assets["App.Web.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" href="/favicon.ico" sizes="any"/>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/manifest.webmanifest"/>
    @* Fallback until the interactive circuit updates head; must match Routes render mode. *@
    <title>@SeoDefaults.DefaultTitle</title>
    <HeadOutlet @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: true))"/>
</head>

<body>
<div id="habitinator-splash-screen" style="position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 10000; background-color: var(--hab-bg-light); transition: opacity 0.2s ease, visibility 0.2s ease;">
    <style>
        .hab-splash-content {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1.25rem;
        }
        .hab-splash-logo {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            font-size: 2.25rem;
            font-weight: 700;
            color: #3b82f6;
            letter-spacing: -0.02em;
            animation: habPulse 1.8s infinite ease-in-out;
        }
        .hab-splash-spinner {
            width: 2.25rem;
            height: 2.25rem;
            border: 3px solid color-mix(in srgb, var(--hab-bg-light) 90%, var(--hab-bg-dark));
            border-top-color: #3b82f6;
            border-radius: 50%;
            animation: habSpin 0.8s linear infinite;
        }
        @@keyframes habPulse {
            0%, 100% { opacity: 0.6; transform: scale(0.97); }
            50% { opacity: 1; transform: scale(1.0); }
        }
        @@keyframes habSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @@media (prefers-color-scheme: dark) {
            html:not(.light-theme) #habitinator-splash-screen {
                background-color: var(--hab-bg-dark) !important;
            }
            html:not(.light-theme) .hab-splash-spinner {
                border-color: color-mix(in srgb, var(--hab-bg-dark) 90%, var(--hab-bg-light)) !important;
                border-top-color: #3b82f6 !important;
            }
        }
        html.dark-theme #habitinator-splash-screen {
            background-color: var(--hab-bg-dark) !important;
        }
        html.dark-theme .hab-splash-spinner {
            border-color: color-mix(in srgb, var(--hab-bg-dark) 90%, var(--hab-bg-light)) !important;
            border-top-color: #3b82f6 !important;
        }
    </style>
    <div class="hab-splash-content">
        <div class="hab-splash-logo">Habitinator</div>
        <div class="hab-splash-spinner"></div>
    </div>
</div>

<CascadingAuthenticationState>
    <Routes/>
</CascadingAuthenticationState>
<ReconnectModal/>
<script src="_content/App.Shared.RCL/js/scriptLoader.js" defer></script>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]" defer crossorigin="anonymous"></script>
<script src="@Assets["_framework/blazor.web.js"]" defer crossorigin="anonymous"></script>
<script>
    window.habitinatorRemoveSplash = function () {
        const el = document.getElementById('habitinator-splash-screen');
        if (el) {
            el.style.opacity = '0';
            setTimeout(() => el.remove(), 250);
        }
    };
</script>
</body>

</html>
