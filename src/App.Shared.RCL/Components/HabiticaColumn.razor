@using System.Globalization
@using App.Shared.RCL.Components.Dialogs
@inject GlobalTimerService TimerService
@inject IBoardDataService BoardData
@inject IDialogService DialogService
@inject IUserNotifier Notifier
@inject IUserTimeZoneService TimeZoneService
@inject IUserDateFormatService DateFormatService
@inject IUndoService UndoService

<MudCard Class="@($"habitica-column {GetAccentClass()}")" Elevation="0" Outlined="false">
    <MudCardHeader Class="pb-2">
        <CardHeaderContent>
            <MudStack Spacing="1">
                <div class="habitica-column-header-flex">
                    <div class="habitica-column-header-left habitica-column-header-row">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="habitica-title-stack">
                            <MudIcon Icon="@BoardSectionVisuals.GetMudIcon(Section)"
                                     Class="habitica-col-type-icon"
                                     Size="Size.Small"
                                     Color="Color.Primary"/>
                            <MudText Typo="Typo.subtitle1" Class="habitica-title">@GetTitle()</MudText>
                            <MudChip T="string"
                                     Text="@VisibleItems().Count.ToString()"
                                     Class="habitica-count-chip ms-1"
                                     Color="Color.Secondary"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"/>
                        </MudStack>
                    </div>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap habitica-filter-toolbar" role="toolbar">
                        @if (Section == BoardSection.Habit)
                        {
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.All)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _habitFilter = HabitListFilter.All; })">
                                All
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.Weak)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _habitFilter = HabitListFilter.Weak; })">
                                Weak
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_habitFilter == HabitListFilter.Strong)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _habitFilter = HabitListFilter.Strong; })">
                                Strong
                            </MudButton>
                        }
                        else if (Section == BoardSection.Daily)
                        {
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.All)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _dailyFilter = DailyListFilter.All; })">
                                All
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.Due)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _dailyFilter = DailyListFilter.Due; })">
                                Due
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_dailyFilter == DailyListFilter.NotDue)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _dailyFilter = DailyListFilter.NotDue; })">
                                Not due
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Active)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _todoFilter = TodoListFilter.Active; })">
                                Active
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Scheduled)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _todoFilter = TodoListFilter.Scheduled; })">
                                Scheduled
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Class="habitica-filter-btn"
                                       Variant="@FilterVariant(_todoFilter == TodoListFilter.Complete)"
                                       Color="Color.Primary"
                                       OnClick="@(() => { _todoFilter = TodoListFilter.Complete; })">
                                Complete
                            </MudButton>
                        }
                    </MudStack>
                </div>
                @if (Section == BoardSection.Todo
                     && _todoFilter == TodoListFilter.Complete
                     && VisibleItems().Count > 0)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Class="align-self-start"
                               OnClick="DeleteAllCompletedTodosAsync">
                        Delete all completed
                    </MudButton>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent Class="pt-0">
        <div @onkeydown="OnDraftKeyAsync" class="habitica-add-wrap">
            <MudTextField @bind-Value="_draft"
                          Class="habitica-add-field"
                          Placeholder="@GetAddPlaceholder()"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Add"
                          OnAdornmentClick="AddFromDraftAsync"
                          Immediate="true"/>
        </div>

        <div class="habitica-list mt-2">
            @{
                var visibleItems = VisibleItems();
                var canReorder = IsItemDraggable();

                RenderFragment<BoardItem> itemCard = item =>
                {
                    var checklist = DailyChecklistJson.Parse(item.ChecklistJson);
                    var subDone = checklist.Count(x => x.IsDone);
                    var subTotal = checklist.Count;
                    var tagsList = BoardTagUtil.ParseTags(item.Tags).ToList();
                    var hasBodyExtra = !string.IsNullOrWhiteSpace(item.Notes) || subTotal > 0 || tagsList.Count > 0;
                    return @<div @key="item.Id" class="@GetCardClass(item)">
                        @if (Section == BoardSection.Habit)
                        {
                            <div class="habitica-card__habit-btns habitica-card__left">
                                @if (item.TrackPlus)
                                {
                                    <button type="button" class="habitica-sq habitica-sq--good" title="Log +" draggable="false" @onclick="@(() => HabitUpAsync(item))" @onclick:stopPropagation="true">+</button>
                                }
                                else
                                {
                                    <span class="habitica-sq-spacer" aria-hidden="true"></span>
                                }
                                @if (item.TrackMinus)
                                {
                                    <button type="button" class="habitica-sq habitica-sq--bad" title="Log −" draggable="false" @onclick="@(() => HabitDownAsync(item))" @onclick:stopPropagation="true">−</button>
                                }
                                else
                                {
                                    <span class="habitica-sq-spacer" aria-hidden="true"></span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="habitica-card__check-col habitica-card__left">
                                <button type="button"
                                        class="habitica-check @GetCheckClass(item)"
                                        title="Toggle"
                                        draggable="false"
                                        @onclick="@(() => ToggleAsync(item))"
                                        @onclick:stopPropagation="true"
                                        aria-pressed="@(item.IsCompleted ? "true" : "false")"
                                        aria-checked="@(item.IsCompleted ? "true" : "false")"
                                        role="checkbox">
                                    @if (item.IsCompleted)
                                    {
                                        <svg class="habitica-check-glyph"
                                             viewBox="0 0 24 24"
                                             width="14"
                                             height="14"
                                             fill="none"
                                             xmlns="http://www.w3.org/2000/svg"
                                             aria-hidden="true">
                                            <path d="M5 12l5 5L19 5"
                                                  stroke="currentColor"
                                                  stroke-width="2.6"
                                                  stroke-linecap="round"
                                                  stroke-linejoin="round"/>
                                        </svg>
                                    }
                                </button>
                            </div>
                        }
                        <div class="habitica-card__head">
                            <div class="habitica-card__title" draggable="false" @onclick="@(() => OpenItemEditorAsync(item))">
                                <span class="habitica-card__title-text">@item.Title</span>
                            </div>
                            <div class="habitica-card__head-actions">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               title="Delete"
                                               Class="ma-0 habitica-card__delete"
                                               OnClick="@(async () => await DeleteAsync(item.Id))"/>
                            </div>
                        </div>
                        @if (hasBodyExtra)
                        {
                            <div class="habitica-card__extra">
                                @if (tagsList.Count > 0)
                                {
                                    <div class="habitica-card__tags">
                                        @if (tagsList.Count <= 3)
                                        {
                                            @foreach (var tag in tagsList)
                                            {
                                                <span class="habitica-card__tag-badge" title="@tag">@tag</span>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var tag in tagsList.Take(2))
                                            {
                                                <span class="habitica-card__tag-badge" title="@tag">@tag</span>
                                            }
                                            <span class="habitica-card__tag-badge habitica-card__tag-badge--more" title="@(string.Join(", ", tagsList.Skip(2)))">+@(tagsList.Count - 2)</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Notes))
                                {
                                    <MudText Typo="Typo.caption" Class="habitica-card__notes" Color="Color.Secondary">@item.Notes</MudText>
                                }
                                @if (subTotal > 0)
                                {
                                    <button type="button"
                                            class="habitica-subtask-pill"
                                            @onclick="@(() => ToggleSubtasksExpand(item.Id))"
                                            @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" Class="me-1"/>
                                        <span class="habitica-subtask-pill__count">@subDone / @subTotal</span>
                                        <MudIcon Icon="@(IsSubtasksExpanded(item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Class="ms-1"/>
                                    </button>
                                }
                                @if (subTotal > 0 && IsSubtasksExpanded(item.Id))
                                {
                                    <ul class="habitica-subtask-list">
                                        @foreach (var line in checklist)
                                        {
                                            <li class="habitica-subtask-list__row" @key="line.Id">
                                                <MudCheckBox T="bool"
                                                             Value="line.IsDone"
                                                             ValueChanged="@(v => SetChecklistItemDoneAsync(item, line.Id, v))"
                                                             Label="@line.Text"
                                                             Class="ma-0 habitica-subtask-cb"
                                                             Color="Color.Secondary"
                                                             Dense="true"/>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        @if (ShouldShowItemFooter(Section, item))
                        {
                            <div class="habitica-card__foot">
                                <div class="habitica-card__foot-left">
                                    @if (Section == BoardSection.Todo && item.TodoDueDate is { } due)
                                    {
                                        <div class="@TodoDueCssClass(due)">
                                            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="me-1" Size="Size.Small"/>
                                            <span class="habitica-todo-due__date">@DateFormatService.Format(due)</span>
                                            <span class="habitica-todo-due__sep" aria-hidden="true">·</span>
                                            <span class="habitica-todo-due__relative">@TodoDueRelativeLabel(due)</span>
                                        </div>
                                    }
                                </div>
                                <div class="habitica-card__foot-right">
                                    @if (Section == BoardSection.Habit)
                                    {
                                        <div class="habitica-streak" title="@HabitCounterTitle(item)">
                                            <MudIcon Icon="@Icons.Material.Filled.FastForward" Size="Size.Small" Class="me-1"/>
                                            <span class="habitica-streak__text">@HabitStreakLabel(item)</span>
                                        </div>
                                    }
                                    else if (Section == BoardSection.Daily)
                                    {
                                        <div class="habitica-streak" title="Streak">
                                            <MudIcon Icon="@Icons.Material.Filled.FastForward" Size="Size.Small" Class="me-1"/>
                                            <span class="habitica-streak__text">@item.Counter</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>;
                };
            }
            @if (visibleItems.Count == 0)
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true" Class="ma-0" NoIcon="true">
                    @GetEmptyMessage()
                </MudAlert>
            }
            else if (canReorder)
            {
                <MudDropContainer T="HabiticaDropItem"
                                  @ref="_dropContainer"
                                  Items="_dropItems"
                                  ItemsSelector="@((item, zone) => item.Zone == zone)"
                                  ItemDropped="OnDropItemAsync"
                                  Class="habitica-drop-container mud-width-full">
                    <ChildContent>
                        <MudDropZone T="HabiticaDropItem"
                                     Identifier="@HabiticaDropItem.ListZoneId"
                                     AllowReorder="true"
                                     Class="habitica-drop-zone mud-width-full"/>
                    </ChildContent>
                    <ItemRenderer>
                        @itemCard(context.Item)
                    </ItemRenderer>
                </MudDropContainer>
            }
            else
            {
                @foreach (var item in visibleItems)
                {
                    @itemCard(item)
                }
            }
        </div>
    </MudCardContent>

    <MudCardActions Class="habitica-col-foot px-4 pb-3 pt-0">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetFooterText()</MudText>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] [EditorRequired] public BoardSection Section { get; set; }

    [Parameter] public IReadOnlyList<BoardItem> Items { get; set; } = Array.Empty<BoardItem>();

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public bool IsBoardFilterExcludingAll { get; set; }

    private string _draft = string.Empty;

    private HabitListFilter _habitFilter;
    private DailyListFilter _dailyFilter = DailyListFilter.Due;
    private TodoListFilter _todoFilter = TodoListFilter.Active;

    private readonly Dictionary<Guid, bool> _subtasksExpand = new();
    private readonly Dictionary<Guid, double> _sortOrderOverrides = new();

    private List<HabiticaDropItem> _dropItems = new();
    private MudDropContainer<HabiticaDropItem>? _dropContainer;
    private bool _needRefresh;

    protected override void OnParametersSet()
    {
        PruneSortOrderOverrides();
        SyncDropItems();
        _needRefresh = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if ((firstRender || _needRefresh) && _dropContainer is not null && IsItemDraggable())
        {
            _needRefresh = false;
            _dropContainer.Refresh();
        }
    }

    private void PruneSortOrderOverrides()
    {
        foreach (var id in _sortOrderOverrides.Keys.ToList())
        {
            var item = Items.FirstOrDefault(x => x.Id == id);
            if (item is null)
            {
                _sortOrderOverrides.Remove(id);
                continue;
            }

            if (item.SortOrder is { } serverOrder
                && Math.Abs(serverOrder - _sortOrderOverrides[id]) < 0.0001)
            {
                _sortOrderOverrides.Remove(id);
            }
        }
    }

    private void SyncDropItems()
    {
        if (!IsItemDraggable())
        {
            _dropItems = new List<HabiticaDropItem>();
            return;
        }

        var visible = VisibleItems();
        _dropItems = visible
            .Select((item, index) => new HabiticaDropItem
            {
                Item = item,
                Zone = HabiticaDropItem.ListZoneId,
                Order = index
            })
            .ToList();
    }

    private enum HabitListFilter
    {
        All,
        Weak,
        Strong
    }

    private enum DailyListFilter
    {
        All,
        Due,
        NotDue
    }

    private enum TodoListFilter
    {
        Active,
        Scheduled,
        Complete
    }

    private static Variant FilterVariant(bool active)
    {
        return active ? Variant.Filled : Variant.Outlined;
    }

    private static bool ShouldShowItemFooter(BoardSection section, BoardItem item)
    {
        return section switch
        {
            BoardSection.Todo => item.TodoDueDate is not null,
            BoardSection.Habit or BoardSection.Daily => true,
            _ => false
        };
    }

    private IReadOnlyList<BoardItem> VisibleItems()
    {
        return Section switch
        {
            BoardSection.Habit => OrderBySort(FilterHabits()),
            BoardSection.Daily => OrderBySort(FilterDailies()),
            BoardSection.Todo => OrderTodos(FilterTodos()),
            _ => OrderBySort(Items)
        };
    }

    private double? GetEffectiveSortOrder(BoardItem item) =>
        _sortOrderOverrides.TryGetValue(item.Id, out var order) ? order : item.SortOrder;

    private IReadOnlyList<BoardItem> OrderBySort(IEnumerable<BoardItem> items) =>
        items.OrderBy(x => GetEffectiveSortOrder(x) ?? double.MaxValue).ThenBy(x => x.Id).ToList();

    private IReadOnlyList<BoardItem> FilterHabits()
    {
        return _habitFilter switch
        {
            HabitListFilter.Weak => Items.Where(x => x.Counter < 3).ToList(),
            HabitListFilter.Strong => Items.Where(x => x.Counter >= 3).ToList(),
            _ => Items.ToList()
        };
    }

    private IReadOnlyList<BoardItem> FilterDailies()
    {
        var today = DailySchedule.LocalToday(TimeZoneService);
        return _dailyFilter switch
        {
            DailyListFilter.Due => Items.Where(d => DailySchedule.IsDueOnDate(d, today)).ToList(),
            DailyListFilter.NotDue => Items.Where(d => !DailySchedule.IsDueOnDate(d, today)).ToList(),
            _ => Items.ToList()
        };
    }

    private IReadOnlyList<BoardItem> FilterTodos()
    {
        return _todoFilter switch
        {
            TodoListFilter.Active => Items.Where(x => !x.IsCompleted).ToList(),
            TodoListFilter.Scheduled => Items.Where(x => !x.IsCompleted && x.TodoDueDate is not null).ToList(),
            TodoListFilter.Complete => Items.Where(x => x.IsCompleted).ToList(),
            _ => Items.ToList()
        };
    }

    private IReadOnlyList<BoardItem> OrderTodos(IReadOnlyList<BoardItem> items) =>
        _todoFilter switch
        {
            TodoListFilter.Active => TodoOrdering.OrderForActiveTab(items, GetEffectiveSortOrder),
            TodoListFilter.Scheduled => TodoOrdering.OrderForScheduledTab(items),
            _ => OrderBySort(items)
        };

    private bool IsItemDraggable() =>
        Section != BoardSection.Todo || _todoFilter == TodoListFilter.Active;

    private string GetTitle()
    {
        return Section switch
        {
            BoardSection.Habit => "Habits",
            BoardSection.Daily => "Dailies",
            BoardSection.Todo => "To Do's",
            _ => "Board"
        };
    }

    private string GetAddPlaceholder()
    {
        return Section switch
        {
            BoardSection.Habit => "Add a Habit",
            BoardSection.Daily => "Add a Daily",
            BoardSection.Todo => "Add a To Do",
            _ => "Add"
        };
    }

    private string GetEmptyMessage()
    {
        if (IsBoardFilterExcludingAll)
        {
            return "No items match your search or tag filters.";
        }

        return "No items here yet. Add one above.";
    }

    private string GetFooterText()
    {
        return Section switch
        {
            BoardSection.Habit => "These are your habits — use +/− to log a rep and undo. Click the title for notes and subtasks. The global timer can follow the habit you trigger.",
            BoardSection.Daily => "Dailies are for recurring work — use the square when you are done for today. Click the title to edit details, or the trash icon to delete.",
            BoardSection.Todo => "To Do's are one-off. On Active, drag cards to reorder; Scheduled sorts by due date. Click the title to edit details.",
            _ => string.Empty
        };
    }

    private string GetAccentClass()
    {
        return Section switch
        {
            BoardSection.Habit => "habitica-column--habit",
            BoardSection.Daily => "habitica-column--daily",
            BoardSection.Todo => "habitica-column--todo",
            _ => string.Empty
        };
    }

    private string GetRowClass(BoardItem item)
    {
        return Section switch
        {
            BoardSection.Habit => "habitica-row--habit",
            BoardSection.Daily => item.IsCompleted ? "habitica-row--done" : "habitica-row--daily-open",
            BoardSection.Todo => item.IsCompleted ? "habitica-row--done" : "habitica-row--todo-open",
            _ => string.Empty
        };
    }

    private string GetCardClass(BoardItem item) =>
        $"habitica-card {GetRowClass(item)}";

    // ── Reordering (MudBlazor MudDropContainer) ─────────────────────────────

    private async Task OnDropItemAsync(MudItemDropInfo<HabiticaDropItem> dropInfo)
    {
        await Task.Yield();

        if (!IsItemDraggable() || dropInfo.Item is null)
        {
            return;
        }

        var sourceItem = dropInfo.Item.Item;
        var visible = VisibleItems().ToList();
        var sourceIndex = visible.FindIndex(x => x.Id == sourceItem.Id);
        if (sourceIndex < 0)
        {
            return;
        }

        var insertAt = dropInfo.IndexInZone;
        if (insertAt < 0)
        {
            insertAt = 0;
        }
        else if (insertAt > visible.Count - 1)
        {
            insertAt = visible.Count - 1;
        }

        if (sourceIndex == insertAt)
        {
            return;
        }

        var reordered = visible.ToList();
        reordered.RemoveAt(sourceIndex);
        if (insertAt > reordered.Count)
        {
            insertAt = reordered.Count;
        }

        reordered.Insert(insertAt, sourceItem);

        dropInfo.Item.Zone = dropInfo.DropzoneIdentifier;
        for (var i = 0; i < reordered.Count; i++)
        {
            var dropItem = _dropItems.First(x => x.Item.Id == reordered[i].Id);
            dropItem.Order = i;
            dropItem.Zone = HabiticaDropItem.ListZoneId;
        }
        _dropItems = _dropItems.OrderBy(x => x.Order).ToList();

        var newSortOrder = Section == BoardSection.Todo && _todoFilter == TodoListFilter.Active
            ? TodoOrdering.ComputeMidpointSortOrderForActiveTab(reordered, insertAt, GetEffectiveSortOrder)
            : BoardItemReorder.ComputeMidpointSortOrder(reordered, insertAt, GetEffectiveSortOrder);
        if (newSortOrder is not { } sortOrder)
        {
            SyncDropItems();
            _dropContainer?.Refresh();
            return;
        }

        _sortOrderOverrides[sourceItem.Id] = sortOrder;
        _dropContainer?.Refresh();
        StateHasChanged();

        var ok = await TryMutateAsync(() => PersistReorderAsync(sourceItem, sortOrder));
        if (!ok)
        {
            _sortOrderOverrides.Remove(sourceItem.Id);
            SyncDropItems();
            _dropContainer?.Refresh();
            StateHasChanged();
            return;
        }
    }

    private Task PersistReorderAsync(BoardItem item, double newSortOrder)
    {
        return Section switch
        {
            BoardSection.Habit => BoardData.UpdateHabitAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                item.TrackPlus,
                item.TrackMinus,
                item.ResetPeriod,
                item.Counter,
                item.NegativeCounter,
                item.ChecklistJson,
                sortOrder: newSortOrder),

            BoardSection.Daily => BoardData.UpdateDailyAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                item.DailyStartDate?.ToDateTime(TimeOnly.MinValue),
                item.DailyRepeat,
                item.DailyRepeatInterval,
                item.ChecklistJson,
                item.Counter,
                sortOrder: newSortOrder),

            BoardSection.Todo => BoardData.UpdateTodoAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                item.ChecklistJson,
                item.TodoDueDate?.ToDateTime(TimeOnly.MinValue),
                sortOrder: newSortOrder),

            _ => Task.CompletedTask
        };
    }

    private string TodoDueRelativeLabel(DateOnly due) =>
        TodoDueRelativeText.Format(due, BoardToday());

    private string TodoDueCssClass(DateOnly due)
    {
        var days = due.DayNumber - BoardToday().DayNumber;
        var state = days switch
        {
            < 0 => "overdue",
            0 => "today",
            _ => "upcoming"
        };

        return $"habitica-todo-due habitica-todo-due--{state}";
    }

    private DateOnly BoardToday() => DailySchedule.LocalToday(TimeZoneService);

    private static string HabitStreakLabel(BoardItem item)
    {
        return (item.TrackPlus, item.TrackMinus) switch
        {
            (true, true) => $"+{item.Counter} / −{item.NegativeCounter}",
            (true, false) => $"{item.Counter}",
            (false, true) => $"−{item.NegativeCounter}",
            _ => "—"
        };
    }

    private bool IsSubtasksExpanded(Guid itemId)
    {
        return !_subtasksExpand.TryGetValue(itemId, out var v) || v;
    }

    private void ToggleSubtasksExpand(Guid id)
    {
        _subtasksExpand[id] = !IsSubtasksExpanded(id);
    }

    private async Task SetChecklistItemDoneAsync(BoardItem item, Guid lineId, bool done)
    {
        var rows = DailyChecklistJson.Parse(item.ChecklistJson);
        var list = rows.ToList();
        var i = list.FindIndex(x => x.Id == lineId);
        if (i < 0 || list[i].IsDone == done)
        {
            return;
        }

        list[i] = list[i] with { IsDone = done };
        var json = DailyChecklistJson.Serialize(list);
        if (json is null)
        {
            return;
        }

        if (Section == BoardSection.Daily)
        {
            await TryMutateAsync(() => BoardData.UpdateDailyAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                item.DailyStartDate?.ToDateTime(TimeOnly.MinValue),
                item.DailyRepeat,
                item.DailyRepeatInterval,
                json,
                item.Counter));
        }
        else if (Section == BoardSection.Todo)
        {
            await TryMutateAsync(() => BoardData.UpdateTodoAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                json,
                item.TodoDueDate?.ToDateTime(TimeOnly.MinValue)));
        }
        else
        {
            await TryMutateAsync(() => BoardData.UpdateHabitAsync(
                item.Id,
                item.Title,
                item.Notes,
                item.Tags,
                item.TrackPlus,
                item.TrackMinus,
                item.ResetPeriod,
                item.Counter,
                item.NegativeCounter,
                json));
        }
    }

    private string GetCheckClass(BoardItem item)
    {
        if (item.IsCompleted)
        {
            return "habitica-check--ok";
        }

        return Section == BoardSection.Daily ? "habitica-check--daily" : "habitica-check--todo";
    }

    private async Task OnDraftKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key is not "Enter" and not "NumpadEnter")
        {
            return;
        }

        await AddFromDraftAsync();
    }

    private async Task AddFromDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft))
        {
            return;
        }

        var title = _draft.Trim();
        if (!await TryMutateAsync(() => BoardData.CreateItemAsync(Section, title)))
        {
            return;
        }

        _draft = string.Empty;
    }

